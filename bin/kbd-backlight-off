#!/bin/bash
# kbd-backlight-off — saves current keyboard-backlight brightness, sets it to 0.
# Counterpart: kbd-backlight-restore.
BACKLIGHT="/sys/class/leds/smc::kbd_backlight/brightness"
STATE_DIR="$HOME/.local/share/arc-kbd-lock-watch"
STATE_FILE="$STATE_DIR/last-brightness"

[[ -w "$BACKLIGHT" ]] || { echo "not writable: $BACKLIGHT (needs the video group + udev rule)" >&2; exit 1; }

mkdir -p "$STATE_DIR"
cat "$BACKLIGHT" > "$STATE_FILE"
echo 0 > "$BACKLIGHT"
