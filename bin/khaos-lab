# ── data sources (read-only) ─────────────────────────────────────────────────
class InventoryData:
    """arc-inv's generated inventory.json -- the panel reads the report, it
    never re-implements the probes."""

    @staticmethod
    def load():
        try:
            return json.loads(INVENTORY_JSON.read_text())
        except Exception:
            return None

    @staticmethod
    def age_minutes(d):
        try:
            at = datetime.fromisoformat(d["scan"]["at"])
            return (datetime.now(timezone.utc) - at).total_seconds() / 60
        except Exception:
            return None

    @classmethod
    def summary(cls, d):
        """(text, color) for a one-line tile."""
        if not d:
            return "no inventory yet — open Inventory → scan now", GOLD
        c = d.get("counts", {})
        age = cls.age_minutes(d)
        parts = [f"{len(d.get('assets', []))} assets", f"{c.get('ok', 0)} ok"]
        for k in ("attention", "drift", "unknown"):
            if c.get(k):
                parts.append(f"{c[k]} {k}")
        if d.get("untracked"):
            parts.append(f"{len(d['untracked'])} unregistered")
        text = "  ·  ".join(parts) + f"\nscan {fmt_age(age)}"
        if c.get("drift"):
            color = ROSE
        elif d.get("untracked") or (age is not None and age > 90) or c.get("unknown", 0) > 3:
            color = GOLD
        else:
            color = TEAL
        return text, color


class CloudLab:
    """AWS lab state, from `arc aws-status` (one source of truth -- the old code
    re-implemented the AWS calls here with a hardcoded account id). Cached 90s
    and shared by every view that shows it, so navigating around never
    multiplies AWS calls."""

    TTL = 90

    def __init__(self, runner):
        self.runner = runner
        self._lock = threading.Lock()
        self._at, self._val = 0.0, ("checking…", FG)

    def snapshot(self):
        with self._lock:
            if time.time() - self._at < self.TTL:
                return self._val
            ok, out = self.runner.run("arc aws-status", timeout=40)
            inst = re.findall(r"·\s+(\S+?)(?:-cloud)?\s+(running|stopped|stopping|pending|terminated|\S+)", out)
            if not ok or not inst:
                self._val = ("unreachable (check aws credentials / network)", ROSE)
            else:
                spend = re.search(r"budget\s+\$([\d.]+)/(\d+)", out)
                spend_s = f"${float(spend.group(1)):.2f}/{spend.group(2)}" if spend else "spend n/a"
                text = "  ·  ".join(f"{n} {s}" for n, s in inst) + f"  ·  {spend_s}"
                self._val = (text, TEAL if any(s == "running" for _, s in inst) else FG)
            self._at = time.time()
            return self._val


# ── dialogs ──────────────────────────────────────────────────────────────────
class Dialog:
    """One modal-dialog helper (the old code copy-pasted three near-identical
    popups, none modal -- so confirms could stack). Escape cancels."""

    def __init__(self, app, title, resizable=False, geometry=None):
        self.app = app
        self.win = tk.Toplevel(app.root)
        self.win.title(title)
        self.win.configure(bg=BG)
        self.win.resizable(resizable, resizable)
        self.win.attributes("-topmost", True)
        self.win.transient(app.root)
        self.win.geometry(geometry or f"+{app.root.winfo_x() + 120}+{app.root.winfo_y() + 150}")
        self.win.bind("<Escape>", lambda _e: self.close())
        self.shell = tk.Frame(self.win, bg=SURFACE)
        self.shell.pack(fill="both", expand=True, padx=8, pady=8)
        tk.Frame(self.shell, bg=app.phase_accent, height=2).pack(fill="x")
        tk.Label(self.shell, text=title, font=app.f.label, bg=SURFACE,
                 fg=FG, anchor="w").pack(fill="x", padx=22, pady=(17, 10))
        self.win.after(60, self._grab)

    def _grab(self):
        try:
            self.win.grab_set()
            self.win.focus_force()
        except tk.TclError:
            pass                      # not viewable yet / already closed -- harmless

    def label(self, text, fg=FG, font=None, wrap=None, pady=(0, 10)):
        tk.Label(self.shell, text=text, font=font or self.app.f.label, bg=SURFACE, fg=fg,
                 wraplength=wrap or 0, justify="left", anchor="w").pack(fill="x", padx=18, pady=pady)

    def buttons(self, specs):
        self.button_rows([specs])

    def button_rows(self, rows):
        for specs in rows:
            row = tk.Frame(self.shell, bg=SURFACE)
            row.pack(pady=(0, 8))
            for text, fg, fn in specs:
                ui.button(row, text, command=(lambda f=fn: (self.close(), f and f())), font=self.app.f.small,
                          bg=SURFACE, fg=fg, hover_bg=OVERLAY, padx=12, pady=6).pack(side="left", padx=6)
        tk.Frame(self.shell, bg=SURFACE, height=6).pack()

    def close(self):
        try:
            self.win.grab_release()
        except tk.TclError:
            pass
        self.win.destroy()


# ── console pane ─────────────────────────────────────────────────────────────
class ConsolePane:
    """Shared output console. Colour is by named tag per colour (the old code
    named tags by text LENGTH, so two equal-length lines shared -- and kept
    overwriting -- one colour, and only the last line of a multi-line block was
    tagged at all). Capped so a chatty command can't grow it without bound."""

    MAX_LINES = 3000

    def __init__(self, app, parent):
        f = app.f
        bar = tk.Frame(parent, bg=BG)
        bar.pack(fill="x", pady=(0, 4))
        tk.Label(bar, text="LIVE OUTPUT", font=f.small, bg=BG, fg=app.phase_accent).pack(side="left")
        tk.Label(bar, text="hover, then drag the divider to resize  ·  wheel to scroll", font=f.small,
                 bg=BG, fg=FG_MUTED).pack(side="right")
        # Canvas + padded create_window (same technique as the content pane): the Text is opaque,
        # so the background art only shows in the pad margin around it -- by design.
        self.canvas = tk.Canvas(parent, bg=SURFACE, highlightthickness=0)
        self.canvas.pack(side="left", fill="both", expand=True)
        if app.content_bg:
            self.canvas.create_image(0, 0, anchor="nw", image=app.content_bg)
        self.text = tk.Text(self.canvas, bg=SURFACE, fg=FG, insertbackground=FG, font=f.mono,
                            relief="flat", padx=8, pady=6, wrap="word", state="disabled")
        self._pad = 5
        self._item = self.canvas.create_window(self._pad, self._pad, anchor="nw", window=self.text)
        self.canvas.bind("<Configure>", self._resize)
        self._tags = {}
        self.scroll = ui.PillScrollbar(parent, orient="vertical", command=self.text.yview,
                                   bg=OVERLAY, troughcolor=BG, activebackground=app.phase_accent,
                                   bd=0, highlightthickness=0, width=13)
        self.scroll.pack(side="right", fill="y")
        self.text.configure(yscrollcommand=self.scroll.set)

    def _resize(self, event):
        self.canvas.itemconfigure(self._item, width=max(event.width - 2 * self._pad, 1),
                                  height=max(event.height - 2 * self._pad, 1))

    def _tag(self, color):
        name = self._tags.get(color)
        if name is None:
            name = self._tags[color] = f"col_{len(self._tags)}"
            self.text.tag_configure(name, foreground=color)
        return name

    def log(self, text, color=None):
        t = self.text
        color = color or FG
        t.configure(state="normal")
        start = t.index("end-1c")
        t.insert("end", text + "\n")
        t.tag_add(self._tag(color), start, "end-1c")
        extra = int(t.index("end-1c").split(".")[0]) - self.MAX_LINES
        if extra > 0:
            t.delete("1.0", f"{extra + 1}.0")
        t.see("end")
        t.configure(state="disabled")


# ── views ────────────────────────────────────────────────────────────────────
class View:
    """One screen. Owns its widgets and its poll jobs; destroy() stops the jobs
    (so nothing keeps updating widgets that no longer exist)."""

    scrollable = False

    def __init__(self, app):
        self.app = app
        self.frame = None
        self._jobs = []

    def show(self):
        self.frame = tk.Frame(self.app.content, bg=SURFACE)
        self.app.embed(self.frame, scrollable=self.scrollable)
        self.build()
        if self.scrollable:
            self.app.refresh_scroll(self.frame)

    def build(self):
        raise NotImplementedError

    def alive(self):
        try:
            return self.frame is not None and bool(self.frame.winfo_exists())
        except tk.TclError:
            return False

    def poll(self, name, every_ms, work, apply):
        self._jobs.append(name)
        self.app.poller.start(name, every_ms, work, apply, self.alive)

    def kick(self, name):
        self.app.poller.kick(name)

    def destroy(self):
        for n in self._jobs:
            self.app.poller.stop(n)
        self._jobs = []
        self.frame = None


class TileView(View):
    """A 2-column grid of live status tiles. Subclasses declare TILES and
    checks() -> {key: callable}; each callable returns text or (text, colour).
    Checks run in parallel and each tile is updated the moment ITS check
    finishes (a refresh used to wait for the slowest one, so tiles stayed
    "checking…" for the length of an AWS call). Colours are decided in the
    worker thread -- never on the UI thread, where a lock held during a slow
    call would freeze the window."""

    scrollable = True
    TILES = []            # (row, col, key, title)
    EVERY = 15000
    NAME = "tiles"

    def build(self):
        self.labels = {}
        self._tile_frames = []
        for _row, _col, key, title in self.TILES:
            shell, f = ui.rounded_frame(self.frame, SURFACE, bg=OVERLAY, radius=16)
            self._tile_frames.append(shell)
            accent = tk.Frame(f, bg=self.app.phase_accent, height=1)
            accent.pack(fill="x")
            self.app.phase_lines.append(accent)
            tk.Label(f, text=title, font=self.app.f.small, bg=OVERLAY, fg=FG_MUTED).pack(
                anchor="w", padx=10, pady=(8, 2))
            val = tk.Label(f, text="checking…", font=self.app.f.label, bg=OVERLAY, fg=FG, justify="left",
                           anchor="w")
            val.pack(anchor="w", fill="x", padx=10, pady=(0, 8))
            # wrap long values to the tile instead of clipping them off both edges
            f.bind("<Configure>", lambda e, v=val: v.configure(wraplength=max(e.width - 30, 80)), add='+')
            self.labels[key] = val
        self.frame.bind("<Configure>", self._layout_tiles, add="+")
        self._layout_tiles(SimpleNamespace(width=max(self.frame.winfo_width(), 600)))
        self.poll(self.NAME, self.EVERY, self.collect, lambda _r: None)

    def _layout_tiles(self, event):
        if not hasattr(self, "_tile_frames"):
            return
        width = getattr(event, "width", self.frame.winfo_width())
        cols = 1 if width < 560 else 2 if width < 980 else 3
        for i, tile in enumerate(self._tile_frames):
            tile.grid(row=i // cols, column=i % cols, padx=8, pady=8, sticky="nsew")
        for col in range(max(cols, getattr(self, "_tile_cols", 0))):
            self.frame.grid_columnconfigure(col, weight=1 if col < cols else 0,
                                            uniform="tiles" if col < cols else "")
        self._tile_cols = cols

    def refresh(self):
        self.kick(self.NAME)

    def checks(self):
        raise NotImplementedError

    def color_for(self, key, val):
        return FG

    def collect(self):
        """Worker thread: run every check concurrently, posting each result to
        the UI as it lands."""
        def one(item):
            key, fn = item
            try:
                r = fn()
            except Exception:
                r = "unavailable"
            text, color = r if isinstance(r, tuple) else (r, None)
            self.app.bridge.post(self._apply_one, key, text, color if color else self.color_for(key, text))
        items = list(self.checks().items())
        with cf.ThreadPoolExecutor(max_workers=len(items)) as ex:
            list(ex.map(one, items))

    def _apply_one(self, key, text, color):
        lbl = self.labels.get(key)
        if lbl is None or not self.alive():
            return
        lbl.configure(text=text, fg=color)
        self.app.refresh_scroll(self.frame)


class AudioView(View):
    """A small, explicit control surface for the current default output."""

    NAME = "audio-default-output"
    EVERY = 8000

    def build(self):
        self.snapshot = None
        self._loading_scale = False
        self._level_dirty = False
        self._eq_dirty = False
        self._eq_stale = False
        self._eq_busy = False
        self._eq_loaded_hash = None
        self._eq_info = read_speaker_eq_snapshot()

        heading = tk.Frame(self.frame, bg=SURFACE)
        heading.pack(fill="x", pady=(0, 10))
        tk.Label(heading, text="AUDIO  /  OUTPUT", font=self.app.f.small, bg=SURFACE,
                 fg=self.app.phase_accent, anchor="w").pack(fill="x")
        tk.Label(heading, text="One clear place for the speaker output.", font=self.app.f.big,
                 bg=SURFACE, fg=FG, anchor="w").pack(fill="x", pady=(3, 2))
        tk.Label(heading, text="Changes apply only when you press a control. Nothing starts in the background.",
                 font=self.app.f.small, bg=SURFACE, fg=FG_MUTED, anchor="w",
                 wraplength=640, justify="left").pack(fill="x")
        heading.bind("<Configure>", lambda event: [
            child.configure(wraplength=max(event.width - 4, 140))
            for child in heading.winfo_children()
            if isinstance(child, tk.Label) and child.cget("justify") == "left"
        ], add="+")

        output_shell, output = ui.rounded_frame(self.frame, SURFACE, bg=OVERLAY, radius=16)
        output_shell.pack(fill="x", pady=6)
        tk.Label(output, text="DEFAULT OUTPUT", font=self.app.f.small, bg=OVERLAY,
                 fg=FG_MUTED, anchor="w").pack(fill="x", padx=12, pady=(10, 3))
        self.output_name = tk.Label(output, text="checking output…", font=self.app.f.label,
                                    bg=OVERLAY, fg=FG, anchor="w", justify="left")
        self.output_name.pack(fill="x", padx=12, pady=(0, 3))
        self.output_state = tk.Label(output, text="", font=self.app.f.small, bg=OVERLAY,
                                     fg=FG_MUTED, anchor="w", justify="left")
        self.output_state.pack(fill="x", padx=12, pady=(0, 10))
        output.bind("<Configure>", lambda event: self.output_name.configure(
            wraplength=max(event.width - 32, 140)), add="+")

        control_shell, controls = ui.rounded_frame(self.frame, SURFACE, bg=OVERLAY, radius=16)
        control_shell.pack(fill="x", pady=6)
        tk.Label(controls, text="LEVEL  ·  panel limit 100%", font=self.app.f.small,
                 bg=OVERLAY, fg=FG_MUTED, anchor="w").pack(fill="x", padx=12, pady=(10, 0))
        self.level_var = tk.IntVar(master=self.frame, value=50)
        self.level_scale = tk.Scale(
            controls, from_=0, to=100, resolution=1, orient="horizontal", showvalue=False,
