}

# ── Mirrors ────────────────────────────────────────────────────────────────────
cmd_mirrors() {
  local sub="${1:-status}"
  local LOG="$HOME/.local/share/sync-mirrors/sync-mirrors.log"

  case "$sub" in
    run)
      echo -e "$HR"
      echo -e "  ${C}${B}arc mirrors run${N}  —  sync k45 → k6 now"
      echo -e "$HR\n"
      sync-mirrors
      echo -e "$HR"
      ;;

    log)
      echo -e "$HR"
      echo -e "  ${C}${B}arc mirrors log${N}  —  sync history"
      echo -e "$HR\n"
      if [[ ! -s "$LOG" ]]; then
        echo -e "  ${D}·${N}  no log yet — run ${C}arc mirrors run${N}"
      else
        tail -40 "$LOG" | while IFS= read -r line; do
          if [[ "$line" == *"OK "* ]];    then echo -e "  ${G}${line}${N}"
          elif [[ "$line" == *"SYNC "* ]]; then echo -e "  ${C}${line}${N}"
          elif [[ "$line" == *"DONE "* ]]; then echo -e "  ${G}${line}${N}"
          elif [[ "$line" == *"ERR "* ]];  then echo -e "  ${R}${line}${N}"
          elif [[ "$line" == *"SKIP "* ]]; then echo -e "  ${Y}${line}${N}"
          else echo -e "  ${D}${line}${N}"
          fi
        done
      fi
      echo -e "\n$HR"
      ;;

    status|'')
      echo -e "$HR"
      echo -e "  ${C}${B}arc mirrors${N}  —  k45 → k6 sync status"
      echo -e "$HR\n"
      if [[ ! -s "$LOG" ]]; then
        echo -e "  ${D}·${N}  no sync on record — run ${C}arc mirrors run${N}"
        echo -e "\n$HR"; return 0
      fi
      # last run stats
      local last_run last_synced last_errors last_skipped
      last_run=$(grep "=== sync-mirrors start ===" "$LOG" | tail -1 | cut -d']' -f1 | tr -d '[')
      local last_block
      last_block=$(awk '/=== sync-mirrors start ===/{ buf="" } { buf=buf"\n"$0 } END{print buf}' "$LOG")
      last_synced=$(echo "$last_block" | grep -c "^.*DONE " || true)
      last_errors=$(echo "$last_block" | grep -c "^.*ERR " || true)
      last_skipped=$(echo "$last_block" | grep -c "^.*SKIP " || true)
      local in_sync
      in_sync=$(echo "$last_block" | grep -c "^.*OK " || true)

      echo -e "  ${D}last run:${N}  ${M}${last_run:-unknown}${N}"
      echo -e "  ${D}in sync:${N}   ${G}${in_sync}${N}"
      [[ "$last_synced" -gt 0 ]] && echo -e "  ${D}synced:${N}    ${C}${last_synced}${N}"
      [[ "$last_skipped" -gt 0 ]] && echo -e "  ${D}skipped:${N}   ${Y}${last_skipped}${N}"
      [[ "$last_errors" -gt 0 ]]  && echo -e "  ${D}errors:${N}    ${R}${last_errors}${N}"
      echo ""
      echo -e "  ${D}arc mirrors run   — sync now${N}"
      echo -e "  ${D}arc mirrors log   — full history${N}"
      echo -e "  ${D}cron: daily 2am   — ~/.local/bin/sync-mirrors${N}"
      echo -e "\n$HR"
      ;;

    *)
      echo -e "  usage: arc mirrors [status|run|log]"
      ;;
  esac
}

# ── Deploy ─────────────────────────────────────────────────────────────────────
cmd_deploy() {
  local target="${1:-athena}"
  local CF_TOKEN
  CF_TOKEN=$(grep '^arc-deploy=' ~/dev-notes/surgery-tools/.cftk | cut -d= -f2)
  export NVM_DIR="$HOME/.nvm"
  [ -s "$NVM_DIR/nvm.sh" ] && source "$NVM_DIR/nvm.sh"

  case "$target" in
    athena)
      cd ~/khaos-lab/athena || { echo -e "  ${R}✗${N}  athena repo not found"; return 1; }
      echo -e "  ${C}building athena${N} …"
      node node_modules/vite/bin/vite.js build 2>&1 | tail -5 || { echo -e "  ${R}✗${N}  build failed"; return 1; }
      echo -e "  ${C}deploying to CF Pages${N} …"
      CLOUDFLARE_API_TOKEN="$CF_TOKEN" npx wrangler pages deploy dist \
        --project-name athena --branch main --commit-dirty=true \
        && echo -e "  ${G}✓${N}  athena deployed" \
        || echo -e "  ${R}✗${N}  deploy failed"
      ;;
    kataleya)
      cd ~/khaos-lab/kataleya || { echo -e "  ${R}✗${N}  kataleya repo not found"; return 1; }
      echo -e "  ${C}building kataleya${N} …"
      node node_modules/vite/bin/vite.js build 2>&1 | tail -5 || { echo -e "  ${R}✗${N}  build failed"; return 1; }
      echo -e "  ${C}deploying to CF Pages${N} …"
      CLOUDFLARE_API_TOKEN="$CF_TOKEN" npx wrangler pages deploy dist \
        --project-name kataleya-web --branch main --commit-dirty=true \
        && echo -e "  ${G}✓${N}  kataleya deployed → kataleya.kontor.studio" \
        || echo -e "  ${R}✗${N}  deploy failed"
      ;;
    *)
      echo -e "  ${R}unknown target:${N} $target  —  try ${C}arc deploy athena${N} or ${C}arc deploy kataleya${N}"
      ;;
  esac
}

