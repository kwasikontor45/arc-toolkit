#!/usr/bin/env python3
"""Local Hub calendar: Orage is read-only; this service owns check marks."""
import argparse
import base64
import hashlib
import json
import os
import re
import secrets
import sqlite3
import threading
from contextlib import contextmanager
from datetime import datetime, timedelta, timezone
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import urlsplit

from dateutil import rrule, tz

HOME = Path.home()
SOURCE = HOME / '.local/share/orage/orage.ics'
STATE = HOME / '.local/share/khaos-hub'
WEB = Path(__file__).resolve().parent.parent / 'apps/khaos-hub/web'
GARAGE_APP = Path(__file__).resolve().parent.parent / 'apps/surgery-workshop/garage.html'
PORT = 8766
ORIGIN = f'http://127.0.0.1:{PORT}'
TOKEN = secrets.token_urlsafe(32)
LOCK = threading.Lock()


def parse_date(prop, value):
    zone = tz.tzlocal()
    for param in prop.split(';')[1:]:
        if param.startswith('TZID='):
            zone = tz.gettz(param[5:].strip('"')) or zone
    if value.endswith('Z'):
        return datetime.strptime(value, '%Y%m%dT%H%M%SZ').replace(tzinfo=timezone.utc)
    if len(value) == 8:
        return datetime.strptime(value, '%Y%m%d').replace(tzinfo=zone)
    return datetime.strptime(value, '%Y%m%dT%H%M%S').replace(tzinfo=zone)


def calendar_items(source=None, now=None):
    source = source or SOURCE
    now = now or datetime.now(tz.tzlocal())
    today = now.replace(hour=0, minute=0, second=0, microsecond=0)
    lines = []
    raw = source.read_text()
    if not raw.lstrip().startswith('BEGIN:VCALENDAR') or not raw.rstrip().endswith('END:VCALENDAR'):
        raise OSError('Calendar is being rewritten; retry')
    for line in raw.splitlines():
        if line.startswith((' ', '\t')) and lines:
            lines[-1] += line[1:]
        else:
            lines.append(line)
    components, current, depth = [], None, 0
    for line in lines:
        if line in ('BEGIN:VEVENT', 'BEGIN:VTODO') and current is None:
            current = {'kind': line[6:], 'fields': {}}
            depth = 1
        elif current is not None:
            if line.startswith('BEGIN:'):
                depth += 1
            elif line.startswith('END:'):
                depth -= 1
                if depth == 0:
                    components.append(current)
                    current = None
            elif depth == 1 and ':' in line:
                prop, value = line.split(':', 1)
                current['fields'].setdefault(prop.split(';')[0].upper(), []).append((prop, value))
    items, seen, overrides = [], set(), set()
    for component in components:
        fields = component['fields']
        if 'RECURRENCE-ID' in fields and 'UID' in fields:
            try:
                overrides.add((fields['UID'][0][1], parse_date(*fields['RECURRENCE-ID'][0]).isoformat()))
            except ValueError:
                pass
    for component in components:
        f = component['fields']
        value = lambda key, default='': f.get(key, [('', default)])[0][1]
        uid, title = value('UID'), value('SUMMARY')
        if not uid or not title or value('STATUS') == 'CANCELLED':
            continue
        title = title.replace(r'\n', ' ').replace(r'\,', ',').replace(r'\;', ';').replace(r'\\', '\\')
        date_field = f.get('DUE', f.get('DTSTART', [])) if component['kind'] == 'VTODO' else f.get('DTSTART', [])
        try:
            start = parse_date(*date_field[0]) if date_field else None
            dates = [start]
            if value('RRULE') and start and 'RECURRENCE-ID' not in f:
                series = rrule.rruleset()
                series.rrule(rrule.rrulestr(value('RRULE'), dtstart=start))
                for prop, vals in f.get('EXDATE', []):
                    for val in vals.split(','):
                        series.exdate(parse_date(prop, val))
                for prop, vals in f.get('RDATE', []):
                    for val in vals.split(','):
                        series.rdate(parse_date(prop, val))
                dates = []
                for occurrence in series.xafter(today, count=60, inc=True):
                    if occurrence > today + timedelta(days=14):
                        break
                    dates.append(occurrence)
            for date in dates:
                if component['kind'] == 'VEVENT' and (date is None or date < today or date > today + timedelta(days=14)):
                    continue
                stamp = date.isoformat() if date and (value('RRULE') or 'RECURRENCE-ID' in f) else ''
                if 'RECURRENCE-ID' in f:
                    stamp = parse_date(*f['RECURRENCE-ID'][0]).isoformat()
                if 'RECURRENCE-ID' not in f and date and (uid, date.isoformat()) in overrides:
                    continue
                key = hashlib.sha256((uid + '\0' + stamp).encode()).hexdigest()
                if key in seen:
                    continue
                seen.add(key)
                if component['kind'] == 'VTODO':
                    kind = 'To-do'
                else:
                    # Orage stores timed VEVENTs as appointments and date-only
                    # VEVENTs as events. Keep that distinction visible to both UIs.
                    start_prop = date_field[0][0] if date_field else ''
                    kind = 'Appointment' if date and 'VALUE=DATE' not in start_prop and len(date_field[0][1]) > 8 else 'Event'
                all_day = bool(date_field and ('VALUE=DATE' in date_field[0][0] or len(date_field[0][1]) == 8))
                when = (date.strftime('%a %b %d') if date and all_day else
                        date.astimezone().strftime('%a %b %d · %H:%M') if date else 'No due date')
                items.append({'id': key, 'title': title, 'kind': kind,
                              'when': when,
                              'date': date.isoformat() if date else '',
                              'all_day': all_day,
                              'repeating': bool(value('RRULE')),
                              'source_done': value('STATUS') == 'COMPLETED'})
        except (ValueError, TypeError, OverflowError):
            continue
    return sorted(items, key=lambda item: (item['date'] or '9999', item['kind'], item['title']))


@contextmanager
def connection():
    STATE.mkdir(mode=0o700, parents=True, exist_ok=True)
    db = sqlite3.connect(STATE / 'checks.db', timeout=5)
    db.execute('CREATE TABLE IF NOT EXISTS checks (id TEXT PRIMARY KEY, done INTEGER NOT NULL, revision INTEGER NOT NULL)')
    try:
        with db:
            yield db
    finally:
        db.close()


def snapshot():
    items = calendar_items()
    with connection() as db:
        marks = dict((key, (bool(done), revision)) for key, done, revision in db.execute('SELECT id,done,revision FROM checks'))
    for item in items:
        item['done'], item['revision'] = marks.get(item['id'], (item.pop('source_done'), 0))
        item.pop('source_done', None)
    return {'items': items, 'updated': datetime.now().isoformat(), 'scope': 'Shared Hub/Lab check marks; Orage appointments and alarms stay unchanged.'}


def set_checked(data):
    if type(data.get('done')) is not bool or type(data.get('revision')) is not int:
        raise ValueError('Invalid check mark')
    with LOCK:
        item = next((i for i in snapshot()['items'] if i['id'] == data.get('id')), None)
        if not item:
            raise ValueError('Appointment is no longer available')
        if item['revision'] != data['revision']:
            raise RuntimeError('Changed in another view. Refresh and retry.')
        with connection() as db:
            db.execute('INSERT INTO checks VALUES (?,?,?) ON CONFLICT(id) DO UPDATE SET done=excluded.done,revision=excluded.revision',
                       (item['id'], int(data['done']), item['revision'] + 1))
        return snapshot()


def library_connection():
    STATE.mkdir(mode=0o700, parents=True, exist_ok=True)
    path = STATE / 'library.sqlite3'
    db = sqlite3.connect(path, timeout=5)
    try:
        os.chmod(STATE, 0o700)
        os.chmod(path, 0o600)
    except OSError:
        pass
    db.execute(
        "CREATE TABLE IF NOT EXISTS library ("
        "id TEXT PRIMARY KEY, title TEXT NOT NULL, url TEXT NOT NULL, "
        "kind TEXT NOT NULL, tags TEXT NOT NULL, note TEXT NOT NULL, "
        "created TEXT NOT NULL, updated TEXT NOT NULL)"
    )
    return db


def library_list():
    with library_connection() as db:
        rows = db.execute(
            "SELECT id,title,url,kind,tags,note,created,updated "
            "FROM library ORDER BY updated DESC"
        ).fetchall()
    keys = ('id', 'title', 'url', 'kind', 'tags', 'note', 'created', 'updated')
    return {'items': [dict(zip(keys, row)) for row in rows]}


def library_save(data):
    if not isinstance(data, dict):
        raise ValueError('Invalid item')
    fields = ('title', 'url', 'kind', 'tags', 'note')
    if any(key in data and not isinstance(data[key], str) for key in fields):
        raise ValueError('Library fields must be text')
    title = data.get('title', '').strip()
    url = data.get('url', '').strip()
    kind = data.get('kind', 'bookmark')
    tags = data.get('tags', '').strip()
    note = data.get('note', '').strip()
    if not title or len(title) > 180:
        raise ValueError('Title required (180 characters max)')
    parsed = urlsplit(url) if url else None
    if len(url) > 2048 or (url and (
        parsed.scheme not in ('http', 'https') or not parsed.hostname
        or parsed.username or parsed.password
        or any(ord(char) < 32 for char in url)
    )):
        raise ValueError('Use a valid http or https URL without embedded credentials')
    if kind not in ('bookmark', 'tutorial', 'research', 'incident'):
        raise ValueError('Invalid library type')
    if len(tags) > 240 or len(note) > 4000:
        raise ValueError('Tags or note are too long')
    item_id = data.get('id') or secrets.token_urlsafe(12)
    if not isinstance(item_id, str) or len(item_id) > 40 or not item_id.replace('-', '').replace('_', '').isalnum():
        raise ValueError('Invalid item identifier')
    now = datetime.now(timezone.utc).isoformat(timespec='seconds')
    with library_connection() as db:
        exists = db.execute('SELECT 1 FROM library WHERE id=?', (item_id,)).fetchone()
        if exists:
            db.execute(
                'UPDATE library SET title=?,url=?,kind=?,tags=?,note=?,updated=? WHERE id=?',
                (title, url, kind, tags, note, now, item_id),
            )
        else:
            db.execute(
                'INSERT INTO library VALUES (?,?,?,?,?,?,?,?)',
                (item_id, title, url, kind, tags, note, now, now),
            )
    return library_list()


def library_delete(data):
    item_id = data.get('id') if isinstance(data, dict) else None
    if not isinstance(item_id, str) or len(item_id) > 40:
        raise ValueError('Invalid item identifier')
    with library_connection() as db:
        db.execute('DELETE FROM library WHERE id=?', (item_id,))
    return library_list()


def garage_csp():
    """Build the Garage policy from its exact inline script and style bytes."""
    html = GARAGE_APP.read_text(encoding='utf-8')
    hashes = {}
    for tag in ('script', 'style'):
        match = re.search(rf'<{tag}[^>]*>(.*?)</{tag}>', html, re.S)
        if not match:
            raise ValueError(f'Garage is missing its inline {tag}')
        digest = base64.b64encode(hashlib.sha256(match.group(1).encode()).digest()).decode()
        hashes[tag] = f"'sha256-{digest}'"
    return ("default-src 'none'; "
            f"script-src {hashes['script']}; style-src {hashes['style']}; "
            "img-src data:; connect-src 'none'; font-src 'none'; object-src 'none'; "
            "frame-ancestors 'none'; base-uri 'none'; form-action 'none'")


def static_assets():
    """Return the exact static routes served by the local Hub."""
    return {
        '/': (WEB, 'index.html', 'text/html; charset=utf-8'),
        '/app.js': (WEB, 'app.js', 'text/javascript'),
        '/app.css': (WEB, 'app.css', 'text/css'),
        '/icon.svg': (WEB, 'icon.svg', 'image/svg+xml'),
        '/icon-kimi-512.png': (WEB, 'icon-kimi-512.png', 'image/png'),
        '/khaos-lab-mark.png': (WEB, 'khaos-lab-mark.png', 'image/png'),
        '/khaos-lab-mark-512.png': (WEB, 'khaos-lab-mark-512.png', 'image/png'),
        '/kimi-khaos-hub.png': (WEB, 'kimi-khaos-hub.png', 'image/png'),
        '/kimi-wallpaper.jpg': (WEB, 'kimi-wallpaper.jpg', 'image/jpeg'),
        '/favicon.ico': (WEB, 'icon-kimi-512.png', 'image/png'),
        '/manifest.webmanifest': (WEB, 'manifest.webmanifest', 'application/manifest+json'),
        '/garage': (GARAGE_APP.parent, GARAGE_APP.name, 'text/html; charset=utf-8'),
        '/garage/': (GARAGE_APP.parent, GARAGE_APP.name, 'text/html; charset=utf-8'),
        '/garage/index.html': (GARAGE_APP.parent, GARAGE_APP.name, 'text/html; charset=utf-8'),
        '/horizon-dusk.jpg': (GARAGE_APP.parent, 'horizon-dusk.jpg', 'image/jpeg'),
    }


class Handler(BaseHTTPRequestHandler):
    def setup(self):
        super().setup()
        self.connection.settimeout(5)

    def reply(self, code, body, mime='application/json'):
        payload = json.dumps(body).encode() if mime == 'application/json' else body
        self.send_response(code)
        self.send_header('Content-Type', mime)
        self.send_header('Content-Length', str(len(payload)))
        self.send_header('Cache-Control', 'no-store')
        self.send_header('X-Content-Type-Options', 'nosniff')
        if urlsplit(self.path).path.startswith('/garage'):
            csp = garage_csp()
        else:
            csp = "default-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'none'"
        self.send_header('Content-Security-Policy', csp)
        self.end_headers()
        self.wfile.write(payload)

    def allowed(self):
        return (self.headers.get('Host') == f'127.0.0.1:{PORT}'
                and self.headers.get('Sec-Fetch-Site') not in ('cross-site', 'same-site')
                and self.headers.get('Origin', ORIGIN) == ORIGIN)

    def do_GET(self):
        if not self.allowed():
            return self.reply(403, {'error': 'Local access only'})
        path = urlsplit(self.path).path
        try:
            if path == '/api/calendar':
                return self.reply(200, snapshot())
            if path == '/api/library':
                return self.reply(200, library_list())
            if path == '/api/session':
                return self.reply(200, {'token': TOKEN})
            assets = static_assets()
            if path in assets:
                root, name, mime = assets[path]
                return self.reply(200, (root / name).read_bytes(), mime)
            self.reply(404, {'error': 'Not found'})
        except (OSError, sqlite3.Error):
            self.reply(503, {'error': 'Calendar unavailable; retry shortly.'})

    def do_POST(self):
        if not self.allowed() or self.headers.get('X-Hub-Token') != TOKEN:
            return self.reply(403, {'error': 'Refresh your local Hub session'})
        if self.path not in ('/api/calendar/check','/api/library/save','/api/library/delete'):
            return self.reply(404, {'error': 'Not found'})
        try:
            length = int(self.headers.get('Content-Length', '0'))
            limit = 2048 if self.path == '/api/calendar/check' else 8192
            if not 0 < length <= limit or self.headers.get('Content-Type') != 'application/json':
                raise ValueError('Invalid request')
            data = json.loads(self.rfile.read(length))
            if not isinstance(data, dict):
                raise ValueError('Invalid request')
            result = set_checked(data) if self.path == '/api/calendar/check' else library_save(data) if self.path == '/api/library/save' else library_delete(data)
            self.reply(200, result)
        except RuntimeError as e:
            self.reply(409, {'error': str(e)})
        except (ValueError, TypeError) as e:
            self.reply(400, {'error': str(e)})
        except (OSError, sqlite3.Error):
            self.reply(503, {'error': 'Could not save; refresh and retry.'})

    def log_message(self, *_args):
        pass  # Do not log private calendar entries.


if __name__ == '__main__':
    argparse.ArgumentParser(description=__doc__).parse_args()
    os.umask(0o077)
    server = ThreadingHTTPServer(('127.0.0.1', PORT), Handler)
    server.daemon_threads = True
    print(f'Khaos Hub local calendar: {ORIGIN}', flush=True)
    server.serve_forever()
