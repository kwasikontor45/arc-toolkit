#!/usr/bin/env python3
"""arc-fail2ban-watch — tails fail2ban's own log and fires a real desktop
notification (via notify-send, so arc-pine picks it up for sound/voice same
as everything else) for each new ban. Built 2026-08-22 after finding
fail2ban had zero notification action configured -- real ban events were
producing no visibility at all beyond manually checking logs, unlike
Suricata/rkhunter which already notify.

Same architecture as arc-suricata-watch (proven, flood-safe): batches over a
window and caps total popups per flush, explicit notification expire
timeout regardless of urgency (critical-urgency notifications don't
auto-dismiss by design -- confirmed live 2026-08-22, same fix applied
there). Runs as root (needed to read fail2ban.log without changing its
permissions), standalone -- safe to stop/delete alone.
"""

import re
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import _arc_watch_common as watch

LOG = "/var/log/fail2ban.log"
TARGET_USER = "architect-of-chaos"
TARGET_UID = 1000

FLUSH_INTERVAL = 8.0
MAX_POPUPS_PER_FLUSH = 4
NOTIFY_TIMEOUT_MS = 12000

# fail2ban's own stable log format: "... fail2ban.actions [PID]: NOTICE  [jail] Ban 1.2.3.4"
BAN_RE = re.compile(r"fail2ban\.actions\s+\[\d+\]:\s+NOTICE\s+\[([^\]]+)\]\s+Ban\s+(\S+)")


# Rewired 2026-08-22 to call arc-pine-notify instead of notify-send --
# see arc-suricata-watch's own comment for the full reasoning (arc-pine
# now owns rendering for this whole watcher family, real stacking cap +
# auto-dismiss, third-party notifications completely unaffected).
def notify(summary: str, body: str, urgency: str = "normal"):
    env = f"DISPLAY=:0 DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{TARGET_UID}/bus"
    import json
    cmd = f"{env} /home/architect-of-chaos/.local/bin/arc-pine-notify {urgency} arc-fail2ban {json.dumps(summary)} {json.dumps(body)}"
    subprocess.run(["su", TARGET_USER, "-c", cmd], check=False)


def flush(pending):
    items = list(pending.items())
    shown, overflow = items[:MAX_POPUPS_PER_FLUSH], items[MAX_POPUPS_PER_FLUSH:]
    for (jail, ip), count in shown:
        prefix = f"x{count}  " if count > 1 else ""
        notify("fail2ban ban", f"{prefix}{ip} banned in jail '{jail}'", "critical")
    if overflow:
        notify("fail2ban ban", f"+{len(overflow)} more IP(s) banned in this window — see: arc sec f2b", "critical")


def main():
    pending = {}
    last_flush = time.time()
    for line in watch.follow(LOG):
        if line:
            m = BAN_RE.search(line)
            if m:
                jail, ip = m.group(1), m.group(2)
                key = (jail, ip)
                pending[key] = pending.get(key, 0) + 1

        if pending and (time.time() - last_flush) >= FLUSH_INTERVAL:
            flush(pending)
            pending.clear()
            last_flush = time.time()


if __name__ == "__main__":
    main()
