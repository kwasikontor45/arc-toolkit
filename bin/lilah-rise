#!/usr/bin/env python3
"""
lilah-rise — the break bubble.

A soap-bubble of a notification: it FALLS from the top of the screen with
a little sway, the message readable inside the whole way, and pops —
bursting into a calm caption that lingers. A languid voice announces it.
No square ever appears.

usage: lilah-rise "TITLE" "subtitle text"
survives reboot: stateless; invoked by lilah-break (autostarted daemon).
"""

import fcntl
import subprocess
import sys
import tempfile
import time
from pathlib import Path

import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import GLib, Gtk, Gdk

FallMs = 1150        # gravity: swift, accelerating
SwayPx = 26          # balloon drift
PopMs = 200          # the burst
HoldMs = 5200        # caption linger
FadeMs = 800

PHASE_TINT = {"dawn": "#e6a57f", "day": "#f6c177", "dusk": "#5ec9b4", "night": "#b8a8d0"}


def phase_now():
    h = time.localtime().tm_hour
    if 5 <= h < 9:
        return "dawn"
    if 9 <= h < 17:
        return "day"
    if 17 <= h < 21:
        return "dusk"
    return "night"


def speak(text):
    """Languid, breathy announcement — the Monroe cadence: slower, softer."""
    voice = Path.home() / ".local/share/piper/voices/en_US-lessac-medium.onnx"
    if not voice.exists():
        return
    try:
        with tempfile.NamedTemporaryFile(suffix=".wav", delete=False) as tf:
            wav = tf.name
        subprocess.Popen(
            [str(Path.home() / ".local/venvs/piper/bin/piper"), "-m", str(voice),
             "--length-scale", "1.38", "--noise-scale", "0.55", "--noise-w", "0.8",
             "-f", wav],
            stdin=subprocess.PIPE, stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL).communicate(text.encode(), timeout=20)
        subprocess.Popen(["paplay", wav], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass


def base_css(tint, r, g, b):
    return f"""
      window {{ background-color: transparent; }}
      box.bubble {{
        background-image: radial-gradient(circle at 32% 28%,
            rgba(255,255,255,.34), rgba(255,255,255,.06) 34%,
            rgba({r},{g},{b},.16) 58%, rgba({r},{g},{b},.05) 78%, rgba(0,0,0,.10) 100%);
        border: 1.5px solid {tint};
        border-radius: 999px;
        box-shadow: inset 0 0 22px rgba(255,255,255,.10), 0 12px 32px rgba(0,0,0,.40);
      }}
      box.bubble.pop {{
        background-image: radial-gradient(circle at 50% 50%,
            rgba(255,255,255,.85), rgba({r},{g},{b},.4) 55%, rgba(0,0,0,0) 78%);
        border-color: #ffffff;
      }}
      label.bub-title {{ color: #f4f7f9; font-size: 17px; font-weight: 700; letter-spacing: 2px; }}
      label.bub-body {{ color: #cfd8de; font-size: 11px; margin-top: 3px; }}
      box.caption {{
        background-image: linear-gradient(145deg, rgba(16,20,26,.92), rgba(8,11,14,.94));
        border: 1px solid rgba({r},{g},{b},0.55);
        border-radius: 999px;
        padding: 9px 22px;
      }}
      label.cap {{ color: #e8edf1; font-size: 13px; letter-spacing: 1px; }}
    """


def main():
    title = sys.argv[1] if len(sys.argv) > 1 else "break time"
    body = sys.argv[2] if len(sys.argv) > 2 else "step away."

    # one rise at a time
    lock = Path(tempfile.gettempdir()) / f"lilah-rise-{__import__('os').getuid()}.lock"
    fh = open(lock, "w")
    try:
        fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        sys.exit(0)

    speak(f"{title}. {body}")

    display = Gdk.Display.get_default()
    monitor = display.get_primary_monitor() or display.get_monitor(0)
    geo = monitor.get_geometry()
    sw, sh = geo.width, geo.height

    tint = PHASE_TINT[phase_now()]
    r, g, b = (int(tint[i:i+2], 16) for i in (1, 3, 5))

    css = Gtk.CssProvider()
    css.load_from_data(base_css(tint, r, g, b).encode())
    Gtk.StyleContext.add_provider_for_screen(
        Gdk.Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def styled(win, css_class):
        win.set_app_paintable(True)
        visual = win.get_screen().get_rgba_visual()
        if visual:
            win.set_visual(visual)
        win.set_type_hint(Gdk.WindowTypeHint.NOTIFICATION)
        win.set_decorated(False)
        win.set_resizable(False)
        win.set_keep_above(True)
        win.set_skip_taskbar_hint(True)
        win.set_skip_pager_hint(True)

    # ── the bubble ────────────────────────────────────────────────
    bub = Gtk.Window(type=Gtk.WindowType.POPUP)
    styled(bub, "bubble")
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
    box.get_style_context().add_class("bubble")
    box.set_valign(Gtk.Align.CENTER)
    lt = Gtk.Label(label=title.lower())
    lt.get_style_context().add_class("bub-title")
    lb = Gtk.Label(label=body)
    lb.get_style_context().add_class("bub-body")
    box.pack_start(lt, True, True, 0)
    box.pack_start(lb, True, True, 0)
    bub.add(box)

    BW, BH = 230, 150
    bub.set_default_size(BW, BH)
    bub.show_all()
    bub.set_opacity(0.0)

    x0 = geo.x + (sw - BW) // 2
    y_start = geo.y - BH - 30
    y_end = geo.y + int(sh * 0.32)

    # ── the caption (post-pop) ────────────────────────────────────
    cap = Gtk.Window(type=Gtk.WindowType.POPUP)
    styled(cap, "caption")
    cbox = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
    cbox.get_style_context().add_class("caption")
    cl = Gtk.Label(label=f"{title.lower()} · {body}")
    cl.get_style_context().add_class("cap")
    cbox.pack_start(cl, True, True, 0)
    cap.add(cbox)
    cap.show_all()
    cap.hide()

    def ease_in_quad(t):
        return t * t

    started = [time.monotonic()]
    popped = [False]

    def tick(_w, _f):
        el = (time.monotonic() - started[0]) * 1000
        if el < FallMs:
            t = el / FallMs
            y = y_start + (y_end - y_start) * ease_in_quad(t)
            sway = int(SwayPx * (1 - t) * __import__("math").sin(el / 210.0))
            bub.move(x0 + sway, int(y))
            bub.set_opacity(min(1.0, el / 180.0))
            return GLib.SOURCE_CONTINUE
        if not popped[0]:
            popped[0] = True
            # pop: flash bright, then burst into the caption
            box.get_style_context().add_class("pop")
            bub.set_opacity(1.0)
            GLib.timeout_add(PopMs, burst)
            return GLib.SOURCE_CONTINUE
        return GLib.SOURCE_CONTINUE

    def burst():
        bub.hide()
        cw, ch = cap.get_size()
        cap.move(geo.x + (sw - cw) // 2, y_end + 20)
        cap.set_opacity(0.0)
        cap.show_all()
        cap.set_opacity(1.0)
        GLib.timeout_add(HoldMs, lambda: fade(cap))
        return GLib.SOURCE_REMOVE

    def fade(win):
        t0 = time.monotonic()
        def ftick(_w, _f):
            ft = (time.monotonic() - t0) * 1000
            if ft >= FadeMs:
                Gtk.main_quit()
                return GLib.SOURCE_REMOVE
            win.set_opacity(1.0 - ft / FadeMs)
            return GLib.SOURCE_CONTINUE
        win.add_tick_callback(ftick)
        return GLib.SOURCE_REMOVE

    bub.add_tick_callback(tick)
    Gtk.main()


if __name__ == "__main__":
    main()
