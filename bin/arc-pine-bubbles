#!/usr/bin/env python3
"""
arc-pine-bubbles -- the visual notification renderer for arc-pine's watcher
family (Suricata/Sagan/fail2ban/rkhunter/VPN/DNS/eero/lynis/chkrootkit/
ClamAV/arc-heal, and -- once it routes through arc-pine-notify -- arc-break).

Redesigned 2026-09-19 (was a plain Tk card): GTK3 + cairo, so it can do what
Tk can't -- real per-pixel transparency on the desktop compositor. Frosted
glass cards with rounded corners and a soft shadow, Kataleya phase-colored
accent (choice/desire/still-pine/nyx, from _arc_ui.phase_info), Lato type,
fade + slide-in, a thin countdown line, and hover-to-pause.

Still its own small process (not folded into arc-pined): one GTK main loop
here, arc-pined's GLib/D-Bus monitor there. Same wire protocol as before --
one JSON object per line on the Unix socket:
    {"urgency": "critical|normal|low", "app": "...", "summary": "...", "body": "..."}
sent by `arc-pine-notify`. Third-party app notifications never reach this.

Structure (no cross-coupling): Palette (colors), CardPainter (pure cairo
drawing, testable offscreen), Bubble (one window), BubbleManager (stack /
queue / burst-merge), SocketBridge (thread -> queue).
"""

import json
import math
import os
import queue
import socket
import sys
import threading
import time
from pathlib import Path

import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("Pango", "1.0")
gi.require_version("PangoCairo", "1.0")
import cairo
from gi.repository import Gdk, GLib, Gtk, Pango, PangoCairo

sys.path.insert(0, str(Path(__file__).resolve().parent))
import _arc_ui as ui

SOCK_PATH = "/run/user/{}/arc-pine-bubbles.sock".format(os.getuid())
CONFIG_PATH = Path.home() / ".config/arc-pine/config.json"

DEFAULT_CONFIG = {
    "bubble_theme": "circadian",
    "bubble_max_visible": 4,
    "bubble_duration_ms": 10000,
    "bubble_width": 360,
    "bubble_opacity": 0.82,   # card fill alpha (the glass)
    "bubble_radius": 16,
}

# Static themes still selectable via config; "circadian" (default) is live.
THEMES = {
    "rose-pine-moon": {"surface": "#2a273f", "fg": "#e0def4", "muted": "#908caa", "accent": "#3e8fb0"},
    "nord":           {"surface": "#3b4252", "fg": "#eceff4", "muted": "#81a1c1", "accent": "#88c0d0"},
    "dracula":        {"surface": "#282a36", "fg": "#f8f8f2", "muted": "#6272a4", "accent": "#8be9fd"},
    "gruvbox":        {"surface": "#3c3836", "fg": "#ebdbb2", "muted": "#928374", "accent": "#83a598"},
}
CRITICAL = "#eb6f92"
URGENCY_RANK = {"low": 0, "normal": 1, "critical": 2}

FONT_TEXT = "Lato, Cantarell, DejaVu Sans"
MARGIN = 20            # transparent margin around the card: room for the shadow
PAD_X, PAD_TOP, PAD_BOTTOM = 18, 14, 16
TEXT_LEFT = 28         # card-relative x where text starts (after the accent pill)


def load_config():
    cfg = DEFAULT_CONFIG.copy()
    try:
        with open(CONFIG_PATH) as f:
            cfg.update(json.load(f))
    except Exception:
        pass
    return cfg


def _rgb(hexstr):
    h = hexstr.lstrip("#")
    return tuple(int(h[i:i + 2], 16) / 255.0 for i in (0, 2, 4))


def _mix(a, b, t):
    return tuple(a[i] + (b[i] - a[i]) * t for i in range(3))


def _ease_out(t):
    t = max(0.0, min(1.0, t))
    return 1 - (1 - t) ** 3


class Palette:
    """Resolves colors for one bubble at the moment it spawns. Bubbles live
    seconds, so resolving "circadian" once per bubble is enough to reflect the
    time of day it appeared. Critical is always rose (functional color); normal
    uses the current Kataleya phase accent; low is a quiet version of it."""

    def __init__(self, theme, urgency):
        if theme == "circadian" or theme not in THEMES:
            c = ui.circadian()
            _, phase_accent = ui.phase_info()
            surface, fg, muted, accent = c["surface"], c["fg"], c["fg_muted"], phase_accent
        else:
            t = THEMES[theme]
            surface, fg, muted, accent = t["surface"], t["fg"], t["muted"], t["accent"]
        self.surface = _rgb(surface)
        self.fg = _rgb(fg)
        self.muted = _rgb(muted)
        self.phase_accent = _rgb(accent)
        self.set_urgency(urgency)

    def set_urgency(self, urgency):
        self.urgency = urgency
        if urgency == "critical":
            self.accent = _rgb(CRITICAL)
        elif urgency == "low":
            self.accent = _mix(self.phase_accent, self.muted, 0.55)
        else:
            self.accent = self.phase_accent


def _rounded_rect(cr, x, y, w, h, r):
    r = max(0.0, min(r, w / 2, h / 2))
    cr.new_sub_path()
    cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    cr.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    cr.close_path()


class CardPainter:
    """Pure drawing + measuring -- no windows, no timers. Everything the card
    looks like lives here, so it can be rendered to a PNG and inspected."""

    def __init__(self, width, opacity, radius):
        self.width = width            # full window width, margin included
        self.opacity = opacity
        self.radius = radius

    def _layouts(self, cr, app, summary, body, count):
        inner_w = self.width - 2 * MARGIN
        text_w = inner_w - TEXT_LEFT - PAD_X
        app_text = app.upper() + (f"  ×{count}" if count > 1 else "")

        def mk(text, font, w, color=None, spacing=0, lines=None):
            lay = PangoCairo.create_layout(cr)
            lay.set_font_description(Pango.FontDescription(font))
            lay.set_width(int(w * Pango.SCALE))
            lay.set_wrap(Pango.WrapMode.WORD_CHAR)
            if lines:
                lay.set_ellipsize(Pango.EllipsizeMode.END)
                lay.set_height(-lines)
            if spacing:
                attrs = Pango.AttrList()
                attrs.insert(Pango.attr_letter_spacing_new(int(spacing * Pango.SCALE)))
                lay.set_attributes(attrs)
            lay.set_text(text, -1)
            return lay

        lays = {
            "app": mk(app_text, f"{FONT_TEXT} Bold 8", text_w - 24, spacing=1.6),
            "summary": mk(summary, f"{FONT_TEXT} Bold 11", text_w, lines=3),
        }
        if body:
            lays["body"] = mk(body, f"{FONT_TEXT} 10", text_w, lines=4)
        return lays

    def measure(self, app, summary, body, count):
        surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, 1, 1)
        cr = cairo.Context(surf)
        lays = self._layouts(cr, app, summary, body, count)
        h = PAD_TOP + lays["app"].get_pixel_size()[1] + 5 + lays["summary"].get_pixel_size()[1]
        if "body" in lays:
            h += 3 + lays["body"].get_pixel_size()[1]
        h += PAD_BOTTOM
        return self.width, int(h + 2 * MARGIN)

    def paint(self, cr, h, pal, app, summary, body, count, progress, hover, alpha=1.0):
        cw = self.width - 2 * MARGIN
        ch = h - 2 * MARGIN
        x0 = y0 = MARGIN
        glass = self.opacity

        # soft drop shadow -- stacked translucent rounded rects, cheap "blur"
        for i in range(10, 0, -1):
            cr.set_source_rgba(0, 0, 0, 0.022 * (1 - i / 11.0) * alpha)
            _rounded_rect(cr, x0 - i * 0.9, y0 - i * 0.5 + 3, cw + i * 1.8, ch + i * 1.8, self.radius + i)
            cr.fill()

        # glass body: subtle top-lit gradient over the phase surface color
        top = _mix(pal.surface, (1, 1, 1), 0.07)
        grad = cairo.LinearGradient(0, y0, 0, y0 + ch)
        grad.add_color_stop_rgba(0, *top, glass * alpha)
        grad.add_color_stop_rgba(1, *pal.surface, glass * 0.9 * alpha)
        _rounded_rect(cr, x0, y0, cw, ch, self.radius)
        cr.set_source(grad)
        cr.fill_preserve()
        # hairline border in the accent, faint inner top highlight
        cr.set_line_width(1)
        cr.set_source_rgba(*pal.accent, 0.38 * alpha)
        cr.stroke()
        cr.save()
        _rounded_rect(cr, x0 + 0.5, y0 + 0.5, cw - 1, ch - 1, self.radius - 0.5)
        cr.clip()
        hl = cairo.LinearGradient(0, y0, 0, y0 + 14)
        hl.add_color_stop_rgba(0, 1, 1, 1, 0.10 * alpha)
        hl.add_color_stop_rgba(1, 1, 1, 1, 0.0)
        cr.set_source(hl)
        cr.rectangle(x0, y0, cw, 14)
        cr.fill()
        cr.restore()

        # accent pill (with a soft glow) down the left edge
        px, py, ph = x0 + 13, y0 + 14, ch - 28
        for g, a in ((7, 0.05), (5, 0.08), (3, 0.13)):
            cr.set_source_rgba(*pal.accent, a * alpha)
            _rounded_rect(cr, px - g / 2, py - g / 2, 3 + g, ph + g, (3 + g) / 2)
            cr.fill()
        cr.set_source_rgba(*pal.accent, 0.95 * alpha)
        _rounded_rect(cr, px, py, 3, ph, 1.5)
        cr.fill()

        # text
        lays = self._layouts(cr, app, summary, body, count)
        tx = x0 + TEXT_LEFT
        ty = y0 + PAD_TOP
        cr.set_source_rgba(*pal.accent, alpha)
        cr.move_to(tx, ty)
        PangoCairo.show_layout(cr, lays["app"])
        ty += lays["app"].get_pixel_size()[1] + 5
        cr.set_source_rgba(*pal.fg, alpha)
        cr.move_to(tx, ty)
        PangoCairo.show_layout(cr, lays["summary"])
        ty += lays["summary"].get_pixel_size()[1]
        if "body" in lays:
            ty += 3
            cr.set_source_rgba(*_mix(pal.muted, pal.fg, 0.4), alpha)   # lifted for legibility on glass
            cr.move_to(tx, ty)
            PangoCairo.show_layout(cr, lays["body"])

        # close mark, only while hovered
        if hover:
            cx, cy = x0 + cw - 18, y0 + 17
            cr.set_source_rgba(*pal.muted, 0.9 * alpha)
            cr.set_line_width(1.4)
            cr.set_line_cap(cairo.LINE_CAP_ROUND)
            cr.move_to(cx - 3.5, cy - 3.5); cr.line_to(cx + 3.5, cy + 3.5)
            cr.move_to(cx + 3.5, cy - 3.5); cr.line_to(cx - 3.5, cy + 3.5)
            cr.stroke()

        # countdown line along the bottom edge (clipped inside the card)
        if progress is not None:
            cr.save()
            _rounded_rect(cr, x0, y0, cw, ch, self.radius)
            cr.clip()
            cr.set_source_rgba(*pal.accent, 0.5 * alpha)
            cr.rectangle(x0, y0 + ch - 2.5, cw * max(0.0, min(1.0, progress)), 2.5)
            cr.fill()
            cr.restore()


class Bubble(Gtk.Window):
    """One notification. Owns its window, timers and animation only."""

    def __init__(self, cfg, urgency, app, summary, body, on_close, on_update):
        super().__init__(type=Gtk.WindowType.POPUP)
        self.cfg = cfg
        self.on_close = on_close
        self.on_update = on_update
        self.app, self.summary, self.body = app, summary, body
        self.count = 1
        self.urgency = urgency
        self.pal = Palette(cfg.get("bubble_theme", "circadian"), urgency)
        self.painter = CardPainter(int(cfg.get("bubble_width", 360)) + 2 * MARGIN,
                                   float(cfg.get("bubble_opacity", 0.82)),
                                   float(cfg.get("bubble_radius", 16)))
        self.duration = max(2000, int(cfg.get("bubble_duration_ms", 10000)))
        self.elapsed = 0
        self.hover = False
        self.dismissed = False
        self.fade = 0.0            # 0 -> 1 in, 1 -> 0 out
        self.slide = 14.0          # px offset, eased to 0
        self.target_y = 0
        self.cur_y = None
        self.x = 0

        screen = Gdk.Screen.get_default()
        visual = screen.get_rgba_visual()
        if visual is not None:
            self.set_visual(visual)
        self.set_app_paintable(True)
        self.set_accept_focus(False)
        self.set_skip_taskbar_hint(True)
        self.set_keep_above(True)
        self.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.ENTER_NOTIFY_MASK
                        | Gdk.EventMask.LEAVE_NOTIFY_MASK)
        self.connect("draw", self._on_draw)
        self.connect("button-press-event", lambda *_: self.dismiss())
        self.connect("enter-notify-event", self._on_enter)
        self.connect("leave-notify-event", self._on_leave)

        self._remeasure()
        self._tick_id = GLib.timeout_add(40, self._tick)
        self._anim_start = time.monotonic()

    # geometry -------------------------------------------------------------
    def _remeasure(self):
        self.w, self.h = self.painter.measure(self.app, self.summary, self.body, self.count)
        self.set_default_size(self.w, self.h)
        self.resize(self.w, self.h)

    def place(self, x, y, animate=True):
        self.x = x
        if self.cur_y is None or not animate:
            self.cur_y = y
        self.target_y = y
        self.move(int(self.x + self.slide), int(self.cur_y))

    # events ----------------------------------------------------------------
    def _on_enter(self, *_):
        self.hover = True
        self.queue_draw()

    def _on_leave(self, *_):
        self.hover = False
        self.queue_draw()

    def _on_draw(self, widget, cr):
        cr.set_operator(cairo.OPERATOR_SOURCE)
        cr.set_source_rgba(0, 0, 0, 0)
        cr.paint()
        cr.set_operator(cairo.OPERATOR_OVER)
        progress = 1.0 - min(1.0, self.elapsed / self.duration)
        self.painter.paint(cr, self.h, self.pal, self.app, self.summary, self.body,
                           self.count, progress, self.hover, alpha=1.0)
        return False

    def _tick(self):
        if self.dismissed and self.fade <= 0.0:
            return False
        dt = 0.040
        # fade / slide
        if self.dismissed:
            self.fade = max(0.0, self.fade - dt / 0.22)
        else:
            self.fade = min(1.0, self.fade + dt / 0.18)
            self.slide = 14.0 * (1 - _ease_out((time.monotonic() - self._anim_start) / 0.22))
            if not self.hover:
                self.elapsed += 40
                if self.elapsed >= self.duration:
                    self.dismiss()
        self.set_opacity(self.fade)
        # ease toward target y (stack reflow)
        if self.cur_y is not None and abs(self.cur_y - self.target_y) > 0.5:
            self.cur_y += (self.target_y - self.cur_y) * 0.35
        elif self.cur_y is not None:
            self.cur_y = self.target_y
        if self.get_realized():
            self.move(int(self.x + self.slide), int(self.cur_y or 0))
        self.queue_draw()
        if self.dismissed and self.fade <= 0.0:
            self._finish()
            return False
        return True

    # public ----------------------------------------------------------------
    def bump(self, urgency, summary, body):
        """Same app fired again while this bubble is up: absorb it (the burst
        fix -- ten fail2ban alerts become one growing bubble, not ten)."""
        self.count += 1
        if URGENCY_RANK.get(urgency, 1) > URGENCY_RANK.get(self.urgency, 1):
            self.urgency = urgency
            self.pal.set_urgency(urgency)
        self.summary = summary
        self.body = body or f"+{self.count - 1} earlier notification(s)"
        self.elapsed = 0
        self._remeasure()
        self.on_update()

    def dismiss(self):
        if self.dismissed:
            return
        self.dismissed = True

    def _finish(self):
        try:
            self.destroy()
        finally:
            self.on_close(self)


class BubbleManager:
    """Owns the stack: positions, the visible cap, the queue, burst-merge."""

    GAP = 4   # cards already carry their own margin, so the gap is small

    def __init__(self, cfg):
        self.cfg = cfg
        self.active = []
        self.by_app = {}
        self.pending = []

    def push(self, urgency, app, summary, body):
        existing = self.by_app.get(app)
        if existing is not None and not existing.dismissed:
            existing.bump(urgency, summary, body)
            return
        self.pending.append((urgency, app, summary, body))
        self._drain()

    def _drain(self):
        cap = int(self.cfg.get("bubble_max_visible", 4))
        while self.pending and len(self.active) < cap:
            urgency, app, summary, body = self.pending.pop(0)
            existing = self.by_app.get(app)
            if existing is not None and not existing.dismissed:
                existing.bump(urgency, summary, body)
                continue
            try:
                b = Bubble(self.cfg, urgency, app, summary, body, self._on_close, self.reflow)
            except RuntimeError as e:
                sys.stderr.write(f"arc-pine-bubbles: cannot create windows ({e}); exiting for restart\n")
                os._exit(1)
            self.active.append(b)
            self.by_app[app] = b
            self.reflow()
            b.show_all()
            b.set_opacity(0.0)

    def _on_close(self, bubble):
        if bubble in self.active:
            self.active.remove(bubble)
        if self.by_app.get(bubble.app) is bubble:
            del self.by_app[bubble.app]
        self.reflow()
        self._drain()

    def _workarea(self):
        display = Gdk.Display.get_default()
        mon = display.get_primary_monitor() or display.get_monitor(0)
        return mon.get_workarea()

    def reflow(self):
        wa = self._workarea()
        y = wa.y + 6
        for b in self.active:
            x = wa.x + wa.width - b.w - 4
            b.place(x, y)
            y += b.h - 2 * MARGIN + self.GAP + 8


class SocketBridge:
    """Unix-socket listener thread -> queue. Nothing else talks to this."""

    def __init__(self, path, out_queue):
        self.path, self.q = path, out_queue

    def start(self):
        threading.Thread(target=self._serve, daemon=True).start()

    def _serve(self):
        try:
            os.unlink(self.path)
        except FileNotFoundError:
            pass
        srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        srv.bind(self.path)
        os.chmod(self.path, 0o600)
        srv.listen(8)
        while True:
            conn, _ = srv.accept()
            try:
                data = b""
                while True:
                    chunk = conn.recv(4096)
                    if not chunk:
                        break
                    data += chunk
                if data:
                    self.q.put(json.loads(data.decode()))
            except Exception:
                pass
            finally:
                conn.close()


def main():
    # Fail FAST if there's no display yet. This daemon is started at login, sometimes before
    # X is ready; GTK then fails to init but the process would otherwise keep running with a
    # dead toolkit, showing nothing forever (the 2026-09-19 "no bubbles after reboot" bug).
    # Exiting non-zero lets systemd's Restart=on-failure retry until the display exists.
    if Gdk.Display.get_default() is None:
        sys.stderr.write("arc-pine-bubbles: no display yet, exiting so systemd retries\n")
        sys.exit(1)
    cfg = load_config()
    mgr = BubbleManager(cfg)
    q = queue.Queue()
    SocketBridge(SOCK_PATH, q).start()

    def poll():
        try:
            while True:
                m = q.get_nowait()
                mgr.push(m.get("urgency", "normal"), m.get("app", "arc-pine"),
                         m.get("summary", ""), m.get("body", ""))
        except queue.Empty:
            pass
        return True

    def reload_cfg():
        new = load_config()
        if new != mgr.cfg:
            mgr.cfg = new
        return True

    GLib.timeout_add(120, poll)
    GLib.timeout_add(3000, reload_cfg)
    Gtk.main()


if __name__ == "__main__":
    main()
