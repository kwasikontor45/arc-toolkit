#!/usr/bin/env python3
"""Conservative pre-ack command allowlist shared by interactive shells."""
import os
import re
import shlex
import subprocess
import sys


def allowed(command: str) -> bool:
    if (not command.strip() or any(c in command for c in ("`", chr(10), chr(13)))
            or "$(" in command or "${" in command or "$[" in command):
        return False
    try:
        lexer = shlex.shlex(command, posix=True, punctuation_chars=";&|<>")
        lexer.whitespace_split = True
        argv = list(lexer)
    except ValueError:
        return False
    if any(token and all(c in ";&|<>" for c in token) for token in argv):
        return False
    if not argv:
        return False
    binary = os.path.basename(argv[0]).lower()
    args = argv[1:]
    if binary == "_arc_sop_refresh_gate" and not args:
        return True
    if binary == "sudo":
        args = args[1:] if args and args[0] == "-n" else args
        if not args:
            return False
        binary, args = os.path.basename(args[0]).lower(), args[1:]
    if binary == "arc-sop" and args:
        verb = args[0].lower()
        return ((verb == "start" and len(args) >= 2)
                or (verb in {"status", "check", "verify", "gate-status", "recover"} and len(args) == 1)
                or (verb == "violations" and args[1:] in ([], ["--watch"]))
                or (verb == "record-violation" and len(args) == 3
                    and args[1] in {"pre-ack-shell-operation", "pre-ack-tool-operation"})
                or (verb == "emergency" and len(args) == 1)
                or (verb == "gate-enable" and len(args) == 1))
    if binary == "arc" and len(args) >= 2 and args[0].lower() == "sop":
        verb = args[1].lower()
        return ((verb == "start" and len(args) >= 3)
                or (verb in {"status", "check", "verify", "recover"} and len(args) == 2)
                or (verb == "violations" and args[2:] in ([], ["--watch"]))
                or (verb == "record-violation" and len(args) == 4
                    and args[2] in {"pre-ack-shell-operation", "pre-ack-tool-operation"})
                or (verb == "emergency" and len(args) == 2)
                or (verb == "gate-enable" and len(args) == 2))
    if binary in {"cd", "pwd", "ls", "cat", "batcat", "bat", "head", "tail", "glow", "stat", "file", "wc",
                  "date", "id", "whoami", "grep", "rg", "clear", "history", "type", "which",
                  "echo", "printf"}:
        return True
    if binary == "arc" and args and args[0] == "help":
        return True
    if binary == "git" and args and args[0] in {"status", "diff", "log", "show", "branch", "remote"}:
        return True
    # Permit read-only line extraction for policy and source inspection. Reject
    # edits, expressions, script files, and every sed mode except a numeric print.
    if binary == "sed" and len(args) >= 3 and args[0] == "-n":
        return (len(args) == 3 and re.fullmatch(r"[0-9]+(?:,[0-9]+)?p", args[1]) is not None
                and not args[2].startswith("-"))
    return False


if __name__ == "__main__":
    command = sys.argv[1] if len(sys.argv) == 2 else ""
    if allowed(command):
        raise SystemExit(0)
    # Persist only the attempted executable name, never its arguments, which
    # may contain private data. The reporting command cannot unlock the gate.
    if not os.environ.get("ARC_SOP_NO_RECORD"):
        try:
            lexer = shlex.shlex(command, posix=True, punctuation_chars=";&|<>")
            lexer.whitespace_split = True
            argv = list(lexer)
            if argv and not any(token and all(c in ";&|<>" for c in token) for token in argv):
                binary = os.path.basename(argv[0])[:64] or "unknown"
                subprocess.run(
                    [os.path.expanduser("~/.local/bin/arc-sop"), "record-violation",
                     "pre-ack-shell-operation", binary],
                    check=False, timeout=5, capture_output=True,
                )
        except Exception:
            pass
    color = sys.stderr.isatty() and "NO_COLOR" not in os.environ
    lock = "\033[1;35mSOP LOCKED\033[0m" if color else "SOP LOCKED"
    step = "\033[1;36mRead\033[0m" if color else "Read"
    print(f"{lock} · {step} GAMEPLAN.md, SOT.md, all MOs; then run arc-sop start \"<task>\".",
          file=sys.stderr)
    raise SystemExit(1)
