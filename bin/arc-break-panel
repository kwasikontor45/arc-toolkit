#!/bin/bash
# Panel status script for arc-break — Xfce Generic Monitor (Genmon) plugin.
# Output is genmon's XML format (<txt>/<click>/<txtclick> tags), not plain
# text -- click(any state)/txtclick starts the daemon if it isn't running
# already (arc-break-start no-ops if it is, so this is always safe to have
# wired up, running or not).
# Setup: right-click panel -> Panel -> Add New Items -> Generic Monitor
#   Command:        /home/architect-of-chaos/.local/bin/arc-break-panel
#   Update period:  5000  (xfconf property is update-period, in MS -- NOT
#                    the "Period" field genmon's own properties dialog shows
#                    in seconds; found the hard way, wired to the wrong
#                    property once already)
STATE="$HOME/.local/share/arc-break/state.json"
PID_F="$HOME/.local/share/arc-break/arc-break.pid"
START="$HOME/.local/bin/arc-break-start"

emit() {
    echo "<txt>$1</txt>"
    echo "<click>$START</click>"
    echo "<txtclick>$START</txtclick>"
}

if [[ ! -f "$PID_F" ]] || ! kill -0 "$(cat "$PID_F" 2>/dev/null)" 2>/dev/null; then
    emit "💀 --:--"
    exit 0
fi

read -r phase phase_start phase_end < <(python3 -c "
import json
with open('$STATE') as f:
    d = json.load(f)
print(d['phase'], int(d['phase_start']), int(d['phase_end']))
" 2>/dev/null)

[[ -z "$phase" ]] && { emit "💀 --:--"; exit 0; }

now=$(date +%s)
remaining=$(( phase_end - now ))
[[ $remaining -lt 0 ]] && remaining=0
mins=$(( remaining / 60 ))
secs=$(( remaining % 60 ))
fmt=$(printf '%02d:%02d' $mins $secs)

total=$(( phase_end - phase_start ))
[[ $total -le 0 ]] && total=1
# remaining as a percentage of the configured phase length, so the
# emoji staircase scales to whatever work/break minutes are set,
# instead of assuming a fixed 30/5 min session.
pct=$(( remaining * 100 / total ))

if [[ "$phase" == "work" ]]; then
    if   (( pct >= 93 )); then emoji="🚀"
    elif (( pct >= 83 )); then emoji="🧠"
    elif (( pct >= 73 )); then emoji="💻"
    elif (( pct >= 63 )); then emoji="⌨️"
    elif (( pct >= 53 )); then emoji="📝"
    elif (( pct >= 43 )); then emoji="🎯"
    elif (( pct >= 33 )); then emoji="🔍"
    elif (( pct >= 23 )); then emoji="👀"
    elif (( pct >= 17 )); then emoji="⏰"
    elif (( pct >= 10 )); then emoji="⚡"
    elif (( pct >= 3  )); then emoji="😤"
    else                        emoji="🔔"
    fi
else
    if   (( pct >= 80 )); then emoji="🌿"
    elif (( pct >= 60 )); then emoji="☕"
    elif (( pct >= 40 )); then emoji="🧘"
    elif (( pct >= 20 )); then emoji="💤"
    else                       emoji="🔔"
    fi
fi

emit "$emoji $fmt"
