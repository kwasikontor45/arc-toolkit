#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════
#  stoic — the walk, carved in stone
#  a daily cognitive guide: sort the morning · review the evening · keep a log
#
#  standalone: bash + coreutils only. portable: any TERM, dumb or smart.
#  register: stone tablet — chiseled slab, pigment only in the grooves,
#  the sky's hour tint deciding the pigment. the chisel moves on a live
#  TTY; everywhere else the tablet is simply, already carved.
#
#  usage: stoic                the walk (morning or evening, by the hour)
#         stoic morning        just the waterline
#         stoic evening        just the glass
#         stoic review         read the last seven days back
#  log:   ~/.local/share/stoic/YYYY-MM-DD.md   (format unchanged since v1)
# ═══════════════════════════════════════════════════════════════════════════
set -uo pipefail

log_dir="${STOIC_HOME:-$HOME/.local/share/stoic}"
mkdir -p "$log_dir"
today="$(date +%Y-%m-%d)"
logfile="$log_dir/$today.md"
hour="$(date +%-H)"

# ── register ────────────────────────────────────────────────────────────────
if [[ -t 1 && -t 0 && "${TERM:-dumb}" != "dumb" && "${TERM:-}" != "" ]]; then
  TTY=1
  B="$(tput bold)"; D="$(tput dim)"; R="$(tput sgr0)"
  # the sky picks the pigment: dawn rose · day gold · dusk pine · night mist
  if   (( hour >= 5 && hour < 9  )); then tint=181; phase="dawn"
  elif (( hour >= 9 && hour < 17 )); then tint=179; phase="day"
  elif (( hour >= 17 && hour < 21 )); then tint=37;  phase="dusk"
  else                                      tint=146; phase="night"
  fi
  T="$(tput setaf "$tint")"; M="$(tput setaf 245)"; W="$(tput setaf 250)"; P="$(tput setaf 238)"
else
  TTY=0; B=""; D=""; R=""; T=""; M=""; W=""; P=""
  if   (( hour >= 5 && hour < 9  )); then phase="dawn"
  elif (( hour >= 9 && hour < 17 )); then phase="day"
  elif (( hour >= 17 && hour < 21 )); then phase="dusk"
  else phase="night"
  fi
fi

SLAB_W=50
edge_o="${T}╭──────────────────────────────────────────────╮${R}"
edge_c="${M}│${R}                                                ${M}│${R}"
edge_i="${M}│${R}"
edge_u="${M}╰──────────────────────────────────────────────╯${R}"

whisper() { printf '%s\n' "${M}  $1${R}"; }
slab_whisper() { slab_line "${M}  $1${R}"; }
pause()   { [[ "$TTY" == 1 ]] && sleep "$1"; }

# chisel the slab in, left to right
slab_open() {
  if [[ "$TTY" != 1 ]]; then printf '%s\n' "$edge_o"; return; fi
  local i n=48
  for (( i=0; i<n; i++ )); do printf '%s─' "$T"; sleep 0.008; done
  printf '%s\n' "${M}╮$R"
}

slab_close() { printf '%s\n' "$edge_u"; }

slab_line() {
  # carve a line of text inside the slab, edges included
  local text="$1" raw_len visual pad
  raw_len=${#text}
  # visible width: strip escape sequences for padding math
  visual=$(printf '%s' "$text" | sed 's/\x1b\[[0-9;]*m//g')
  if (( ${#visual} > SLAB_W - 4 )); then
    text="${text:0:SLAB_W-7}…"; visual=$(printf '%s' "$text" | sed 's/\x1b\[[0-9;]*m//g')
  fi
  pad=$(( SLAB_W - 2 - ${#visual} ))
  (( pad < 0 )) && pad=0
  printf '%s  %s%s%*s%s%s\n' "$edge_i" "$text" "$R" "$pad" '' "$M" "│$R"
}

slab_blank() { printf '%s\n' "$edge_c"; }

# the inscription: letters appear one tap at a time
inscribe() {
  local text="$1" visual i ch
  visual=$(printf '%s' "$text" | sed 's/\x1b\[[0-9;]*m//g')
  printf '%s  ' "$edge_i"
  if [[ "$TTY" == 1 ]]; then
    for (( i=0; i<${#text}; i++ )); do
      ch="${text:i:1}"
      # print through escape-state simply: raw char-by-char works for plain text
      printf '%s' "$ch"
      [[ "$ch" != " " ]] && sleep 0.018
    done
  else
    printf '%s' "$text"
  fi
  local pad=$(( SLAB_W - 2 - ${#visual} ))
  printf '%*s%s\n' "$pad" '' "${M}│$R"
}

say()  { slab_line "$T$B  $1$R"; }
ask()  { slab_line "$W  $1$R"; printf '%s  %s❯ %s' "$edge_i" "$T" "$R"; }

# three quiet chisel taps
tap() {
  [[ "$TTY" != 1 ]] && return
  local i
  for i in 1 2 3; do printf '%s  ·%s' "$P" "$R"; sleep 0.18; done
  printf '\r%*s\r' 8 ''
}

# ── the whispers (original lines, in the family voice) ─────────────────────
slab_whisper_for() {
  local pick=$(( RANDOM % 4 + 1 ))
  if [[ "$1" == "morning" ]]; then
    case $pick in
      1) slab_whisper "the water is quietest before the first step." ;;
      2) slab_whisper "you don't owe the day your worry — only your attention." ;;
      3) slab_whisper "sort what circles. keep what swims." ;;
      4) slab_whisper "a small true action outweighs a large one." ;;
    esac
  else
    case $pick in
      1) slab_whisper "review the build, not the builder." ;;
      2) slab_whisper "the glass shows what happened, not who you are." ;;
      3) slab_whisper "let the day settle. don't stir it." ;;
      4) slab_whisper "what held, holds. what broke, teaches." ;;
    esac
  fi
}

# ── morning: the waterline ─────────────────────────────────────────────────
morning() {
  slab_open
  inscribe "${T}${B}S T O I C  ·  the waterline${R}"
  slab_line "${M}  $(date '+%A, %B %d') — $phase${R}"
  slab_blank
  slab_whisper_for morning
  slab_blank

  ask "what is circling the water today?"
  read -r topic
  printf '\n'
  if [[ -z "$topic" ]]; then
    slab_whisper "nothing circling. step inside the day."
    slab_close; return
  fi
  slab_blank

  ask "can it touch shore today? (y/n)"
  read -r yn
  printf '\n'
  slab_blank
  local entry="## $topic"$'\n'
  if [[ "$yn" =~ ^[Yy] ]]; then
    ask "name the smallest action that counts"
    read -r action
  printf '\n'
    entry+="- [ ] ACTION: ${action:-(unnamed, still counts)}"$'\n'
    printf '%s\n' "$entry" >> "$logfile"
    slab_whisper "given to the shore. let the worry go."
  else
    entry+="- [x] RELEASED: no shore today. the water keeps it."$'\n'
    printf '%s\n' "$entry" >> "$logfile"
    slab_whisper "let it sink. the water keeps it now."
  fi
  slab_blank
  slab_close
}

# ── evening: the glass ─────────────────────────────────────────────────────
evening() {
  slab_open
  inscribe "${T}${B}S T O I C  ·  the glass${R}"
  slab_line "${M}  $(date '+%A, %B %d') — $phase${R}"
  slab_blank
  slab_whisper_for evening
  slab_blank
  tap

  ask "through the glass: what would you reshape?"
  read -r q1
  printf '\n'
  ask "what held — one thing that carried the day?"
  read -r q2
  printf '\n'
  {
    printf '## evening — %s\n' "$(date '+%H:%M')"
    printf -- '- reshape: %s\n' "${q1:-quiet}"
    printf -- '- held: %s\n' "${q2:-quiet}"
  } >> "$logfile"
  slab_blank
  slab_whisper "settled. the glass fogs over until tomorrow."
  slab_blank
  slab_close
}

# ── review: read the week back (kept on the desk, not the slab) ────────────
review() {
  inscribe "${T}${B}s e v e n   d a y s   b a c k${R}"
  echo
  local f n=0 open=0 released=0
  for i in 6 5 4 3 2 1 0; do
    f="$log_dir/$(date -d "-$i day" +%Y-%m-%d).md"
    [[ -f "$f" ]] || continue
    n=$((n+1))
    open=$(( open + $(grep -c '^- \[ \] ACTION' "$f" 2>/dev/null || true) ))
    released=$(( released + $(grep -c '^- \[x\] RELEASED' "$f" 2>/dev/null || true) ))
    printf '%s%s%s\n' "$T" "  ── $(date -d "-$i day" '+%a %b %d') ──" "$R"
    sed 's/^## /    /; s/^- \[ \] ACTION: /    ☐ /; s/^- \[x\] RELEASED: /    ~ /; s/^- /    · /' "$f"
    echo
  done
  [[ $n -eq 0 ]] && { whisper "no entries yet. the water is unmarked."; return; }
  printf '%s%s%s\n' "$P" "  ──────────────────────────────────────────" "$R"
  whisper "$n day(s) on record · $open still open · $released released"
}

# ── entry ──────────────────────────────────────────────────────────────────
case "${1:-}" in
  morning) morning ;;
  evening) evening ;;
  review)  review ;;
  ""|walk)
    if (( hour >= 4 && hour < 17 )); then morning; else evening; fi
    ;;
  -h|--help|help)
    sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *)
    printf 'stoic: unknown stop %q — try: morning · evening · review\n' "$1" >&2
    exit 2 ;;
esac
