#!/usr/bin/env python3
"""
arc-pined — background notification daemon.

Monitors desktop notifications via D-Bus (org.freedesktop.DBus.Monitoring
BecomeMonitor — the modern non-deprecated alternative to the old
eavesdrop=true match rule), without replacing the system notification
daemon that actually renders the visual popups. For every notification:

  - logs it to SQLite (~/.local/share/arc-pine/notifications.db)
  - plays a gentle notification sound (never an alarm sound — see config)
  - speaks it via Piper TTS, but ONLY for apps in the speak_apps allowlist
    (empty list = speak nothing; default scopes this to arc-break alone,
    so routine notifications from other apps stay silent-voice)

Rebuilt from scratch (source lost with the Tails USB, never recovered) —
this is a fresh implementation of the original's purpose, not a port of
its exact old design.

Config/logging/audio-playback core lives in _arc_pine_common.py (shared
with arc-pine-notify) -- extracted 2026-08-26 after the two scripts drifted
into carrying a near-verbatim copy of the same ~150 lines each. This file
now owns only what's actually specific to being the passive D-Bus watcher:
the monitor setup, the singleton guard, and deciding what to do with a
notification once one arrives.
"""

import os
import sys
from pathlib import Path

import dbus
import dbus.mainloop.glib
from gi.repository import GLib

sys.path.insert(0, str(Path(__file__).resolve().parent))
import _arc_pine_common as pine

DATA_DIR = pine.DATA_DIR
PID_PATH = DATA_DIR / "arc-pined.pid"


def handle_notify(args):
    # Notify(app_name, replaces_id, app_icon, summary, body, actions, hints, expire_timeout)
    if len(args) < 8:
        return
    app_name, _replaces_id, _icon, summary, body, _actions, hints, _timeout = args[:8]
    app_name = str(app_name)
    summary  = str(summary)
    body     = str(body)
    urgency  = int(hints.get("urgency", 1)) if hints else 1

    cfg = pine.load_config()
    if app_name in cfg.get("ignored_apps", []):
        return

    pine.log_notification(app_name, summary, body, urgency)

    sound_file = cfg.get("sound_file") if cfg.get("sound_enabled", True) else None
    speak_text = None
    if cfg.get("speak_enabled", True) and app_name in cfg.get("speak_apps", []):
        speak_text = summary if not body else f"{summary}. {body}"

    pine.emit_audio_async(sound_file, speak_text)


def _refuse_if_already_running():
    """Real bug, 2026-08-26: this daemon had no singleton guard at all, so
    a second copy (leftover from manual kill/relaunch juggling during
    debugging) could sit running alongside the real one indefinitely with
    nothing to notice -- both independently monitor the same D-Bus
    notifications, so every single one got logged and its sound/speech
    played TWICE, overlapping like an echo. Confirmed live: history.db had
    every recent row duplicated with identical timestamps, and exactly two
    live arc-pined processes were found running. Guard against a repeat."""
    if PID_PATH.exists():
        try:
            os.kill(int(PID_PATH.read_text().strip()), 0)
            print("arc-pined: already running (see " + str(PID_PATH) + ") -- refusing to start a second copy", file=sys.stderr)
            sys.exit(1)
        except ProcessLookupError:
            pass  # stale PID file, previous instance is actually dead -- fine to proceed
        except Exception:
            pass
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    PID_PATH.write_text(str(os.getpid()))


def main():
    _refuse_if_already_running()
    pine.write_default_config_if_missing()

    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    bus = dbus.SessionBus()

    def on_message(bus, msg):
        if msg.get_member() == "Notify" and msg.get_interface() == "org.freedesktop.Notifications":
            try:
                handle_notify(msg.get_args_list())
            except Exception as e:
                print(f"arc-pined: error handling notification: {e}", file=sys.stderr)

    bus.add_message_filter(on_message)

    monitor_iface = dbus.Interface(
        bus.get_object("org.freedesktop.DBus", "/org/freedesktop/DBus"),
        "org.freedesktop.DBus.Monitoring",
    )
    monitor_iface.BecomeMonitor(
        ["interface='org.freedesktop.Notifications',member='Notify'"],
        dbus.UInt32(0),
    )

    print("arc-pined running — monitoring notifications", flush=True)
    GLib.MainLoop().run()


if __name__ == "__main__":
    main()
