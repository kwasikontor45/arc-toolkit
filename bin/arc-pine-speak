#!/usr/bin/env python3
"""
arc-pine-speak — TTS toggle for arc-pined.

Usage:
  arc-pine-speak on         — enable TTS
  arc-pine-speak off        — disable TTS (AFK/bathroom mode — silence voice
                               without killing the daemon or sound entirely)
  arc-pine-speak            — show current state
  arc-pine-speak "text"     — speak arbitrary text directly (low-level,
                               bypasses the notification pipeline entirely)
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import _arc_pine_common as pine

# speak_direct() used to be its own local implementation here -- a plain
# `subprocess.run(["paplay", wav_path], ...)` with none of pine.speak()'s
# WirePlumber force-unmute workaround. Real, live bug this carried as a
# result: this low-level bypass mode was still exposed to the exact
# "paplay reports success, WirePlumber has it permanently remembered as
# muted, total silence" incident that was already found and fixed twice
# elsewhere (arc-pined, arc-pine-notify) -- just never here, since it was
# never sharing their fix. Refactored 2026-08-26 onto the shared module for
# exactly this reason, not just to deduplicate.


def main():
    args = sys.argv[1:]
    cfg = pine.load_config()

    if not args:
        print(f"speak_enabled: {cfg.get('speak_enabled', True)}")
        print(f"speak_apps: {cfg.get('speak_apps', [])}")
        return

    arg = args[0]
    if arg == "on":
        cfg["speak_enabled"] = True
        pine.save_config(cfg)
        print("TTS enabled")
    elif arg == "off":
        cfg["speak_enabled"] = False
        pine.save_config(cfg)
        print("TTS disabled")
    else:
        if not pine.PIPER_BIN.exists() or not pine.PIPER_VOICE.exists():
            print("piper not installed — nothing to speak with", file=sys.stderr)
            sys.exit(1)
        pine.speak(" ".join(args))


if __name__ == "__main__":
    main()
