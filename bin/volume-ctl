#!/bin/bash
# volume-ctl — speaker volume control, bound to F10 (mute) / F11 (down) / F12 (up).
# usage: volume-ctl up|down|mute
#
# Built 2026-08-26 alongside kbd-backlight -- same underlying gap: no volume-key
# daemon exists on this system (checked: xfce4-volumed / xfce4-volumed-pulse,
# the usual XFCE component for this, isn't in Kali's repos at all, and nothing
# else was grabbing these keys -- confirmed live, no XF86Audio* entries existed
# anywhere in xfce4-keyboard-shortcuts before this). Talks to the default sink
# directly via pactl (PipeWire's pulse-compat layer, confirmed live on this
# system) rather than pulling in a whole extra daemon. Shows a progress-bar
# style OSD via notify-send's "value" hint, which xfce4-notifyd (already
# running) renders as a real popup -- same visual language a native
# volume-key daemon would give, without needing one.
#
# Deliberately does NOT touch @DEFAULT_SOURCE@ (the mic) -- that's a separate,
# explicit privacy default handled by arc-mic / mic-default-mute.desktop, see
# reference.md's 2026-08-26 session note. Keeping mute/vol keys scoped to
# output only avoids any chance of a keybinding accidentally reactivating
# the mic.

set -euo pipefail
umask 077

# Keep rapid key presses serialized and reuse one notification.  Xfce's
# notify daemon does not implement Ubuntu's x-canonical-private-synchronous
# hint, so relying on that hint stacks a bubble for every 5% step.
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
LOCK_FILE="$RUNTIME_DIR/volume-ctl.lock"
NOTIFY_ID_FILE="$RUNTIME_DIR/volume-ctl-notification-id"
exec 9>"$LOCK_FILE"
flock -x 9

STEP=5
MAX_VOLUME=150

# Cap upward key presses at 150% while letting downward presses reduce any
# pre-existing level in steady 5% steps. This avoids the old 100% clamp, which
# made one down press jump from 150% to 95%, and avoids the runaway boost seen
# previously at 373% / +34.3 dB.
CURRENT=$(pactl get-sink-volume @DEFAULT_SINK@ | grep -oP '\d+(?=%)' | head -1)
[[ "$CURRENT" =~ ^[0-9]+$ ]] || { echo "could not read sink volume" >&2; exit 1; }

case "${1:-}" in
  up)   NEXT=$((CURRENT + STEP)); (( NEXT > MAX_VOLUME )) && NEXT=$MAX_VOLUME
        (( CURRENT >= MAX_VOLUME )) && NEXT=$CURRENT
        pactl set-sink-volume @DEFAULT_SINK@ "${NEXT}%" ;;
  down) NEXT=$((CURRENT - STEP)); (( NEXT < 0 )) && NEXT=0
        pactl set-sink-volume @DEFAULT_SINK@ "${NEXT}%" ;;
  mute) pactl set-sink-mute @DEFAULT_SINK@ toggle ;;
  *)    echo "usage: volume-ctl up|down|mute" >&2; exit 1 ;;
esac

MUTED=$(pactl get-sink-mute @DEFAULT_SINK@ | awk '{print $2}')
PCT=$(pactl get-sink-volume @DEFAULT_SINK@ | grep -oP '\d+(?=%)' | head -1)

if [[ "$MUTED" == "yes" ]]; then
  MESSAGE="Volume muted"
  ICON=audio-volume-muted
else
  MESSAGE="Volume ${PCT}%"
  ICON=audio-volume-high
fi

# Xfce supports the standard replaces_id field. Reusing the daemon-issued ID
# turns a burst of key-repeat events into one updating OSD instead of a stack.
NOTIFY_ID=0
if [[ -r "$NOTIFY_ID_FILE" ]]; then
  IFS= read -r NOTIFY_ID < "$NOTIFY_ID_FILE" || NOTIFY_ID=0
  [[ "$NOTIFY_ID" =~ ^[0-9]+$ ]] || NOTIFY_ID=0
fi
NEW_NOTIFY_ID=$(notify-send --print-id --replace-id="$NOTIFY_ID" --expire-time=1400 \
  -a volume -h "int:value:${PCT:-0}" -i "$ICON" "$MESSAGE" 2>/dev/null || true)
if [[ "$NEW_NOTIFY_ID" =~ ^[0-9]+$ ]]; then
  printf '%s\n' "$NEW_NOTIFY_ID" > "$NOTIFY_ID_FILE"
fi
