#!/usr/bin/env python3
"""
build-notes-site — static, offline, self-contained site over your notes.

Home page = resources-in-place.md rendered as a dashboard (the "sites/servers
blueprint"). Browse page = full-text search across arc-lt-cmc + dev-notes +
khaos-lab + vault/archive, with an inline (not fetched) search index so it
works from a plain file:// open in any browser, no server, no internet.

Visual language matches kontor.studio / kontor.studio/bootlog: JetBrains Mono
(installed locally, no webfont fetch needed), phosphor/cyan on near-black,
scanline+vignette overlay, system-bar with circadian phase color shift.

Output lives inside the encrypted vault (/mnt/storage/Persistent/notes-site) -- that's
the "lock": it only exists while the vault is unlocked and mounted.
"""
import base64
import hashlib
import html
import json
import sys
from pathlib import Path

try:
    import markdown as _markdown
except ImportError:
    print("python3-markdown not installed: sudo apt install python3-markdown", file=sys.stderr)
    sys.exit(1)

