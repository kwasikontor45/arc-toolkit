#!/usr/bin/env python3
"""
arc-sop — SOP enforcement engine for kontor studio.

Local-only SQLite database. No network. No cloud. No required git dependency.
Backups: via arc backup → USB vault → MEGA.
Root copy: /usr/local/share/arc/sop/ (created by arc-sop --root-copy, requires sudo).

Commands:
  ack              Record agent SOP acknowledgment for this session.
  baseline         Record current hashes of all SOP files into the local DB.
  verify           Verify intel-ops files match the stored local DB baseline.
  check            Run all compliance checks.
  status           Show current compliance state.
  recover          Restore SOP files from root copy or MEGA fallback.
  bundle           Archive intel-ops to USB vault for MEGA sync.
  root-copy        Copy current intel-ops to /usr/local/share/arc/sop/ (sudo).
"""

import hashlib
import json
import os
import shutil
import shlex
import sqlite3
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
def _user_home() -> Path:
    """Return the real user's home directory, even when running under sudo."""
    import pwd
    euid = os.getuid()
    if euid != 0:
        # Real effective user -- covers `sudo -u architect-of-chaos` de-escalation
        # from a root-native session (this machine's Claude Code sessions run as
        # root). SUDO_USER always names who *typed* sudo, not who the process now
        # runs as, so for `sudo -u <other>` it's backwards for this case -- it'd
        # say "root" even though euid is correctly 1000 here. Trust the euid first.
        try:
            return Path(pwd.getpwuid(euid).pw_dir)
        except KeyError:
            pass
    # Running as root itself -- either genuinely root, or escalated via a bare
    # `sudo <cmd>` from a real user (SUDO_USER correctly names them in that case).
    sudo_user = os.environ.get("SUDO_USER")
    if sudo_user:
        try:
            return Path(pwd.getpwnam(sudo_user).pw_dir)
        except KeyError:
            pass
    return Path.home()


HOME = _user_home()
INTEL_OPS = HOME / "dev-notes/intel-ops"
MO_FILE = INTEL_OPS / "MO.md"
SOT_FILE = INTEL_OPS / "SOT.md"
SOP_DIR = HOME / ".config/arc/sop"
DB_PATH = SOP_DIR / "arc-sop.db"
ROOT_COPY = Path("/usr/local/share/arc/sop")
VAULT_SOP = Path("/mnt/storage/arc-sop")
MEGA_SOP = Path("mega:/arc-sop")

# ---------------------------------------------------------------------------
# Colors
# ---------------------------------------------------------------------------
G = "\033[0;32m"
R = "\033[0;31m"
Y = "\033[0;33m"
C = "\033[0;36m"
D = "\033[0;90m"
N = "\033[0m"

BOLD = "\033[1m"

# ---------------------------------------------------------------------------
# Notification helper — emits a desktop notification that Arc Pine captures.
# ---------------------------------------------------------------------------
def _notify(title: str, message: str, urgency: str = "normal"):
    """Send a notification via notify-send if available."""
    urgency_map = {"low": "low", "normal": "normal", "critical": "critical"}
    level = urgency_map.get(urgency, "normal")
    try:
        subprocess.run(
            ["notify-send", f"--urgency={level}", "--app-name=arc-sop", title, message],
            check=False, timeout=10, capture_output=True,
        )
    except Exception:
        pass


# ---------------------------------------------------------------------------
# DB helpers
# ---------------------------------------------------------------------------
def init_db():
    SOP_DIR.mkdir(parents=True, exist_ok=True)
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.executescript(
        """
        CREATE TABLE IF NOT EXISTS acks (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            timestamp TEXT,
            agent_id TEXT,
            session_id TEXT,
            ack_type TEXT
        );

        CREATE TABLE IF NOT EXISTS checks (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            timestamp TEXT,
            check_name TEXT,
            passed INTEGER,
            message TEXT
        );

        CREATE TABLE IF NOT EXISTS violations (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            timestamp TEXT,
            rule TEXT,
            details TEXT,
            resolved INTEGER DEFAULT 0
        );

        CREATE TABLE IF NOT EXISTS baseline (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            timestamp TEXT,
            file_path TEXT UNIQUE,
            file_hash TEXT
        );
        """
    )
    conn.commit()
    conn.close()


def db_insert(table: str, **kwargs):
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    cols = ", ".join(kwargs.keys())
    placeholders = ", ".join("?" for _ in kwargs)
    c.execute(f"INSERT INTO {table} ({cols}) VALUES ({placeholders})", tuple(kwargs.values()))
    conn.commit()
    conn.close()


def db_query(query: str, params=()):
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    c = conn.cursor()
    c.execute(query, params)
    rows = [dict(r) for r in c.fetchall()]
    conn.close()
    return rows


# ---------------------------------------------------------------------------
# Core helpers
# ---------------------------------------------------------------------------
def now() -> str:
    return datetime.now().strftime("%Y-%m-%d %H:%M:%S")


_KNOWN_TERMINALS = {
    "xfce4-terminal", "gnome-terminal", "gnome-terminal-server", "konsole",
    "tabby", "tabby-shell", "alacritty", "kitty", "terminator", "xterm",
    "tilix", "rxvt", "urxvt", "sakura", "terminology", "st",
}


def _detect_terminal_emulator() -> str:
    """Walk process ancestry to find the terminal emulator hosting this shell.
    Falls back to $TERM_PROGRAM, then 'unknown-terminal' if neither works."""
    try:
        pid = os.getpid()
        for _ in range(12):
            with open(f"/proc/{pid}/status") as f:
                status = f.read()
            ppid = None
            for line in status.splitlines():
                if line.startswith("PPid:"):
                    ppid = int(line.split()[1])
                    break
            if not ppid or ppid <= 1:
                break
            try:
                with open(f"/proc/{ppid}/comm") as f:
                    comm = f.read().strip()
            except Exception:
                break
            if comm in _KNOWN_TERMINALS:
                return comm
            pid = ppid
    except Exception:
        pass
    return os.environ.get("TERM_PROGRAM", "unknown-terminal")


def _detect_shell() -> str:
    shell = os.environ.get("SHELL", "")
    return os.path.basename(shell) if shell else "unknown-shell"


def session_id() -> str:
    # Only harness-injected vars (genuine agent context) get used as the
    # session id. CLAUDE_SESSION_ID is deliberately excluded here even though
    # it's often set -- .bashrc/.zshrc export it unconditionally for every
    # interactive shell (a past session's convenience id, prefixed "claude-"
    # regardless of who's actually typing), so showing it next to "User
    # <name>" reads as contradictory. Confirmed confusing live 2026-07-26:
    # a human ack showed "User architect-of-chaos" correctly, but
    # "session: claude-20260726-044456-3388" right next to it. For any
    # non-agent context, always describe the real shell/terminal instead.
    sid = (
        os.environ.get("ARC_SESSION_ID")
        or os.environ.get("AGENT_SESSION_ID")
        or os.environ.get("KIMI_SESSION_ID")
        or os.environ.get("CODEX_SESSION_ID")
        or os.environ.get("CLAUDE_CODE_SESSION_ID")
        or os.environ.get("CLAUDE_CODE_BRIDGE_SESSION_ID")
        or ""
    )
    if sid:
        return sid[:64]
    try:
        tty = os.ttyname(0)
    except OSError:
        tty = "no-tty"
    return f"{_detect_shell()}@{_detect_terminal_emulator()}:{tty}"[:64]


def agent_id() -> str:
    # Only harness-injected vars mean an actual agent is driving this --
    # confirmed live 2026-07-26: a human running `arc sop ack` by hand still
    # had CLAUDE_SESSION_ID set (from .bashrc/.zshrc, see session_id() above)
    # and got misreported as "Agent claude". Don't repeat that.
    if os.environ.get("CODEX_SESSION_ID"):
        return "codex"
    if os.environ.get("CLAUDE_CODE_SESSION_ID") or os.environ.get("CLAUDE_CODE_BRIDGE_SESSION_ID"):
        return "claude"
    if os.environ.get("KIMI_SESSION_ID"):
        return "kimi"
    if os.environ.get("ARC_SESSION_ID") or os.environ.get("AGENT_SESSION_ID"):
        return os.environ.get("AGENT_ID") or "arc-agent"
    explicit = os.environ.get("AGENT_ID")
    if explicit:
        return explicit
    # Not a recognized agent session -- a human is running this directly.
    who = os.environ.get("USER") or os.environ.get("LOGNAME")
    if who:
        return who
    try:
        result = subprocess.run(["whoami"], capture_output=True, text=True, timeout=5)
        return result.stdout.strip() or "unknown-user"
    except Exception:
        return "unknown-user"


def is_agent_id(aid: str) -> bool:
    return (aid in ("claude", "codex", "kimi", "arc-agent")
            or any(os.environ.get(key) for key in
                   ("AGENT_ID", "ARC_SESSION_ID", "AGENT_SESSION_ID")))


def run(cmd: list, check: bool = False, capture: bool = True) -> tuple:
    try:
        if capture:
            result = subprocess.run(cmd, capture_output=True, text=True, check=check, timeout=30)
        else:
            result = subprocess.run(cmd, text=True, check=check, timeout=30)
        return result.returncode, result.stdout, result.stderr
    except Exception as e:
        return 1, "", str(e)


def print_rule(name: str, passed: bool, message: str):
    symbol = f"{G}✓{N}" if passed else f"{R}✗{N}"
    print(f"  {symbol}  {BOLD}{name}{N}: {message}")


# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------
def cmd_ack():
    """Refuse unversioned acknowledgments; they cannot satisfy the gate."""
    print(f"{R}✗{N}  bare acknowledgment cannot unlock operations.")
    print_reading_guide()
    print('After reading, enter a short non-empty task description:')
    print('  arc-sop start "task description" --accept-policy <digest-shown-by-start>')
    return 2


def print_reading_guide():
    """Show exact policy paths and available, simple terminal readers."""
    print("Read these complete sources before accepting:")
    print(f"  GAMEPLAN context: {INTEL_OPS / 'GAMEPLAN.md'}")
    print(f"  Source of truth:  {SOT_FILE}")
    print(f"  Every current MO: {MO_FILE}")
    readers = [name for name in ("batcat", "bat", "cat")
               if shutil.which(name)]
    print("Reader examples (use one command per file):")
    for reader in readers or ["cat"]:
        print(f"  {reader} {INTEL_OPS / 'GAMEPLAN.md'}")
        print(f"  {reader} {SOT_FILE}")
        print(f"  {reader} {MO_FILE}")


def cmd_ack_auto(script_name: str):
    """Non-interactive ack for cron/scripted jobs -- same audit trail as a
    human ack, but never touches GAMEPLAN.md (would flood it with routine
    automation noise) and never blocks. This is the 'bridge' for automation:
    tracked under the same policy, not exempt from being logged, but not
    gated -- gating a backup/security-sync cron job would be worse than the
    friction this whole feature exists to fix."""
    init_db()
    ts = now()
    aid = f"cron:{script_name}"
    db_insert("acks", timestamp=ts, agent_id=aid, session_id=f"cron@{script_name}", ack_type="sop-auto")
    print(f"{D}[arc-sop] auto-ack: {aid} @ {ts}{N}")


def cmd_record_violation(rule: str, detail: str):
    """Append a minimal, secret-safe gate denial to the compliance ledger."""
    init_db()
    rule = "".join(c for c in rule if c.isalnum() or c in "_.-")[:80]
    detail = "".join(c for c in detail if c.isalnum() or c in "_.-:@")[:100]
    if not rule or not detail:
        print("Usage: arc-sop record-violation <rule> <safe-tool-name>", file=sys.stderr)
        return 2
    aid, sid = agent_id(), session_id()
    db_insert("violations", timestamp=now(), rule=rule,
              details=f"actor={aid[:40]}; session={sid[:64]}; tool={detail}", resolved=0)
    cutoff = datetime.fromtimestamp(time.time() - 60).strftime("%Y-%m-%d %H:%M:%S")
    recent = db_query("SELECT COUNT(*) AS c FROM violations WHERE timestamp >= ?", (cutoff,))[0]["c"]
    if recent == 1:
        _notify("SOP gate blocked an operation",
                f"{aid} · {detail} · review with: arc sop violations", urgency="normal")
    return 0


def _gameplan_today_has_starting(sid: str = "", aid: str = "") -> bool:
    gp = INTEL_OPS / "GAMEPLAN.md"
    if not gp.exists():
        return False
    today = datetime.now().strftime("%Y-%m-%d")
    content = gp.read_text()
    today_lines = [l for l in content.splitlines() if today in l and "[STARTING]" in l]
    if sid:
        today_lines = [line for line in today_lines if f"[sid:{sid}]" in line]
    if aid:
        today_lines = [line for line in today_lines if f"· {aid} ·" in line]
    return bool(today_lines)


def _policy_digest() -> str:
    """Bind acceptance to current SOT/MOs and this exact user/agent session."""
    h = hashlib.sha256()
    for path in (SOT_FILE, MO_FILE):
        if not path.is_file():
            raise FileNotFoundError(path)
        h.update(path.name.encode("utf-8"))
        h.update(b"\0")
        h.update(path.read_bytes())
        h.update(b"\0")
    h.update(b"agent\0" + agent_id().encode("utf-8") + b"\0")
    h.update(b"session\0" + session_id().encode("utf-8") + b"\0")
    return h.hexdigest()


def cmd_start(description: str, accepted_digest: str = ""):
    """Present current policy and require explicit, version-bound acceptance
    before logging the task or opening the operations gate."""
    init_db()
    gp = INTEL_OPS / "GAMEPLAN.md"
    description = description.strip()
    if not description:
        print(f"{R}✗{N}  task description must not be empty; no task was logged and the gate stays locked")
        print_reading_guide()
        return 2

    # Present current gameplan context before policy acceptance.
    if not gp.exists():
        print(f"{R}✗{N}  GAMEPLAN.md not found at {gp} -- cannot satisfy the gate")
        return 1
    print(f"{C}── GAMEPLAN.md — current context ──{N}")
    all_lines = gp.read_text().splitlines()
    header_lines = [i for i, l in enumerate(all_lines) if l.startswith("## ")]
    print("\n".join(all_lines[max(0, len(all_lines) - 80):]))
    print(f"{D}({len(header_lines)} dated entries; read relevant prior entries in full at {gp}){N}")
    print(f"{C}──────────────────────────{N}\n")

    try:
        current_digest = _policy_digest()
    except OSError as e:
        print(f"{R}✗{N} could not fingerprint current policy: {e}")
        return 1
    if accepted_digest != current_digest:
        # Print complete policy source text; summaries cannot stand in for the
        # current seven (or any future number of) MOs.
        for label, path in (("SOT.md — read the complete source of truth", SOT_FILE),
                            ("MO.md — read and accept every current MO", MO_FILE)):
            if not path.is_file():
                print(f"{R}✗{N} required policy file missing: {path}")
                return 1
            print(f"{C}── {label} ──{N}")
            print(path.read_text())
            print(f"{C}──────────────────────────{N}\n")
        print(f"{Y}Policy not yet acknowledged.{N}")
        print("Read the full GAMEPLAN context, entire SOT.md, and every current MO in MO.md.")
        print_reading_guide()
        print("Then explicitly accept them for this session with this exact command:")
        print(f"  arc-sop start {shlex.quote(description)} --accept-policy {current_digest}")
        print("The digest is session-bound and changes when SOT.md or MO.md changes; stale acknowledgments fail closed.")
        return 2
    print(f"{G}✓{N}  current SOT + all MOs accepted for this exact session ({current_digest})")

    # 2. Log every accepted task before it can operate. Exact duplicate retries
    # in the same session are idempotent; a second task gets its own entry.
    sid = session_id()
    aid = agent_id()
    ts_date = datetime.now().strftime("%Y-%m-%d")

    entry = f"\n## {ts_date} · {aid} · [sid:{sid}] · [STARTING] {description}\n"
    existing = gp.read_text()
    header = entry.strip()
    if header not in existing.splitlines():
        try:
            with open(gp, "a") as f:
                f.write(entry)
        except Exception as e:
            print(f"{R}✗{N}  couldn't write to GAMEPLAN.md: {e}")
            return 1

    if not _gameplan_today_has_starting(sid, aid):
        print(f"{R}✗{N}  wrote the entry but the today+[STARTING] check still doesn't pass -- something's off, not unlocking")
        return 1

    print(f"{G}✓{N}  GAMEPLAN.md: logged today's [STARTING] entry")
    return _finish_start(sid, aid, current_digest)


def _finish_start(sid: str, aid: str, policy_digest: str) -> int:
    """Shared tail of cmd_start: ack + unlock, used whether or not a fresh
    GAMEPLAN entry was written this call."""
    ts = now()
    db_insert("acks", timestamp=ts, agent_id=aid, session_id=sid,
              ack_type=f"sop-policy-sha256:{policy_digest}")
    who_label = "Agent" if is_agent_id(aid) else "User"
    print(f"{G}✓{N}  {who_label} {Y}{aid}{N} explicitly accepted current SOT + all MOs")
    print(f"{D}   policy sha256: {policy_digest}{N}")
    _notify("SOP acknowledged", f"{who_label} {aid} acknowledged all SOPs -- session unlocked", urgency="normal")

    print(f"\n{G}✓ unlocked{N}")
    return 0


GATE_BYPASS_FILE = HOME / ".config/arc/gate-bypass"
GATE_EMERGENCY_FILE = HOME / ".config/arc/gate-emergency.json"
GATE_EMERGENCY_LOG = HOME / ".config/arc/gate-emergency.jsonl"
GATE_EMERGENCY_SECONDS = 30 * 60


def _active_emergency():
    try:
        record = json.loads(GATE_EMERGENCY_FILE.read_text())
        if float(record["expires_epoch"]) > time.time():
            return record
    except (OSError, ValueError, KeyError, TypeError, json.JSONDecodeError):
        pass
    return None


def cmd_gate_status():
    gp_ok = _gameplan_today_has_starting()
    owner_uid = _gate_owner_uid(create=False)
    print(f"{C}arc-sop gate status{N}")
    state = G + "enforced — no bypass/emergency window can unlock operations" + N
    print(f"  {D}state{N}     {state}")
    if GATE_BYPASS_FILE.exists() or GATE_EMERGENCY_FILE.exists():
        print(f"  {Y}!{N}  legacy override record exists but is ignored; owner may clear it with arc-sop gate-enable")
    print(f"  {D}gameplan{N}  {(G + 'satisfied for today' + N) if gp_ok else (Y + 'not satisfied yet' + N)}")
    if owner_uid is None:
        owner_label = "not configured"
    else:
        owner_label = f"uid {owner_uid} ({_current_username() if os.getuid() == owner_uid else 'not you'})"
    print(f"  {D}owner{N}     {Y}{owner_label}{N}  {D}(all identities use the same policy gate){N}")


def cmd_gate_check() -> bool:
    """Require this session's current, explicit SOT+MO acceptance and start log."""
    today = datetime.now().strftime("%Y-%m-%d")
    aid = agent_id()
    sid = session_id()
    gp_ok = _gameplan_today_has_starting(sid, aid)
    try:
        expected_ack = f"sop-policy-sha256:{_policy_digest()}"
    except OSError as e:
        print(f"gate NOT satisfied: required policy unavailable ({e})")
        return False
    rows = db_query(
        "SELECT * FROM acks WHERE timestamp LIKE ? AND agent_id = ? AND session_id = ? ORDER BY timestamp DESC LIMIT 1",
        (f"{today}%", aid, sid),
    )
    ack_ok = bool(rows and rows[0].get("ack_type") == expected_ack)

    if gp_ok and ack_ok:
        print("gate satisfied")
        return True

    missing = []
    if not gp_ok:
        missing.append("GAMEPLAN.md missing this session's [STARTING] entry")
    if not ack_ok:
        missing.append(f"no current SOT+all-MO acceptance for '{aid}' session '{sid}'")
    print(f"gate NOT satisfied: {'; '.join(missing)}")
    print_reading_guide()
    print('After reading, run: arc-sop start "<short task description>"')
    return False


GATE_OWNER_UID_FILE = HOME / ".config/arc/gate-owner-uid"


def _gate_owner_uid(create: bool = True):
    """The one UID allowed to bypass/enable the gate. Stored explicitly
    rather than hardcoded, and keyed on UID (not username) specifically so
    a future username change ('architect-of-chaos' renamed to something
    else) doesn't lock the real owner out -- usermod -l keeps the UID, only
    the login name changes. First call enrolls whoever's running it right
    now as the owner (this machine's real primary user, UID 1000 at the
    time this was built)."""
    GATE_OWNER_UID_FILE.parent.mkdir(parents=True, exist_ok=True)
    if GATE_OWNER_UID_FILE.exists():
        try:
            return int(GATE_OWNER_UID_FILE.read_text().strip())
        except (ValueError, OSError):
            pass
    if not create:
        return None
    uid = os.getuid()
    GATE_OWNER_UID_FILE.write_text(f"{uid}\n")
    return uid


def _is_gate_owner() -> bool:
    return os.getuid() == _gate_owner_uid()


def _current_username() -> str:
    try:
        import pwd
        return pwd.getpwuid(os.getuid()).pw_name
    except Exception:
        return os.environ.get("USER", f"uid:{os.getuid()}")


def cmd_gate_bypass():
    print(f"{R}✗{N}  gate bypass is retired; it cannot authorize operations for any user or agent.")
    print('Read and accept the current SOT + all MOs with: arc-sop start "task"')
    return 1


def cmd_gate_emergency(reason: str):
    """Read-only emergency hatch; it diagnoses recovery without bypassing policy."""
    print(f"{C}SOP emergency hatch · read-only · operations remain locked{N}")
    print_reading_guide()
    print("If a policy source is missing or unreadable, `arc sop recover` makes a dated copy")
    print("of the current files, restores from the configured root copy or USB archive, and")
    print("invalidates all previous acceptances. Re-read the restored sources and accept again.")
    print("This hatch never authorizes application, system, or deployment operations.")
    cmd_gate_status()
    return 0


def cmd_gate_enable():
    aid = agent_id()
    if is_agent_id(aid):
        print(f"{R}✗{N}  refused — agent cannot manage gate enforcement, regardless of uid. Detected: {aid}")
        _notify("SOP gate enable REFUSED", f"Agent tried to re-enable: {aid} (uid {os.getuid()}, {_current_username()})", urgency="critical")
        sys.exit(1)
    if not _is_gate_owner():
        print(f"{R}✗{N}  refused — only the machine's owner (uid {_gate_owner_uid()}) can manage gate enforcement. You are: {_current_username()} (uid {os.getuid()})")
        _notify("SOP gate enable REFUSED", f"Non-owner tried to re-enable: {_current_username()} (uid {os.getuid()})", urgency="critical")
        sys.exit(1)
    had_override = GATE_BYPASS_FILE.exists() or GATE_EMERGENCY_FILE.exists()
    emergency = _active_emergency()
    if GATE_BYPASS_FILE.exists():
        GATE_BYPASS_FILE.unlink()
    if GATE_EMERGENCY_FILE.exists():
        GATE_EMERGENCY_FILE.unlink()
    if had_override:
        if emergency:
            record = {"event": "closed_early", "closed_at": now(), "user": _current_username(),
                      "uid": os.getuid(), "session_id": session_id(), "reason": emergency.get("reason", "")}
            with GATE_EMERGENCY_LOG.open("a") as audit:
                audit.write(json.dumps(record, sort_keys=True) + "\n")
            os.chmod(GATE_EMERGENCY_LOG, 0o600)
        print(f"{G}✓{N}  gate enforced again for new commands")
    else:
        print(f"{D}gate already enforced — nothing to do{N}")


def hash_file(path: Path) -> str:
    """Return MD5 hex digest of a file."""
    h = hashlib.md5()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(8192), b""):
            h.update(chunk)
    return h.hexdigest()


SOP_EXCLUDE_DIRS = {"inventory"}


def sop_files():
    """Yield (relative_path, absolute_path) for all SOP files."""
    if not INTEL_OPS.exists():
        return
    for f in INTEL_OPS.rglob("*"):
        rel = f.relative_to(INTEL_OPS)
        if not f.is_file() or ".git/" in str(rel):
            continue
        # inventory/ has its own integrity mechanism (git history + arc-inv's hash-chained ledger,
        # `arc inv verify`), and ledger.jsonl is appended by every 30-min scan -- hashing it here
        # would leave the SOP baseline permanently "stale" and train everyone to ignore it.
        if rel.parts and rel.parts[0] in SOP_EXCLUDE_DIRS:
            continue
        yield rel, f


def cmd_baseline():
    """Record current hashes of all SOP files into the local DB."""
    init_db()
    ts = now()

    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("DELETE FROM baseline")

    count = 0
    for rel, abs_path in sop_files():
        c.execute(
            "INSERT INTO baseline (timestamp, file_path, file_hash) VALUES (?, ?, ?)",
            (ts, str(rel), hash_file(abs_path)),
        )
        count += 1

    conn.commit()
    conn.close()

    print(f"{C}arc-sop baseline{N}")
    print(f"  {G}✓{N}  Recorded {count} SOP file hashes")
    print(f"  {D}   time: {ts}{N}")


def cmd_verify():
    """Verify intel-ops files match the stored local DB baseline."""
    init_db()
    if not INTEL_OPS.exists():
        print(f"{R}✗{N}  intel-ops directory missing. Run: arc-sop recover")
        return False

    baseline_rows = db_query("SELECT file_path, file_hash FROM baseline")
    if not baseline_rows:
        print(f"{Y}!{N}  No baseline recorded yet. Run: arc-sop baseline")
        return False

    baseline = {row["file_path"]: row["file_hash"] for row in baseline_rows}
    current = {}
    for rel, abs_path in sop_files():
        current[str(rel)] = hash_file(abs_path)

    missing = [p for p in baseline if p not in current]
    added = [p for p in current if p not in baseline]
    changed = [p for p in baseline if p in current and baseline[p] != current[p]]

    if missing or added or changed:
        details = []
        for p in missing:
            print(f"  {R}✗{N}  missing: {Y}{p}{N}")
            details.append(f"missing:{p}")
        for p in added:
            print(f"  {R}✗{N}  added:   {Y}{p}{N}")
            details.append(f"added:{p}")
        for p in changed:
            print(f"  {R}✗{N}  changed: {Y}{p}{N}")
            details.append(f"changed:{p}")
        details_str = "; ".join(details)
        already_open = db_query(
            "SELECT COUNT(*) AS c FROM violations WHERE rule = ? AND details = ? AND resolved = 0",
            ("SOP-baseline-mismatch", details_str),
        )[0]["c"]
        if not already_open:
            db_insert(
                "violations",
                timestamp=now(),
                rule="SOP-baseline-mismatch",
                details=details_str,
                resolved=0,
            )
            _notify(
                "SOP violation: baseline mismatch",
                f"{len(missing)} missing, {len(added)} added, {len(changed)} changed",
                urgency="critical",
            )
        return False

    print(f"{G}✓{N}  SOP files match local DB baseline ({len(current)} files)")
    return True


def cmd_done_balance() -> bool:
    """Check that every today [STARTING] entry has a paired [DONE]."""
    gp = INTEL_OPS / "GAMEPLAN.md"
    if not gp.exists():
        print(f"{Y}!{N}  GAMEPLAN.md not found")
        return True
    content = gp.read_text()
    today = datetime.now().strftime("%Y-%m-%d")
    lines = content.splitlines()
    starts = [l.strip() for l in lines if today in l and "[STARTING]" in l]
    dones  = [l.strip() for l in lines if today in l and "[DONE]" in l]
    if len(starts) > len(dones):
        unmatched = len(starts) - len(dones)
        print(f"{Y}!{N}  {unmatched} task(s) have no [DONE] entry today")
        for s in starts:
            print(f"  {D}  {s}{N}")
        return False
    print(f"{G}✓{N}  All today's tasks closed  {D}({len(dones)}/{len(starts)}){N}")
    return True


def cmd_violations(watch: bool = False):
    """List unresolved violations, or stream newly recorded events."""
    init_db()
    print(f"{C}arc-sop violations{N}")
    last_id = 0
    if watch:
        state = db_query("SELECT COALESCE(MAX(id), 0) AS last_id, "
                         "SUM(CASE WHEN resolved = 0 THEN 1 ELSE 0 END) AS open_count "
                         "FROM violations")[0]
        last_id = int(state["last_id"] or 0)
        open_count = int(state["open_count"] or 0)
        print(f"  watching new events from id {last_id}; current open count: {open_count}", flush=True)
    try:
        while True:
            rows = db_query(
                "SELECT * FROM violations WHERE id > ? ORDER BY id ASC" if watch else
                "SELECT * FROM violations WHERE resolved = 0 ORDER BY timestamp DESC",
                (last_id,) if watch else (),
            )
            if not rows and not watch:
                print(f"  {G}✓{N}  No open violations")
                return
            if not rows and watch and last_id == 0:
                print(f"  {G}✓{N}  No violations recorded; watching for new events…")
            for row in rows:
                last_id = max(last_id, int(row["id"]))
                state = "open" if not row["resolved"] else "resolved"
                print(f"  {Y}[{row['id']}]{N}  {row['timestamp']}  {row['rule']} · {state}")
                print(f"        {row['details']}", flush=True)
            if not watch:
                return
            time.sleep(2)
    except KeyboardInterrupt:
        print("\nStopped watching.")


def cmd_resolve(vid: str):
    """Mark a violation as resolved."""
    init_db()
    if not vid.isdigit():
        print(f"{R}✗{N}  Usage: arc sop resolve <id>")
        return
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("UPDATE violations SET resolved = 1 WHERE id = ?", (int(vid),))
    if c.rowcount == 0:
        print(f"{R}✗{N}  No violation with id {vid}")
    else:
        print(f"{G}✓{N}  Violation {vid} marked resolved")
    conn.commit()
    conn.close()


def cmd_ack_today() -> bool:
    """Return True only for this session's current SOT+all-MO acceptance."""
    init_db()
    today = datetime.now().strftime("%Y-%m-%d")
    aid = agent_id()
    sid = session_id()
    rows = db_query(
        "SELECT * FROM acks WHERE timestamp LIKE ? AND agent_id = ? AND session_id = ? ORDER BY timestamp DESC LIMIT 1",
        (f"{today}%", aid, sid),
    )
    try:
        expected_ack = f"sop-policy-sha256:{_policy_digest()}"
    except OSError:
        expected_ack = ""
    if rows and rows[0].get("ack_type") == expected_ack:
        print(f"{G}✓{N}  SOP acknowledged today  {D}({rows[0]['timestamp']}){N}")
        return True
    print(f"{R}✗{N}  No current SOT + all-MO acceptance for this session ({today})")
    print_reading_guide()
    print('  After reading, run: arc-sop start "<short task description>"')
    return False


def cmd_check():
    """Run all compliance checks."""
    init_db()
    print(f"{C}arc-sop check{N}")

    checks = []

    # 1. SOP baseline clean
    sop_clean = cmd_verify()
    checks.append(("SOP baseline", sop_clean, "intel-ops matches local DB baseline" if sop_clean else "SOP files changed since baseline"))

    # 2. Read-only dirs exist and are readable
    read_only = [
        (HOME / "arc-lt-cmc", "arc-lt-cmc"),
        (HOME / "dev-notes/hq-main", "hq-main"),
    ]
    for path, label in read_only:
        if path.exists() and path.is_dir():
            if os.access(path, os.R_OK):
                checks.append((f"{label} read-only", True, f"{label} present and readable"))
            else:
                checks.append((f"{label} read-only", False, f"{label} not readable"))
        else:
            checks.append((f"{label} read-only", True, f"{label} not present (OK)"))

    # 3. GAMEPLAN has a task start for this same session, not merely any entry today.
    gp = INTEL_OPS / "GAMEPLAN.md"
    today = datetime.now().strftime("%Y-%m-%d")
    gp_ok = _gameplan_today_has_starting(session_id(), agent_id())
    gp_msg = (f"GAMEPLAN.md has {today} [STARTING] for this session" if gp_ok
              else f"GAMEPLAN.md missing {today} [STARTING] for this session")
    checks.append(("GAMEPLAN today", gp_ok, gp_msg))

    # 4. Recent ack -- same-session, same-day (mirrors cmd_gate_check's scoping;
    # previously had NO filter at all, so any historical ack ever kept this green forever)
    check_today = datetime.now().strftime("%Y-%m-%d")
    check_aid = agent_id()
    check_sid = session_id()
    try:
        expected_ack = f"sop-policy-sha256:{_policy_digest()}"
    except OSError:
        expected_ack = ""
    recent_ack = db_query(
        "SELECT * FROM acks WHERE timestamp LIKE ? AND agent_id = ? AND session_id = ? ORDER BY timestamp DESC LIMIT 1",
        (f"{check_today}%", check_aid, check_sid),
    )
    ack_ok = False
    ack_msg = "no SOP acknowledgment on record"
    if recent_ack and recent_ack[0].get("ack_type") == expected_ack:
        last = recent_ack[0]["timestamp"]
        ack_msg = f"last ack: {last}"
        ack_ok = True
    checks.append(("Current SOT + all-MO acknowledgment", ack_ok, ack_msg))

    # 5. Backup recent (< 24h)
    stamp = HOME / ".usb-bakup/.last-sync"
    backup_ok = False
    backup_msg = "no backup on record"
    if stamp.exists():
        last = stamp.read_text().strip()
        try:
            last_ts = datetime.strptime(last, "%Y-%m-%d %H:%M")
            hours = (datetime.now() - last_ts).total_seconds() / 3600
            backup_ok = hours < 24
            backup_msg = f"last backup: {last} ({hours:.1f}h ago)"
        except ValueError:
            backup_msg = f"last backup: {last} (parse error)"
    checks.append(("Backup <24h", backup_ok, backup_msg))

    open_violations = db_query("SELECT COUNT(*) AS c FROM violations WHERE resolved = 0")[0]["c"]
    checks.append(("Open compliance violations", open_violations == 0,
                   f"{open_violations} unresolved event(s)"))

    # Print results
    all_passed = True
    for name, passed, message in checks:
        print_rule(name, passed, message)
        db_insert("checks", timestamp=now(), check_name=name, passed=int(passed), message=message)
        if not passed:
            all_passed = False

    if not all_passed:
        failed_names = [name for name, passed, _ in checks if not passed]
        summary = ", ".join(failed_names)
        print(f"\n{Y}⚠{N}  Compliance issues found. Review above.")
        _notify("SOP compliance failed", summary, urgency="critical")
    else:
        print(f"\n{G}✓{N}  All checks passed.")

    return all_passed


def cmd_status():
    """Show current compliance state."""
    init_db()
    print(f"{C}arc-sop status{N}")

    acks = db_query("SELECT COUNT(*) as c FROM acks")[0]["c"]
    violations = db_query("SELECT COUNT(*) as c FROM violations WHERE resolved = 0")[0]["c"]
    checks = db_query("SELECT * FROM checks ORDER BY timestamp DESC LIMIT 5")

    print(f"  Total acknowledgments: {acks}")
    print(f"  Open violations:       {violations}")
    print(f"\n  Recent checks:")
    for c in checks:
        sym = f"{G}✓{N}" if c["passed"] else f"{R}✗{N}"
        print(f"    {sym}  {c['timestamp']} · {c['check_name']}: {c['message']}")


def cmd_bundle():
    """Create a tar archive of intel-ops and place it in USB vault for MEGA sync."""
    init_db()
    if not INTEL_OPS.exists():
        print(f"{R}✗{N}  intel-ops directory missing")
        return False

    if not VAULT_SOP.parent.exists():
        print(f"{R}✗{N}  USB vault not mounted at /mnt/storage")
        return False

    VAULT_SOP.mkdir(parents=True, exist_ok=True)

    bundle_name = f"intel-ops-{datetime.now().strftime('%Y%m%d-%H%M%S')}.tar.gz"
    bundle_path = VAULT_SOP / bundle_name

    rc, _, stderr = run(
        ["tar", "-czf", str(bundle_path), "-C", str(INTEL_OPS.parent), "intel-ops"]
    )
    if rc != 0:
        print(f"{R}✗{N}  archive failed: {stderr}")
        return False

    print(f"{G}✓{N}  SOP archive created: {bundle_path}")
    print(f"{D}   MEGA sync on next arc sync{N}")
    return True


def cmd_root_copy():
    """Copy current intel-ops to root-backed disaster recovery path."""
    init_db()
    if not INTEL_OPS.exists():
        print(f"{R}✗{N}  intel-ops directory missing")
        return False

    # Create parent directory first, then rsync. ROOT_COPY needs sudo.
    rc, _, stderr = run(["sudo", "mkdir", "-p", str(ROOT_COPY.parent)])
    if rc != 0:
        print(f"{R}✗{N}  failed to create {ROOT_COPY.parent}: {stderr}")
        return False

    # root-owned, group-readable by the user (recover reads it unprivileged) but
    # writable only by root. Plain -a under sudo preserves the source's user
    # ownership, which left this "root copy" user-writable -- defeating its purpose.
    owner = f"0:{os.getgid()}"
    rc, _, stderr = run(
        ["sudo", "rsync", "-a", "--delete", f"--chown={owner}",
         "--chmod=D750,F640", f"{INTEL_OPS}/", f"{ROOT_COPY}/"]
    )
    if rc != 0:
        print(f"{R}✗{N}  root copy failed: {stderr}")
        return False

    # Also copy the SQLite enforcement DB so the baseline/history/acks survive
    # a home-directory wipe, not just the markdown SOP files.
    db_dest = str(ROOT_COPY / "arc-sop.db")
    db_rc, _, db_stderr = run(["sudo", "cp", str(DB_PATH), db_dest])
    if db_rc == 0:
        db_rc, _, db_stderr = run(["sudo", "chown", owner, db_dest])
    if db_rc == 0:
        db_rc, _, db_stderr = run(["sudo", "chmod", "640", db_dest])
    if db_rc != 0:
        print(f"{R}✗{N}  DB root copy failed: {db_stderr}")
        return False
    run(["sudo", "chown", owner, str(ROOT_COPY)])
    run(["sudo", "chmod", "750", str(ROOT_COPY)])

    print(f"{G}✓{N}  Root copy updated: {ROOT_COPY}")
    print(f"{G}✓{N}  DB copied to:       {ROOT_COPY / 'arc-sop.db'}")
    return True


def cmd_recover():
    """Restore SOP files from root copy or MEGA fallback."""
    init_db()
    source = None
    source_type = None

    if ROOT_COPY.exists() and (ROOT_COPY / "SOT.md").exists():
        source = ROOT_COPY
        source_type = "dir"
        print(f"{C}Recovering SOP from root copy: {ROOT_COPY}{N}")
    elif VAULT_SOP.exists():
        archives = sorted(VAULT_SOP.glob("*.tar.gz"))
        if archives:
            source = archives[-1]
            source_type = "tar"
            print(f"{C}Recovering SOP from archive: {source}{N}")
        else:
            print(f"{R}✗{N}  No root copy or archive found")
            return False
    else:
        print(f"{R}✗{N}  No recovery source available")
        return False

    # Backup current
    backup_ts = datetime.now().strftime("%Y%m%d-%H%M%S")
    backup_dir = HOME / f"dev-notes/intel-ops-backup-{backup_ts}"
    if INTEL_OPS.exists():
        rc, _, stderr = run(["cp", "-a", str(INTEL_OPS), str(backup_dir)])
        if rc != 0 or not backup_dir.is_dir():
            print(f"{R}✗{N}  current policy backup failed; recovery stopped: {stderr}")
            return False
        print(f"{D}   current backed up to: {backup_dir}{N}")

    # Recovery is deliberately available while locked, but it cannot preserve
    # an earlier acceptance. Invalidate before modifying files so partial
    # failures remain fail-closed; repeat after restoring a root-copy DB below.
    conn = sqlite3.connect(DB_PATH)
    conn.execute("UPDATE acks SET ack_type = 'invalidated-after-policy-recovery:' || ack_type "
                 "WHERE ack_type LIKE 'sop-policy-sha256:%'")
    conn.commit()
    conn.close()

    if source_type == "dir":
        rc, _, stderr = run(["rsync", "-a", "--delete", "--exclude=arc-sop.db", f"{source}/", f"{INTEL_OPS}/"])
    else:
        INTEL_OPS.mkdir(parents=True, exist_ok=True)
        rc, _, stderr = run(["tar", "-xzf", str(source), "-C", str(INTEL_OPS.parent)])
    if rc != 0:
        print(f"{R}✗{N}  policy restore failed; gate remains locked: {stderr}")
        return False
    if not (SOT_FILE.is_file() and MO_FILE.is_file()):
        print(f"{R}✗{N}  restored policy is incomplete; gate remains locked")
        return False

    # Restore the SQLite DB if a root copy exists.
    dr_db = source / "arc-sop.db" if source_type == "dir" else None
    if dr_db and dr_db.exists():
        SOP_DIR.mkdir(parents=True, exist_ok=True)
        db_backup = DB_PATH.with_suffix(f".db.pre-recover-{backup_ts}")
        rc, _, stderr = run(["cp", "-a", str(DB_PATH), str(db_backup)])
        if rc != 0:
            print(f"{R}✗{N}  current enforcement DB backup failed: {stderr}")
            return False
        rc, _, stderr = run(["cp", "-a", str(dr_db), str(DB_PATH)])
        if rc != 0:
            print(f"{R}✗{N}  recovery DB restore failed: {stderr}")
            return False
        print(f"{G}✓{N}  DB restored from:   {dr_db}")
        print(f"{D}   previous DB saved: {db_backup}{N}")

    # A root-copy DB may contain historical acknowledgments; invalidate them
    # after copying as well, then retain a visible audit check.
    conn = sqlite3.connect(DB_PATH)
    conn.execute(
        "UPDATE acks SET ack_type = 'invalidated-after-policy-recovery:' || ack_type "
        "WHERE ack_type LIKE 'sop-policy-sha256:%'"
    )
    conn.execute(
        "INSERT INTO checks (timestamp, check_name, passed, message) VALUES (?, ?, ?, ?)",
        (now(), "SOP recovery", 1, "Policy sources restored; all prior acceptances invalidated; gate remains locked"),
    )
    conn.commit()
    conn.close()
    print(f"{G}✓{N}  SOP recovery complete")
    print(f"{Y}!{N}  all prior policy acknowledgments invalidated; explicitly re-read and accept before operating")
    return True


# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------
def main():
    if len(sys.argv) < 2:
        print('Usage: arc-sop start "<non-empty task>" [--accept-policy <digest>] | emergency | recover | gate-check | status | check | violations [--watch] | ...')
        sys.exit(1)

    cmd = sys.argv[1]
    if cmd == "ack":
        sys.exit(cmd_ack())
    elif cmd == "baseline":
        cmd_baseline()
    elif cmd == "verify":
        sys.exit(0 if cmd_verify() else 1)
    elif cmd == "check":
        sys.exit(0 if cmd_check() else 1)
    elif cmd == "status":
        cmd_status()
    elif cmd == "bundle":
        cmd_bundle()
    elif cmd == "root-copy":
        cmd_root_copy()
    elif cmd == "recover":
        sys.exit(0 if cmd_recover() else 1)
    elif cmd in ("ack-today", "check-today"):
        ok = cmd_ack_today()
        sys.exit(0 if ok else 1)
    elif cmd in ("done-balance", "check-done"):
        ok = cmd_done_balance()
        sys.exit(0 if ok else 1)
    elif cmd == "violations":
        if len(sys.argv) == 2:
            cmd_violations()
        elif sys.argv[2:] == ["--watch"]:
            cmd_violations(watch=True)
        else:
            print("Usage: arc-sop violations [--watch]")
            sys.exit(2)
    elif cmd == "record-violation":
        if len(sys.argv) != 4:
            print("Usage: arc-sop record-violation <rule> <safe-tool-name>")
            sys.exit(2)
        sys.exit(cmd_record_violation(sys.argv[2], sys.argv[3]))
    elif cmd == "resolve":
        if len(sys.argv) < 3:
            print("Usage: arc-sop resolve <id>")
            sys.exit(1)
        cmd_resolve(sys.argv[2])
    elif cmd == "start":
        args = sys.argv[2:]
        accepted_digest = ""
        if "--accept-policy" in args:
            index = args.index("--accept-policy")
            if index + 1 >= len(args) or index + 2 != len(args):
                print("Usage: arc-sop start \"<non-empty task>\" [--accept-policy <sha256-digest>]")
                sys.exit(2)
            accepted_digest = args[index + 1]
            args = args[:index]
        description = " ".join(args)
        sys.exit(cmd_start(description, accepted_digest))
    elif cmd == "ack-auto":
        if len(sys.argv) < 3:
            print("Usage: arc-sop ack-auto <script-name>")
            sys.exit(1)
        cmd_ack_auto(sys.argv[2])
    elif cmd == "gate-status":
        cmd_gate_status()
    elif cmd == "gate-check":
        ok = cmd_gate_check()
        sys.exit(0 if ok else 1)
    elif cmd == "gate-bypass":
        sys.exit(cmd_gate_bypass())
    elif cmd == "emergency":
        sys.exit(cmd_gate_emergency(" ".join(sys.argv[2:])))
    elif cmd == "gate-enable":
        cmd_gate_enable()
    else:
        print(f"Unknown command: {cmd}")
        print('Usage: arc-sop [start "<task>" [--accept-policy <digest>] | baseline | verify | check | status | violations [--watch] | resolve <id> | bundle | root-copy | recover | ack-today | done-balance | ack-auto | gate-check | gate-status | gate-enable]')
        sys.exit(1)


if __name__ == "__main__":
    main()
