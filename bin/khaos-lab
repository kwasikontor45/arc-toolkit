#!/usr/bin/env python3
"""
khaos-lab — central control panel for the arc toolkit.
Renamed twice 2026-08-26 (control panel -> khaos-panel -> khaos-klinik ->
khaos-lab), user's own call each time -- keep it simple stuck.

A lightweight GUI front-end over the `arc` CLI you already have. Every
button here shells out to the exact same `arc <subcommand>` (or a small,
well-understood handful of raw commands for live status) already built,
tested, and running on this machine -- this does not reimplement any
logic, it's a dashboard/launcher over what already works.

Manual-start only, same principle as arc-break/arc-pine/darkstat/zap --
no autostart entry, nothing brings this up on its own.

Layout: left sidebar picks a category, right side shows that category's
actions, bottom is a shared output console (every action's real stdout/
stderr lands there) plus a free-form command box for anything not
covered by a button.
"""

import calendar
import re
import subprocess
import threading
import time
import tkinter as tk
from datetime import datetime
from pathlib import Path
from tkinter import font as tkfont

HEADER_ICON_PATH = Path.home() / ".local/share/khaos-lab/header-icon.png"
HEADER_BG_PATH   = Path.home() / ".local/share/khaos-lab/header-bg.png"
SIDEBAR_BG_PATH  = Path.home() / ".local/share/khaos-lab/sidebar-bg.png"
CONTENT_BG_PATH  = Path.home() / ".local/share/khaos-lab/content-bg.png"
TASKBAR_ICON_PATH = Path.home() / ".local/share/khaos-lab/taskbar-icon.png"
HEAL_LOG_PATH    = Path.home() / "khaos-lab/arc-heal-log/latest-status.md"
ORAGE_ICS_PATH   = Path.home() / ".local/share/orage/orage.ics"
# Taskbar-icon bug (2026-08-27, real root cause found 2026-08-29): the
# window-list entry showed a generic icon instead of khaos-lab's own art.
# className="khaos-lab" (below) was a real, separate correctness fix
# (WM_CLASS was genuinely just generic "Tk") but didn't move the taskbar
# icon on its own. The actual cause: iconphoto()'s image was 256x256 --
# too large for a single _NET_WM_ICON X11 property write. Verified directly
# via `xprop`: at 256x256 the property came back completely empty (silent
# failure, no error anywhere); at 48x48, the exact same call produces a
# real, correctly-sized icon block and the taskbar picks it up immediately
# -- no panel restart needed at all, the plugin just reads live window
# state. TASKBAR_ICON_PATH is a pre-shrunk 48x48 copy of icon.png for
# this reason -- iconphoto() needs a small image, the hicolor
# icon-theme install (still 256x256, correct for that use) is unrelated.
# This WM theme also turns out not to render any titlebar-corner icon at
# all (confirmed via a zoomed screenshot) -- the earlier "blank icon for
# the titlebar" workaround was solving a problem that didn't exist here,
# and is gone now that the real icon just works.

_ANSI_RE = re.compile(r"\x1b\[[0-9;]*[a-zA-Z]")


def strip_ansi(text):
    """arc's own subcommands print real ANSI color codes for terminal use
    -- a plain Tkinter Text/Label renders those as literal garbage
    characters instead of interpreting them. Strip before ever displaying
    command output anywhere in this GUI."""
    return _ANSI_RE.sub("", text)


def load_image(path):
    """Load a PhotoImage, or None if the file's missing/unreadable. Every
    themed image in this app (header icon/bg, sidebar bg, content bg, the
    blank titlebar icon) used to repeat the same 5-line try/except around
    this -- trimmed 2026-08-27 into one place, same behavior, less to keep
    in sync. Caller must keep the returned object referenced (a local that
    goes out of scope gets garbage-collected and the image just vanishes,
    a classic Tkinter gotcha) -- unchanged from before, this helper doesn't
    change that contract, just the loading boilerplate."""
    if not path.exists():
        return None
    try:
        return tk.PhotoImage(file=str(path))
    except Exception:
        return None


def get_upcoming_events(limit=3):
    """Read Orage's real calendar file directly and return the next few
    upcoming events, briefly formatted. Deliberately a lightweight regex
    parser, not a full RFC5545 library -- a full icalendar dependency
    isn't installed and isn't worth adding just for this. Only SUMMARY +
    DTSTART are read -- never DESCRIPTION, which can hold considerably
    more personal detail than belongs in a glanced-at dashboard tile.

    Handles both DTSTART forms Orage actually writes: timed
    (DTSTART:20260918T143000) and all-day (DTSTART;VALUE=DATE:20281009,
    no time component at all). The original version only matched the
    timed form, so any all-day event silently failed the regex and never
    appeared here regardless of how soon it was -- real bug, found
    2026-08-31 when a same-day-added all-day event ("phoenix-home-
    stretch") never showed up. All-day events sort/compare by date only
    (comparing them to `now` as midnight would wrongly exclude one dated
    today, since midnight has already passed) and print without a time."""
    if not ORAGE_ICS_PATH.exists():
        return []
    try:
        text = ORAGE_ICS_PATH.read_text()
    except Exception:
        return []

    events = []
    for block in re.findall(r"BEGIN:VEVENT.*?END:VEVENT", text, re.DOTALL):
        summary_m = re.search(r"^SUMMARY:(.*)$", block, re.MULTILINE)
        dtstart_m = re.search(r"^DTSTART[^:]*:(\d{8})(?:T(\d{6}))?", block, re.MULTILINE)
        if not (summary_m and dtstart_m):
            continue
        date_part, time_part = dtstart_m.group(1), dtstart_m.group(2)
        try:
            if time_part:
                dt = datetime.strptime(date_part + "T" + time_part, "%Y%m%dT%H%M%S")
                all_day = False
            else:
                dt = datetime.strptime(date_part, "%Y%m%d")
                all_day = True
        except ValueError:
            continue
        events.append((dt, summary_m.group(1).strip(), all_day))

    now = datetime.now()
    upcoming = sorted(
        (e for e in events if (e[0].date() >= now.date() if e[2] else e[0] >= now)),
        key=lambda e: e[0],
    )
    out = []
    for dt, summary, all_day in upcoming[:limit]:
        when = dt.strftime("%b %d") if all_day else dt.strftime("%b %d, %I:%M %p").replace(" 0", " ")
        out.append(f"{when} — {summary}")
    return out


def strip_banner(text, cmd=None):
    """Most `arc` subcommands wrap their real output in a decorative
    header/footer (a horizontal-rule line, the command's own name as a
    repeated title, another rule) meant for full-width terminal display.
    Dumped raw into a small dashboard tile it just looks like clutter --
    drop any line that's purely box-drawing/dash characters, any blank
    lines, and the title-echo line (the command's own name, which arc's
    banner style always repeats verbatim) if `cmd` is given."""
    title = cmd.strip().lower() if cmd else None
    lines = []
    for line in text.splitlines():
        stripped = line.strip()
        if not stripped:
            continue
        if all(ch in "─-—= " for ch in stripped):
            continue
        if title and stripped.lower() == title:
            continue
        lines.append(stripped)
    return "\n".join(lines)

# ── Rose Pine Moon (exact values, matching arc-break/arc-pine) ─────────────
BG       = "#232136"
SURFACE  = "#2a273f"
OVERLAY  = "#393552"
FG       = "#e0def4"
FG_MUTED = "#6e6a86"
GOLD     = "#f6c177"
ROSE     = "#eb6f92"
PINE     = "#3e8fb0"
TEAL     = "#9ccfd8"

def run(cmd, timeout=30):
    """Run a shell command, return (ok, output). Never raises."""
    try:
        r = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=timeout)
        out = (r.stdout or "") + (r.stderr or "")
        return r.returncode == 0, strip_ansi(out).strip()
    except subprocess.TimeoutExpired:
        return False, f"(timed out after {timeout}s -- command may still be running in the background)"
    except Exception as e:
        return False, f"(error launching command: {e})"


def launch_detached(cmd):
    """For actions that open a *persistent* GUI window (arc-break gui,
    arc-pine, emoji picker, TOTP app) rather than run-and-exit. This is
    NOT the same as run() with a trailing `&` -- a classic Python
    subprocess gotcha, confirmed live: subprocess.run(shell=True,
    capture_output=True) creates a pipe that a backgrounded grandchild
    process inherits, and .communicate() then blocks waiting for that
    pipe's write end to close, which never happens as long as the GUI
    window stays open -- even with `&>/dev/null` in the shell command
    itself. Popen with stdio all DEVNULL avoids the pipe entirely, so this
    returns instantly regardless of how long the launched window stays
    open.

    Deliberately NOT passing start_new_session=True here -- a second real
    bug found live: that setsid()'s the child into a new session outside
    systemd-logind's tracking of this login session, and logind reaped it
    consistently around 4-5s in (confirmed by direct timed observation,
    with vs. without the flag). Plain DEVNULL-redirected Popen, still
    inside the normal session, doesn't have this problem and the window
    stays open exactly as long as the user keeps it open."""
    try:
        subprocess.Popen(
            cmd, shell=True,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL,
        )
        return True, "launched"
    except Exception as e:
        return False, f"(error launching: {e})"


class Action:
    """One button: a label, the real command it runs, whether it needs a
    confirm step first (destructive/system-changing actions only -- plain
    status/read-only checks run immediately), and whether it's a
    detached GUI launch (see launch_detached()) rather than a normal
    run-and-capture-output command."""
    def __init__(self, label, cmd, confirm=False, timeout=30, detach=False):
        self.label = label
        self.cmd = cmd
        self.confirm = confirm
        self.timeout = timeout
        self.detach = detach


