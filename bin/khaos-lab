# ── data sources (read-only) ─────────────────────────────────────────────────
class InventoryData:
    """arc-inv's generated inventory.json -- the panel reads the report, it
    never re-implements the probes."""

    @staticmethod
    def load():
        try:
            return json.loads(INVENTORY_JSON.read_text())
        except Exception:
            return None

    @staticmethod
    def age_minutes(d):
        try:
            at = datetime.fromisoformat(d["scan"]["at"])
            return (datetime.now(timezone.utc) - at).total_seconds() / 60
        except Exception:
            return None

    @classmethod
    def summary(cls, d):
        """(text, color) for a one-line tile."""
        if not d:
            return "no inventory yet — open Inventory → scan now", GOLD
        c = d.get("counts", {})
        age = cls.age_minutes(d)
        parts = [f"{len(d.get('assets', []))} assets", f"{c.get('ok', 0)} ok"]
        for k in ("attention", "drift", "unknown"):
            if c.get(k):
                parts.append(f"{c[k]} {k}")
        if d.get("untracked"):
            parts.append(f"{len(d['untracked'])} unregistered")
        text = "  ·  ".join(parts) + f"\nscan {fmt_age(age)}"
        if c.get("drift"):
            color = ROSE
        elif d.get("untracked") or (age is not None and age > 90) or c.get("unknown", 0) > 3:
            color = GOLD
        else:
            color = TEAL
        return text, color


class CloudLab:
    """AWS lab state, from `arc aws-status` (one source of truth -- the old code
    re-implemented the AWS calls here with a hardcoded account id). Cached 90s
    and shared by every view that shows it, so navigating around never
    multiplies AWS calls."""

    TTL = 90

    def __init__(self, runner):
        self.runner = runner
        self._lock = threading.Lock()
        self._at, self._val = 0.0, ("checking…", FG)

    def snapshot(self):
        with self._lock:
            if time.time() - self._at < self.TTL:
                return self._val
            ok, out = self.runner.run("arc aws-status", timeout=40)
            inst = re.findall(r"·\s+(\S+?)(?:-cloud)?\s+(running|stopped|stopping|pending|terminated|\S+)", out)
            if not ok or not inst:
                self._val = ("unreachable (check aws credentials / network)", ROSE)
            else:
                spend = re.search(r"budget\s+\$([\d.]+)/(\d+)", out)
                spend_s = f"${float(spend.group(1)):.2f}/{spend.group(2)}" if spend else "spend n/a"
                text = "  ·  ".join(f"{n} {s}" for n, s in inst) + f"  ·  {spend_s}"
                self._val = (text, TEAL if any(s == "running" for _, s in inst) else FG)
            self._at = time.time()
            return self._val


# ── dialogs ──────────────────────────────────────────────────────────────────
class Dialog:
    """One modal-dialog helper (the old code copy-pasted three near-identical
    popups, none modal -- so confirms could stack). Escape cancels."""

    def __init__(self, app, title, resizable=False, geometry=None):
        self.app = app
        self.win = tk.Toplevel(app.root)
        self.win.title(title)
        self.win.configure(bg=BG)
        self.win.resizable(resizable, resizable)
        self.win.attributes("-topmost", True)
        self.win.transient(app.root)
        self.win.geometry(geometry or f"+{app.root.winfo_x() + 120}+{app.root.winfo_y() + 150}")
        self.win.bind("<Escape>", lambda _e: self.close())
        self.win.after(60, self._grab)

    def _grab(self):
        try:
            self.win.grab_set()
            self.win.focus_force()
        except tk.TclError:
            pass                      # not viewable yet / already closed -- harmless

    def label(self, text, fg=FG, font=None, wrap=None, pady=(0, 10)):
        tk.Label(self.win, text=text, font=font or self.app.f.label, bg=BG, fg=fg,
                 wraplength=wrap or 0, justify="left").pack(padx=20, pady=pady)

    def buttons(self, specs):
        row = tk.Frame(self.win, bg=BG)
        row.pack(pady=(0, 16))
        for text, fg, fn in specs:
            ui.button(row, text, command=(lambda f=fn: (self.close(), f and f())), font=self.app.f.small,
                      bg=SURFACE, fg=fg, hover_bg=OVERLAY, padx=12, pady=6).pack(side="left", padx=6)

    def close(self):
        try:
            self.win.grab_release()
        except tk.TclError:
            pass
        self.win.destroy()


# ── console pane ─────────────────────────────────────────────────────────────
class ConsolePane:
    """Shared output console. Colour is by named tag per colour (the old code
    named tags by text LENGTH, so two equal-length lines shared -- and kept
    overwriting -- one colour, and only the last line of a multi-line block was
    tagged at all). Capped so a chatty command can't grow it without bound."""

    MAX_LINES = 3000

    def __init__(self, app, parent):
        f = app.f
        tk.Label(parent, text="output", font=f.small, bg=BG, fg=FG_MUTED).pack(anchor="w")
        # Canvas + padded create_window (same technique as the content pane): the Text is opaque,
        # so the background art only shows in the pad margin around it -- by design.
        self.canvas = tk.Canvas(parent, bg=SURFACE, highlightthickness=0)
        self.canvas.pack(fill="both", expand=True)
        if app.content_bg:
            self.canvas.create_image(0, 0, anchor="nw", image=app.content_bg)
        self.text = tk.Text(self.canvas, bg=SURFACE, fg=FG, insertbackground=FG, font=f.mono,
                            relief="flat", padx=8, pady=6, wrap="word", state="disabled")
        self._pad = 5
        self._item = self.canvas.create_window(self._pad, self._pad, anchor="nw", window=self.text)
        self.canvas.bind("<Configure>", self._resize)
        self._tags = {}

    def _resize(self, event):
        self.canvas.itemconfigure(self._item, width=max(event.width - 2 * self._pad, 1),
                                  height=max(event.height - 2 * self._pad, 1))

    def _tag(self, color):
        name = self._tags.get(color)
        if name is None:
            name = self._tags[color] = f"col_{len(self._tags)}"
            self.text.tag_configure(name, foreground=color)
        return name

    def log(self, text, color=FG):
        t = self.text
        t.configure(state="normal")
        start = t.index("end-1c")
        t.insert("end", text + "\n")
        t.tag_add(self._tag(color), start, "end-1c")
        extra = int(t.index("end-1c").split(".")[0]) - self.MAX_LINES
        if extra > 0:
            t.delete("1.0", f"{extra + 1}.0")
        t.see("end")
        t.configure(state="disabled")


# ── views ────────────────────────────────────────────────────────────────────
class View:
    """One screen. Owns its widgets and its poll jobs; destroy() stops the jobs
    (so nothing keeps updating widgets that no longer exist)."""

    scrollable = False

    def __init__(self, app):
        self.app = app
        self.frame = None
        self._jobs = []

    def show(self):
        self.frame = tk.Frame(self.app.content, bg=SURFACE)
        self.app.embed(self.frame, scrollable=self.scrollable)
        self.build()
        if self.scrollable:
            self.app.refresh_scroll(self.frame)

    def build(self):
        raise NotImplementedError

    def alive(self):
        try:
            return self.frame is not None and bool(self.frame.winfo_exists())
        except tk.TclError:
            return False

    def poll(self, name, every_ms, work, apply):
        self._jobs.append(name)
        self.app.poller.start(name, every_ms, work, apply, self.alive)

    def kick(self, name):
        self.app.poller.kick(name)

    def destroy(self):
        for n in self._jobs:
            self.app.poller.stop(n)
        self._jobs = []
        self.frame = None


class TileView(View):
    """A 2-column grid of live status tiles. Subclasses declare TILES and
    checks() -> {key: callable}; each callable returns text or (text, colour).
    Checks run in parallel and each tile is updated the moment ITS check
    finishes (a refresh used to wait for the slowest one, so tiles stayed
    "checking…" for the length of an AWS call). Colours are decided in the
    worker thread -- never on the UI thread, where a lock held during a slow
    call would freeze the window."""

    scrollable = True
    TILES = []            # (row, col, key, title)
    EVERY = 15000
    NAME = "tiles"

    def build(self):
        self.labels = {}
        for row, col, key, title in self.TILES:
            f = tk.Frame(self.frame, bg=OVERLAY, highlightthickness=1, highlightbackground=BORDER)
            f.grid(row=row, column=col, padx=8, pady=8, sticky="nsew")
            self.frame.columnconfigure(col, weight=1, uniform="tiles")
            tk.Label(f, text=title, font=self.app.f.small, bg=OVERLAY, fg=FG_MUTED).pack(
                anchor="w", padx=12, pady=(10, 2))
            val = tk.Label(f, text="checking…", font=self.app.f.label, bg=OVERLAY, fg=FG, justify="left",
                           anchor="w")
            val.pack(anchor="w", fill="x", padx=12, pady=(0, 10))
            # wrap long values to the tile instead of clipping them off both edges
            f.bind("<Configure>", lambda e, v=val: v.configure(wraplength=max(e.width - 30, 80)))
            self.labels[key] = val
        self.poll(self.NAME, self.EVERY, self.collect, lambda _r: None)

    def refresh(self):
        self.kick(self.NAME)

    def checks(self):
        raise NotImplementedError

    def color_for(self, key, val):
        return FG

    def collect(self):
        """Worker thread: run every check concurrently, posting each result to
        the UI as it lands."""
        def one(item):
            key, fn = item
            try:
                r = fn()
            except Exception:
                r = "unavailable"
            text, color = r if isinstance(r, tuple) else (r, None)
            self.app.bridge.post(self._apply_one, key, text, color if color else self.color_for(key, text))
        items = list(self.checks().items())
        with cf.ThreadPoolExecutor(max_workers=len(items)) as ex:
            list(ex.map(one, items))

    def _apply_one(self, key, text, color):
        lbl = self.labels.get(key)
        if lbl is None or not self.alive():
            return
        lbl.configure(text=text, fg=color)
        self.app.refresh_scroll(self.frame)


class StatusView(TileView):
    NAME = "status"
    EVERY = 15000
    TILES = [
        (0, 0, "dns", "DNS"), (0, 1, "break", "Break timer"),
        (1, 0, "disk", "Disk"), (1, 1, "services", "Failed services"),
        (2, 0, "uptime", "Uptime / load"), (2, 1, "selfheal", "Self-heal (arc-heal)"),
        (3, 0, "idsips", "IDS/IPS"), (3, 1, "calendar", "Upcoming (Orage)"),
        (4, 0, "awslab", "AWS lab (gvm / soclab / wazuh)"), (4, 1, "inventory", "Inventory (arc inv)"),
        (5, 0, "notify", "Notify stack (voice · bubbles · site)"),
    ]

    def checks(self):
        r = self.app.runner.run

        def dns():
            ok, out = r("arc dns status", timeout=10)
            line = next((l for l in out.splitlines() if "mode:" in l), "")
            return line.split("mode:")[-1].strip() if line else (out[:60] or "unavailable")

        def brk():
            ok, out = r("arc break status", timeout=10)
            return strip_banner(out, cmd="arc break status") or "unavailable"

        def disk():
            ok, out = r("df -h / --output=used,avail,pcent", timeout=8)
            lines = out.splitlines()
            return lines[-1].strip() if len(lines) > 1 else "unavailable"

        def services():
            _, a = r("systemctl --failed --no-legend", timeout=8)
            _, b = r("systemctl --user --failed --no-legend", timeout=8)
            n = len([l for l in (a + "\n" + b).splitlines() if l.strip()])
            return f"{n} failed" if n else "all healthy"

        def uptime():
            ok, out = r("uptime -p && uptime | grep -oP 'load average: \\K.*'", timeout=8)
            return out.replace("\n", "  ·  ") or "unavailable"

        def selfheal():
            # A plain read of arc-heal's last result, not a fresh run (that's 20s+ and cron already
            # runs it every 3h) -- keeps the 15s refresh cheap.
            try:
                text = HEAL_LOG_PATH.read_text()
            except Exception:
                return "no runs on record yet"
            ts = re.search(r"— (\d{8}T\d{6}Z)", text)
            sm = re.search(r"Run took .*", text)
            summary = sm.group(0) if sm else "unrecognized log format"
            if not ts:
                return summary
            epoch = calendar.timegm(time.strptime(ts.group(1), "%Y%m%dT%H%M%SZ"))
            return f"{summary}  ·  {fmt_age(max(0, (time.time() - epoch) / 60))}"

        def idsips():
            _, sur = r("systemctl is-active suricata", timeout=5)
            ok1, sag = r("docker inspect --format '{{.State.Status}}' sagan", timeout=5)
            ok2, eve = r("docker inspect --format '{{.State.Status}}' evebox", timeout=5)
            return (f"suricata {sur.strip() or 'unknown'}  ·  sagan {sag.strip() if ok1 else 'missing'}"
                    f"  ·  evebox {eve.strip() if ok2 else 'missing'}")

        def calendar_():
            up = get_upcoming_events(limit=2)
            return "\n".join(up) if up else "nothing scheduled"

        def awslab():
            return self.app.cloudlab.snapshot()

        def inventory():
            return InventoryData.summary(InventoryData.load())

        def notify():
            _, out = r("systemctl --user is-active arc-pined arc-pine-bubbles notes-site", timeout=8)
            s = out.split()
            names = ["voice", "bubbles", "site"]
            if len(s) != 3:
                return "unavailable"
            return "  ·  ".join(f"{n} {'ok' if v == 'active' else v}" for n, v in zip(names, s))

        return {"dns": dns, "break": brk, "disk": disk, "services": services, "uptime": uptime,
                "selfheal": selfheal, "idsips": idsips, "calendar": calendar_,
                "awslab": awslab, "inventory": inventory, "notify": notify}

    def color_for(self, key, val):
        if key == "services":
            return ROSE if "failed" in val and not val.startswith("0 ") and val != "all healthy" else FG
        if key == "selfheal":
            fl, he = re.search(r"(\d+) flagged", val), re.search(r"(\d+) healed", val)
            if fl and int(fl.group(1)) > 0:
                return ROSE
            if he and int(he.group(1)) > 0:
                return TEAL
            return FG
        if key == "idsips":
            # exact-word checks: "inactive" contains "active"
            return TEAL if "suricata active" in val and val.count("running") == 2 else ROSE
        if key == "notify":
            return TEAL if val.count(" ok") == 3 else ROSE
        return FG


class CockpitView(TileView):
    NAME = "cockpit"
    EVERY = 60000
    TILES = [
        (0, 0, "vpn", "VPN (ProtonVPN)"), (0, 1, "dns", "DNS + leak check"),
        (1, 0, "netstats", "Network (wlan0, since boot)"), (1, 1, "eero", "Eero"),
        (2, 0, "cloudlab", "Cloud lab (gvm / soclab / wazuh)"), (2, 1, "kismet", "Kismet (wireless recon)"),
        (3, 0, "tailscale", "Tailscale (remote access)"), (3, 1, "site", "Private notes site"),
    ]

    def checks(self):
        r = self.app.runner.run

        def vpn():
            # 2026-09-22, user's follow-up: "add additional details for vpn and dns info...
            # place/point of current connection." `arc vpn status` already returns Server/
            # Protocol/Load -- this tile was discarding all three, showing only the bare
            # "Connected" word. Server is the actual point of connection (ProtonVPN's own
            # naming, e.g. "US-FREE#22 in Seattle, United States").
            ok, out = r("arc vpn status", timeout=20)
            status = re.search(r"Status:\s*(.+)", out)
            if not status:
                return out.strip()[:60] or "unavailable"
            head = status.group(1).strip()
            server = re.search(r"Server:\s*(.+)", out)
            protocol = re.search(r"Protocol:\s*(.+)", out)
            load = re.search(r"Load:\s*(.+)", out)
            if not server:
                return head  # disconnected -- no point of connection to show
            if protocol:
                head += f"  ·  {protocol.group(1).strip()}"
            line2 = server.group(1).strip()
            if load:
                line2 += f"  ·  {load.group(1).strip()} load"
            return f"{head}\n{line2}"

        def dns():
            # Same follow-up -- `query:` here was regex-captured as just the first token ("OK"),
            # silently dropping the "(<resolving IP>)" that arc dns check already prints right
            # next to it. That IP is DNS's own point-of-connection equivalent (which NextDNS
            # anycast edge actually answered), so it's worth keeping instead of throwing away.
            ok, out = r("arc dns check", timeout=20)
            d = re.search(r"daemon:\s*(\S+)", out)
            ro = re.search(r"routing:\s*(.+)", out)
            q = re.search(r"query:\s*(\S+)(?:\s*\(([^)]+)\))?", out)
            if d and q:
                qtext = q.group(1) + (f" ({q.group(2)})" if q.group(2) else "")
                return f"daemon {d.group(1)}  ·  query {qtext}\n{(ro.group(1).strip() if ro else '')[:60]}"
            return "unavailable"

        def netstats():
            ok, out = r("arc net stats", timeout=8)
            return next((l.strip() for l in out.splitlines() if "wlan0" in l), "") or "unavailable"

        def eero():
            ok, out = r("arc eero-summary", timeout=20)
            if "auth: ok" in out:
                d = {}
                for line in out.splitlines():
                    if ":" in line:
                        k, v = line.split(":", 1)
                        d[k.strip()] = v.strip()
                return (f"{d.get('internet', '?')}  ·  {d.get('clients', '?')} clients  ·  {d.get('nodes', '?')} node(s)"
                        f"\ndns {d.get('dns', '?')}  ·  {d.get('public_ip', '?')}")
            return "not signed in — arc eero" if "not signed in" in out else "unavailable"

        def cloudlab():
            return self.app.cloudlab.snapshot()

        def kismet():
            ok, out = r("arc kismet status", timeout=8)
            return strip_banner(out, cmd="arc kismet status") or "unavailable"

        def tailscale():
            ok, out = r("tailscale status --json", timeout=10)
            d = json.loads(out)
            me = d.get("Self", {})
            peers = list((d.get("Peer") or {}).values())
            on = [p for p in peers if p.get("Online")]
            off = [p.get("HostName", "?").strip() for p in peers if not p.get("Online")]
            head = f"{'online' if me.get('Online') else 'OFFLINE'}  ·  {len(on)}/{len(peers)} peers online"
            return head + (f"\noffline: {', '.join(off)}" if off else "")

        def site():
            ok, out = r("arc site", timeout=20)
            g = lambda k: (re.search(rf"^\s*{k}\s+(.+?)(?:\s{{2}}|$)", out, re.M) or [None, "?"])[1].strip()
            return f"server {g('server')}  ·  tailnet {g('tailnet')}  ·  funnel {g('funnel')}"

        return {"vpn": vpn, "dns": dns, "netstats": netstats, "eero": eero, "cloudlab": cloudlab,
                "kismet": kismet, "tailscale": tailscale, "site": site}

    def color_for(self, key, val):
        low = val.lower()
        if key == "vpn":
            return TEAL if "connected" in low and "disconnected" not in low else FG_MUTED
        if key == "dns":
            return ROSE if "unavailable" in low else FG
        if key == "eero":
            return ROSE if ("down" in low or "unavailable" in low) else FG
        if key == "tailscale":
            return ROSE if "unavailable" in low or "offline" in low.split("\n")[0] else (GOLD if "offline:" in low else TEAL)
        if key == "site":
            if "funnel off" not in low:
                return ROSE                       # anything but "off" = possible public exposure
            return TEAL if "server running" in low and "tailnet exposed" in low else FG_MUTED
        return FG


class InventoryView(View):
    """register vs reality (arc inv): counts, what needs attention, the
    unregistered queue, scan freshness, and a Scan button. Reads the generated
    inventory.json; every mutation (adopt/ignore/retire/review) needs arguments,
    so those stay in a terminal -- the view says so."""

    scrollable = True
    HEALTH_COLOR = {"ok": TEAL, "attention": GOLD, "drift": ROSE, "unknown": FG_MUTED, "info": FG_MUTED}
    ORDER = {"drift": 0, "attention": 1, "unknown": 2}

    def build(self):
        f = self.app.f
        top = tk.Frame(self.frame, bg=SURFACE)
        top.pack(fill="x", padx=4, pady=(4, 6))
        for text, fg, cmd, to in (("scan now", TEAL, "arc inv scan --quiet", 180), ("verify ledger", GOLD, "arc inv verify", 30),
                                  ("list all", GOLD, "arc inv list", 30), ("history", GOLD, "arc inv history", 30)):
            ui.button(top, text, command=lambda c=cmd, t=to: self.app.run_async(c, timeout=t, on_done=self.reload),
                      font=f.small, bg=OVERLAY, fg=fg, hover_bg=BG, padx=12, pady=5).pack(side="right", padx=3)
        # packed AFTER the buttons: when the row is narrow the label gets squeezed, never a button
        self.fresh = tk.Label(top, text="", font=f.small, bg=SURFACE, fg=FG_MUTED, anchor="w", justify="left")
        self.fresh.pack(side="left", fill="x", expand=True)
        top.bind("<Configure>", lambda e: self.fresh.configure(wraplength=max(e.width - 340, 120)))
        self.counts = tk.Frame(self.frame, bg=SURFACE)
        self.counts.pack(fill="x", padx=4, pady=(0, 6))
        self.body = tk.Frame(self.frame, bg=SURFACE)
        self.body.pack(fill="both", expand=True)
        self.poll("inventory-view", 30000, InventoryData.load, self.render)

    def reload(self):
        if self.alive():
            self.kick("inventory-view")

    def _section(self, title):
        tk.Label(self.body, text=title, font=self.app.f.small, bg=SURFACE, fg=GOLD, anchor="w").pack(
            fill="x", padx=6, pady=(10, 3))

    def _row(self, tag, tag_color, main, sub=""):
        f = self.app.f
        row = tk.Frame(self.body, bg=OVERLAY, highlightthickness=1, highlightbackground=BORDER)
        row.pack(fill="x", pady=1, padx=4)
        tk.Label(row, text=tag, font=f.small, bg=OVERLAY, fg=tag_color, width=10, anchor="w").pack(
            side="left", padx=(8, 4), pady=5)
        col = tk.Frame(row, bg=OVERLAY)
        col.pack(side="left", fill="x", expand=True, pady=4)
        tk.Label(col, text=main, font=f.label, bg=OVERLAY, fg=FG, anchor="w").pack(fill="x")
        if sub:
            tk.Label(col, text=sub, font=f.small, bg=OVERLAY, fg=FG_MUTED, anchor="w", justify="left",
                     wraplength=430).pack(fill="x")

    def render(self, d):
        for w in self.counts.winfo_children():
            w.destroy()
        for w in self.body.winfo_children():
            w.destroy()
        f = self.app.f
        if not d:
            self.fresh.configure(text="no inventory yet — click scan now", fg=GOLD)
            self.app.refresh_scroll(self.frame)
            return
        age = InventoryData.age_minutes(d)
        stale = age is None or age > 90
        led = d.get("ledger", {})
        self.fresh.configure(
            text=f"{len(d['assets'])} assets  ·  scanned {fmt_age(age)}"
                 f"{'  (STALE — timer not firing?)' if stale else ''}  ·  ledger "
                 f"{'verified' if led.get('verified') else 'BROKEN'} ({led.get('entries', 0)})",
            fg=GOLD if stale or not led.get("verified") else FG_MUTED)
        for k in ("ok", "attention", "drift", "unknown", "info"):
            n = d.get("counts", {}).get(k, 0)
            tk.Label(self.counts, text=f"{k} {n}", font=f.label, bg=SURFACE,
                     fg=self.HEALTH_COLOR[k] if n else FG_MUTED).pack(side="left", padx=(6, 14))
        if d.get("untracked"):
            tk.Label(self.counts, text=f"unregistered {len(d['untracked'])}", font=f.label, bg=SURFACE,
                     fg=GOLD).pack(side="left", padx=(6, 14))
        bad = sorted((a for a in d["assets"] if a["health"] in self.ORDER),
                     key=lambda a: (self.ORDER[a["health"]], a["id"]))
        self._section(f"needs attention ({len(bad)})")
        if not bad:
            tk.Label(self.body, text="  nothing — every registered asset matches its desired state",
                     font=f.small, bg=SURFACE, fg=TEAL, anchor="w").pack(fill="x", padx=6)
        for a in bad[:40]:
            self._row(a["health"], self.HEALTH_COLOR[a["health"]], a.get("name", a["id"]),
                      "; ".join(a.get("problems") or []) or f"observed {a.get('observed', '?')} ({a.get('detail', '')})")
        if len(bad) > 40:
            tk.Label(self.body, text=f"  +{len(bad) - 40} more — arc inv drift", font=f.small, bg=SURFACE,
                     fg=FG_MUTED, anchor="w").pack(fill="x", padx=6)
        if d.get("untracked"):
            self._section(f"unregistered — found by discovery, nobody wrote it down ({len(d['untracked'])})")
            for u in d["untracked"][:20]:
                self._row("untracked", GOLD, u["identity"], f"{u.get('detail', '')}  ·  adopt or ignore in a terminal: "
                                                            f"arc inv adopt {u['identity']} --id … --kind …")
        self._section("recent changes (tamper-evident ledger)")
        for e in d.get("recent", [])[:8]:
            self._row(e["ts"][5:16].replace("T", " "), FG_MUTED, f"{e['event']}  ·  {e['id'] or '—'}")
        tk.Label(self.body, text="adopt / ignore / retire / review take arguments — run them in a terminal "
                                 "(arc inv help). Register: ~/dev-notes/intel-ops/inventory/registry.toml",
                 font=f.small, bg=SURFACE, fg=FG_MUTED, anchor="w", justify="left", wraplength=500).pack(
            fill="x", padx=6, pady=(12, 4))
        self.app.refresh_scroll(self.frame)


class LogsView(View):
    """Click a log, review real content, purge (clears the actual file on disk,
    not just the display) or keep. Built after a real complaint: a heal
    notification said "1 thing healed... see the log" with zero detail."""

    def build(self):
        f = self.app.f
        for src in LOG_SOURCES:
            row = tk.Frame(self.frame, bg=OVERLAY)
            row.pack(fill="x", padx=8, pady=5)
            left = tk.Frame(row, bg=OVERLAY)
            left.pack(side="left", fill="x", expand=True, padx=12, pady=10)
            tk.Label(left, text=src["name"], font=f.label, bg=OVERLAY, fg=FG).pack(anchor="w")
            stat = tk.Label(left, text=self._stat(src["path"]), font=f.small, bg=OVERLAY, fg=FG_MUTED)
            stat.pack(anchor="w")
            btns = tk.Frame(row, bg=OVERLAY)
            btns.pack(side="right", padx=12)
            ui.button(btns, "view", command=lambda s=src: self._view(s), font=f.small, bg=SURFACE, fg=TEAL,
                      hover_bg=BG, padx=10, pady=5).pack(side="left", padx=4)
            # ui.button captures `command` at creation (a Label has no -command), so it must be
            # passed here -- a later .configure(command=...) can't work.
            ui.button(btns, "purge", command=lambda s=src, l=stat: self._purge(s, l), font=f.small,
                      bg=SURFACE, fg=ROSE, hover_bg=BG, padx=10, pady=5).pack(side="left", padx=4)

    @staticmethod
    def _stat(path):
        try:
            st = path.stat()
        except FileNotFoundError:
            return "not found"
        except PermissionError:
            return "permission denied"
        size = float(st.st_size)
        for unit in ("B", "KB", "MB", "GB"):
            if size < 1024 or unit == "GB":
                s = f"{size:.0f}B" if unit == "B" else f"{size:.1f}{unit}"
                break
            size /= 1024
        return f"{s}  ·  {datetime.fromtimestamp(st.st_mtime).strftime('%Y-%m-%d %H:%M')}"

    def _tail(self, src):
        run, p = self.app.runner.run, shlex.quote(str(src["path"]))
        if src["kind"] == "sqlite":
            ok, out = run(f'sqlite3 -separator " | " {p} "SELECT timestamp, app_name, summary, body '
                          f'FROM notifications ORDER BY id DESC LIMIT 50;"', timeout=10)
        else:
            ok, out = run(f"tail -n 200 {p}", timeout=10)
        return out if ok else f"(couldn't read {src['path']} — {out})"

    def _view(self, src):
        f = self.app.f
        d = Dialog(self.app, src["name"], resizable=True, geometry="900x600")
        tk.Label(d.win, text=f"{src['name']}  —  {src['path']}", font=f.small, bg=BG, fg=FG_MUTED,
                 anchor="w").pack(fill="x", padx=14, pady=(12, 4))
        tf = tk.Frame(d.win, bg=BG)
        tf.pack(fill="both", expand=True, padx=14, pady=(0, 8))
        sb = tk.Scrollbar(tf)
        sb.pack(side="right", fill="y")
        box = tk.Text(tf, bg=SURFACE, fg=FG, font=("JetBrains Mono", 10), wrap="word",
                      yscrollcommand=sb.set, relief="flat")
        box.pack(side="left", fill="both", expand=True)
        sb.configure(command=box.yview)
        box.insert("1.0", "loading…")
        box.configure(state="disabled")
        ui.button(d.win, "close", command=d.close, font=f.small, bg=SURFACE, fg=FG_MUTED, hover_bg=OVERLAY,
                  padx=14, pady=8).pack(pady=(0, 12))

        def show(text):
            try:
                box.configure(state="normal")
                box.delete("1.0", "end")
                box.insert("1.0", text or "(empty)")
                box.configure(state="disabled")
                box.see("end")
            except tk.TclError:
                pass                      # dialog closed while loading
        self.app.bg(lambda: self._tail(src), show)

    def _purge(self, src, stat_lbl):
        d = Dialog(self.app, "confirm")
        d.label(f"clear {src['name']}?")
        d.label("This deletes the real file's content — cannot be undone.", fg=ROSE, font=self.app.f.small)

        def go():
            p = shlex.quote(str(src["path"]))
            if src["kind"] == "sqlite":
                cmd = f'sqlite3 {p} "DELETE FROM notifications; VACUUM;"'
            elif src["sudo"]:
                cmd = f"sudo -n truncate -s 0 {p}"
            else:
                cmd = f"truncate -s 0 {p}"

            def done(res):
                ok, out = res
                if self.alive():
                    stat_lbl.configure(text=self._stat(src["path"]))
                if not ok:
                    e = Dialog(self.app, "purge failed")
                    e.label(f"couldn't clear {src['name']}", fg=ROSE)
                    e.label((out or "")[:300] + ("\n\nlikely needs: arc sot install-sudoers"
                                                 if "password" in (out or "") else ""),
                            fg=FG_MUTED, font=self.app.f.small, wrap=380)
                    e.buttons([("ok", FG_MUTED, None)])
            self.app.bg(lambda: self.app.runner.run(cmd, timeout=15), done)
        d.buttons([("yes, clear it", ROSE, go), ("cancel (keep)", FG_MUTED, None)])


class FindView(View):
    """`arc find <query>` across arc-lt-cmc + dev-notes + khaos-lab +
    vault/archive, plus `arc ref` -- the literal answer to "surface the notes"."""

    scrollable = True

    def build(self):
        f = self.app.f
        top = tk.Frame(self.frame, bg=SURFACE)
        top.pack(fill="x", padx=4, pady=(4, 10))
        tk.Label(top, text="search arc-lt-cmc + dev-notes + khaos-lab + vault/archive", font=f.small, bg=SURFACE,
                 fg=FG_MUTED, anchor="w").pack(fill="x", pady=(0, 6))
        er = tk.Frame(top, bg=SURFACE)
        er.pack(fill="x")
        self.q = tk.StringVar()
        entry = tk.Entry(er, textvariable=self.q, font=f.label, bg=OVERLAY, fg=FG, insertbackground=FG, relief="flat")
        entry.pack(side="left", fill="x", expand=True, ipady=6, padx=(0, 8))
        entry.bind("<Return>", lambda _e: self._search())
        ui.button(er, "search", command=self._search, font=f.small, bg=OVERLAY, fg=TEAL, hover_bg=BG,
                  padx=14, pady=6).pack(side="left", padx=(0, 6))
        ui.button(er, "browse refs (arc ref)", command=self._refs, font=f.small, bg=OVERLAY, fg=GOLD,
                  hover_bg=BG, padx=14, pady=6).pack(side="left")
        tf = tk.Frame(self.frame, bg=BG)
        tf.pack(fill="both", expand=True, padx=4, pady=(0, 4))
        sb = tk.Scrollbar(tf)
        sb.pack(side="right", fill="y")
        self.box = tk.Text(tf, bg=SURFACE, fg=FG, font=("JetBrains Mono", 10), wrap="word",
                           yscrollcommand=sb.set, relief="flat", height=24)
        self.box.pack(side="left", fill="both", expand=True)
        sb.configure(command=self.box.yview)
        self._show("type a query, press enter or click search")
        entry.focus_set()

    def _show(self, text):
        if not self.alive():
            return
        self.box.configure(state="normal")
        self.box.delete("1.0", "end")
        self.box.insert("1.0", text or "(no results)")
        self.box.configure(state="disabled")
        self.box.see("1.0")

    def _search(self):
        q = self.q.get().strip()
        if not q:
            return
        self._show(f"searching for '{q}'…")
        self.app.bg(lambda: self.app.runner.run(f"arc find {shlex.quote(q)}", timeout=25),
                    lambda res: self._show(res[1] if res[0] else f"(search failed) {res[1]}"))

    def _refs(self):
        self._show("loading archived references…")
        self.app.bg(lambda: self.app.runner.run("arc ref", timeout=20),
                    lambda res: self._show(res[1] if res[0] else f"(failed) {res[1]}"))


class ActionsView(View):
    """A category's button list (also used for global-search results, where
    `prefix` says which category a hit came from)."""

    scrollable = True

    def __init__(self, app, actions, prefix_by_action=None, empty_text=None):
        super().__init__(app)
        self.actions, self.prefix, self.empty_text = actions, prefix_by_action or {}, empty_text

    def build(self):
        if not self.actions:
            tk.Label(self.frame, text=self.empty_text or "nothing here", font=self.app.f.label, bg=SURFACE,
                     fg=FG_MUTED, anchor="w", padx=10, pady=10).pack(fill="x")
        for a in self.actions:
            self._row(a, self.prefix.get(id(a), ""))

    def _row(self, action, prefix):
        # The whole row highlights together on hover: with the label far-left and the button
        # far-right, nothing else ties them together once a category has many actions.
        f = self.app.f
        row = tk.Frame(self.frame, bg=SURFACE, highlightthickness=1, highlightbackground=BORDER)
        row.pack(fill="x", pady=1)
        gated = ConfirmPolicy.required(action) and not action.detach
        label = tk.Label(row, text=f"{prefix}{action.label}", font=f.label, bg=SURFACE, fg=FG, anchor="w",
                         padx=10, pady=6)
        label.pack(side="left", fill="x", expand=True)
        btn = tk.Button(row, text="run…" if gated else "run", command=lambda a=action: self.app.run_action(a),
                        font=f.small, bg=OVERLAY, fg=ROSE if gated else TEAL, activebackground=BG,
                        activeforeground=TEAL, relief="flat", bd=0, padx=14, pady=4, cursor="hand2")
        btn.pack(side="right", padx=10, pady=6)

        def hover(on):
            bg = OVERLAY if on else SURFACE
            row.configure(bg=bg)
            label.configure(bg=bg)
        for w in (row, label, btn):
            w.bind("<Enter>", lambda _e: hover(True))
            w.bind("<Leave>", lambda _e: hover(False))


# ── the app ──────────────────────────────────────────────────────────────────
class App:
    SPECIAL_VIEWS = {"Status": StatusView, "Cockpit": CockpitView, "Inventory": InventoryView,
                     "Logs": LogsView, "Find": FindView}

    def __init__(self):
        # className explicit: WM_CLASS was generic "Tk" (never "khaos-lab" as the .desktop
        # StartupWMClass assumed) -- a correctness fix independent of the taskbar-icon bug.
        self.root = root = tk.Tk(className="khaos-lab")
        root.title("khaos☠️lab")
        root.configure(bg=BG)
        # 860x730: comfortably inside the real usable area (_NET_WORKAREA is 766px tall; the taskbar
        # panel reserves the rest). No forced position -- xfwm4's own placement keeps the window on
        # screen; the geometry watchdog below corrects it if it's ever dragged off-area.
        root.geometry("860x730")
        root.minsize(720, 480)
        self.errors = []
        root.report_callback_exception = self._on_callback_error

        self._taskbar_icon = load_image(TASKBAR_ICON_PATH)
        if self._taskbar_icon:
            root.iconphoto(True, self._taskbar_icon)
        self.f = self._make_fonts()

        self.runner = Runner()
        self.bridge = UiBridge(root)
        self.poller = Poller(root, self.bridge)
        self.cloudlab = CloudLab(self.runner)
        self._busy = set()
        self.view = None
        self.current = "Status"
        self._console_room_done = False
        self._maximized = False
        self._pre_max_geometry = None

        self.content_bg = load_image(CONTENT_BG_PATH)
        self._build_header()
        self._build_panes()
        self._build_sidebar()
        self._bind_search()
        root.bind("<Control-f>", lambda _e: (self.search_entry.focus_set(), "break")[1])

        self.select("Status")
        self._tick()
        root.after(500, self._geometry_watchdog)   # give the WM time to finish its initial placement

    # -- setup ---------------------------------------------------------------
    @staticmethod
    def _make_fonts():
        try:
            # DejaVu Sans for the title: JetBrains Mono has no glyph for the skull and Tk does no
            # per-character font fallback (it rendered blank space).
            return SimpleNamespace(
                big=tkfont.Font(family="DejaVu Sans", size=14, weight="bold"),
                label=tkfont.Font(family="JetBrains Mono", size=10),
                small=tkfont.Font(family="JetBrains Mono", size=9),
                mono=tkfont.Font(family="JetBrains Mono", size=9),
                nav=tkfont.Font(family="JetBrains Mono", size=10))
        except Exception:
            d = tkfont.Font(size=10)
            return SimpleNamespace(big=d, label=d, small=d, mono=d, nav=d)

    def _build_header(self):
        f, root = self.f, self.root
        header = tk.Frame(root, bg=BG)
        header.pack(fill="x", padx=14, pady=(14, 8))
        # Background watermark via place() so the icon/title/clock (packed normally) stack on top
        # of it and keep their own resize behaviour.
        self._header_bg = load_image(HEADER_BG_PATH)
        if self._header_bg:
            tk.Label(header, image=self._header_bg, bg=BG).place(relx=0, rely=0, relwidth=1, relheight=1)
        self._header_icon = load_image(HEADER_ICON_PATH)
        if self._header_icon:
            tk.Label(header, image=self._header_icon, bg=BG, highlightthickness=2,
                     highlightbackground=GOLD).pack(side="left", padx=(0, 10))
        tk.Label(header, text="khaos", font=f.big, bg=BG, fg=GOLD).pack(side="left")
        tk.Label(header, text="/", font=f.big, bg=BG, fg=FG_MUTED).pack(side="left")
        tk.Label(header, text="lab", font=f.big, bg=BG, fg=TEAL).pack(side="left", padx=(0, 16))
        # Window controls (min/max/close), 2026-09-22 -- user's own follow-up: "its tricky to
        # find max/min/close buttons". Real cause, confirmed via xwininfo: this WM theme is
        # currently drawing essentially zero titlebar chrome for this window (the client and
        # its WM frame came back pixel-identical -- no reserved space for WM-drawn buttons at
        # all), a desktop/WM theme characteristic, not something khaos-lab's own code was ever
        # doing. Fixing the WM theme system-wide is out of scope here (it'd affect every window
        # on the desktop); drawing khaos-lab's own controls, scoped to just this app, is the
        # same pattern any custom-chrome app uses regardless of what the WM does. Packed before
        # clock/phase below so it claims the rightmost slot (pack(side="right") stacks in the
        # order packed -- first claims the far edge).
        ctrl = tk.Frame(header, bg=BG)
        ctrl.pack(side="right", padx=(10, 0))
        ui.button(ctrl, "─", command=root.iconify, font=f.small, bg=BG, fg=FG_MUTED,
                  hover_bg=OVERLAY, hover_fg=FG, padx=8, pady=2).pack(side="left")
        ui.button(ctrl, "▢", command=self._toggle_maximize, font=f.small, bg=BG, fg=FG_MUTED,
                  hover_bg=OVERLAY, hover_fg=FG, padx=8, pady=2).pack(side="left")
        ui.button(ctrl, "✕", command=root.destroy, font=f.small, bg=BG, fg=FG_MUTED,
                  hover_bg=ROSE, hover_fg=FG, padx=8, pady=2).pack(side="left")
        self.clock_lbl = tk.Label(header, text="", font=f.small, bg=BG, fg=FG_MUTED)
        self.clock_lbl.pack(side="right")
        # The panel's palette is fixed on purpose; which Kataleya phase it is (choice/desire/
        # still-pine/nyx) is still useful at a glance, in that phase's own accent.
        self.phase_lbl = tk.Label(header, text="", font=f.small, bg=BG, fg=FG_MUTED)
        self.phase_lbl.pack(side="right", padx=(0, 14))
        # Global quick-jump: searches ACTION LABELS across every category (the Find view searches
        # note CONTENT). Fixed width -- filling the strip crushed the header art.
        self.search_var = tk.StringVar()
        self.search_entry = tk.Entry(header, textvariable=self.search_var, font=f.small, width=28, bg=OVERLAY,
                                     fg=FG, insertbackground=FG, relief="flat", highlightthickness=1,
                                     highlightbackground=OVERLAY, highlightcolor=GOLD)
        self.search_entry.pack(side="left", ipady=4, padx=(0, 16))
        self._placeholder = "quick-jump: type an action name…   (ctrl+f)"
        self._ph_active = True
        self.search_entry.insert(0, self._placeholder)
        self.search_entry.configure(fg=FG_MUTED)
        self.search_entry.bind("<FocusIn>", self._search_focus_in)
        self.search_entry.bind("<FocusOut>", self._search_focus_out)
        tk.Frame(root, bg=OVERLAY, height=1).pack(fill="x", padx=14)

    def _search_focus_in(self, _e=None):
        if self._ph_active:
            self.search_entry.delete(0, "end")
            self.search_entry.configure(fg=FG)
            self._ph_active = False

    def _search_focus_out(self, _e=None):
        if not self.search_var.get().strip():
            self._ph_active = True
            self.search_entry.delete(0, "end")
            self.search_entry.insert(0, self._placeholder)
            self.search_entry.configure(fg=FG_MUTED)

    def _build_panes(self):
        root = self.root
        # Body/console split is a real drag-resizable PanedWindow (the console used to be fixed
        # at 9 lines and could never grow). Sidebar/content is a second one.
        self.main_pane = tk.PanedWindow(root, orient="vertical", bg=OVERLAY, sashwidth=6, sashrelief="flat",
                                        bd=0, showhandle=False, opaqueresize=True)
        self.main_pane.pack(fill="both", expand=True, padx=14, pady=10)
        body = tk.Frame(self.main_pane, bg=BG)
        # 400 is only the INITIAL split; the console auto-grows once on the first real output.
        self.main_pane.add(body, minsize=240, height=400)
        body_pane = tk.PanedWindow(body, orient="horizontal", bg=OVERLAY, sashwidth=6, sashrelief="flat",
                                   bd=0, showhandle=False, opaqueresize=True)
        body_pane.pack(fill="both", expand=True)
        # Canvas, not Frame, so the watermark can sit behind the nav buttons.
        self.sidebar = tk.Canvas(body_pane, bg=BG, width=150, highlightthickness=0)
        body_pane.add(self.sidebar, minsize=110, width=150)
        content_wrap = tk.Frame(body_pane, bg=SURFACE)
        body_pane.add(content_wrap, minsize=300)
        self.content = tk.Canvas(content_wrap, bg=SURFACE, highlightthickness=0)
        # A real scrollbar wired to a scrollregion kept honest by the embedded widget's actual
        # required size (fixes SOC being clipped with no way to reach the bottom rows). Shown
        # only when a view actually overflows.
        self.content_scroll = tk.Scrollbar(content_wrap, orient="vertical", command=self.content.yview, bg=OVERLAY,
                                           troughcolor=BG, activebackground=TEAL, bd=0, highlightthickness=0, width=12)
        self.content.configure(yscrollcommand=self.content_scroll.set)
        self.content.pack(side="left", fill="both", expand=True, padx=(10, 0))
        if self.content_bg:
            self.content.create_image(0, 0, anchor="nw", image=self.content_bg)
        console_frame = tk.Frame(self.main_pane, bg=BG)
        # minsize=110 is a real floor: whatever's left only ever shrinks the Text, never hides it.
        self.main_pane.add(console_frame, minsize=110, height=190)
        self.console = ConsolePane(self, console_frame)

    def _build_sidebar(self):
        sb = self.sidebar
        self._sidebar_bg = load_image(SIDEBAR_BG_PATH)
        if self._sidebar_bg:
            sb.create_image(0, 0, anchor="nw", image=self._sidebar_bg)
        # Brand badge: a fixed strip at the top, drawn before the nav buttons and never covered by
        # them (the art's own wordmark sits low in a tall image the button stack covers).
        self._sidebar_icon = load_image(SIDEBAR_ICON_PATH)
        if self._sidebar_icon:
            sb.create_image(8, 6, anchor="nw", image=self._sidebar_icon)
        sb.create_text(34, 16, anchor="w", text="khaos-lab", font=self.f.small, fill=GOLD)
        sb.create_line(0, 30, 150, 30, fill=OVERLAY, width=1)
        self.nav_buttons, self.nav_y = {}, {}
        self.nav_accent = sb.create_rectangle(0, 0, 0, 0, fill=GOLD, width=0)   # active-row tick
        y = 30
        for cat in CATEGORIES:
            b = ui.button(sb, cat, command=lambda c=cat: self.select(c), font=self.f.nav, bg=BG, fg=FG_MUTED,
                          hover_bg=OVERLAY, hover_fg=GOLD, padx=14, pady=6)
            b.configure(anchor="w")
            sb.create_window(4, y, anchor="nw", window=b, width=146)
            b.update_idletasks()
            self.nav_y[cat] = (y, b.winfo_reqheight())
            y += b.winfo_reqheight() + 1
            self.nav_buttons[cat] = b
            # Bound on each button (they cover most of the canvas), not bind_all: the content
            # pane's scrollable views already use bind_all for their own wheel handling.
            b.bind("<Button-4>", lambda _e: sb.yview_scroll(-1, "units"))
            b.bind("<Button-5>", lambda _e: sb.yview_scroll(1, "units"))
        # Scrollable, so every category stays reachable at any window height / sash position.
        sb.configure(scrollregion=(0, 0, 150, y + 4))
        sb.bind("<Button-4>", lambda _e: sb.yview_scroll(-1, "units"))
        sb.bind("<Button-5>", lambda _e: sb.yview_scroll(1, "units"))

    def _bind_search(self):
        self.search_entry.bind("<KeyRelease>", self._do_search)
        self.search_entry.bind("<Escape>", self._clear_search)

    # -- content embedding ---------------------------------------------------
    def _set_scrollbar(self, visible):
        if visible and not self.content_scroll.winfo_ismapped():
            self.content_scroll.pack(side="right", fill="y")
        elif not visible and self.content_scroll.winfo_ismapped():
            self.content_scroll.pack_forget()

    def _on_wheel(self, evt):
        if isinstance(evt.widget, tk.Text):
            return                                     # a Text scrolls itself; don't also scroll the page
        self.content.yview_scroll(-1 if (evt.num == 4 or evt.delta > 0) else 1, "units")

    def embed(self, widget, pad=16, scrollable=False):
        # pad on all sides is also what lets the watermark show through.
        item = self.content.create_window(pad, pad, anchor="nw", window=widget)

        def resize(event):
            try:
                self.content.itemconfigure(item, width=max(event.width - 2 * pad, 1))
                if scrollable:
                    # grow to the content's real height (not forced to the viewport) so the
                    # overflow is reachable by scrolling instead of clipped
                    widget.update_idletasks()
                    req_h = max(widget.winfo_reqheight(), event.height - 2 * pad)
                    self.content.configure(scrollregion=(0, 0, event.width, req_h + 2 * pad))
                    self._set_scrollbar(req_h + 2 * pad > event.height)
                else:
                    self.content.itemconfigure(item, height=max(event.height - 2 * pad, 1))
                    self.content.configure(scrollregion=(0, 0, event.width, event.height))
                    self._set_scrollbar(False)
            except tk.TclError:
                pass                                   # widget replaced mid-resize
        self.content.bind("<Configure>", resize)
        self.content.update_idletasks()
        resize(SimpleNamespace(width=self.content.winfo_width(), height=self.content.winfo_height()))
        if scrollable:
            for seq in ("<Button-4>", "<Button-5>", "<MouseWheel>"):
                self.content.bind_all(seq, self._on_wheel)
        else:
            for seq in ("<Button-4>", "<Button-5>", "<MouseWheel>"):
                self.content.unbind_all(seq)
            self._set_scrollbar(False)

    def refresh_scroll(self, widget, pad=16):
        """Re-measure after rows are added to an already-sized canvas (a category switch doesn't
        resize anything, so <Configure> alone would never fire)."""
        try:
            widget.update_idletasks()
            w, vh = self.content.winfo_width(), self.content.winfo_height()
            req_h = max(widget.winfo_reqheight(), vh - 2 * pad)
            self.content.configure(scrollregion=(0, 0, w, req_h + 2 * pad))
            self._set_scrollbar(req_h + 2 * pad > vh)
        except tk.TclError:
            pass

    # -- routing -------------------------------------------------------------
    def select(self, name):
        self.current = name
        for n, b in self.nav_buttons.items():
            b.set_look(bg=OVERLAY if n == name else BG, fg=GOLD if n == name else FG_MUTED)
        if name in self.nav_y:
            y, h = self.nav_y[name]
            self.sidebar.coords(self.nav_accent, 0, y, 3, y + h)
            self.sidebar.tag_raise(self.nav_accent)
        cls = self.SPECIAL_VIEWS.get(name)
        self._show(cls(self) if cls else ActionsView(self, CATEGORIES[name]))
        self.content.yview_moveto(0)

    def _show(self, view):
        if self.view:
            self.view.destroy()
        for w in self.content.winfo_children():
            w.destroy()
        self.view = view
        view.show()

    def _do_search(self, _evt=None):
        if self._ph_active:
            return
        q = self.search_var.get().strip().lower()
        if not q:
            self.select(self.current)
            return
        for b in self.nav_buttons.values():
            b.set_look(bg=BG, fg=FG_MUTED)
        hits = [(c, a) for c, acts in CATEGORIES.items() for a in acts if q in a.label.lower()]
        self._show(ActionsView(self, [a for _, a in hits], {id(a): f"{c} — " for c, a in hits},
                               empty_text=f"no actions match '{q}'"))

    def _clear_search(self, _evt=None):
        self.search_var.set("")
        self.select(self.current)
        self.root.focus_set()

    # -- running things ------------------------------------------------------
    def bg(self, work, done):
        """Run work() in a thread, then done(result) on the main thread."""
        def worker():
            try:
                res, err = work(), None
            except Exception:
                res, err = None, sys.exc_info()
            if err:
                self.bridge.post(lambda: self.root.report_callback_exception(*err))
            else:
                self.bridge.post(done, res)
        threading.Thread(target=worker, daemon=True).start()

    def ensure_console_room(self):
        """First time any command runs, grow the console sash once so real output has room without
        the user needing to know to drag it -- then never touch it again (a deliberate manual
        resize is never fought)."""
        if self._console_room_done:
            return
        self.root.update_idletasks()
        total = self.main_pane.winfo_height()
        if total <= 1:
            return                                     # not realized yet -- retry on the next run
        try:
            _, sash_y = self.main_pane.sash_coord(0)
        except tk.TclError:
            return
        self._console_room_done = True
        if max(0, total - 260) < sash_y:
            self.main_pane.sash_place(0, 0, max(0, total - 260))

    def run_async(self, cmd, timeout=30, on_done=None):
        # Ignore a repeat while the identical command is still running: a double-click used to run
        # a mutating action twice (`gvm cloud-start` bills).
        if cmd in self._busy:
            self.console.log(f"(already running — ignoring repeat: {cmd})", GOLD)
            return
        self._busy.add(cmd)
        self.ensure_console_room()
        self.console.log(f"$ {cmd}", TEAL)

        def done(res):
            ok, out = res
            self._busy.discard(cmd)
            if out:
                self.console.log(out, FG if ok else ROSE)
            self.console.log(f"[{'ok' if ok else 'failed'}]", PINE if ok else ROSE)
            if on_done:
                on_done()
            if isinstance(self.view, StatusView) and self.view.alive():
                self.view.refresh()
        self.bg(lambda: self.runner.run(cmd, timeout=timeout), done)

    def run_action(self, a):
        if a.detach:
            self.ensure_console_room()
            self.console.log(f"$ {a.cmd}  (opens its own window)", TEAL)
            ok, msg = self.runner.detach(a.cmd)
            self.console.log(f"[{'ok' if ok else 'failed'}] {msg}", PINE if ok else ROSE)
        elif ConfirmPolicy.required(a):
            d = Dialog(self, "confirm")
            d.label(f"run: {a.label}?")
            d.label(a.cmd, fg=FG_MUTED, font=self.f.small, wrap=420, pady=(0, 14))
            d.win.bind("<y>", lambda _e: (d.close(), self.run_async(a.cmd, a.timeout)))
            d.buttons([("yes, run it", ROSE, lambda: self.run_async(a.cmd, a.timeout)), ("cancel", FG_MUTED, None)])
        else:
            self.run_async(a.cmd, a.timeout)

    # -- periodic loops ------------------------------------------------------
    def _tick(self):
        self.root.after(1000, self._tick)              # schedule first: one bad tick can't end the clock
        try:
            self.clock_lbl.configure(text=time.strftime("%H:%M:%S"))
            name, color = ui.phase_info()
            self.phase_lbl.configure(text=f"◐ {name}", fg=color)
            self.runner.reap()
        except Exception:
            self.root.report_callback_exception(*sys.exc_info())

    def _geometry_watchdog(self):
        """Keep the window inside the real usable desktop area (`_NET_WORKAREA`, what the WM itself
        publishes -- not a guessed panel size). A forced position once put the bottom edge under
        the taskbar and silently hid the last widget. The xprop call runs off the UI thread."""
        self.root.after(10000, self._geometry_watchdog)
        self.bg(lambda: self.runner.run("xprop -root _NET_WORKAREA", timeout=3), self._apply_workarea)

    def _apply_workarea(self, res):
        ok, out = res
        nums = [int(n) for n in re.findall(r"-?\d+", out)] if ok and out else []
        if len(nums) < 4:
            return
        wx, wy, ww, wh = nums[:4]
        r = self.root
        r.update_idletasks()
        x, y, w, h = r.winfo_x(), r.winfo_y(), r.winfo_width(), r.winfo_height()
        nx = wx if x < wx else max(wx, wx + ww - w) if x + w > wx + ww else x
        ny = wy if y < wy else max(wy, wy + wh - h) if y + h > wy + wh else y
        if (nx, ny) != (x, y):
            r.geometry(f"+{nx}+{ny}")

    def _toggle_maximize(self):
        # Real bug caught before shipping, 2026-09-22: tried Tk's '-zoomed' attribute first
        # (the standard X11 EWMH maximize toggle) -- confirmed via a direct non-UI test
        # (set it True, re-read it, checked winfo geometry) that it's a silent no-op on this
        # WM: geometry unchanged, state still reports False right after setting True. Falls
        # back to the same _NET_WORKAREA technique _geometry_watchdog below already uses
        # successfully -- save the current geometry once, size to the real usable desktop
        # area to "maximize", restore the saved geometry to toggle back. Async via self.bg,
        # same pattern as the watchdog, so the xprop call can't stall a button click.
        if self._maximized:
            self.root.geometry(self._pre_max_geometry)
            self._maximized = False
            return
        self.root.update_idletasks()
        r = self.root
        self._pre_max_geometry = f"{r.winfo_width()}x{r.winfo_height()}+{r.winfo_x()}+{r.winfo_y()}"
        self.bg(lambda: self.runner.run("xprop -root _NET_WORKAREA", timeout=3), self._apply_maximize)

    def _apply_maximize(self, res):
        ok, out = res
        nums = [int(n) for n in re.findall(r"-?\d+", out)] if ok and out else []
        if len(nums) < 4:
            return
        wx, wy, ww, wh = nums[:4]
        self.root.geometry(f"{ww}x{wh}+{wx}+{wy}")
        self._maximized = True

    def _on_callback_error(self, exc, val, tb):
        self.errors.append("".join(traceback.format_exception(exc, val, tb)))
        traceback.print_exception(exc, val, tb)

    # -- lifecycle -----------------------------------------------------------
    def run(self):
        self.root.mainloop()

    def _pump(self, seconds):
        end = time.time() + seconds
        while time.time() < end:
            self.root.update()
            time.sleep(0.02)

    def selftest(self):
        """Open every view (and the global search), let their poll jobs run, and check nothing
        raised in a Tk callback and no poll job outlived its view."""
        print("khaos-lab selftest")
        for name in CATEGORIES:
            self.select(name)
            self._pump(1.2 if name in ("Status", "Cockpit", "Inventory") else 0.25)
            print(f"  view {name:<14} ok  (poll jobs: {', '.join(self.poller.active()) or 'none'})")
        self._ph_active = False
        for q in ("vpn", "zzz-no-such-action"):
            self.search_var.set(q)
            self._do_search()
            self._pump(0.2)
        print("  global search            ok")
        self.select("Personal")
        self._pump(0.3)
        leaked = self.poller.active()
        print(f"  poll jobs after leaving polled views: {leaked or 'none (no leak)'}")
        ov = ConfirmPolicy.overrides(CATEGORIES)
        print(f"  confirm-policy overrides (each must have a stated reason): {[o[1] for o in ov]}")
        bad = self.errors or leaked
        print("  " + ("FAILED" if bad else "all views built with no callback errors"))
        for e in self.errors:
            print(e)
        self.root.destroy()
        return 1 if bad else 0


def main(argv):
    app = App()
    if "--selftest" in argv:
        sys.exit(app.selftest())
    app.run()


if __name__ == "__main__":
    main(sys.argv[1:])
