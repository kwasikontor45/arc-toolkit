def parse_arc_catalog(output):
    """Extract the documented arc command index without evaluating its entries."""
    rows = []
    for line in strip_ansi(output).splitlines():
        parts = re.split(r"\s{2,}", line.strip(), maxsplit=1)
        if len(parts) != 2:
            continue
        usage, description = parts[0].strip(), parts[1].strip()
        if not (usage == "arc" or usage.startswith("arc ") or usage.startswith("arc-")):
            continue
        try:
            tokens = shlex.split(usage)
        except ValueError:
            continue
        command = []
        for token in tokens:
            if token.startswith(("<", "[")) or any(mark in token for mark in ("|", "/")):
                break
            command.append(token)
        if command and (command[0] == "arc" or command[0].startswith("arc-")):
            rows.append((usage, description, shlex.join(command)))
    return rows


def fmt_age(minutes):
    if minutes is None:
        return "never"
    minutes = int(minutes)
    if minutes < 2:
        return "just now"
    if minutes < 120:
        return f"{minutes}m ago"
    return f"{minutes // 60}h ago"


def read_audio_snapshot(runner):
    """Read the default output through PipeWire's PulseAudio compatibility layer.

    Keep the three fixed pactl queries in one bounded Runner call. The panel never
    guesses a sink ID, changes an audio service, or touches the microphone here.
    """
    eq = read_speaker_eq_snapshot()
    ok, output = runner.run(
        "pactl get-sink-volume @DEFAULT_SINK@ && "
        "pactl get-sink-mute @DEFAULT_SINK@ && "
        "pactl get-default-sink",
        timeout=8,
    )
    if not ok:
        return {"available": False, "error": output or "audio control unavailable",
                "eq": eq}

    lines = output.splitlines()
    volume_match = re.search(r"(\d+)%", lines[0]) if lines else None
    mute_match = re.search(r"\bMute:\s*(yes|no)\b", lines[1], re.I) if len(lines) > 1 else None
    if not volume_match or not mute_match or len(lines) < 3:
        return {"available": False, "error": "unexpected audio status response", "eq": eq}

    sink = "".join(ch for ch in lines[2].strip()
                   if ch == "\t" or (ord(ch) >= 32 and not 127 <= ord(ch) <= 159))[:160]
    return {
        "available": True,
        "sink": sink or "default output",
        "volume": int(volume_match.group(1)),
        "muted": mute_match.group(1).lower() == "yes",
        "eq_configured": eq.get("available", False),
        "eq": eq,
    }


