#!/usr/bin/env bash
# arc-vpn-watch — fast VPN reconnect check, NOT the slow arc-heal 3h cadence.
# Runs every 60s via arc-vpn-watch.timer.
#
# Desired-state-aware: only acts if `arc vpn connect` recorded "connected" as
# the desired state, and never fights a deliberate `arc vpn disconnect`.
# Proton authentication/keyring failures back off from one minute to a
# 30-minute ceiling instead of invoking the heavy CLI every timer tick.
#
# Every Proton call is bounded. The CLI takes a global SSO lock around session
# lookup; a boot-time call against a locked keyring can otherwise block the
# user's own interactive signin. Timeouts release that lock.
set -uo pipefail

STATE_FILE="$HOME/.config/arc/vpn-desired-state"
RETRY_FILE="$HOME/.cache/arc/vpn-auth-retry"
[[ -f "$STATE_FILE" ]] || exit 0
[[ "$(cat "$STATE_FILE" 2>/dev/null)" == "connected" ]] || exit 0
command -v protonvpn >/dev/null 2>&1 || exit 0

retry_count=0
retry_after=0
if [[ -r "$RETRY_FILE" ]]; then
  read -r retry_count retry_after < "$RETRY_FILE" || true
  [[ "$retry_count" =~ ^[0-9]+$ ]] || retry_count=0
  [[ "$retry_after" =~ ^[0-9]+$ ]] || retry_after=0
  if [[ "$retry_count" =~ ^[0-9]+$ && "$retry_after" =~ ^[0-9]+$ ]] && (( $(date +%s) < retry_after )); then
    exit 0
  fi
fi

schedule_auth_retry() {
  local next_count delay now tmp i
  next_count=$((retry_count + 1))
  delay=60
  for ((i = 1; i < next_count && delay < 1800; i++)); do delay=$((delay * 2)); done
  (( delay > 1800 )) && delay=1800
  now=$(date +%s)
  mkdir -p "$(dirname "$RETRY_FILE")"
  tmp="$RETRY_FILE.$$"
  (umask 077; printf '%s %s\n' "$next_count" "$((now + delay))" > "$tmp")
  mv -f "$tmp" "$RETRY_FILE"
  echo "arc-vpn-watch: ProtonVPN sign-in/keyring unavailable; reconnect check deferred for ${delay}s." >&2
  echo "arc-vpn-watch: after signing in, run 'arc vpn connect' to retry immediately." >&2
}

status_out=$(timeout 25 protonvpn status 2>&1)
status_rc=$?
if printf '%s\n' "$status_out" | grep -q '^Status: Connected'; then
  rm -f "$RETRY_FILE"
  exit 0
fi
if printf '%s\n' "$status_out" | grep -Eiq 'authentication required|please sign in|keyring.*locked|failed to unlock the collection'; then
  schedule_auth_retry
  exit 0
fi
if (( status_rc == 124 )); then
  echo "arc-vpn-watch: ProtonVPN status timed out; reconnect deferred to the next check." >&2
  exit 0
fi

# Free-tier servers can time out transiently. Retry those quickly, but stop
# immediately when the CLI says authentication or the login keyring is missing.
for _attempt in 1 2 3; do
  connect_out=$(timeout 60 protonvpn connect 2>&1)
  connect_rc=$?
  if printf '%s\n' "$connect_out" | grep -Eiq 'authentication required|please sign in|keyring.*locked|failed to unlock the collection'; then
    schedule_auth_retry
    exit 0
  fi
  if (( connect_rc == 124 )); then
    echo "arc-vpn-watch: ProtonVPN connect timed out; reconnect deferred to the next check." >&2
    exit 0
  fi
  status_out=$(timeout 25 protonvpn status 2>&1)
  status_rc=$?
  if printf '%s\n' "$status_out" | grep -q '^Status: Connected'; then
    rm -f "$RETRY_FILE"
    exit 0
  fi
  if (( status_rc == 124 )); then
    echo "arc-vpn-watch: ProtonVPN status timed out after connect; reconnect deferred." >&2
    exit 0
  fi
  sleep 2
done
# Still disconnected after server retries; the next 60s tick tries again.
