                                   insertbackground=FG, relief="flat")
        self.task_entry.pack(side="left", fill="x", expand=True, ipady=7, padx=(0, 8))
        self.task_entry.insert(0, "briefly name today's work…")
        self.task_entry.bind("<FocusIn>", self._clear_placeholder)
        self.task_entry.bind("<Return>", lambda _e: self.start_task())
        ui.button(row, "accept all MOs · log task", command=self.start_task, font=f.small, bg=OVERLAY,
                  fg=TEAL, hover_bg=BG, padx=12, pady=7).pack(side="right")

        self.docs_read = set()
        self.doc_hashes = {}
        self.accept_var = tk.BooleanVar(value=False)
        tk.Checkbutton(self.frame,
                       text="I read GAMEPLAN context, all of SOT.md, and every current MO in MO.md; I accept them for this session.",
                       variable=self.accept_var, font=f.small, bg=BG, fg=FG,
                       activebackground=BG, activeforeground=TEAL, selectcolor=OVERLAY,
                       anchor="w", justify="left", wraplength=720).pack(fill="x", padx=14, pady=(0, 8))

        violations = tk.Frame(self.frame, bg=OVERLAY, highlightthickness=1, highlightbackground=BORDER)
        violations.pack(fill="x", padx=8, pady=(0, 8))
        tk.Label(violations, text="LIVE COMPLIANCE EVENTS", font=f.small, bg=OVERLAY, fg=TEAL,
                 anchor="w").pack(fill="x", padx=12, pady=(9, 3))
        self.violations_label = tk.Label(violations, text="loading…", font=f.small, bg=OVERLAY,
                                         fg=FG_MUTED, anchor="w", justify="left", wraplength=700)
        self.violations_label.pack(fill="x", padx=12, pady=(0, 9))
        ui.button(violations, "open violation ledger", command=lambda: self.app.run_async(
            "arc sop violations", timeout=10), font=f.small, bg=OVERLAY, fg=FG,
            hover_bg=BG, padx=10, pady=6).pack(anchor="e", padx=10, pady=(0, 8))

        ui.button(self.frame, "run full SOP compliance check", command=lambda: self.app.run_async(
            "arc sop check", timeout=20, on_done=self.refresh_gate), font=f.small, bg=SURFACE,
            fg=FG, hover_bg=OVERLAY, padx=12, pady=7).pack(anchor="w", padx=12, pady=(0, 8))
        tk.Label(self.frame, text="If the gate is locked, panel operations are blocked. Reading these documents and starting this task remain available.",
                 font=f.small, bg=SURFACE, fg=FG_MUTED, anchor="w", justify="left",
                 wraplength=720).pack(fill="x", padx=12, pady=(0, 10))
        self.refresh_gate()
        self.poll("sop-gate-status", 5000, check_sop_gate, self._show_gate_status)
        self.poll("sop-violations", 1000, self._read_violations, self._show_violations)

    def _clear_placeholder(self, _event=None):
        if self.task_text.get() == "briefly name today's work…":
            self.task_text.set("")

    def refresh_gate(self):
        if not self.alive():
            return
        self._show_gate_status(check_sop_gate())

    def _show_gate_status(self, state):
        if not self.alive():
            return
        ok, detail = state
        self.gate_label.configure(text="OPERATIONS OPEN" if ok else "OPERATIONS LOCKED",
                                  fg=TEAL if ok else ROSE)
        self.detail_label.configure(text=detail or ("This session is cleared." if ok else
                                                     "Read the current plan, then log and acknowledge."))

    def start_task(self):
        description = self.task_text.get().strip()
        if description == "briefly name today's work…":
            description = ""
        if not description:
            self.app.console.log("enter a short task name before unlocking operations", GOLD)
            self.task_entry.focus_set()
            return
        if not self.accept_var.get() or not {"gameplan", "sot", "mo"}.issubset(self.docs_read):
            self.app.console.log("read the three current sources and explicitly accept every MO before starting", ROSE)
            return
        try:
            for name, key in (("SOT.md", "sot"), ("MO.md", "mo")):
                current = (HOME / "dev-notes/intel-ops" / name).read_bytes()
                if hashlib.sha256(current).hexdigest() != self.doc_hashes.get(key):
                    self.app.console.log(f"{name} changed since you read it; reopen it before accepting", ROSE)
                    self.docs_read.discard(key)
                    self.accept_var.set(False)
                    return
        except OSError as e:
            self.app.console.log(f"policy unavailable; gate stays locked: {e}", ROSE)
            return
        self.app.run_async(f"arc sop start {shlex.quote(description)}", timeout=20,
                           on_result=lambda result: self._confirm_policy(description, result))

    def _confirm_policy(self, description, result):
        _ok, output = result
        match = re.search(r"--accept-policy ([a-f0-9]{64})", output or "")
        if not match:
            self.app.console.log("could not obtain a fresh session policy digest; gate remains locked", ROSE)
            return
        if messagebox.askyesno("Accept all current MOs?",
                               "I read the current GAMEPLAN context, all of SOT.md, and every MO in MO.md.\n\n"
                               "Accept them for this session and log the task?", parent=self.app.root):
            command = f"arc sop start {shlex.quote(description)} --accept-policy {match.group(1)}"
            self.app.run_async(command, timeout=20, on_done=self.refresh_gate)

    def _read_doc(self, title, path, tail=None, read_key=None):
        d = Dialog(self.app, title, resizable=True, geometry="940x650")
        tk.Label(d.shell, text=f"read-only source  ·  {path}", font=self.app.f.small,
                 bg=SURFACE, fg=FG_MUTED, anchor="w").pack(fill="x", padx=14, pady=(12, 5))
        frame = tk.Frame(d.shell, bg=SURFACE)
        frame.pack(fill="both", expand=True, padx=14, pady=(0, 8))
        scroll = ui.PillScrollbar(frame)
        scroll.pack(side="right", fill="y")
        text = tk.Text(frame, bg=SURFACE, fg=FG, font=self.app.f.mono, wrap="word",
                       yscrollcommand=scroll.set, relief="flat")
        text.pack(side="left", fill="both", expand=True)
        scroll.configure(command=text.yview)
        text.insert("1.0", "loading…")
        text.configure(state="disabled")
        ui.button(d.shell, "close", command=d.close, font=self.app.f.small, bg=OVERLAY,
                  fg=FG_MUTED, hover_bg=BG, padx=14, pady=7).pack(pady=(0, 12))

        def load():
            try:
                content = path.read_text(errors="replace")
                if tail is not None:
                    content = "\n".join(content.splitlines()[-tail:])
                return content
            except Exception as e:
                return f"Could not read {path}: {e}"

        def show(content):
            try:
                text.configure(state="normal")
                text.delete("1.0", "end")
                text.insert("1.0", content or "(empty)")
                text.configure(state="disabled")
                text.see("1.0")
                if read_key and not str(content).startswith("Could not read"):
                    self.docs_read.add(read_key)
                    if read_key in {"sot", "mo"}:
                        self.doc_hashes[read_key] = hashlib.sha256(content.encode("utf-8")).hexdigest()
            except tk.TclError:
                pass
        self.app.bg(load, show)

    def _read_violations(self):
        db = HOME / ".config/arc/sop/arc-sop.db"
        try:
            with sqlite3.connect(f"file:{db}?mode=ro", uri=True, timeout=1) as conn:
                count = conn.execute("SELECT COUNT(*) FROM violations WHERE resolved = 0").fetchone()[0]
                rows = conn.execute("SELECT timestamp, rule FROM violations WHERE resolved = 0 ORDER BY id DESC LIMIT 3").fetchall()
            return count, rows
        except (OSError, sqlite3.Error):
            return None, []

    def _show_violations(self, result):
        count, rows = result
        if count is None:
            summary = "ledger unavailable; see `arc sop violations`"
            color = ROSE
        elif count == 0:
            summary = "No open violations · live refresh (1 second)"
            color = PINE
        else:
            summary = f"{count} open violation(s) · live refresh (1 second)\n" + "\n".join(
                f"{stamp} · {rule}" for stamp, rule in rows)
            color = ROSE
        try:
            self.violations_label.configure(text=summary, fg=color)
        except tk.TclError:
            pass


class HelpView(View):
    """A command-center front door: explain the panel, then jump to real menus.

    Counts and destinations come directly from CATEGORIES so this guide doesn't
    maintain a second list of runnable actions.
    """

    scrollable = True

    DESCRIPTIONS = {
        "SOP": "Read SOT/GAMEPLAN, satisfy the gate, and review compliance",
        "Status": "Live workstation health and security snapshot",
        "Audio": "Default output level and mute controls · full and hardware mixers",
        "Calendar": "Check events and to-dos; shared live with local Khaos Hub",
        "LT": "Personal focus and tasks from the existing lt board",
        "Commands": "Browse and run every arc or lt command safely",
        "Cockpit": "At-a-glance network, cloud, and remote-access controls",
        "Inventory": "Track registered assets and find drift or untracked items",
        "Logs": "Review recent system, security, and self-heal activity",
        "Find": "Search your notes and archived references",
        "Network": "VPN, DNS, router, and network-monitoring actions",
        "Reference": "Build and open your private reference library",
        "Phone": "ADB device tools · UAD-ng package management",
        "Waydroid": "Open Android → connect ADB → manage it from Phone",
        "Studio": "Launch LMMS, open the practice project, or read its beginner guide",
        "Security": "SOPs, firewall, account, and security checks",
        "SOC": "Local and cloud security labs, dashboards, and scanners",
        "Cloud": "AWS guardrails and stop controls · Cloudflare · Git release lanes · SSH references",
        "Dev": "Git health, Arc Toolkit source-of-truth, mirrors, and development workflows",
        "Remote Access": "Tailscale, private notes site, and backup tunnel",
        "Maintenance": "Backups, cleanup, updates, and system repair",
        "Personal": "Personal utilities and daily workflow actions",
    }

    def build(self):
        f = self.app.f
        hero = tk.Frame(self.frame, bg=BG)
        hero.pack(fill="x", pady=(0, 12))
        accent = tk.Frame(hero, bg=self.app.phase_accent, height=2)
        accent.pack(fill="x", pady=(0, 8))
        self.app.phase_lines.append(accent)
        tk.Label(hero, text="AGENT COMMAND CENTER  /  WORKSPACES", font=f.small, bg=BG,
                 fg=self.app.phase_accent,
                 anchor="w").pack(fill="x", padx=14, pady=(12, 3))
        tk.Label(hero, text="What do you need to do?", font=f.big, bg=BG, fg=FG,
                 anchor="w").pack(fill="x", padx=14, pady=(0, 4))
        tk.Label(hero, text="Choose a workspace, or search the whole toolkit from quick-jump.",
                 font=f.small, bg=BG, fg=FG_MUTED, anchor="w", wraplength=580,
                 justify="left").pack(fill="x", padx=14, pady=(0, 10))
        row = tk.Frame(hero, bg=BG)
        row.pack(fill="x", padx=14, pady=(0, 12))
        ui.button(row, "focus quick-jump  ·  Ctrl+F", command=self._focus_search, font=f.small,
                  bg=OVERLAY, fg=GOLD, hover_bg=BORDER, padx=10, pady=6).pack(side="left", padx=(0, 8))
        ui.button(row, "full CLI reference  ·  arc help all", command=lambda: self.app.run_async(
            "arc help all", timeout=15),
                  font=f.small, bg=OVERLAY, fg=TEAL, hover_bg=BORDER, padx=10, pady=6).pack(side="left")

        tk.Label(self.frame, text=f"WORKSPACES  ·  {len(CATEGORIES) - 1}", font=f.small,
                 bg=SURFACE, fg=FG_MUTED,
                 anchor="w").pack(fill="x", pady=(0, 5))
        grid = tk.Frame(self.frame, bg=SURFACE)
        grid.pack(fill="x")
        grid.bind("<Configure>", lambda e: self._layout_cards(grid, e.width))
        self._cards = []
        for name in CATEGORIES:
            if name == "Help":
                continue
            actions = CATEGORIES[name]
            count = len(actions)
            subtitle = self.DESCRIPTIONS.get(name, "Open this workspace")
            card = tk.Frame(grid, bg=BG, padx=10, pady=7, cursor="hand2")
            top = tk.Frame(card, bg=BG)
            top.pack(fill="x")
            tk.Label(top, text=name.upper(), font=f.small, bg=BG, fg=self.app.phase_accent,
                     anchor="w").pack(side="left")
            tk.Label(top, text=(f"{count} actions  →" if count else "overview  →"), font=f.small,
                     bg=BG, fg=TEAL, anchor="e").pack(side="right")
            desc = tk.Label(card, text=subtitle, font=f.small, bg=BG, fg=FG_MUTED, anchor="w",
                            justify="left", wraplength=240)
            desc.pack(fill="x", pady=(3, 0))
            card.bind("<Configure>", lambda e, d=desc: d.configure(wraplength=max(e.width - 22, 150)))
            tk.Frame(card, bg=BORDER, height=1).pack(fill="x", pady=(6, 0))
            for widget in (card, *card.winfo_children()):
                widget.bind("<Button-1>", lambda _e, n=name: self.app.select(n))
                widget.configure(cursor="hand2")
                widget.bind("<Enter>", lambda _e, c=card: self._card_hover(c, True))
                widget.bind("<Leave>", lambda _e, c=card: self._card_hover(c, False))
            self._cards.append(card)
        self._layout_cards(grid, 580)
        tk.Label(self.frame, text="Guarded actions ask before changing system state. Results and errors appear in the output console below.",
                 font=f.small, bg=SURFACE, fg=FG_MUTED, anchor="w", wraplength=580,
                 justify="left").pack(fill="x", pady=(12, 4))

    def _layout_cards(self, grid, width):
        if not hasattr(self, "_cards"):
            return
        columns = 1 if width < 430 else 2 if width < 820 else 3
        for index, card in enumerate(self._cards):
            card.grid(row=index // columns, column=index % columns, sticky="nsew", padx=(0, 7), pady=(0, 7))
        for col in range(3):
            grid.grid_columnconfigure(col, weight=1 if col < columns else 0,
                                      uniform="help-card" if col < columns else "")

    def _focus_search(self):
        self.app.search_entry.focus_set()
        self.app.search_entry.icursor("end")

    @staticmethod
    def _card_hover(card, on):
        bg = OVERLAY if on else BG
        def paint(widget):
            try:
                if widget.winfo_class() in ("Frame", "Label"):
                    widget.configure(bg=bg)
            except tk.TclError:
                return
            for child in widget.winfo_children():
                paint(child)
        paint(card)


class ActionsView(View):
    """A category's button list (also used for global-search results, where
    `prefix` says which category a hit came from)."""

    scrollable = True

    def __init__(self, app, actions, prefix_by_action=None, empty_text=None):
        super().__init__(app)
        self.actions, self.prefix, self.empty_text = actions, prefix_by_action or {}, empty_text

    def build(self):
        self.rows = []
        self.filter_var = tk.StringVar()
        if self.actions and len(self.actions) >= 5:
            head = tk.Frame(self.frame, bg=SURFACE)
            head.pack(fill="x", pady=(2, 10))
            sources = {self.prefix.get(id(a), "").split(" — ")[0]
                       for a in self.actions if self.prefix.get(id(a), "")}
            label = (next(iter(sources)) if len(sources) == 1 else
                     "QUICK-JUMP RESULTS" if sources else self.app.current)
            tk.Label(head, text=label.upper(), font=self.app.f.small, bg=SURFACE,
                     fg=GOLD, anchor="w").pack(fill="x", pady=(0, 4))
            tk.Label(head, text=f"{len(self.actions)} tools · filter this workspace or use quick-jump",
                     font=self.app.f.small, bg=SURFACE, fg=FG_MUTED, anchor="w").pack(fill="x", pady=(0, 7))
            entry = tk.Entry(head, textvariable=self.filter_var, font=self.app.f.small, bg=OVERLAY, fg=FG,
                             insertbackground=FG, relief="flat", highlightthickness=1,
                             highlightbackground=BORDER, highlightcolor=TEAL)
            entry.pack(fill="x", ipady=6)
            entry.insert(0, "filter tools…")
            entry.bind("<FocusIn>", lambda _e: entry.delete(0, "end")
                       if entry.get() == "filter tools…" else None)
            self.filter_var.trace_add("write", lambda *_: self._filter_rows())
        if not self.actions:
            tk.Label(self.frame, text=self.empty_text or "nothing here", font=self.app.f.label, bg=SURFACE,
                     fg=FG_MUTED, anchor="w", padx=10, pady=10).pack(fill="x")
        for a in self.actions:
            self._row(a, self.prefix.get(id(a), ""))
        if self.actions and len(self.actions) >= 5:
            self.no_match = tk.Label(self.frame, text="No tools match that filter.", font=self.app.f.small,
                                     bg=SURFACE, fg=FG_MUTED, anchor="w")
            self.no_match.pack_forget()

    def _filter_rows(self):
        query = self.filter_var.get().strip().lower()
        if query == "filter tools…":
            query = ""
        visible = []
        for row, searchable in self.rows:
            row.pack_forget()
            if not query or query in searchable:
                visible.append(row)
        for row in visible:
            row.pack(fill="x", pady=2)
        if hasattr(self, "no_match"):
            if visible:
                self.no_match.pack_forget()
            else:
                self.no_match.pack(fill="x", pady=10)

    def _row(self, action, prefix):
        # The whole row highlights together on hover: with the label far-left and the button
        # far-right, nothing else ties them together once a category has many actions.
        f = self.app.f
        item = tk.Frame(self.frame, bg=SURFACE)
        item.pack(fill="x", pady=2)
        row = tk.Frame(item, bg=SURFACE)
        row.pack(fill="x")
        gated = ConfirmPolicy.required(action) and not action.detach
        label = tk.Label(row, text=f"{prefix}{action.label}", font=f.label, bg=SURFACE, fg=FG, anchor="w",
                         padx=9, pady=5)
        label.pack(side="left", fill="x", expand=True)
        btn = ui.button(row, "confirm" if gated else "open" if action.detach else "run",
                        command=lambda a=action: self.app.run_action(a),
                        font=f.small, bg=OVERLAY, fg=ROSE if gated else TEAL,
                        hover_bg=BG, hover_fg=FG, padx=11, pady=4)
        btn.pack(side="right", padx=7, pady=3)

        def hover(on):
            bg = OVERLAY if on else SURFACE
            row.configure(bg=bg)
            label.configure(bg=bg)
        line = tk.Frame(item, bg=BORDER, height=1)
        line.pack(fill="x", padx=9, pady=(1, 0))
        self.rows.append((item, f"{prefix} {action.label} {action.cmd}".lower()))
        for w in (row, label, btn):
            w.bind("<Enter>", lambda _e: hover(True))
            w.bind("<Leave>", lambda _e: hover(False))


# ── the app ──────────────────────────────────────────────────────────────────
class App:
    SPECIAL_VIEWS = {"Help": HelpView, "SOP": SopView, "Status": StatusView, "Calendar": CalendarView,
                     "Audio": AudioView, "LT": LtView, "Commands": CommandsView,
                     "Cockpit": CockpitView, "Inventory": InventoryView,
                     "Logs": LogsView, "Find": FindView}

    def __init__(self):
        # className explicit: WM_CLASS was generic "Tk" (never "khaos-lab" as the .desktop
        # StartupWMClass assumed) -- a correctness fix independent of the taskbar-icon bug.
        self.root = root = tk.Tk(className="khaos-lab")
        root.title("khaos☠️lab")
        root.configure(bg=BG)
        # Start at a comfortable fraction of the actual screen instead of imposing one
        # workstation-sized box on every display. The window remains freely resizable.
        screen_w, screen_h = root.winfo_screenwidth(), root.winfo_screenheight()
        width = min(1120, max(640, int(screen_w * 0.88)))
        height = min(790, max(500, int(screen_h * 0.88)))
        root.geometry(f"{width}x{height}")
        root.minsize(min(640, max(520, screen_w - 40)), min(480, max(380, screen_h - 50)))
        self.errors = []
        root.report_callback_exception = self._on_callback_error

        self._taskbar_icon = load_image(TASKBAR_ICON_PATH)
        if self._taskbar_icon:
            root.iconphoto(True, self._taskbar_icon)
        self.f = self._make_fonts()

        self.runner = Runner()
        self.bridge = UiBridge(root)
        self.poller = Poller(root, self.bridge)
        self.cloudlab = CloudLab(self.runner)
        self._busy = set()
        self.view = None
        self.current = "Status"
        self._console_room_done = False
        self._sidebar_visible = True
        self._sidebar_auto_hidden = False
        self._is_fullscreen = False
        self._windowed_geometry = None
        self._windowed_state = None
        self._console_user_resized = False
        self._sash_dragging = False
        self.phase_name, self.phase_accent = ui.phase_info()
        self._last_ambient = None
        self._ambient_current = dict(_BASE_PALETTE)
        self.phase_lines = []

        self.content_bg = load_image(CONTENT_BG_PATH)
        self._build_header()
        self._build_panes()
        self._build_sidebar()
        self._bind_search()
        root.bind("<Configure>", self._on_root_configure, add="+")
        root.bind("<Control-f>", lambda _e: (self.search_entry.focus_set(), "break")[1])
        root.bind("<F1>", lambda _e: (self.select("Help"), "break")[1])
        root.bind("<F11>", self.toggle_fullscreen)
        root.bind("<Escape>", self.exit_fullscreen)

        gate_open, gate_detail = check_sop_gate()
        gate_text, gate_color = gate_status(gate_open, gate_detail)
        self.status_gate.configure(text=gate_text, fg=gate_color)
        self.status_phase.configure(text=f"{self.phase_name.upper()}  ·  {time.strftime('%H:%M')}")
        self.select("Status" if gate_open else "SOP")
        self._tick()
        root.after(500, self._geometry_watchdog)   # give the WM time to finish its initial placement

    # -- setup ---------------------------------------------------------------
    @staticmethod
    def _make_fonts():
        try:
            # DejaVu Sans for the title: JetBrains Mono has no glyph for the skull and Tk does no
            # per-character font fallback (it rendered blank space).
            return SimpleNamespace(
                big=tkfont.Font(family="DejaVu Sans", size=16, weight="bold"),
                identity=tkfont.Font(family="DejaVu Sans", size=9),
                label=tkfont.Font(family="DejaVu Sans", size=10, weight="bold"),
                small=tkfont.Font(family="DejaVu Sans", size=9),
                mono=tkfont.Font(family="JetBrains Mono", size=10),
                nav=tkfont.Font(family="DejaVu Sans", size=10))
        except Exception:
            d = tkfont.Font(size=10)
            return SimpleNamespace(big=d, identity=d, label=d, small=d, mono=d, nav=d)

    def _build_header(self):
        f, root = self.f, self.root
        header = tk.Frame(root, bg=BG)
        header.pack(fill="x", padx=18, pady=(12, 5))
        # Background watermark via place() so the icon/title/clock (packed normally) stack on top
        # of it and keep their own resize behaviour.
        self._header_bg = load_image(HEADER_BG_PATH)
        if self._header_bg:
            tk.Label(header, image=self._header_bg, bg=BG).place(relx=0, rely=0, relwidth=1, relheight=1)
        self._header_icon = load_image(HEADER_ICON_PATH)
        if self._header_icon:
            tk.Label(header, image=self._header_icon, bg=BG, highlightthickness=0).pack(side="left", padx=(0, 8))
        self.nav_toggle = ui.button(header, "menu", command=self.toggle_nav, font=f.small, bg=BG,
                                    fg=FG_MUTED, hover_bg=OVERLAY, hover_fg=self.phase_accent, padx=8, pady=4)
        self.nav_toggle.pack(side="left", padx=(0, 8))
        self.fullscreen_toggle = ui.button(header, "⛶  Full screen  ·  F11",
                                           command=self.toggle_fullscreen, font=f.small, bg=OVERLAY,
                                           fg=FG_MUTED, hover_bg=BG, hover_fg=self.phase_accent,
                                           padx=10, pady=5)
        self.fullscreen_toggle.pack(side="right", padx=(8, 0))
        tk.Label(header, text="khaos", font=f.big, bg=BG, fg=GOLD).pack(side="left")
        tk.Label(header, text="/", font=f.big, bg=BG, fg=FG_MUTED).pack(side="left")
        self.brand_accent = tk.Label(header, text="lab", font=f.big, bg=BG, fg=self.phase_accent)
        self.brand_accent.pack(side="left", padx=(0, 16))
        studio_link = tk.Label(header, text="kontor.studio", font=f.small, bg=BG, fg=TEAL,
                               cursor="hand2", underline=True)
        studio_link.pack(side="left")
        studio_link.bind("<Button-1>", lambda _e: webbrowser.open("https://kontor.studio"))
        studio_link.bind("<Enter>", lambda _e: studio_link.configure(fg=GOLD))
        studio_link.bind("<Leave>", lambda _e: studio_link.configure(fg=TEAL))
        self.clock_lbl = tk.Label(header, text="", font=f.small, bg=BG, fg=FG_MUTED)
        self.clock_lbl.pack(side="right")
        # The panel's palette is fixed on purpose; which Kataleya phase it is (choice/desire/
        # still-pine/nyx) is still useful at a glance, in that phase's own accent.
        self.phase_lbl = tk.Label(header, text="", font=f.small, bg=BG, fg=FG_MUTED)
        self.phase_lbl.pack(side="right", padx=(0, 14))
        # The quick-jump gets its own full-width row, leaving the brand and window controls clear.
        self.search_var = tk.StringVar()
        quickbar_shell, quickbar = ui.rounded_frame(root, BG, bg=OVERLAY, radius=20, border=BORDER)
        quickbar_shell.pack(fill="x", padx=18, pady=(0, 9))
        self.search_entry = tk.Entry(quickbar, textvariable=self.search_var, font=f.small, bg=OVERLAY,
                                     fg=FG, insertbackground=FG, relief="flat", highlightthickness=0,
                                     highlightbackground=OVERLAY, highlightcolor=GOLD)
        self.search_entry.pack(fill="x", ipady=7)
        self._placeholder = "⌕   Find a workspace or action…     Ctrl+F"
        self._ph_active = True
        self.search_entry.insert(0, self._placeholder)
        self.search_entry.configure(fg=FG_MUTED)
        self.search_entry.bind("<FocusIn>", self._search_focus_in)
        self.search_entry.bind("<FocusOut>", self._search_focus_out)
        tk.Frame(root, bg=OVERLAY, height=1).pack(fill="x", padx=18)

    def _search_focus_in(self, _e=None):
        if self._ph_active:
            self.search_entry.delete(0, "end")
            self.search_entry.configure(fg=FG)
            self._ph_active = False

    def _search_focus_out(self, _e=None):
        if not self.search_var.get().strip():
            self._ph_active = True
            self.search_entry.delete(0, "end")
            self.search_entry.insert(0, self._placeholder)
            self.search_entry.configure(fg=FG_MUTED)

    def toggle_nav(self):
        """Let the workspace reclaim width on demand; the menu stays one click away."""
        if self._sidebar_visible:
            self.body_pane.forget(self.sidebar_frame)
            self._sidebar_visible = False
        else:
            self.body_pane.add(self.sidebar_frame, before=self.content_wrap, minsize=188, width=216)
            self._sidebar_visible = True
        self._sidebar_auto_hidden = False
        if hasattr(self, "menu_access"):
            self.menu_access.configure(text="HIDE MENU" if self._sidebar_visible else "SHOW MENU")
        if hasattr(self, "nav_toggle"):
            self.nav_toggle.configure(text="menu" if self._sidebar_visible else "show menu")
        self.root.after_idle(lambda: self.refresh_scroll(self.view.frame) if self.view else None)

    def toggle_fullscreen(self, _event=None):
        """Use the whole display for the work area; F11 or Escape restores the window."""
        if not self._is_fullscreen:
            self._windowed_geometry = self.root.geometry()
            self._windowed_state = self.root.state()
            self._is_fullscreen = True
            self.root.attributes("-fullscreen", True)
            self.fullscreen_toggle.configure(text="Exit full screen  ·  Esc")
        else:
            self.exit_fullscreen()
        return "break"

    def exit_fullscreen(self, _event=None):
        if not self._is_fullscreen:
            return
        self._is_fullscreen = False
        self.root.attributes("-fullscreen", False)
        if self._windowed_geometry:
            self.root.geometry(self._windowed_geometry)
        if self._windowed_state == "zoomed":
            self.root.state("zoomed")
        self.fullscreen_toggle.configure(text="Full screen  ·  F11")
        return "break"

    def _on_root_configure(self, event):
        if event.widget is not self.root:
            return
        if self._is_fullscreen:
            self.root.after_idle(self._fit_console_pane)
            return
        # Auto-tuck navigation only at genuinely narrow widths; wide screens never get
        # an unsolicited layout change, and a manual toggle takes priority.
        if event.width < 700 and self._sidebar_visible:
            self.body_pane.forget(self.sidebar_frame)
            self._sidebar_visible = False
            self._sidebar_auto_hidden = True
            self.menu_access.configure(text="SHOW MENU")
        elif event.width > 840 and self._sidebar_auto_hidden and not self._sidebar_visible:
            self.body_pane.add(self.sidebar_frame, before=self.content_wrap, minsize=188, width=216)
            self._sidebar_visible = True
            self._sidebar_auto_hidden = False
            self.menu_access.configure(text="HIDE MENU")
        self.root.after_idle(self._fit_console_pane)

    def _build_panes(self):
        root = self.root
        # Keep both splitters as fine glass-like seams; hover supplies the accent cue.
        self.main_pane = tk.PanedWindow(root, orient="vertical", bg=BORDER, sashwidth=5,
                                        sashpad=0, sashrelief="flat", bd=0, showhandle=False,
                                        opaqueresize=True,
                                        cursor="arrow")
        self.main_pane.pack(fill="both", expand=True, padx=18, pady=(5, 0))
        body = tk.Frame(self.main_pane, bg=BG)
        self.main_pane.add(body, minsize=240, height=520)
        body_pane = self.body_pane = tk.PanedWindow(body, orient="horizontal", bg=BORDER, sashwidth=5,
                                                     sashpad=0, sashrelief="flat", bd=0, showhandle=False,
                                                     opaqueresize=True,
                                                     cursor="arrow")
        self._bind_splitter_feedback(self.main_pane, "vertical")
        self._bind_splitter_feedback(body_pane, "horizontal")
        body_pane.pack(fill="both", expand=True)
        # Canvas, not Frame, so the watermark can sit behind the nav buttons.
        self.sidebar_frame, sidebar_inner = ui.rounded_pane(body_pane, BORDER, bg=BG)
        self.sidebar_frame.configure(width=216)
        self.sidebar_frame.pack_propagate(False)
        self.sidebar = tk.Canvas(sidebar_inner, bg=BG, width=207, highlightthickness=0)
        self.sidebar_scroll = ui.PillScrollbar(sidebar_inner, orient="vertical", command=self.sidebar.yview,
                                           bg=OVERLAY, troughcolor=BG, activebackground=self.phase_accent,
                                           bd=0, highlightthickness=0, width=8)
        self.sidebar.configure(yscrollcommand=self.sidebar_scroll.set)
        self.sidebar.pack(side="left", fill="both", expand=True)
        self.sidebar_scroll.pack(side="right", fill="y")
        body_pane.add(self.sidebar_frame, minsize=188, width=216)
        self.content_wrap, content_wrap = ui.rounded_pane(body_pane, BORDER, bg=SURFACE)
        body_pane.add(self.content_wrap, minsize=300)
        self.content = tk.Canvas(content_wrap, bg=SURFACE, highlightthickness=0)
        # A real scrollbar wired to a scrollregion kept honest by the embedded widget's actual
        # required size (fixes SOC being clipped with no way to reach the bottom rows). Shown
        # only when a view actually overflows.
        self.content_scroll = ui.PillScrollbar(content_wrap, orient="vertical", command=self.content.yview, bg=OVERLAY,
                                           troughcolor=BG, activebackground=self.phase_accent,
                                           bd=0, highlightthickness=0, width=14)
        self.content.configure(yscrollcommand=self.content_scroll.set)
        self.content.pack(side="left", fill="both", expand=True, padx=(10, 0))
        if self.content_bg:
            self.content.create_image(0, 0, anchor="nw", image=self.content_bg)
        console_shell, console_frame = ui.rounded_pane(self.main_pane, BORDER, bg=BG)
        # Keep output available without letting it dominate the work area at startup.
        self.console_frame = console_shell
        self.main_pane.add(console_shell, minsize=86, height=148)
        self.console = ConsolePane(self, console_frame)
        # An always-visible operational rail makes state discoverable while moving between
        # every workspace. The nearby splitter grip above controls output height.
        self.statusbar = tk.Frame(root, bg=BG)
        self.statusbar.pack(fill="x", padx=18, pady=(5, 11))
        tk.Frame(self.statusbar, bg=self.phase_accent, width=3).pack(side="left", fill="y", padx=(0, 9))
        self.route_menu = tk.Menu(self.root, tearoff=0, bg=OVERLAY, fg=FG,
                                  activebackground=SURFACE, activeforeground=GOLD,
                                  borderwidth=0, relief="flat")
        for workspace in CATEGORIES:
            self.route_menu.add_command(label=workspace, command=lambda n=workspace: self.select(n))
        self.status_route = tk.Menubutton(self.statusbar, text="WORKSPACE  /  STATUS  ▾",
                                          font=self.f.small, bg=BG, fg=FG, activebackground=OVERLAY,
                                          activeforeground=GOLD, relief="flat", bd=0, padx=2, pady=2,
                                          cursor="hand2", menu=self.route_menu)
        self.status_route.pack(side="left")
        self.status_gate = tk.Label(self.statusbar, text="", font=self.f.small, bg=BG, fg=FG_MUTED)
        self.status_gate.pack(side="right", padx=(12, 0))
        self.status_phase = tk.Label(self.statusbar, text="", font=self.f.small, bg=BG, fg=self.phase_accent)
        self.status_phase.pack(side="right", padx=(10, 0))
        self.menu_access = ui.button(self.statusbar, "HIDE MENU", command=self.toggle_nav,
                                     font=self.f.small, bg=OVERLAY, fg=FG_MUTED,
                                     hover_bg=BG, padx=9, pady=3)
        self.menu_access.pack(side="right", padx=(10, 0))

    def _bind_splitter_feedback(self, pane, orientation):
        """Light the sash on hover and keep the pointer in its normal shape."""
        pane.bind("<Motion>", lambda event, p=pane, o=orientation: self._splitter_motion(p, o, event))
        pane.bind("<Leave>", lambda _event, p=pane: p.configure(bg=BORDER))
        if orientation == "vertical":
            pane.bind("<ButtonPress-1>", self._splitter_press)
            pane.bind("<ButtonRelease-1>", self._splitter_release)

    def _splitter_motion(self, pane, orientation, event):
        try:
            x, y = pane.sash_coord(0)
            width = int(pane.cget("sashwidth"))
            point, sash = ((event.y, y) if orientation == "vertical" else (event.x, x))
            on_sash = abs(point - sash) <= width + 3
        except (tk.TclError, TypeError):
            on_sash = False
        pane.configure(bg=self.phase_accent if on_sash else BORDER)

    def _splitter_press(self, event):
        try:
            _x, y = self.main_pane.sash_coord(0)
            self._sash_dragging = abs(event.y - y) <= int(self.main_pane.cget("sashwidth")) + 3
        except (tk.TclError, TypeError):
            self._sash_dragging = False

    def _splitter_release(self, _event):
        if self._sash_dragging:
            self._console_user_resized = True
            self._sash_dragging = False

    def _fit_console_pane(self):
        """Keep output proportional on resize until the user chooses a sash position."""
        if self._console_user_resized:
            return
        try:
            total = self.main_pane.winfo_height()
            if total <= 1:
                return
            console_h = min(250, max(110, round(total * 0.25)))
            console_h = min(console_h, max(86, total - 240))
            target_y = max(0, total - console_h)
            _x, current_y = self.main_pane.sash_coord(0)
            # Configure events can arrive in short bursts while the WM and
            # compositor settle a maximized window. Reapplying the same sash
            # position on every event made the split line shimmer and forced
            # Tk to relayout the full workspace repeatedly.
            if abs(current_y - target_y) > 2:
                self.main_pane.sash_place(0, 0, target_y)
        except tk.TclError:
            pass

    def _build_sidebar(self):
        sb = self.sidebar
        # Quiet identity header: a fine Mercury staff echoes the website SVG
        # without sitting behind labels or bringing old wallpaper into the rail.
        sb.create_line(24, 14, 24, 72, fill=self.phase_accent, width=1.6, capstyle="round")
        sb.create_line(24, 20, 12, 13, 24, 17, 36, 13, 24, 20,
                       fill=self.phase_accent, width=1.5, smooth=True, splinesteps=24)
        sb.create_line(24, 24, 12, 33, 24, 42, 36, 51, 24, 61,
                       fill=TEAL, width=1.7, smooth=True, splinesteps=28)
        sb.create_line(24, 24, 36, 33, 24, 42, 12, 51, 24, 61,
                       fill=self.phase_accent, width=1.7, smooth=True, splinesteps=28)
        sb.create_text(49, 28, anchor="w", text="khaos / lab", font=self.f.label, fill=FG)
        sb.create_text(49, 49, anchor="w", text="b6ones6aw-418☠️", font=self.f.identity, fill=FG_MUTED)
        dev_link = sb.create_text(49, 65, anchor="w", text="kwasikontor.dev",
                                  font=self.f.small, fill=TEAL, underline=True, tags=("dev_link",))
        sb.tag_bind("dev_link", "<Button-1>", lambda _e: webbrowser.open("https://kwasikontor.dev"))
        sb.tag_bind("dev_link", "<Enter>", lambda _e: (sb.itemconfigure(dev_link, fill=GOLD),
                                                          sb.configure(cursor="hand2")))
        sb.tag_bind("dev_link", "<Leave>", lambda _e: (sb.itemconfigure(dev_link, fill=TEAL),
                                                          sb.configure(cursor="arrow")))
        sb.create_line(12, 81, 202, 81, fill=BORDER, width=1)
        sb.create_text(13, 91, anchor="nw", text="WORKSPACES", font=self.f.small, fill=FG_MUTED)
        self.nav_buttons, self.nav_y = {}, {}
        self.nav_accent = sb.create_rectangle(0, 0, 0, 0, fill=GOLD, width=0)   # active-row tick
        y = 112
        for cat in CATEGORIES:
            b = ui.button(sb, cat, command=lambda c=cat: self.select(c), font=self.f.nav, bg=BG, fg=FG_MUTED,
                          hover_bg=OVERLAY, hover_fg=GOLD, padx=14, pady=6)
            b.configure(anchor="w")
            sb.create_window(10, y, anchor="nw", window=b, width=194)
            b.update_idletasks()
            self.nav_y[cat] = (y, b.winfo_reqheight())
            y += b.winfo_reqheight() + 1
            self.nav_buttons[cat] = b
            # Bound on each button (they cover most of the canvas), not bind_all: the content
            # pane's scrollable views already use bind_all for their own wheel handling.
            b.bind("<Button-4>", lambda _e: sb.yview_scroll(-1, "units"))
            b.bind("<Button-5>", lambda _e: sb.yview_scroll(1, "units"))
            b.bind("<MouseWheel>", lambda e: sb.yview_scroll(-1 if e.delta > 0 else 1, "units"))
        # Scrollable, so every category stays reachable at any window height / sash position.
        sb.configure(scrollregion=(0, 0, 216, y + 8))
        sb.bind("<Button-4>", lambda _e: sb.yview_scroll(-1, "units"))
        sb.bind("<Button-5>", lambda _e: sb.yview_scroll(1, "units"))
        sb.bind("<MouseWheel>", lambda e: sb.yview_scroll(-1 if e.delta > 0 else 1, "units"))

    def _bind_search(self):
        self.search_entry.bind("<KeyRelease>", self._do_search)
        self.search_entry.bind("<Escape>", self._clear_search)

    # -- content embedding ---------------------------------------------------
    def _set_scrollbar(self, visible):
        if visible and not self.content_scroll.winfo_ismapped():
            self.content_scroll.pack(side="right", fill="y")
        elif not visible and self.content_scroll.winfo_ismapped():
            self.content_scroll.pack_forget()

    def _on_wheel(self, evt):
        if isinstance(evt.widget, tk.Text):
            return                                     # a Text scrolls itself; don't also scroll the page
        self.content.yview_scroll(-1 if (evt.num == 4 or evt.delta > 0) else 1, "units")

    def embed(self, widget, pad=22, scrollable=False):
        # pad on all sides is also what lets the watermark show through.
        item = self.content.create_window(pad, pad, anchor="nw", window=widget)

        def resize(event):
            try:
                self.content.itemconfigure(item, width=max(event.width - 2 * pad, 1))
                if scrollable:
                    # grow to the content's real height (not forced to the viewport) so the
                    # overflow is reachable by scrolling instead of clipped
                    widget.update_idletasks()
                    req_h = max(widget.winfo_reqheight(), event.height - 2 * pad)
                    self.content.configure(scrollregion=(0, 0, event.width, req_h + 2 * pad))
                    self._set_scrollbar(req_h + 2 * pad > event.height)
                else:
                    self.content.itemconfigure(item, height=max(event.height - 2 * pad, 1))
                    self.content.configure(scrollregion=(0, 0, event.width, event.height))
                    self._set_scrollbar(False)
            except tk.TclError:
                pass                                   # widget replaced mid-resize
        self.content.bind("<Configure>", resize)
        self.content.update_idletasks()
        resize(SimpleNamespace(width=self.content.winfo_width(), height=self.content.winfo_height()))
        if scrollable:
            for seq in ("<Button-4>", "<Button-5>", "<MouseWheel>"):
                self.content.bind_all(seq, self._on_wheel)
        else:
            for seq in ("<Button-4>", "<Button-5>", "<MouseWheel>"):
                self.content.unbind_all(seq)
            self._set_scrollbar(False)

    def refresh_scroll(self, widget, pad=22):
        """Re-measure after rows are added to an already-sized canvas (a category switch doesn't
        resize anything, so <Configure> alone would never fire)."""
        try:
            widget.update_idletasks()
            w, vh = self.content.winfo_width(), self.content.winfo_height()
            req_h = max(widget.winfo_reqheight(), vh - 2 * pad)
            self.content.configure(scrollregion=(0, 0, w, req_h + 2 * pad))
            self._set_scrollbar(req_h + 2 * pad > vh)
        except tk.TclError:
            pass

    # -- routing -------------------------------------------------------------
    def select(self, name):
        self.current = name
        if hasattr(self, "status_route"):
            self.status_route.configure(text=f"WORKSPACE  /  {name.upper()}  ▾")
        for n, b in self.nav_buttons.items():
            b.set_look(bg=OVERLAY if n == name else BG,
                       fg=self.phase_accent if n == name else FG_MUTED)
        if name in self.nav_y:
            y, h = self.nav_y[name]
            self.sidebar.itemconfigure(self.nav_accent, fill=self.phase_accent)
            self.sidebar.coords(self.nav_accent, 0, y, 3, y + h)
            self.sidebar.tag_raise(self.nav_accent)
        cls = self.SPECIAL_VIEWS.get(name)
        self._show(cls(self) if cls else ActionsView(self, CATEGORIES[name]))
        self.content.yview_moveto(0)

    def _show(self, view):
        if self.view:
            self.view.destroy()
        for w in self.content.winfo_children():
            w.destroy()
        self.view = view
        view.show()

    def _do_search(self, _evt=None):
        if self._ph_active:
            return
        q = self.search_var.get().strip().lower()
        if not q:
            self.select(self.current)
            return
        for b in self.nav_buttons.values():
            b.set_look(bg=BG, fg=FG_MUTED)
        hits = [(c, a) for c, acts in CATEGORIES.items() for a in acts if q in a.label.lower()]
        self._show(ActionsView(self, [a for _, a in hits], {id(a): f"{c} — " for c, a in hits},
                               empty_text=f"no actions match '{q}'"))

    def _clear_search(self, _evt=None):
        self.search_var.set("")
        self.select(self.current)
        self.root.focus_set()

    # -- running things ------------------------------------------------------
    def bg(self, work, done):
        """Run work() in a thread, then done(result) on the main thread."""
        def worker():
            try:
                res, err = work(), None
            except Exception:
                res, err = None, sys.exc_info()
            if err:
                self.bridge.post(lambda: self.root.report_callback_exception(*err))
            else:
                self.bridge.post(done, res)
        threading.Thread(target=worker, daemon=True).start()

    def ensure_console_room(self):
        """Fit the shared output area before writing the first command line."""
        if self._console_room_done:
            return
        self.root.update_idletasks()
        if self.main_pane.winfo_height() <= 1:
            return
        self._console_room_done = True
        self._fit_console_pane()

    def run_async(self, cmd, timeout=30, on_done=None, on_result=None):
        if not self.require_ops_gate(cmd):
            return
        # Ignore a repeat while the identical command is still running: a double-click used to run
        # a mutating action twice (`gvm cloud-start` bills).
        if cmd in self._busy:
            self.console.log(f"(already running — ignoring repeat: {cmd})", GOLD)
            return
        self._busy.add(cmd)
        self.ensure_console_room()
        self.console.log(f"$ {cmd}", TEAL)

        def done(res):
            ok, out = res
            self._busy.discard(cmd)
            waiting = not ok and "Policy not yet acknowledged." in (out or "")
            if out:
                self.console.log(out, FG if ok else GOLD if waiting else ROSE)
            self.console.log("[review required · no task logged yet]" if waiting else
                             f"[{'ok' if ok else 'failed'}]",
                             GOLD if waiting else PINE if ok else ROSE)
            if on_result:
                on_result(res)
            if on_done:
                on_done()
            if isinstance(self.view, StatusView) and self.view.alive():
                self.view.refresh()
        self.bg(lambda: self.runner.run(cmd, timeout=timeout), done)

    def run_action(self, a):
        if not self.require_ops_gate(a.cmd):
            return
        if a.detach:
            self.ensure_console_room()
            self.console.log(f"$ {a.cmd}  (opens its own window)", TEAL)
            ok, msg = self.runner.detach(a.cmd)
            self.console.log(f"[{'ok' if ok else 'failed'}] {msg}", PINE if ok else ROSE)
        elif ConfirmPolicy.required(a):
            d = Dialog(self, "confirm")
            d.label(f"run: {a.label}?")
            d.label(a.cmd, fg=FG_MUTED, font=self.f.small, wrap=420, pady=(0, 14))
            d.win.bind("<y>", lambda _e: (d.close(), self.run_async(a.cmd, a.timeout)))
            d.buttons([("yes, run it", ROSE, lambda: self.run_async(a.cmd, a.timeout)), ("cancel", FG_MUTED, None)])
        else:
            self.run_async(a.cmd, a.timeout)

    def require_ops_gate(self, cmd):
        """Fail closed for panel operations; leave only SOP recovery actions available."""
        if panel_preflight_command(cmd):
            return True
        ok, detail = check_sop_gate()
        if panel_command_allowed(cmd, ok):
            if hasattr(self, "status_gate"):
                if ok:
                    text, color = gate_status(ok, detail)
                else:
                    text, color = "SOP GATE  ·  RECOVERY", GOLD
                self.status_gate.configure(text=text, fg=color)
            return True
        if hasattr(self, "status_gate"):
            self.status_gate.configure(text="SOP GATE  ·  LOCKED", fg=ROSE)
        self.console.log("⛔ BLOCKED — operations are locked until this session satisfies the SOP gate.", ROSE)
        try:
            words = shlex.split(cmd)
            tool = os.path.basename(words[0]) if words else "unknown"
            subprocess.run(["arc-sop", "record-violation", "pre-ack-panel-operation", tool],
                           capture_output=True, timeout=5, check=False)
        except Exception:
            pass
        if detail:
            self.console.log(detail, GOLD)
        self.console.log("Read GAMEPLAN.md, all of SOT.md, and every MO in MO.md under ~/dev-notes/intel-ops. Use batcat or cat with each full path; then explicitly accept before operating.", FG_MUTED)
        if self.current != "SOP":
            self.select("SOP")
        return False

    # -- periodic loops ------------------------------------------------------
    def _tick(self):
        self.root.after(1000, self._tick)              # schedule first: one bad tick can't end the clock
        if (not getattr(self, "_gate_refresh_pending", False)
                and time.monotonic() - getattr(self, "_gate_checked_at", 0) >= 5):
            self._gate_refresh_pending = True
            threading.Thread(target=self._refresh_gate_worker, daemon=True).start()
        try:
            self.clock_lbl.configure(text=time.strftime("%H:%M:%S"))
            name, color = ui.phase_info()
            minute = int(time.time() // 60)
            if minute != self._last_ambient:
                self._last_ambient = minute
                self._apply_circadian_ambient()
            if name != self.phase_name or color != self.phase_accent:
                self.phase_name, self.phase_accent = name, color
                self.phase_lbl.configure(text=f"◐ {name}", fg=color)
                self.brand_accent.configure(fg=color)
                self.search_entry.configure(highlightcolor=color)
                self.nav_toggle.configure(hover_fg=color)
                live_lines = []
                for line in self.phase_lines:
                    try:
                        if line.winfo_exists():
                            line.configure(bg=color)
                            live_lines.append(line)
                    except tk.TclError:
                        pass
                self.phase_lines = live_lines
                if self.current in self.nav_buttons:
                    self.nav_buttons[self.current].set_look(bg=OVERLAY, fg=color)
                if self.current in self.nav_y:
                    y, h = self.nav_y[self.current]
                    self.sidebar.itemconfigure(self.nav_accent, fill=color)
                    self.sidebar.coords(self.nav_accent, 0, y, 3, y + h)
                if hasattr(self, "status_phase"):
                    self.status_phase.configure(text=f"{name.upper()}  ·  {time.strftime('%H:%M')}", fg=color)
                    self.statusbar.winfo_children()[0].configure(bg=color)
            self.runner.reap()
        except Exception:
            self.root.report_callback_exception(*sys.exc_info())

    def _refresh_gate_worker(self):
        ok, detail = check_sop_gate()
        self.bridge.post(self._apply_gate_status, ok, detail)

    def _apply_gate_status(self, ok, detail):
        self._gate_refresh_pending = False
        self._gate_checked_at = time.monotonic()
        if not self.root.winfo_exists():
            return
        text, color = gate_status(ok, detail)
        self.status_gate.configure(text=text, fg=color)
        if isinstance(self.view, SopView) and self.view.alive():
            bypass = ok and 'owner bypass active' in str(detail).lower()
            self.view.gate_label.configure(text="OWNER BYPASS ACTIVE" if bypass else
                                           "OPERATIONS OPEN" if ok else "OPERATIONS LOCKED",
                                           fg=GOLD if bypass else TEAL if ok else ROSE)
            self.view.detail_label.configure(text=detail or ("This session is cleared." if ok else
                                                               "Read the current plan, then log and acknowledge."))

    def _apply_circadian_ambient(self):
        """Recolor the live workspace from Kataleya's shared time palette.

        Functional colors stay steady; only ambient roles drift. Applying one
        role map recursively prevents old and new routes from mixing palettes.
        """
        ambient = ui.circadian()
        global BG, SURFACE, OVERLAY, BORDER, FG, FG_MUTED
        palette = {
            "BG": ambient["bg"], "SURFACE": ambient["surface"],
            "OVERLAY": ambient["overlay"],
            "BORDER": ui._lerp_hex(ambient["surface"], ambient["fg_muted"], 0.32),
            "FG": ambient["fg"], "FG_MUTED": ambient["fg_muted"],
        }
        role_map = {_BASE_PALETTE[key]: value for key, value in palette.items()}
        role_map.update({self._ambient_current[key]: value for key, value in palette.items()})
        self._ambient_current = palette
        globals().update(palette)
        self.root.configure(bg=BG)

        def repaint(widget):
            for option in ("background", "foreground", "insertbackground", "highlightbackground",
                           "highlightcolor", "activebackground", "activeforeground", "selectbackground",
                           "troughcolor"):
                try:
                    value = widget.cget(option)
                    if value in role_map:
                        widget.configure(**{option: role_map[value]})
                except (tk.TclError, TypeError):
                    pass
            try:
                for child in widget.winfo_children():
                    repaint(child)
            except tk.TclError:
                pass
        repaint(self.root)

    def _geometry_watchdog(self):
        """Keep the window inside the real usable desktop area (`_NET_WORKAREA`, what the WM itself
        publishes -- not a guessed panel size). A forced position once put the bottom edge under
        the taskbar and silently hid the last widget. The xprop call runs off the UI thread."""
        self.root.after(10000, self._geometry_watchdog)
        if self._is_fullscreen:
            return
        self.bg(lambda: self.runner.run("xprop -root _NET_WORKAREA", timeout=3), self._apply_workarea)

    def _apply_workarea(self, res):
        ok, out = res
        nums = [int(n) for n in re.findall(r"-?\d+", out)] if ok and out else []
        if len(nums) < 4:
            return
        wx, wy, ww, wh = nums[:4]
        r = self.root
        r.update_idletasks()
        x, y, w, h = r.winfo_x(), r.winfo_y(), r.winfo_width(), r.winfo_height()
        nx = wx if x < wx else max(wx, wx + ww - w) if x + w > wx + ww else x
        ny = wy if y < wy else max(wy, wy + wh - h) if y + h > wy + wh else y
        if (nx, ny) != (x, y):
            r.geometry(f"+{nx}+{ny}")

    def _on_callback_error(self, exc, val, tb):
        self.errors.append("".join(traceback.format_exception(exc, val, tb)))
        traceback.print_exception(exc, val, tb)

    # -- lifecycle -----------------------------------------------------------
    def run(self):
        self.root.mainloop()

    def _pump(self, seconds):
        end = time.time() + seconds
        while time.time() < end:
            self.root.update()
            time.sleep(0.02)

    def selftest(self):
        """Open every view (and the global search), let their poll jobs run, and check nothing
        raised in a Tk callback and no poll job outlived its view."""
        print("khaos-lab selftest")
        for name in CATEGORIES:
            self.select(name)
            self._pump(1.2 if name in ("Status", "Cockpit", "Inventory") else 0.25)
            print(f"  view {name:<14} ok  (poll jobs: {', '.join(self.poller.active()) or 'none'})")
        self._ph_active = False
        for q in ("vpn", "zzz-no-such-action"):
            self.search_var.set(q)
            self._do_search()
            self._pump(0.2)
        print("  global search            ok")
        self.select("Network")
        action_view = self.view
        if isinstance(action_view, ActionsView) and hasattr(action_view, "filter_var"):
            action_view.filter_var.set("vpn")
            filtered = sum(row.winfo_manager() == "pack" for row, _ in action_view.rows)
            action_view.filter_var.set("")
            filter_ok = filtered > 0 and filtered < len(action_view.rows)
        else:
            filter_ok = False
        self.select("Status")
        layouts = []
        if isinstance(self.view, TileView):
            for width, expected in ((400, 1), (760, 2), (1100, 3)):
                self.view._layout_tiles(SimpleNamespace(width=width))
                cols = max((w.grid_info().get("column", 0) for w in self.view._tile_frames), default=0) + 1
                layouts.append(cols == expected)
        self._on_root_configure(SimpleNamespace(widget=self.root, width=650))
        nav_narrow = not self._sidebar_visible and self._sidebar_auto_hidden
        self._on_root_configure(SimpleNamespace(widget=self.root, width=900))
        nav_wide = self._sidebar_visible and not self._sidebar_auto_hidden
        print(f"  responsive tile layouts  {'ok' if all(layouts) else 'FAILED'} ({layouts})")
        print(f"  workspace filter         {'ok' if filter_ok else 'FAILED'}")
        print(f"  adaptive navigation      {'ok' if nav_narrow and nav_wide else 'FAILED'}")
        self.select("Status")
        self.toggle_nav()
        self.route_menu.invoke(list(CATEGORIES).index("Phone"))
        route_picker_ok = self.current == "Phone" and not self._sidebar_visible
        self.route_menu.invoke(list(CATEGORIES).index("Status"))
        route_picker_ok = route_picker_ok and self.current == "Status" and not self._sidebar_visible
        self.toggle_nav()
        fullscreen_ok = False
        try:
            self.toggle_fullscreen()
            self.root.update_idletasks()
            entered = self._is_fullscreen and self.fullscreen_toggle.cget("text").startswith("Exit full screen")
            self.exit_fullscreen()
            self.root.update_idletasks()
            fullscreen_ok = entered and not self._is_fullscreen and self.fullscreen_toggle.cget("text").startswith("Full screen")
        except tk.TclError:
            self.exit_fullscreen()
        print(f"  hidden-menu workspace jump {'ok' if route_picker_ok else 'FAILED'}")
        print(f"  full-screen enter/restore  {'ok' if fullscreen_ok else 'FAILED'}")
        wired = {category: {a.label for a in CATEGORIES.get(category, [])}
                 for category in ("Phone", "Waydroid", "Studio")}
        waydroid_launcher = shutil.which("arc-waydroid")
        waydroid_source = Path(waydroid_launcher).read_text(errors="replace") if waydroid_launcher else ""
        waydroid_manual_lock = (
            '"/usr/bin/systemctl", "unmask", UNIT' in waydroid_source
            and '"/usr/bin/systemctl", "mask", UNIT' in waydroid_source
        )
        integration_ok = (
            {"UAD-ng: launch (multi-device GUI)"} <= wired["Phone"]
            and {"ADB: connect Waydroid (then manage under Phone)",
                 "Android: open (starts Waydroid + X11 display if needed)",
                 "Android: restart session"} <= wired["Waydroid"]
            and waydroid_manual_lock
            and {"LMMS: launch music studio", "LMMS: open Reborn practice beat",
                 "Audacity: launch audio editor", "Mixxx: launch DJ decks",
                 "Markdown: launch ReText", "Guide: Reborn beat baby steps",
                 "Guide: studio quick start",
                 "Template: event cue sheet", "Tutorial: Audacity recording and editing",
                 "Guide: Mixxx hardware and headphone cueing", "iPhone: GarageBand for iOS",
                 "Reference: Lorde — Hammer",
                 "Tutorial: Reborn beat-making video"} <= wired["Studio"]
            and all(shutil.which(cmd) for cmd in ("arc", "arc-sop", "arc-waydroid", "adb", "uad-ng", "flatpak"))
            and (HOME / "khaos-lab/4dev-studio18/ref/Reborn_Practice_Beat.mmp").is_file()
            and (HOME / "khaos-lab/4dev-studio18/ref/Reborn_LMMS_Baby_Steps.md").is_file()
            and (STUDIO_DOC_DIR / "quick-start.md").is_file()
            and (STUDIO_DOC_DIR / "event-cue-sheet-template.md").is_file()
            and all(shutil.which(cmd) for cmd in ("mixxx", "retext"))
        )
        print(f"  program/project wiring   {'ok' if integration_ok else 'FAILED'} "
              "(Arc SOP · Waydroid manual-start lock/ADB/UAD · LMMS/Audacity/Mixxx/ReText + studio assets)")
        self.select("Personal")
        self._pump(0.3)
        leaked = self.poller.active()
        print(f"  poll jobs after leaving polled views: {leaked or 'none (no leak)'}")
        ov = ConfirmPolicy.overrides(CATEGORIES)
        print(f"  confirm-policy overrides (each must have a stated reason): {[o[1] for o in ov]}")
        gate_cases = (
            ("arc inv scan", False, False),
            ("arc inv scan", True, True),
            ("arc sop start 'test task'", False, True),
            ("arc sop check", False, True),
            ("arc sop baseline", False, False),
            ("arc sop start 'task' && arc clean", False, False),
        )
        gate_ok = all(panel_command_allowed(cmd, opened) == expected
                      for cmd, opened, expected in gate_cases)
        original_gate = globals()["check_sop_gate"]
        original_subprocess_run = subprocess.run
        blocked_logs, launches = [], []
        blocked_events = []
        fake = SimpleNamespace(current="Status", _busy=set(),
                               console=SimpleNamespace(log=lambda text, _color=None: blocked_logs.append(text)),
                               select=lambda name: setattr(fake, "current", name),
                               ensure_console_room=lambda: None,
                               bg=lambda _work, _done: launches.append("launched"))
        fake.require_ops_gate = lambda cmd: App.require_ops_gate(fake, cmd)
        globals()["check_sop_gate"] = lambda timeout=5: (False, "gate NOT satisfied (selftest)")
        def record_test_denial(argv, *args, **kwargs):
            # Exercise the real gate path without adding test-only denials to
            # the user's compliance ledger.
            if isinstance(argv, (list, tuple)) and list(argv[:2]) == ["arc-sop", "record-violation"]:
                blocked_events.append(tuple(argv))
                return SimpleNamespace(returncode=0, stdout="", stderr="")
            return original_subprocess_run(argv, *args, **kwargs)
        subprocess.run = record_test_denial
        try:
            App.run_async(fake, "arc inv scan")
            locked_action_blocked = not launches and fake.current == "SOP"
            App.run_action(fake, Action("test operation", "arc inv scan"))
            locked_button_blocked = not launches
            App.run_async(fake, "arc sop start 'selftest task'")
            recovery_action_available = len(launches) == 1
        finally:
            globals()["check_sop_gate"] = original_gate
            subprocess.run = original_subprocess_run
        gate_ok = (gate_ok and locked_action_blocked and locked_button_blocked
                   and recovery_action_available and len(blocked_events) == 2)
        print(f"  SOP operation gate        {'ok' if gate_ok else 'FAILED'} (locked ops denied; setup retained)")
        bad = (self.errors or leaked or not gate_ok or not filter_ok or not all(layouts)
               or not route_picker_ok or not fullscreen_ok
               or not (nav_narrow and nav_wide) or not integration_ok)
        print("  " + ("FAILED" if bad else "all views built with no callback errors"))
        for e in self.errors:
            print(e)
        self.root.destroy()
        return 1 if bad else 0


def main(argv):
    app = App()
    if "--selftest" in argv:
        sys.exit(app.selftest())
    app.run()


if __name__ == "__main__":
    main(sys.argv[1:])
