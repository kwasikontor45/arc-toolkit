#!/usr/bin/env python3
"""
arc-site-server -- private, tailnet-only host for the notes site (`arc site`).

Built 2026-09-19 to get the site off the USB vault. The site is a folder of
static HTML (built by build-notes-site into ~/khaos-lab/notes-site); this is
the only thing that ever serves it. Design goal: only the owner can reach it
and only the owner knows where it is -- layered so that no single mistake
exposes it ("a safe in a safe in a safe"):

  1. NETWORK    binds 127.0.0.1 only. Nothing on the LAN/WAN can connect.
                The only way in from another device is `tailscale serve`
                (tailnet-only, HTTP over WireGuard) -- never Funnel.
  2. IDENTITY   tailscale serve stamps each proxied request with the caller's
                Tailscale-User-Login. Anything but the owner's login is refused.
                A request that looks proxied but carries no identity (Funnel,
                a tagged/shared node, any other proxy) is refused, fail closed.
  3. SECRET     every URL must start with a long random token
                (~/.config/arc/site-token, 0600). Wrong/missing token, wrong
                method, bad path, wrong Host: byte-identical 404, after a short
                delay. Nothing distinguishes "exists" from "doesn't".
  4. CONTENT    static files only, GET/HEAD only, no directory listings, path
                confined to the site root (symlinks resolved), no-store cache,
                noindex, strict CSP (inline script allowed, but it can't load
                or send anything: connect-src/default-src 'none').
  5. PROCESS    runs as a sandboxed systemd user unit (see notes-site.service).

The token is never logged or printed except by `arc-site-server url`, which
refuses to run unless stdout is a real terminal (so it can't leak into a pipe,
a log, or an agent transcript). Nothing that carries the token is ever written
to a tracked or backed-up file.

Usage:  arc-site-server            serve (default; run by systemd)
        arc-site-server init       create token + owner login (once)
        arc-site-server rotate     new token; the old URL dies immediately
        arc-site-server url        show the private URLs (terminal only)
        arc-site-server open       open the local URL in this machine's browser
        arc-site-server audit      probe every layer above; exit 1 on any FAIL
"""

import hmac
import http.client
import http.server
import json
import mimetypes
import os
import secrets
import socketserver
import subprocess
import sys
import time
from pathlib import Path
from urllib.parse import unquote

HOST = "127.0.0.1"
PORT = 8642
ROOT = Path.home() / "khaos-lab" / "notes-site"
CONF_DIR = Path.home() / ".config" / "arc"
TOKEN_FILE = CONF_DIR / "site-token"
LOGIN_FILE = CONF_DIR / "site-allowed-login"
TS_HTTP_PORT = 80   # what `tailscale serve --http` exposes on the tailnet

SECURITY_HEADERS = {
    "Cache-Control": "no-store",
    "X-Robots-Tag": "noindex, nofollow, noarchive, nosnippet",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "no-referrer",
    "X-Frame-Options": "DENY",
    "Cross-Origin-Opener-Policy": "same-origin",
    "Cross-Origin-Resource-Policy": "same-origin",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
    "Content-Security-Policy": (
        "default-src 'none'; script-src 'unsafe-inline'; style-src 'self' 'unsafe-inline'; "
        "img-src 'self' data:; font-src 'self'; connect-src 'none'; base-uri 'none'; "
        "form-action 'none'; frame-ancestors 'none'"
    ),
}
DENY_BODY = b"Not Found"


# ── secrets & identity ───────────────────────────────────────────────────────
class Secrets:
    """Owns the token + owner login. Files must be private (0600) or the
    server refuses to start -- fail closed. Re-read on change, so `rotate`
    takes effect on the very next request with no restart."""

    def __init__(self):
        self._cache = {}

    def _read(self, path, min_len):
        st = path.stat()
        if st.st_mode & 0o077:
            raise PermissionError(f"{path} is group/world-accessible (must be 0600)")
        key = (str(path), st.st_mtime_ns)
        if key not in self._cache:
            value = path.read_text().strip()
            if len(value) < min_len:
                raise ValueError(f"{path} is too short")
            self._cache = {key: value}
        return self._cache[key]

    def token(self):
        return self._read(TOKEN_FILE, 32)

    def owner_login(self):
        return self._read(LOGIN_FILE, 3).lower()

    @staticmethod
    def _write_private(path, value):
        CONF_DIR.mkdir(parents=True, exist_ok=True)
        tmp = path.with_suffix(".tmp")
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(value + "\n")
        os.replace(tmp, path)
        os.chmod(path, 0o600)

    @classmethod
    def new_token(cls):
        cls._write_private(TOKEN_FILE, secrets.token_urlsafe(32))

    @classmethod
    def set_owner(cls, login):
        cls._write_private(LOGIN_FILE, login)


class Tailnet:
    """Thin read-only view of `tailscale`: who am I, what's my name, what's
    exposed. Everything here is a subprocess call; nothing is cached."""

    @staticmethod
    def _run(*args):
        try:
            r = subprocess.run(["tailscale", *args], capture_output=True, text=True, timeout=8)
            return r.stdout
        except Exception:
            return ""

    @classmethod
    def status(cls):
        try:
            return json.loads(cls._run("status", "--json"))
        except Exception:
            return {}

    @classmethod
    def me(cls):
        st = cls.status()
        self_ = st.get("Self", {})
        user = st.get("User", {}).get(str(self_.get("UserID")), {})
        return {
            "login": user.get("LoginName", ""),
            "dns": (self_.get("DNSName") or "").rstrip("."),
            "ip": (self_.get("TailscaleIPs") or [""])[0],
            "peers": [(p.get("HostName", "").strip(), p.get("OS", ""), p.get("Online", False))
                      for p in (st.get("Peer") or {}).values()],
        }

    @classmethod
    def serve_json(cls):
        try:
            return json.loads(cls._run("serve", "status", "--json") or "{}")
        except Exception:
            return {}

    @classmethod
    def funnel_on(cls):
        cfg = cls.serve_json()
        allow = cfg.get("AllowFunnel") or {}
        return any(allow.values())


# ── the guard ────────────────────────────────────────────────────────────────
class Guard:
    """Decides, from a request alone, whether it may be answered, and if so
    which file. Pure logic (no I/O beyond the Secrets files) so the auditor
    can exercise it exactly like a real request."""

    LOCAL_HOSTS = {f"127.0.0.1:{PORT}", f"localhost:{PORT}"}

    def __init__(self, secrets_):
        self.secrets = secrets_

    def authorize(self, method, raw_path, headers, peer_ip):
        """Returns the relative path under ROOT to serve, or None to deny."""
        try:
            token = self.secrets.token()
            owner = self.secrets.owner_login()
        except Exception:
            return None                                   # can't read secrets -> serve nothing
        if method not in ("GET", "HEAD"):
            return None
        if peer_ip not in ("127.0.0.1", "::1"):
            return None                                   # tailscale serve connects from loopback
        if len(raw_path) > 512 or "\x00" in raw_path or "\\" in raw_path:
            return None
        if not self._identity_ok(headers, owner):
            return None
        path = unquote(raw_path.split("?", 1)[0].split("#", 1)[0])
        parts = [p for p in path.split("/") if p not in ("", ".")]
        if not parts or ".." in parts:
            return None
        if not hmac.compare_digest(parts[0].encode(), token.encode()):
            return None
        return "/".join(parts[1:])

    def _identity_ok(self, headers, owner):
        login = headers.get("Tailscale-User-Login")
        proxied = any(k.lower().startswith(("x-forwarded-", "tailscale-")) for k in headers.keys())
        if login is not None:
            return login.strip().lower() == owner          # via tailscale serve: must be the owner
        if proxied:
            return False                                   # proxied but no identity (Funnel/tagged/other)
        return headers.get("Host", "") in self.LOCAL_HOSTS  # direct local use only


class Handler(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.0"
    timeout = 10

    def version_string(self):
        return "site"

    def log_message(self, fmt, *args):     # never let the token reach the journal
        pass

    def log_request(self, code="-", size="-"):
        line = f"{self.command} {self.path} -> {code}"
        try:
            line = line.replace(self.server.secrets.token(), "•••")
        except Exception:
            line = f"{self.command} <path hidden> -> {code}"
        sys.stderr.write(line + "\n")

    def _headers(self):
        for k, v in SECURITY_HEADERS.items():
            self.send_header(k, v)

    def _deny(self, head_only=False):
        time.sleep(0.25)                   # slow any probing; identical for every failure
        self.send_response(404, "Not Found")
        self.send_header("Content-Type", "text/plain; charset=utf-8")
        self.send_header("Content-Length", str(len(DENY_BODY)))
        self._headers()
        self.end_headers()
        if not head_only:
            self.wfile.write(DENY_BODY)

    def _serve(self, head_only):
        rel = self.server.guard.authorize(self.command, self.path, self.headers, self.client_address[0])
        if rel is None:
            return self._deny(head_only)
        root = os.path.realpath(ROOT)
        target = os.path.realpath(os.path.join(root, rel))
        if target != root and not target.startswith(root + os.sep):
            return self._deny(head_only)
        if os.path.isdir(target):
            target = os.path.join(target, "index.html")
        if not os.path.isfile(target):
            return self._deny(head_only)
        ctype = mimetypes.guess_type(target)[0] or "application/octet-stream"
        if ctype.startswith("text/") or ctype in ("application/javascript", "application/json"):
            ctype += "; charset=utf-8"
        size = os.path.getsize(target)
        self.send_response(200)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(size))
        self._headers()
        self.end_headers()
        if not head_only:
            with open(target, "rb") as f:
                self.wfile.write(f.read())

    def do_GET(self):
        self._serve(False)

    def do_HEAD(self):
        self._serve(True)

    def do_POST(self):
        self._deny()

    do_PUT = do_DELETE = do_PATCH = do_OPTIONS = do_POST


class SiteServer(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True
    allow_reuse_address = True

    def __init__(self):
        super().__init__((HOST, PORT), Handler)
        self.secrets = Secrets()
        self.guard = Guard(self.secrets)


# ── audit ─────────────────────────────────────────────────────────────────────
class Auditor:
    """Exercises every layer against the running server exactly as a client
    would. The token is read from disk for the probes and never printed."""

    def __init__(self):
        self.results = []
        self.s = Secrets()

    def ok(self, cond, label, detail=""):
        self.results.append((bool(cond), label, detail))

    def _get(self, path, headers=None, method="GET", host=None):
        conn = http.client.HTTPConnection(HOST, PORT, timeout=8)
        h = {"Host": host or f"{HOST}:{PORT}"}
        h.update(headers or {})
        conn.request(method, path, headers=h)
        r = conn.getresponse()
        body = r.read()
        hdrs = {k.lower(): v for k, v in r.getheaders()}
        conn.close()
        return r.status, hdrs, body

    def run(self):
        # 1 secrets
        try:
            token = self.s.token()
            login = self.s.owner_login()
            self.ok(True, "token file private (0600), long enough", f"{len(token)} chars")
            self.ok(bool(login), "owner login recorded", "")
        except Exception as e:
            self.ok(False, "secrets", str(e))
            return self.results
        me = Tailnet.me()
        self.ok(login == me["login"].lower(), "owner login matches this node's tailnet login", "")

        # 2 network
        ss = subprocess.run(["ss", "-tlnH", f"sport = :{PORT}"], capture_output=True, text=True).stdout
        addrs = [l.split()[3] for l in ss.splitlines() if l.strip()]
        self.ok(bool(addrs) and all(a.startswith("127.0.0.1:") for a in addrs), "listens on 127.0.0.1 only", ", ".join(addrs) or "not listening")
        self.ok(not Tailnet.funnel_on(), "Tailscale Funnel (public internet) is OFF", "")
        srv = Tailnet.serve_json()
        web = (srv.get("Web") or {})
        tcp = (srv.get("TCP") or {})
        exposed = bool(web or tcp)
        if exposed:
            handlers = [h.get("Proxy", "") for w in web.values() for h in (w.get("Handlers") or {}).values()]
            self.ok(all(p.rstrip("/") == f"http://127.0.0.1:{PORT}" for p in handlers) and len(web) == 1,
                    "tailnet exposure is exactly one HTTP mapping -> loopback", ", ".join(web.keys()))
            if me["ip"] and me["dns"]:
                # the real path: tailnet IP -> tailscaled serve -> identity header -> guard
                def via_serve(path):
                    c = http.client.HTTPConnection(me["ip"], TS_HTTP_PORT, timeout=8)
                    c.request("GET", path, headers={"Host": me["dns"]})
                    st = c.getresponse().status
                    c.close()
                    return st
                try:
                    self.ok(via_serve(f"/{token}/") == 200, "REAL PATH via tailscale serve, owner + token -> 200", "")
                    self.ok(via_serve("/") == 404, "REAL PATH via tailscale serve, no token -> 404", "")
                except Exception as e:
                    self.ok(False, "real path via tailscale serve reachable", str(e))
        else:
            self.results.append((True, "not exposed on the tailnet yet (local only)", "run: arc site expose"))

        # 3 content location
        self.ok(ROOT.is_dir() and (ROOT / "index.html").exists(), "site built", str(ROOT))
        self.ok(not str(ROOT.resolve()).startswith("/mnt"), "site is off the USB (local disk)", "")

        # 4 behavior probes
        base = f"/{token}/"
        s, h, _ = self._get(base)
        self.ok(s == 200, "valid token, local direct -> 200", str(s))
        for k in ("content-security-policy", "x-robots-tag", "cache-control", "x-content-type-options", "referrer-policy"):
            self.ok(k in h, f"header present: {k}", "")
        s404, _, b404 = self._get("/nope/")
        probes = {
            "no token": self._get("/"),
            "wrong token": self._get("/" + "x" * len(token) + "/"),
            "token, wrong Host header": self._get(base, host="evil.example"),
            "token, wrong owner login": self._get(base, {"Tailscale-User-Login": "intruder@example.com"}),
            "token, proxied w/o identity (Funnel-like)": self._get(base, {"X-Forwarded-For": "203.0.113.5"}),
            "POST": self._get(base, method="POST"),
            "path traversal": self._get(f"/{token}/../../../../etc/passwd"),
            "encoded traversal": self._get(f"/{token}/%2e%2e/%2e%2e/etc/passwd"),
        }
        for name, (st, _, body) in probes.items():
            self.ok(st == 404 and body == DENY_BODY, f"refused (uniform 404): {name}", str(st))
        st, _, _ = self._get(base, {"Tailscale-User-Login": login, "X-Forwarded-For": "100.64.0.9"}, host=me["dns"] or "x")
        self.ok(st == 200, "owner via tailscale-serve-style request -> 200", str(st))
        st, _, body = self._get(f"/{token}/notes/")
        self.ok(st == 404, "no directory listing", str(st))

        # 5 process
        r = subprocess.run(["systemctl", "--user", "show", "notes-site", "-p", "NoNewPrivileges,ProtectSystem,PrivateTmp,ActiveState"],
                           capture_output=True, text=True).stdout
        self.ok("ActiveState=active" in r, "systemd unit active", "")
        self.ok("NoNewPrivileges=yes" in r and "ProtectSystem=strict" in r and "PrivateTmp=yes" in r, "unit sandbox in effect", "")
        return self.results


# ── commands ─────────────────────────────────────────────────────────────────
def cmd_init():
    if TOKEN_FILE.exists() or LOGIN_FILE.exists():
        print("already initialised (use `rotate` for a new token)")
        return 1
    me = Tailnet.me()
    if not me["login"]:
        print("could not read this node's Tailscale login -- is tailscaled up?")
        return 1
    Secrets.new_token()
    Secrets.set_owner(me["login"])
    print(f"created {TOKEN_FILE} and {LOGIN_FILE} (0600); owner = {me['login']}")
    return 0


def cmd_rotate():
    if not TOKEN_FILE.exists():
        print("not initialised -- run `init` first")
        return 1
    Secrets.new_token()
    print("token rotated -- every previously-shared URL is dead now. run `arc site url` in your own terminal.")
    return 0


def cmd_url():
    if not sys.stdout.isatty():
        print("refusing: stdout is not a terminal. Run `arc site url` yourself in a terminal so the")
        print("private URL never lands in a pipe, log, or transcript.")
        return 2
    token = Secrets().token()
    me = Tailnet.me()
    print("\n  Private URLs -- keep them to yourself. Work only from devices signed into your tailnet as")
    print(f"  {me['login']}, and only while this PC is on.\n")
    if me["dns"]:
        print(f"    http://{me['dns']}/{token}/")
        print("\n  (use the NAME, not the 100.x IP -- tailscale serve matches on hostname and 404s an IP.")
        print("   the name resolves on your phone via the Tailscale app's MagicDNS; on this PC it")
        print("   doesn't, because Tailscale DNS is off here so it can't fight NextDNS -- use `arc site open`.)")
    print(f"\n  on this PC:  http://{HOST}:{PORT}/{token}/   (or: arc site open)")
    peers = [f"{n} ({o}) {'online' if on else 'OFFLINE'}" for n, o, on in me["peers"]]
    print("\n  devices on your tailnet: " + (", ".join(peers) or "none besides this PC"))
    print()
    return 0


def cmd_open():
    token = Secrets().token()
    subprocess.Popen(["xdg-open", f"http://{HOST}:{PORT}/{token}/"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    print("opened in your browser (local, loopback)")
    return 0


def cmd_audit():
    results = Auditor().run()
    bad = 0
    for ok, label, detail in results:
        print(f"  {'PASS' if ok else 'FAIL'}  {label}" + (f"  [{detail}]" if detail and not ok else ""))
        bad += 0 if ok else 1
    print(f"\n  {len(results) - bad}/{len(results)} checks passed" + ("" if not bad else f" -- {bad} FAILED"))
    return 1 if bad else 0


def cmd_serve():
    Secrets().token()          # fail loudly at startup if not initialised / not private
    Secrets().owner_login()
    srv = SiteServer()
    sys.stderr.write(f"arc-site-server: serving {ROOT} on {HOST}:{PORT} (loopback only)\n")
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else "serve"
    handlers = {"serve": cmd_serve, "init": cmd_init, "rotate": cmd_rotate, "url": cmd_url,
                "open": cmd_open, "audit": cmd_audit}
    if cmd not in handlers:
        print(__doc__)
        sys.exit(2)
    sys.exit(handlers[cmd]())
