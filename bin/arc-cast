#!/usr/bin/env python3
"""Small, read-only Google Cast discovery and Chromium launcher for Linux."""

import shutil
import subprocess
import sys
from pathlib import Path


TV_GUIDE = (Path.home() / "khaos-lab" / "local-cloud-hub" / "personal-cabinet" / "reference" / "ref" /
            "tv-display-paths-ns32-fefl26.md")


def run(argv, timeout=8):
    try:
        return subprocess.run(argv, capture_output=True, text=True,
                             timeout=timeout, check=False)
    except (OSError, subprocess.SubprocessError) as exc:
        print(f"arc-cast: {exc}", file=sys.stderr)
        return None


def command_status(argv):
    result = run(argv, timeout=3)
    if result is None or result.returncode not in (0, 3):
        return "unknown"
    state = result.stdout.strip()
    return state if state in {"active", "inactive", "failed", "activating", "deactivating"} else "unknown"


def avahi_state():
    state = command_status(["systemctl", "is-active", "avahi-daemon"])
    if state != "unknown":
        return state
    pgrep = shutil.which("pgrep")
    if not pgrep:
        return "unknown"
    result = run([pgrep, "-x", "avahi-daemon"], timeout=2)
    if result is None:
        return "unknown"
    if result.returncode == 0:
        return "active"
    return "inactive" if result.returncode == 1 else "unknown"


def status():
    chromium = shutil.which("chromium")
    browser = f"available · {chromium}" if chromium else "not installed"
    mdns = shutil.which("avahi-browse")
    browser_mdns = f"available · {mdns}" if mdns else "not installed"
    avahi = avahi_state()
    print("screen share · local readiness")
    print(f"Chromium: {browser}")
    print(f"mDNS browser: {browser_mdns} · avahi-daemon {avahi}")
    print("Google Cast: requires a Google Cast receiver on the same local Wi-Fi.")
    print("Fire TV: this Insignia uses a different mirroring path; current PC Wi-Fi lacks P2P.")
    print(f"TV guide: {TV_GUIDE}")
    print("No network, VPN, DNS, firewall, or service settings are changed.")
    return 0


def discover():
    browser = shutil.which("avahi-browse")
    if not browser:
        print("mDNS discovery unavailable: install the distro avahi-utils package if needed.")
        return 2
    avahi = avahi_state()
    if avahi != "active":
        print(f"mDNS discovery not run: avahi-daemon is {avahi}; it was left unchanged.")
        return 2
    result = run([browser, "--resolve", "--terminate", "--parsable", "_googlecast._tcp"],
                 timeout=12)
    if result is None:
        return 2
    output = (result.stdout or "").strip()
    if output:
        print(output)
        return 0 if result.returncode == 0 else result.returncode
    print("No Google Cast receiver answered local mDNS discovery. This does not prove the TV is offline.")
    if result.stderr.strip():
        print(result.stderr.strip(), file=sys.stderr)
    return 0


def open_cast():
    browser = shutil.which("chromium")
    if not browser:
        print("Chromium is not installed.", file=sys.stderr)
        return 2
    try:
        subprocess.Popen([browser, "--new-window", "chrome://cast/"],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    except OSError as exc:
        print(f"Could not launch Chromium: {exc}", file=sys.stderr)
        return 1
    print("Opened Chromium Cast controls. A Google Cast receiver is required.")
    return 0


def open_guide():
    opener = shutil.which("xdg-open")
    if not TV_GUIDE.is_file():
        print(f"TV guide is missing: {TV_GUIDE}", file=sys.stderr)
        return 2
    if not opener:
        print(TV_GUIDE)
        return 0
    try:
        subprocess.Popen([opener, str(TV_GUIDE)], stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    except OSError as exc:
        print(f"Could not open TV guide: {exc}", file=sys.stderr)
        return 1
    print("Opened the Insignia TV connection guide.")
    return 0


def main(argv):
    commands = {"status": status, "discover": discover,
                "open": open_cast, "guide": open_guide}
    if len(argv) != 1 or argv[0] not in commands:
        print("usage: arc-cast {status|discover|open|guide}", file=sys.stderr)
        return 2
    return commands[argv[0]]()


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
