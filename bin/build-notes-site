PHASE_SCRIPT = """
(function(){
  var h=new Date().getHours();
  var p=(h>=21||h<6)?'nyx':(h<11?'choice':(h<17?'desire':'still-pine'));
  document.documentElement.setAttribute('data-phase',p);
  var el=document.getElementById('phase-label');
  if(el) el.textContent=p;
}());
"""

SEARCH_JS = """
const q = document.getElementById('q');
const results = document.getElementById('results');
const stats = document.getElementById('stats');

function esc(s) {
  return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

function highlight(text, needle) {
  const safe = esc(text);
  if (!needle) return safe.slice(0, 160);
  const idx = safe.toLowerCase().indexOf(needle.toLowerCase());
  if (idx === -1) return safe.slice(0, 160);
  const start = Math.max(0, idx - 40);
  const end = Math.min(safe.length, idx + needle.length + 100);
  let snippet = (start > 0 ? '...' : '') + safe.slice(start, end) + (end < safe.length ? '...' : '');
  const re = new RegExp(needle.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&'), 'ig');
  return snippet.replace(re, m => '<mark>' + m + '</mark>');
}

function render(items, needle) {
  stats.textContent = items.length + ' result' + (items.length === 1 ? '' : 's');
  results.innerHTML = items.slice(0, 200).map(it => `
    <div class="lab-entry">
      <div class="tree-tag">${it.tree}</div>
      <a class="lab-title" href="${it.href}">${esc(it.rel)}</a>
      <div class="lab-desc">${highlight(it.content, needle)}</div>
    </div>
  `).join('');
}

q.addEventListener('input', () => {
  const needle = q.value.trim();
  if (!needle) { results.innerHTML = ''; stats.textContent = ''; return; }
  const lower = needle.toLowerCase();
  const hits = INDEX.filter(it =>
    it.rel.toLowerCase().includes(lower) || it.content.toLowerCase().includes(lower)
  );
  render(hits, needle);
});
"""


def slug_for(path: Path) -> str:
    h = hashlib.sha1(str(path).encode()).hexdigest()[:12]
    return f"{path.stem}-{h}.html".replace(" ", "-")


def render_markdown(text: str) -> str:
    return _markdown.markdown(text, extensions=["fenced_code", "tables"])


def page_shell(system_label: str, body: str, active: str, extra_script: str = "") -> str:
    home_cls = ' class="uplink-btn active"' if active == "home" else ' class="uplink-btn"'
    browse_cls = ' class="uplink-btn active"' if active == "browse" else ' class="uplink-btn"'
    blueprint_cls = ' class="uplink-btn active"' if active == "blueprint" else ' class="uplink-btn"'
    return f"""<!doctype html>
<html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{html.escape(system_label)}</title>
{FAVICON_TAG}
<style>{CSS}</style>
</head><body>
<div class="site-wrapper">
  <div class="system-bar">
    <div>SYSTEM: {html.escape(system_label.upper())} <span class="cursor">_</span></div>
    <div class="right">
      STATE: ADAPTIVE_SYNC
      <span class="mercury-glyph" style="display:inline-block;animation:flow 2.4s ease-in-out infinite;">&#9791;</span><span class="mercury-glyph" style="display:inline-block;animation:flow-delay 2.4s ease-in-out infinite;margin-right:4px;">&#9789;</span>
    </div>
  </div>

  <nav class="uplinks" style="padding:14px 0;">
    <a href="index.html"{home_cls}>dashboard</a>
    <a href="browse.html"{browse_cls}>browse // search</a>
    <a href="blueprint.html"{blueprint_cls}>blueprint</a>
  </nav>

  {body}

  <div class="close-bar">
    <div class="signature">..: :..</div>
    <div style="margin-top:6px;">notes-site &middot; vault-local &middot; <a href="index.html">home</a></div>
  </div>
</div>
<script>{PHASE_SCRIPT}</script>
{extra_script}
</body></html>"""


def collect_notes():
    notes = []
    for tree_label, tree_root in TREES.items():
        if not tree_root.is_dir():
            continue
        for f in tree_root.rglob("*"):
            if not f.is_file():
                continue
            if f.suffix.lower() not in (".md", ".txt"):
                continue
            if any(part in SKIP_DIR_NAMES for part in f.parts):
                continue
            try:
                text = f.read_text(encoding="utf-8", errors="ignore")
            except Exception:
                continue
            rel = str(f.relative_to(tree_root))
            notes.append({"tree": tree_label, "path": f, "rel": rel, "content": text})
    return notes


