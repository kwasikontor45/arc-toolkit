  echo -e "  ${D}arc ${C}find ${W}<query>${N}          ${M}search across arc-lt-cmc + dev-notes + khaos-lab + vault/archive${N}"
  echo -e "  ${D}arc ${C}book${N}                  ${M}compiled reference archive (master-book.md) — stats${N}"
  echo -e "  ${D}arc ${C}book rebuild${N}          ${M}recompile it from current notes${N}"
  echo -e "  ${D}arc ${C}site${N}                  ${M}dashboard + browsable/searchable notes (lives in the vault)${N}"
