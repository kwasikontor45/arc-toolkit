#!/usr/bin/env python3
"""
arc-pine — notification history browser.

Rebuilt from scratch (original source lost with the Tails USB). Fresh,
functional design rather than a port of the old one: one clean theme
(Rose Pine Moon, matching this system's existing GTK/terminal theme) instead
of three, search-as-you-type, delete individual entries, purge by age or by
app. Reads the same history.db that arc-pined writes to.
"""

import sqlite3
import sys
import tkinter as tk
from tkinter import ttk
from pathlib import Path
from datetime import datetime, timedelta

sys.path.insert(0, str(Path(__file__).resolve().parent))
import _arc_pine_common as pine

DB_PATH     = pine.DB_PATH
ICON_PATH   = Path.home() / ".local/share/arc-pine/icon.png"

# Same theme palette arc-pine-bubbles renders with -- kept in one place
# there, mirrored here just for the Settings preview swatches (this
# viewer's own chrome always stays Rose Pine Moon regardless of the
# selected bubble theme -- only the popups themselves change).
THEMES = {
    "rose-pine-moon": {"bg": "#2a273f", "accent": "#eb6f92", "fg": "#e0def4"},
    "nord":           {"bg": "#3b4252", "accent": "#bf616a", "fg": "#eceff4"},
    "dracula":        {"bg": "#282a36", "accent": "#ff5555", "fg": "#f8f8f2"},
    "gruvbox":        {"bg": "#3c3836", "accent": "#fb4934", "fg": "#ebdbb2"},
}

# Rose Pine Moon
BG       = "#232136"
SURFACE  = "#2a273f"
OVERLAY  = "#393552"
FG       = "#e0def4"
FG_MUTED = "#6e6a86"
GOLD     = "#f6c177"
ROSE     = "#eb6f92"
PINE     = "#3e8fb0"
TEAL     = "#9ccfd8"

URGENCY_COLOR = {0: FG_MUTED, 1: TEAL, 2: ROSE}


def db_query(sql, params=()):
    if not DB_PATH.exists():
        return []
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    rows = conn.execute(sql, params).fetchall()
    conn.close()
    return rows


def db_exec(sql, params=()):
    if not DB_PATH.exists():
        return
    conn = sqlite3.connect(DB_PATH)
    conn.execute(sql, params)
    conn.commit()
    conn.close()


class ArcPine(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("arc · pine")
        self.geometry("480x560")
        self.configure(bg=BG)

        if ICON_PATH.exists():
            try:
                self._icon = tk.PhotoImage(file=str(ICON_PATH))
                self.iconphoto(True, self._icon)
            except Exception:
                pass

        self.search_var = tk.StringVar()
        self.search_var.trace_add("write", lambda *_: self.refresh())

        self.config = pine.load_config()
        self.view = "history"

        self._build_ui()
        self.refresh()

    def _build_ui(self):
        top = tk.Frame(self, bg=BG)
        top.pack(fill="x", padx=10, pady=10)

        tk.Label(top, text="arc pine", font=("JetBrains Mono", 14, "bold"),
                 bg=BG, fg=GOLD).pack(side="left")

        # Snooze is set from the CLI (arc-pine-snooze) with nothing in this
        # GUI that visibly reflects it -- found during a 2026-09-10 bug
        # sweep as a real "why did bubbles stop, is something broken"
        # trap. Hidden by default (pack_forget), shown only while a
        # snooze is actually active.
        self.snooze_lbl = tk.Label(top, text="😴 snoozed", font=("JetBrains Mono", 9, "bold"),
                                    bg=BG, fg=ROSE)

        self.settings_btn = tk.Button(
            top, text="⚙", font=("JetBrains Mono", 9), bg=SURFACE, fg=TEAL,
            activebackground=OVERLAY, activeforeground=TEAL, relief="flat", bd=0,
            padx=8, pady=4, cursor="hand2", command=lambda: self.set_view("settings"),
        )
        self.settings_btn.pack(side="right", padx=(4, 0))

        self.insights_btn = tk.Button(
            top, text="📊", font=("JetBrains Mono", 9), bg=SURFACE, fg=TEAL,
            activebackground=OVERLAY, activeforeground=TEAL, relief="flat", bd=0,
            padx=8, pady=4, cursor="hand2", command=lambda: self.set_view("insights"),
        )
        self.insights_btn.pack(side="right", padx=(4, 0))

        self.search_entry = tk.Entry(top, textvariable=self.search_var, font=("JetBrains Mono", 10),
                                      bg=SURFACE, fg=FG, insertbackground=FG, relief="flat")
        self.search_entry.pack(side="right", fill="x", expand=True)
        self.search_entry.focus()

        # Body: history/insights/settings views share the same slot, only
        # one packed at a time -- simplest way to keep this single-window,
        # no extra Toplevel/dialog clutter.
        self.body = tk.Frame(self, bg=BG)
        self.body.pack(fill="both", expand=True)

        self._build_history_view()
        self._build_insights_view()
        self._build_settings_view()
        self._update_nav_buttons()

    def _view_frame(self, name):
        return {"history": self.history_view, "insights": self.insights_view,
                "settings": self.settings_view}[name]

    def set_view(self, name):
        if name == self.view:
            name = "history"  # clicking the active view's icon returns home
        self._view_frame(self.view).pack_forget()
        self.view = name
        self._view_frame(name).pack(fill="both", expand=True)
        if name == "settings":
            self._load_settings_into_ui()
        elif name == "insights":
            self._refresh_insights()
        self._update_nav_buttons()

    def _update_nav_buttons(self):
        self.settings_btn.configure(bg=OVERLAY if self.view == "settings" else SURFACE)
        self.insights_btn.configure(bg=OVERLAY if self.view == "insights" else SURFACE)

    def _build_history_view(self):
        self.history_view = tk.Frame(self.body, bg=BG)
        self.history_view.pack(fill="both", expand=True)

        # Scrollable list
        container = tk.Frame(self.history_view, bg=BG)
        container.pack(fill="both", expand=True, padx=10)

        canvas = tk.Canvas(container, bg=BG, highlightthickness=0)
        scrollbar = ttk.Scrollbar(container, orient="vertical", command=canvas.yview)
        self.list_frame = tk.Frame(canvas, bg=BG)

        self.list_frame.bind(
            "<Configure>", lambda e: canvas.configure(scrollregion=canvas.bbox("all"))
        )
        canvas.create_window((0, 0), window=self.list_frame, anchor="nw", width=440)
        canvas.configure(yscrollcommand=scrollbar.set)

        canvas.pack(side="left", fill="both", expand=True)
        scrollbar.pack(side="right", fill="y")

        # Bottom action bar
        bottom = tk.Frame(self.history_view, bg=BG)
        bottom.pack(fill="x", padx=10, pady=10)

        BTN = dict(font=("JetBrains Mono", 9), bg=SURFACE, fg=TEAL,
                   activebackground=OVERLAY, activeforeground=TEAL,
                   relief="flat", bd=0, padx=8, pady=4, cursor="hand2")

        tk.Button(bottom, text="purge >7d", command=lambda: self.purge_age(7), **BTN).pack(side="left", padx=2)
        tk.Button(bottom, text="purge >30d", command=lambda: self.purge_age(30), **BTN).pack(side="left", padx=2)
        tk.Button(bottom, text="clear all", command=self.purge_all, **{**BTN, "fg": ROSE}).pack(side="left", padx=2)

        self.count_lbl = tk.Label(bottom, text="", font=("JetBrains Mono", 9), bg=BG, fg=FG_MUTED)
        self.count_lbl.pack(side="right")

    def _build_insights_view(self):
        self.insights_view = tk.Frame(self.body, bg=BG)
        # not packed yet -- history view shows first

        tk.Label(self.insights_view, text="last 7 days", font=("JetBrains Mono", 10, "bold"),
                 bg=BG, fg=GOLD, anchor="w").pack(fill="x", padx=14, pady=(14, 4))

        self.insights_total_lbl = tk.Label(self.insights_view, text="", font=("JetBrains Mono", 9),
                                            bg=BG, fg=FG_MUTED, anchor="w")
        self.insights_total_lbl.pack(fill="x", padx=14)

        tk.Label(self.insights_view, text="noisiest apps", font=("JetBrains Mono", 10, "bold"),
                 bg=BG, fg=GOLD, anchor="w").pack(fill="x", padx=14, pady=(16, 6))

        self.insights_bars = tk.Frame(self.insights_view, bg=BG)
        self.insights_bars.pack(fill="both", expand=True, padx=14)

    def _refresh_insights(self):
        for w in self.insights_bars.winfo_children():
            w.destroy()

        cutoff = (datetime.now() - timedelta(days=7)).strftime("%Y-%m-%d %H:%M:%S")
        total_row = db_query("SELECT COUNT(*) as c FROM notifications WHERE timestamp >= ?", (cutoff,))
        total = total_row[0]["c"] if total_row else 0
        self.insights_total_lbl.configure(text=f"{total} notifications")

        rows = db_query(
            "SELECT app_name, COUNT(*) as c FROM notifications WHERE timestamp >= ? "
            "GROUP BY app_name ORDER BY c DESC LIMIT 8",
            (cutoff,),
        )

        if not rows:
            tk.Label(self.insights_bars, text="no notifications in the last 7 days",
                     font=("JetBrains Mono", 9), bg=BG, fg=FG_MUTED).pack(pady=10)
            return

        max_c = max(r["c"] for r in rows)
        for r in rows:
            row = tk.Frame(self.insights_bars, bg=BG)
            row.pack(fill="x", pady=3)
            tk.Label(row, text=r["app_name"], font=("JetBrains Mono", 9), bg=BG, fg=FG,
                     width=18, anchor="w").pack(side="left")
            bar_track = tk.Frame(row, bg=SURFACE, height=14)
            bar_track.pack(side="left", fill="x", expand=True, padx=(6, 6))
            bar_track.pack_propagate(False)
            frac = r["c"] / max_c if max_c else 0
            tk.Frame(bar_track, bg=PINE, height=14, width=max(int(220 * frac), 3)
                     ).place(x=0, y=0, relheight=1)
            tk.Label(row, text=str(r["c"]), font=("JetBrains Mono", 9), bg=BG, fg=FG_MUTED,
                     width=4, anchor="e").pack(side="left")

    def _build_settings_view(self):
        self.settings_view = tk.Frame(self.body, bg=BG)
        # not packed yet -- history view shows first

        pad = dict(padx=14, pady=(14, 4))

        def section(text):
            tk.Label(self.settings_view, text=text, font=("JetBrains Mono", 10, "bold"),
                      bg=BG, fg=GOLD, anchor="w").pack(fill="x", **pad)

        def row():
            r = tk.Frame(self.settings_view, bg=BG)
            r.pack(fill="x", padx=14, pady=2)
            return r

        # -- Bubble popups --
        section("bubble popups")

        r = row()
        tk.Label(r, text="theme", font=("JetBrains Mono", 9), bg=BG, fg=FG, width=16, anchor="w").pack(side="left")
        self.theme_var = tk.StringVar()
        theme_menu = ttk.Combobox(r, textvariable=self.theme_var, values=list(THEMES.keys()),
                                   state="readonly", font=("JetBrains Mono", 9), width=18)
        theme_menu.pack(side="left")
        theme_menu.bind("<<ComboboxSelected>>", lambda e: self._save_setting("bubble_theme", self.theme_var.get()))

        r = row()
        tk.Label(r, text="max visible", font=("JetBrains Mono", 9), bg=BG, fg=FG, width=16, anchor="w").pack(side="left")
        self.max_visible_var = tk.IntVar()
        tk.Spinbox(r, from_=1, to=10, textvariable=self.max_visible_var, width=6,
                   font=("JetBrains Mono", 9), bg=SURFACE, fg=FG, insertbackground=FG,
                   relief="flat", command=lambda: self._save_setting("bubble_max_visible", self.max_visible_var.get())
                   ).pack(side="left")

        r = row()
        tk.Label(r, text="duration (sec)", font=("JetBrains Mono", 9), bg=BG, fg=FG, width=16, anchor="w").pack(side="left")
        self.duration_var = tk.IntVar()
        tk.Spinbox(r, from_=3, to=60, textvariable=self.duration_var, width=6,
                   font=("JetBrains Mono", 9), bg=SURFACE, fg=FG, insertbackground=FG,
                   relief="flat",
                   command=lambda: self._save_setting("bubble_duration_ms", self.duration_var.get() * 1000)
                   ).pack(side="left")
        tk.Label(r, text="always auto-clears, never sticks around", font=("JetBrains Mono", 8),
                  bg=BG, fg=FG_MUTED).pack(side="left", padx=(10, 0))

        # -- Sound & voice --
        section("sound & voice")

        r = row()
        self.sound_var = tk.BooleanVar()
        tk.Checkbutton(r, text="sound on new notification", variable=self.sound_var,
                       font=("JetBrains Mono", 9), bg=BG, fg=FG, selectcolor=SURFACE,
                       activebackground=BG, activeforeground=FG, anchor="w",
                       command=lambda: self._save_setting("sound_enabled", self.sound_var.get())
                       ).pack(side="left")

        r = row()
        self.speak_var = tk.BooleanVar()
        tk.Checkbutton(r, text="speak notifications (arc-break only)", variable=self.speak_var,
                       font=("JetBrains Mono", 9), bg=BG, fg=FG, selectcolor=SURFACE,
                       activebackground=BG, activeforeground=FG, anchor="w",
                       command=lambda: self._save_setting("speak_enabled", self.speak_var.get())
                       ).pack(side="left")

        # -- Quiet hours --
        section("quiet hours  (mutes sound + speech only -- still logs, still shows a bubble)")
        r = row()
        self.dnd_var = tk.BooleanVar()
        tk.Checkbutton(r, text="enabled", variable=self.dnd_var,
                       font=("JetBrains Mono", 9), bg=BG, fg=FG, selectcolor=SURFACE,
                       activebackground=BG, activeforeground=FG,
                       command=lambda: self._save_setting("dnd_enabled", self.dnd_var.get())
                       ).pack(side="left")
        r = row()
        tk.Label(r, text="from", font=("JetBrains Mono", 9), bg=BG, fg=FG_MUTED).pack(side="left")
        self.dnd_start_var = tk.StringVar()
        dnd_start_entry = tk.Entry(r, textvariable=self.dnd_start_var, font=("JetBrains Mono", 9),
                                    bg=SURFACE, fg=FG, insertbackground=FG, relief="flat", width=6)
        dnd_start_entry.pack(side="left", padx=(6, 12))
        tk.Label(r, text="to", font=("JetBrains Mono", 9), bg=BG, fg=FG_MUTED).pack(side="left")
        self.dnd_end_var = tk.StringVar()
        dnd_end_entry = tk.Entry(r, textvariable=self.dnd_end_var, font=("JetBrains Mono", 9),
                                  bg=SURFACE, fg=FG, insertbackground=FG, relief="flat", width=6)
        dnd_end_entry.pack(side="left", padx=(6, 0))
        tk.Label(r, text="HH:MM, 24h", font=("JetBrains Mono", 8), bg=BG, fg=FG_MUTED).pack(side="left", padx=(10, 0))

        def _save_dnd_times(*_):
            self._save_setting("dnd_start", self.dnd_start_var.get().strip())
            self._save_setting("dnd_end", self.dnd_end_var.get().strip())
        dnd_start_entry.bind("<FocusOut>", _save_dnd_times)
        dnd_end_entry.bind("<FocusOut>", _save_dnd_times)

        # -- Per-app rules --
        section("per-app rules")
        tk.Label(self.settings_view, text="apps seen in history, plus any you add below",
                 font=("JetBrains Mono", 8), bg=BG, fg=FG_MUTED, anchor="w").pack(fill="x", padx=14)

        rules_container = tk.Frame(self.settings_view, bg=BG)
        rules_container.pack(fill="both", expand=True, padx=14, pady=(6, 0))
        rules_canvas = tk.Canvas(rules_container, bg=BG, highlightthickness=0, height=160)
        rules_scroll = ttk.Scrollbar(rules_container, orient="vertical", command=rules_canvas.yview)
        self.rules_list = tk.Frame(rules_canvas, bg=BG)
        self.rules_list.bind("<Configure>", lambda e: rules_canvas.configure(scrollregion=rules_canvas.bbox("all")))
        rules_canvas.create_window((0, 0), window=self.rules_list, anchor="nw", width=400)
        rules_canvas.configure(yscrollcommand=rules_scroll.set)
        rules_canvas.pack(side="left", fill="both", expand=True)
        rules_scroll.pack(side="right", fill="y")

        r = row()
        tk.Label(r, text="add app:", font=("JetBrains Mono", 9), bg=BG, fg=FG_MUTED).pack(side="left")
        self.add_app_var = tk.StringVar()
        add_entry = tk.Entry(r, textvariable=self.add_app_var, font=("JetBrains Mono", 9),
                              bg=SURFACE, fg=FG, insertbackground=FG, relief="flat")
        add_entry.pack(side="left", fill="x", expand=True, padx=(6, 6))

        def add_app():
            name = self.add_app_var.get().strip()
            if not name:
                return
            self.config.setdefault("app_rules", {}).setdefault(name, {})
            pine.save_config(self.config)
            self.add_app_var.set("")
            self._rebuild_rules_list()
        add_entry.bind("<Return>", lambda e: add_app())
        tk.Button(r, text="+", command=add_app, font=("JetBrains Mono", 9), bg=SURFACE, fg=TEAL,
                  activebackground=OVERLAY, activeforeground=TEAL, relief="flat", bd=0,
                  padx=8, cursor="hand2").pack(side="left")

        tk.Label(self.settings_view, text="changes apply live -- no restart needed",
                 font=("JetBrains Mono", 8), bg=BG, fg=FG_MUTED).pack(anchor="w", padx=14, pady=(10, 10))

    def _known_apps(self):
        rows = db_query("SELECT DISTINCT app_name FROM notifications ORDER BY app_name")
        seen = {r["app_name"] for r in rows}
        seen |= set(self.config.get("app_rules", {}).keys())
        return sorted(seen)

    def _rebuild_rules_list(self):
        for w in self.rules_list.winfo_children():
            w.destroy()

        apps = self._known_apps()
        if not apps:
            tk.Label(self.rules_list, text="no apps seen yet", font=("JetBrains Mono", 9),
                     bg=BG, fg=FG_MUTED).pack(pady=10)
            return

        for app in apps:
            rule = self.config.get("app_rules", {}).get(app, {})
            r = tk.Frame(self.rules_list, bg=BG)
            r.pack(fill="x", pady=1)
            tk.Label(r, text=app, font=("JetBrains Mono", 9), bg=BG, fg=FG,
                     width=22, anchor="w").pack(side="left")

            mute_var = tk.BooleanVar(value=bool(rule.get("mute", False)))
            speak_var = tk.BooleanVar(value=bool(rule.get("speak", False)))

            def on_toggle(app=app, mute_var=mute_var, speak_var=speak_var):
                pine.set_app_rule(self.config, app, mute=mute_var.get(), speak=speak_var.get())
                pine.save_config(self.config)

            tk.Checkbutton(r, text="mute", variable=mute_var, command=on_toggle,
                           font=("JetBrains Mono", 9), bg=BG, fg=FG, selectcolor=SURFACE,
                           activebackground=BG, activeforeground=FG).pack(side="left", padx=(0, 10))
            tk.Checkbutton(r, text="speak", variable=speak_var, command=on_toggle,
                           font=("JetBrains Mono", 9), bg=BG, fg=FG, selectcolor=SURFACE,
                           activebackground=BG, activeforeground=FG).pack(side="left")

    def _load_settings_into_ui(self):
        self.config = pine.load_config()
        self.theme_var.set(self.config.get("bubble_theme", "rose-pine-moon"))
        self.max_visible_var.set(self.config.get("bubble_max_visible", 4))
        self.duration_var.set(self.config.get("bubble_duration_ms", 12000) // 1000)
        self.sound_var.set(self.config.get("sound_enabled", True))
        self.speak_var.set(self.config.get("speak_enabled", True))
        self.dnd_var.set(self.config.get("dnd_enabled", False))
        self.dnd_start_var.set(self.config.get("dnd_start", "23:00"))
        self.dnd_end_var.set(self.config.get("dnd_end", "07:00"))
        self._rebuild_rules_list()

    def _save_setting(self, key, value):
        self.config[key] = value
        pine.save_config(self.config)

    def _update_snooze_indicator(self):
        if pine.is_snoozed(pine.load_config()):
            self.snooze_lbl.pack(side="left", padx=(10, 0))
        else:
            self.snooze_lbl.pack_forget()

    def refresh(self):
        self._update_snooze_indicator()
        for w in self.list_frame.winfo_children():
            w.destroy()

        q = self.search_var.get().strip()
        if q:
            rows = db_query(
                "SELECT * FROM notifications WHERE app_name LIKE ? OR summary LIKE ? OR body LIKE ? "
                "ORDER BY id DESC LIMIT 200",
                (f"%{q}%", f"%{q}%", f"%{q}%"),
            )
        else:
            rows = db_query("SELECT * FROM notifications ORDER BY id DESC LIMIT 200")

        if not rows:
            tk.Label(self.list_frame, text="no notifications", font=("JetBrains Mono", 10),
                     bg=BG, fg=FG_MUTED).pack(pady=20)

        for row in rows:
            self._add_card(row)

        total = db_query("SELECT COUNT(*) as c FROM notifications")
        self.count_lbl.configure(text=f"{total[0]['c'] if total else 0} total")

    def _add_card(self, row):
        card = tk.Frame(self.list_frame, bg=SURFACE)
        card.pack(fill="x", pady=3)

        color = URGENCY_COLOR.get(row["urgency"], TEAL)

        header = tk.Frame(card, bg=SURFACE)
        header.pack(fill="x", padx=8, pady=(6, 0))
        tk.Label(header, text=row["app_name"], font=("JetBrains Mono", 9, "bold"),
                 bg=SURFACE, fg=color).pack(side="left")
        tk.Label(header, text=row["timestamp"], font=("JetBrains Mono", 8),
                 bg=SURFACE, fg=FG_MUTED).pack(side="right")

        tk.Label(card, text=row["summary"], font=("JetBrains Mono", 10),
                 bg=SURFACE, fg=FG, anchor="w", wraplength=420, justify="left"
                 ).pack(fill="x", padx=8, pady=(2, 0))

        if row["body"]:
            tk.Label(card, text=row["body"], font=("JetBrains Mono", 9),
                     bg=SURFACE, fg=FG_MUTED, anchor="w", wraplength=420, justify="left"
                     ).pack(fill="x", padx=8, pady=(0, 4))

        actions = tk.Frame(card, bg=SURFACE)
        actions.pack(fill="x", padx=8, pady=(0, 6))

        def do_copy(text=f"{row['summary']} {row['body']}".strip()):
            self.clipboard_clear()
            self.clipboard_append(text)

        def do_delete(nid=row["id"]):
            db_exec("DELETE FROM notifications WHERE id = ?", (nid,))
            self.refresh()

        tk.Button(actions, text="copy", command=do_copy, font=("JetBrains Mono", 8),
                  bg=OVERLAY, fg=TEAL, relief="flat", bd=0, padx=6, cursor="hand2"
                  ).pack(side="left")
        tk.Button(actions, text="delete", command=do_delete, font=("JetBrains Mono", 8),
                  bg=OVERLAY, fg=ROSE, relief="flat", bd=0, padx=6, cursor="hand2"
                  ).pack(side="left", padx=(4, 0))

    def purge_age(self, days):
        cutoff = (datetime.now() - timedelta(days=days)).strftime("%Y-%m-%d %H:%M:%S")
        db_exec("DELETE FROM notifications WHERE timestamp < ?", (cutoff,))
        self.refresh()

    def purge_all(self):
        db_exec("DELETE FROM notifications")
        self.refresh()


if __name__ == "__main__":
    ArcPine().mainloop()
