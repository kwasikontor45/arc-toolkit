#!/bin/bash
# arc — your system architect
# usage: arc [command]

# ── Colors ─────────────────────────────────────────────────────────────────────
C='\033[0;36m'   # cyan
G='\033[0;32m'   # green
R='\033[0;31m'   # red
Y='\033[1;33m'   # yellow
D='\033[0;90m'   # dim
W='\033[0;37m'   # white
M='\033[38;5;250m'   # silver-grey (matches architect-of-chaos)
GOLD='\033[38;5;183m'  # iris — butterfly top
ART='\033[1;38;5;222m' # gold bold — butterfly bottom
B='\033[1m'      # bold
N='\033[0m'      # reset

HR="${D}────────────────────────────────────────────────${N}"

# ── Helpers ────────────────────────────────────────────────────────────────────
disk_used()  { df -h / | awk 'NR==2 {print $3}'; }
disk_total() { df -h / | awk 'NR==2 {print $2}'; }
disk_free()  { df -h / | awk 'NR==2 {print $4}'; }
disk_pct()   { df /   | awk 'NR==2 {print $5}'; }
disk_kb()    { df /   | awk 'NR==2 {print $4}'; }

# Real I/O test — mountpoint alone lies after USB disconnect/port-change
# (dm-crypt mapper stays alive but reads fail). This actually touches the fs.
storage_ok() { mountpoint -q /mnt/storage 2>/dev/null && ls /mnt/storage/ >/dev/null 2>&1; }

saved_mb() {
  local start="$1" end="$2"
  local diff=$(( end - start ))
  if (( diff > 0 )); then
    echo "scale=1; $diff / 1024" | bc 2>/dev/null || echo "?"
  else
    echo "0"
  fi
}

# Scan home subdirs + USB repos dirs for git repos
scan_repos() {
  for d in "$HOME"/*/; do
    [[ -d "$d/.git" ]] && echo "$d"
  done
  # Real projects live nested one level under khaos-lab/ (athena, kataleya,
  # arc-toolkit-public, arc-private, etc.) -- a plain $HOME/*/ scan never saw
  # them. Found 2026-08-17: "no repos found" despite 6 real repos existing,
  # once codex/ (the old location this originally scanned) emptied out.
  for d in "$HOME"/khaos-lab/*/; do
    [[ -d "$d/.git" ]] && echo "$d"
  done
  for usb_dir in "/mnt/storage/codex" "/mnt/storage/forge"; do
    if [[ -d "$usb_dir" ]]; then
      for d in "$usb_dir"/*/; do
        [[ -d "$d/.git" ]] && echo "$d"
      done
    fi
  done
}

# ── Status ─────────────────────────────────────────────────────────────────────
cmd_status() {
  echo -e "$HR"
  echo -e "  ${C}${B}arc${N}  ${D}·${N}  ${GOLD}$(whoami)${D}@${N}${ART}$(hostname)${N}"
  echo -e "$HR"
  echo -e "  ${C}disk${N}    ${M}$(disk_used)${N} used  ${D}·${N}  ${M}$(disk_free)${N} free  ${D}/  ${M}$(disk_total)  ($(disk_pct))${N}"

  if storage_ok; then
    local uu uf
    uu=$(df -h /mnt/storage | awk 'NR==2 {print $3}')
    uf=$(df -h /mnt/storage | awk 'NR==2 {print $4}')
    echo -e "  ${C}usb ${N}    ${M}${uu}${N} used  ${D}·${N}  ${M}${uf}${N} free  ${D}/ /mnt/storage${N}"
  else
    echo -e "  ${C}usb ${N}    ${R}not accessible${N}  ${D}— run arc mount${N}"
  fi

  if mountpoint -q /fortress 2>/dev/null && ls /fortress/ >/dev/null 2>&1; then
    local fu ff
    fu=$(df -h /fortress | awk 'NR==2 {print $3}')
    ff=$(df -h /fortress | awk 'NR==2 {print $4}')
    echo -e "  ${C}fortress${N}  ${M}${fu}${N} used  ${D}·${N}  ${M}${ff}${N} free  ${D}/ /fortress${N}"
  else
    echo -e "  ${C}fortress${N}  ${R}not accessible${N}"
  fi

  # Was reading /var/cache/vault-last-backup, a path vault-backup-mega never
  # wrote to -- it logs real completions to /var/log/vault-mega.log as
  # "<timestamp> sync complete". This showed "no backup on record" forever,
  # even with real nightly backups genuinely succeeding. Found 2026-08-17.
  local vault_log="/var/log/vault-mega.log"
  local last_line
  last_line=$(grep "sync complete$" "$vault_log" 2>/dev/null | tail -1)
  if [[ -n "$last_line" ]]; then
    local vault_date days_ago
    vault_date=$(echo "$last_line" | awk '{print $1, $2}')
    days_ago=$(( ( $(date +%s) - $(date -d "$vault_date" +%s 2>/dev/null || echo 0) ) / 86400 ))
    echo -e "  ${C}vault${N}   ${M}${vault_date}${N}  ${D}(${days_ago}d ago)${N}"
    echo -e "          ${D}mega:/vault${N}"
  else
    echo -e "  ${C}vault${N}   ${Y}no backup on record${N}  ${D}— run arc sync${N}"
  fi

  echo -e "$HR"
  echo -e "  ${C}repos${N}"

  local found=0
  while IFS= read -r d; do
    [[ -z "$d" ]] && continue
    found=1
    local name branch short ahead last status_str ahead_str
    name=$(basename "$d")
    branch=$(git -C "$d" branch --show-current 2>/dev/null)
    short=$(git -C "$d" status --short 2>/dev/null)
    ahead=$(git -C "$d" rev-list @{u}..HEAD 2>/dev/null | wc -l | tr -d ' ')
    last=$(git -C "$d" log -1 --format="%cr" 2>/dev/null || echo "no commits")

    if [[ -n "$short" ]]; then
      status_str="${Y}uncommitted${N}"
    else
      status_str="${G}clean${N}"
    fi

    ahead_str=""
    (( ahead > 0 )) && ahead_str="  ${D}·${N}  ${C}${ahead} ahead${N}"

    printf "  ${D}·${N}  ${M}%-20s${N}  ${D}[%s]${N}  %b%b  ${D}%s${N}\n" \
      "$name" "$branch" "$status_str" "$ahead_str" "$last"
  done < <(scan_repos)

  (( found == 0 )) && echo -e "  ${D}no repos found${N}"

  # mirrors last sync
  local MIRROR_LOG="$HOME/.local/share/sync-mirrors/sync-mirrors.log"
  if [[ -s "$MIRROR_LOG" ]]; then
    local last_run in_sync errors
    last_run=$(grep "=== sync-mirrors start ===" "$MIRROR_LOG" | tail -1 | cut -d']' -f1 | tr -d '[')
    local last_block
    last_block=$(awk '/=== sync-mirrors start ===/{ buf="" } { buf=buf"\n"$0 } END{print buf}' "$MIRROR_LOG")
    in_sync=$(echo "$last_block" | grep -c "^.*OK " || true)
    errors=$(echo "$last_block" | grep -c "^.*ERR " || true)
    if [[ "$errors" -gt 0 ]]; then
      printf "  ${D}mirrors${N}  ${R}%s err${N}  ${D}· last run %s${N}\n" "$errors" "$last_run"
    else
      printf "  ${D}mirrors${N}  ${G}%s in sync${N}  ${D}· last run %s${N}\n" "$in_sync" "$last_run"
    fi
  else
    echo -e "  ${D}mirrors${N}  ${D}no sync on record — arc mirrors run${N}"
  fi

  echo -e "$HR"
}

# ── Health ─────────────────────────────────────────────────────────────────────
cmd_health() {
  echo -e "$HR"
  echo -e "  ${C}${B}arc health${N}  —  system health"
  echo -e "$HR\n"

  # Disks
  echo -e "  ${C}disks${N}"
  local iu if_ it ip
  iu=$(df -h / | awk 'NR==2 {print $3}')
  if_=$(df -h / | awk 'NR==2 {print $4}')
  it=$(df -h / | awk 'NR==2 {print $2}')
  ip=$(df / | awk 'NR==2 {print $5}')
  echo -e "  ${D}·${N}  internal    ${iu} used · ${if_} free / ${it}  ${D}(${ip})${N}"

  if storage_ok; then
    local uu uf ut up
    uu=$(df -h /mnt/storage | awk 'NR==2 {print $3}')
    uf=$(df -h /mnt/storage | awk 'NR==2 {print $4}')
    ut=$(df -h /mnt/storage | awk 'NR==2 {print $2}')
    up=$(df /mnt/storage | awk 'NR==2 {print $5}')
    echo -e "  ${G}·${N}  usb         ${uu} used · ${uf} free / ${ut}  ${D}(${up})${N}"
  else
    echo -e "  ${R}·${N}  usb         not accessible  ${D}— arc mount${N}"
  fi

  # RAM
  echo ""
  echo -e "  ${C}memory${N}"
  local rm_used rm_avail rm_total
  rm_used=$(free -h | awk '/Mem:/ {print $3}')
  rm_avail=$(free -h | awk '/Mem:/ {print $7}')
  rm_total=$(free -h | awk '/Mem:/ {print $2}')
  echo -e "  ${D}·${N}  ram         ${rm_used} used · ${rm_avail} available / ${rm_total}"

  local sw_used sw_total
  sw_used=$(free -h | awk '/Swap:/ {print $3}')
  sw_total=$(free -h | awk '/Swap:/ {print $2}')
  echo -e "  ${D}·${N}  swap        ${sw_used} used / ${sw_total}"

  # Encryption layers
  echo ""
  echo -e "  ${C}encryption${N}"

  # Home (ecryptfs)
  if grep -q ecryptfs /proc/mounts 2>/dev/null; then
    echo -e "  ${G}✓${N}  home        ecryptfs active"
  else
    echo -e "  ${Y}?${N}  home        ecryptfs not detected"
  fi

  # Swap (luks)
  if swapon --show 2>/dev/null | grep -q mapper; then
    echo -e "  ${G}✓${N}  swap        LUKS encrypted"
  else
    echo -e "  ${D}·${N}  swap        ${D}(not luks or not active)${N}"
  fi

  # USB (luks) — check mapper device, then verify actual I/O
  if [[ -b /dev/mapper/storage_crypt ]]; then
    if storage_ok; then
      echo -e "  ${G}✓${N}  usb         LUKS open · accessible"
    else
      echo -e "  ${Y}!${N}  usb         LUKS open · stale  ${D}(USB unplugged? run arc mount)${N}"
    fi
  else
    echo -e "  ${R}✗${N}  usb         LUKS not open"
  fi

  echo -e "\n$HR"
}

# ── Mount ──────────────────────────────────────────────────────────────────────
cmd_mount() {
  echo -e "$HR"
  echo -e "  ${C}${B}arc mount${N}  —  manual USB remount"
  echo -e "$HR\n"

  if mountpoint -q /mnt/storage 2>/dev/null; then
    if storage_ok; then
      local uu uf
      uu=$(df -h /mnt/storage | awk 'NR==2 {print $3}')
      uf=$(df -h /mnt/storage | awk 'NR==2 {print $4}')
      echo -e "  ${G}✓${N}  already mounted  —  ${uu} used · ${uf} free"
      echo -e "$HR"
      return 0
    else
      echo -e "  ${Y}!${N}  stale mount detected — USB disconnected or port changed. repairing..."
      sudo umount -l /mnt/storage 2>/dev/null || true
      sudo cryptsetup close storage_crypt 2>/dev/null || true
      sleep 0.5
    fi
  fi

  local PARTUUID="b00feb5b-4ef4-4a01-a58d-2a6543cbaa90"
  local DEV="/dev/disk/by-partuuid/$PARTUUID"
  local KEY="/etc/luks/storage.key"

  if [[ ! -e "$DEV" ]]; then
    echo -e "  ${R}✗${N}  drive not found — is the USB plugged in?"
    echo -e "  ${D}PARTUUID: ${PARTUUID}${N}"
    echo -e "$HR"
    return 1
  fi

  # Stale mapper entry guard (2026-06-01 incident: cryptsetup refuses to open when
  # /dev/mapper/storage_crypt exists but has no live dm table — e.g. after an unclean
  # USB disconnect). Clear it first so open doesn't fail with "already exists".
  if [[ -e /dev/mapper/storage_crypt ]] && ! sudo dmsetup table storage_crypt &>/dev/null; then
    echo -e "  ${Y}!${N}  stale mapper entry detected — clearing before open"
    sudo rm -f /dev/mapper/storage_crypt
  fi

  echo -e "  ${C}opening LUKS container...${N}"
  if sudo cryptsetup open "$DEV" storage_crypt --key-file "$KEY"; then
    echo -e "  ${G}✓${N}  LUKS opened"
  else
    echo -e "  ${R}✗${N}  cryptsetup failed — key file issue?"
    echo -e "  ${D}key: ${KEY}${N}"
    echo -e "$HR"
    return 1
  fi

  echo -e "  ${C}mounting /mnt/storage...${N}"
  if sudo mount /dev/mapper/storage_crypt /mnt/storage; then
    echo -e "  ${G}✓${N}  mounted at /mnt/storage"
  else
    echo -e "  ${Y}!${N}  trying with exec flag..."
    sudo mount /dev/mapper/storage_crypt /mnt/storage -o exec
    echo -e "  ${G}✓${N}  mounted (exec)"
  fi

  echo -e "\n$HR"
}

# ── Update ─────────────────────────────────────────────────────────────────────
cmd_update() {
  echo -e "$HR"
  echo -e "  ${C}${B}arc update${N}  —  system refresh"
  echo -e "$HR\n"

  local start
  start=$(disk_kb)

  echo -e "${C}packages...${N}"
  sudo apt update \
    && sudo DEBIAN_FRONTEND=noninteractive apt upgrade -y \
      -o Dpkg::Options::="--force-confdef" \
      -o Dpkg::Options::="--force-confold"

  echo -e "\n${C}cleanup...${N}"
  sudo apt autoremove -y && sudo apt clean

  local end mb
  end=$(disk_kb)
  mb=$(saved_mb "$start" "$end")

  echo -e "\n$HR"
  echo -e "  ${G}done${N}  ${D}·${N}  ${G}+${mb} MB reclaimed${N}"
  echo -e "  ${C}disk${N}    $(disk_used) used  ${D}·${N}  $(disk_free) free"
  echo -e "$HR"
}

# ── Clean ──────────────────────────────────────────────────────────────────────
cmd_clean() {
  if [[ -n "${1:-}" ]]; then
    echo -e "${R}unknown:${N} arc clean $1"
    echo -e "${D}arc clean takes no arguments — it always runs the full deep clean.${N}"
    echo -e "${D}looking for browser caches? that's ${C}arc browser-clean${N}${D}.${N}"
    return 1
  fi

  echo -e "$HR"
  echo -e "  ${C}${B}arc clean${N}  —  deep clean"
  echo -e "$HR\n"

  local start
  start=$(disk_kb)

  # Home sweep first — moves junk, packs it, purges the pack
  if command -v arc-home-sweep &>/dev/null; then
    echo -e "${C}home sweep...${N}"
    arc-home-sweep --purge
    echo ""
  fi

  echo -e "${C}user cache...${N}"
  rm -rf ~/.cache/*

  echo -e "${C}trash...${N}"
  # If it's trash, it's trash — actually empty it, don't just hide it from
  # backups. gio handles the real XDG trash spec (files/ + info/ + any other
  # registered trash dirs), not just this one path.
  local trash_before trash_after
  trash_before=$(du -sb ~/.local/share/Trash 2>/dev/null | cut -f1)
  gio trash --empty 2>/dev/null || rm -rf ~/.local/share/Trash/files/* ~/.local/share/Trash/info/* 2>/dev/null
  trash_after=$(du -sb ~/.local/share/Trash 2>/dev/null | cut -f1)
  if [[ -n "$trash_before" ]] && (( trash_before > trash_after )); then
    echo -e "  ${G}✓${N}  emptied ($(( (trash_before - trash_after) / 1048576 )) MB freed)"
  else
    echo -e "  ${D}·${N}  already empty"
  fi

  echo -e "${C}session logs...${N}"
  rm -f ~/.xsession-errors ~/.xsession-errors.old ~/nohup.out

  echo -e "${C}home junk...${N}"
  find "$HOME" -maxdepth 1 -type f -name "*.log" -delete
  find "$HOME" -maxdepth 1 -type f -empty ! -name ".ICEauthority" ! -name ".bash_history" ! -name ".bash_logout" -delete

  echo -e "${C}tmp...${N}"
  # Only clean user-owned files in /tmp older than 2h — never touch ssh sockets,
  # systemd-private dirs, chromium/claude runtime dirs, or other users' files
  local tmp_cleaned=0
  while IFS= read -r f; do
    rm -rf "$f" 2>/dev/null && (( tmp_cleaned++ ))
  done < <(find /tmp -maxdepth 1 -user "$USER" -mmin +120 \
    ! -name 'ssh-*' \
    ! -name 'claude-*' \
    ! -name 'org.chromium.*' \
    ! -name 'systemd-private-*' \
    2>/dev/null)
  if (( tmp_cleaned > 0 )); then
    echo -e "  ${G}✓${N}  removed ${tmp_cleaned} stale tmp item(s)"
  else
    echo -e "  ${D}·${N}  nothing stale to clean"
  fi

  echo -e "${C}apt...${N}"
  sudo apt autoremove -y && sudo apt clean

  local end mb
  end=$(disk_kb)
  mb=$(saved_mb "$start" "$end")

  echo -e "\n$HR"
  echo -e "  ${G}done${N}  ${D}·${N}  ${G}+${mb} MB reclaimed${N}"
  echo -e "  ${C}disk${N}    $(disk_used) used  ${D}·${N}  $(disk_free) free"
  echo -e "$HR"
}

# ── Sweep ──────────────────────────────────────────────────────────────────────
cmd_sweep() {
  local sub="${1:-}"
  case "$sub" in
    dry|--dry-run) arc-home-sweep --dry-run ;;
    purge)         arc-home-sweep --purge ;;
    status)        arc-home-sweep --status ;;
    '')            arc-home-sweep ;;
    *)
      echo -e "${R}unknown:${N} arc sweep $sub"
      echo -e "${D}options: dry · purge · status${N}"
      ;;
  esac
}

# ── Disk ───────────────────────────────────────────────────────────────────────
_disk_top() {
  echo -e "$HR"
  echo -e "  ${C}${B}arc disk${N}  —  top space consumers"
  echo -e "$HR\n"

  echo -e "  ${C}filesystem${N}"
  df -h / | awk 'NR==1{printf "  %s\n",$0} NR==2{printf "  %s\n",$0}'

  echo -e "\n  ${C}home  ${D}(top 15)${N}"
  du -sh "$HOME"/* "$HOME"/.[!.]* 2>/dev/null | sort -rh | head -15 \
    | while IFS=$'\t' read -r sz path; do
        printf "  ${M}%-8s${N} ${D}%s${N}\n" "$sz" "$(basename "$path")"
      done

  if command -v flatpak &>/dev/null; then
    echo -e "\n  ${C}flatpak${N}  ${D}$(du -sh /var/lib/flatpak 2>/dev/null | cut -f1) total${N}"
    flatpak list --columns=application,size 2>/dev/null | while IFS=$'\t' read -r app sz; do
      printf "  ${M}%-10s${N} ${D}%s${N}\n" "$sz" "$app"
    done
  fi

  echo -e "\n  ${C}kernels${N}"
  local running old_found=0
  running=$(uname -r)
  while read -r img; do
    [[ -z "$img" ]] && continue
    echo -e "  ${Y}!${N}  ${img}  ${D}(not running — candidate for removal)${N}"
    old_found=1
  done < <(dpkg -l 'linux-image-[0-9]*' 2>/dev/null | awk '/^ii/{print $2}' | grep -v "$running")
  (( old_found == 0 )) && echo -e "  ${D}·${N}  only the active kernel (${running}) is installed"

  echo -e "\n$HR"
  echo -e "  ${D}arc disk caches${N}   ${M}known reclaimable caches, sized${N}"
  echo -e "  ${D}arc disk clean${N}    ${M}reclaim the safe ones${N}"
  echo -e "$HR"
}

_disk_caches() {
  echo -e "$HR"
  echo -e "  ${C}${B}arc disk caches${N}  —  reclaimable, nothing touched"
  echo -e "$HR\n"

  local sz

  if [[ -d "$HOME/.npm" ]]; then
    sz=$(du -sh "$HOME/.npm" 2>/dev/null | cut -f1)
    echo -e "  ${M}${sz}${N}  ${W}npm cache${N}          ${D}arc disk clean  (clears _cacache + _npx)${N}"
  fi

  if [[ -d "$HOME/.cache/pip" ]]; then
    sz=$(du -sh "$HOME/.cache/pip" 2>/dev/null | cut -f1)
    echo -e "  ${M}${sz}${N}  ${W}pip cache${N}          ${D}pip cache purge${N}"
  fi

  if [[ -d "$HOME/.local/share/claude/versions" ]]; then
    local current old_total=0
    current=$(claude --version 2>/dev/null | awk '{print $1}')
    for v in "$HOME/.local/share/claude/versions"/*; do
      [[ -e "$v" ]] || continue
      [[ "$(basename "$v")" == "$current" ]] && continue
      old_total=$(( old_total + $(du -k "$v" 2>/dev/null | cut -f1) ))
    done
    if (( old_total > 0 )); then
      sz=$(echo "scale=1; $old_total/1024" | bc 2>/dev/null)
      echo -e "  ${M}${sz}M${N}  ${W}superseded Claude Code CLI versions${N}  ${D}(keeping ${current})${N}"
    fi
  fi

  local brave_total=0
  local BRAVE_BASE="$HOME/.config/BraveSoftware/Brave-Browser/Default"
  for d in Cache "Code Cache" GPUCache DawnGraphiteCache DawnWebGPUCache CacheStorage "Service Worker"; do
    [[ -d "$BRAVE_BASE/$d" ]] && brave_total=$(( brave_total + $(du -sk "$BRAVE_BASE/$d" 2>/dev/null | cut -f1) ))
  done
  if (( brave_total > 0 )); then
    sz=$(echo "scale=1; $brave_total/1024" | bc 2>/dev/null)
    echo -e "  ${M}${sz}M${N}  ${W}browser cache (brave + firefox)${N}  ${D}arc browser-clean${N}"
  fi

  if [[ -d /var/cache/apt/archives ]]; then
    sz=$(du -sh /var/cache/apt/archives 2>/dev/null | cut -f1)
    echo -e "  ${M}${sz}${N}  ${W}apt archive cache${N}     ${D}sudo apt clean${N}"
  fi

  if command -v flatpak &>/dev/null; then
    local unused
    unused=$(flatpak list --app --columns=application 2>/dev/null | wc -l)
    echo -e "  ${D}?${N}     ${W}unused flatpak runtimes${N}   ${D}arc disk clean  (size varies, safe — only prunes orphaned runtimes)${N}"
  fi

  echo -e "\n$HR"
  echo -e "  ${D}arc disk clean${N}  reclaims all of the above except pip/apt (run those directly)"
  echo -e "$HR"
}

_disk_clean() {
  echo -e "$HR"
  echo -e "  ${C}${B}arc disk clean${N}  —  reclaim safe, known caches"
  echo -e "$HR\n"

  local start end mb
  start=$(disk_kb)

  if command -v npm &>/dev/null; then
    echo -e "  ${C}npm cache...${N}"
    npm cache clean --force &>/dev/null
    rm -rf "$HOME/.npm/_npx"/* 2>/dev/null
    echo -e "  ${G}✓${N}  cleaned (_cacache + _npx)"
  fi

  if [[ -d "$HOME/.local/share/claude/versions" ]]; then
    echo -e "  ${C}superseded Claude Code CLI versions...${N}"
    local current removed=0
    current=$(claude --version 2>/dev/null | awk '{print $1}')
    for v in "$HOME/.local/share/claude/versions"/*; do
      [[ -e "$v" ]] || continue
      [[ "$(basename "$v")" == "$current" ]] && continue
      rm -f "$v" && (( removed++ ))
    done
    (( removed > 0 )) && echo -e "  ${G}✓${N}  removed ${removed} old version(s), kept ${current}" \
      || echo -e "  ${D}·${N}  nothing superseded"
  fi

  if command -v flatpak &>/dev/null; then
    echo -e "  ${C}unused flatpak runtimes...${N}"
    local fp_out
    fp_out=$(flatpak uninstall -y --unused 2>&1)
    if [[ "$fp_out" == *"Nothing unused"* ]]; then
      echo -e "  ${D}·${N}  nothing unused"
    else
      echo -e "  ${G}✓${N}  pruned"
    fi
  fi

  end=$(disk_kb)
  mb=$(saved_mb "$start" "$end")

  echo -e "\n$HR"
  echo -e "  ${G}done${N}  ${D}·${N}  ${G}+${mb} MB reclaimed${N}"
  echo -e "  ${C}disk${N}    $(disk_used) used  ${D}·${N}  $(disk_free) free"
  echo -e "  ${D}still growing? try:${N}  ${C}arc browser-clean${N}  ·  ${C}sudo apt clean${N}"
  echo -e "$HR"
}

cmd_disk() {
  local sub="${1:-}"
  case "$sub" in
    ''|top)  _disk_top ;;
    caches)  _disk_caches ;;
    clean)   _disk_clean ;;
    *)
      echo -e "${R}unknown:${N} arc disk ${sub}"
      echo -e "${D}options: top (default) · caches · clean${N}"
      ;;
  esac
}

# ── Audit ──────────────────────────────────────────────────────────────────────
cmd_audit() {
  echo -e "$HR"
  echo -e "  ${C}${B}arc audit${N}  —  git repository audit"
  echo -e "$HR"

  local found=0
  while IFS= read -r d; do
    [[ -z "$d" ]] && continue
    found=1
    local name branch short ahead behind last
    name=$(basename "$d")
    branch=$(git -C "$d" branch --show-current 2>/dev/null)
    last=$(git -C "$d" log -1 --format="%cr" 2>/dev/null || echo "no commits")
    short=$(git -C "$d" status --short 2>/dev/null)

    echo -e "\n${C}fetching ${name}...${N}" >&2
    git -C "$d" fetch --prune &>/dev/null

    ahead=$(git -C "$d" rev-list @{u}..HEAD 2>/dev/null | wc -l | tr -d ' ')
    behind=$(git -C "$d" rev-list HEAD..@{u} 2>/dev/null | wc -l | tr -d ' ')

    if [[ -n "$short" ]]; then
      echo -e "\n  ${Y}⚠${N}  ${W}${name}${N}  ${D}[${branch}]${N}  ${D}·  ${last}${N}"
      echo "$short" | while IFS= read -r line; do
        echo -e "       ${D}${line}${N}"
      done
    else
      echo -e "\n  ${G}✓${N}  ${W}${name}${N}  ${D}[${branch}]${N}  ${D}·  ${last}${N}"
    fi

    (( ahead  > 0 )) && echo -e "       ${C}${ahead} commit(s) ahead of remote — push when ready${N}"
    (( behind > 0 )) && echo -e "       ${R}${behind} commit(s) behind remote — consider pulling${N}"
  done < <(scan_repos)

  (( found == 0 )) && echo -e "  ${D}no repos found${N}"
  echo -e "\n$HR"
}

# ── Setup ──────────────────────────────────────────────────────────────────────
cmd_setup() {
  echo -e "$HR"
  echo -e "  ${C}${B}arc setup${N}  —  git + ssh first-time configuration"
  echo -e "$HR\n"

  echo -e "${C}installing git...${N}"
  sudo apt update && sudo apt install git -y

  echo ""
  read -rp "  github username: " git_user
  read -rp "  github email:    " git_email

  git config --global user.name  "$git_user"
  git config --global user.email "$git_email"
  git config --global core.excludesfile ~/.gitignore_global
  git config --global init.defaultBranch main

  echo -e "\n${C}global gitignore...${N}"
  for entry in '.env' '*.env.local' '*.log' 'node_modules/' '.DS_Store' '__pycache__/' '*.pyc' '.expo/'; do
    grep -qxF "$entry" ~/.gitignore_global 2>/dev/null || echo "$entry" >> ~/.gitignore_global
  done

  local key_is_new=0
  if [[ ! -f ~/.ssh/id_ed25519 ]]; then
    echo -e "\n${C}generating ssh key (ed25519)...${N}"
    ssh-keygen -t ed25519 -C "$git_email" -f ~/.ssh/id_ed25519 -N ""
    eval "$(ssh-agent -s)"
    ssh-add ~/.ssh/id_ed25519
    key_is_new=1
  else
    echo -e "\n${D}ssh key already exists — skipping keygen${N}"
  fi

  echo -e "\n$HR"
  if (( key_is_new )); then
    echo -e "  ${C}add this key to github.com › Settings › SSH keys${N}"
  else
    echo -e "  ${D}your existing key — only add to GitHub if not already done${N}"
  fi
  echo -e "$HR"
  cat ~/.ssh/id_ed25519.pub
  echo -e "$HR"
  echo -e "  ${D}test with:  ssh -T git@github.com${N}"
  echo -e "$HR"
}

# ── Keys ───────────────────────────────────────────────────────────────────────
_KEYS_LIST=(
  "$HOME/.ssh/id_ed25519:kwasikontor45 (primary)"
  "$HOME/.ssh/id_ed25519_k6:k6-bleedin6ed6e-k6 (contingency)"
)

_keys_guard() {
  local quiet=0
  [[ "${1:-}" == "--quiet" ]] && quiet=1

  ssh-add -l &>/dev/null
  local rc=$?
  if (( rc == 2 )); then
    (( quiet )) || { echo -e "  ${R}✗${N}  no ssh-agent reachable"; }
    return 1
  fi

  (( quiet )) || { echo -e "$HR"; echo -e "  ${C}${B}arc keys guard${N}  —  ensure GitHub keys load with confirm-on-use"; echo -e "$HR\n"; }

  local loaded_fps; loaded_fps=$(ssh-add -l 2>/dev/null | awk '{print $2}')

  for entry in "${_KEYS_LIST[@]}"; do
    local path="${entry%%:*}" label="${entry##*:}"
    [[ -f "$path" ]] || continue
    local fp; fp=$(ssh-keygen -lf "$path" 2>/dev/null | awk '{print $2}')
    if [[ -n "$fp" ]] && grep -q "$fp" <<< "$loaded_fps"; then
      (( quiet )) || echo -e "  ${D}·${N}  ${label} already loaded"
    else
      if ssh-add -c "$path" &>/dev/null; then
        echo -e "  ${G}✓${N}  ${label} loaded with confirm-on-use"
      else
        (( quiet )) || echo -e "  ${R}✗${N}  ${label} failed to load"
      fi
    fi
  done

  (( quiet )) || echo -e "$HR"
}

cmd_keys() {
  local sub="${1:-}"
  case "$sub" in
    guard)
      _keys_guard
      ;;
    guard-quiet)
      _keys_guard --quiet
      ;;
    '')
      echo -e "$HR"
      echo -e "  ${C}${B}arc keys${N}  —  SSH public keys"
      echo -e "$HR\n"

      for entry in "${_KEYS_LIST[@]}"; do
        local path="${entry%%:*}"
        local label="${entry##*:}"
        echo -e "  ${C}${label}${N}"
        if [[ -f "${path}.pub" ]]; then
          echo -e "  ${G}✓${N}  ${path}.pub"
          echo -e "  ${D}$(cat "${path}.pub")${N}"
          echo -e "  ${D}test: ssh -T git@github.com${N}"
        else
          echo -e "  ${R}✗${N}  ${path}.pub not found"
        fi
        echo ""
      done

      echo -e "  ${D}to add a key: github.com › Settings › SSH and GPG keys › New SSH key${N}"
      echo -e "  ${D}arc keys guard         ${N}${D}— load both into the agent with confirm-on-use${N}"
      echo -e "  ${D}arc keys guard-quiet   ${N}${D}— same, silent unless it loads something (manual — no longer auto-run at shell startup, too disruptive in practice)${N}"
      echo -e "$HR"
      ;;
    *)
      echo -e "${R}unknown:${N} arc keys ${sub}"
      echo -e "${D}options: guard · guard-quiet${N}"
      ;;
  esac
}

# ── Expo ───────────────────────────────────────────────────────────────────────
cmd_expo() {
  local mode_arg="${1:-}"
  local PROJECT_DIR="${ARC_EXPO_DIR:-}"

  echo -e "$HR"
  echo -e "  ${C}${B}arc expo${N}  —  expo dev server"
  echo -e "$HR\n"

  if [[ -z "$PROJECT_DIR" ]]; then
    echo -e "  ${R}ARC_EXPO_DIR is not set${N}"
    echo -e "  ${D}add to ~/.bashrc:${N}"
    echo -e "  ${D}export ARC_EXPO_DIR=\"/path/to/expo/project\"${N}"
    echo -e "$HR"
    return 1
  fi

  # Kill stale Metro on 8081
  local stale
  stale=$(lsof -ti :8081 2>/dev/null || true)
  if [[ -n "$stale" ]]; then
    echo -e "${Y}clearing stale Metro on 8081...${N}"
    echo "$stale" | xargs kill -9 2>/dev/null || true
    sleep 1
  fi

  # Mode: explicit arg > env var > tunnel default
  local MODE
  if [[ "$mode_arg" == "lan" ]]; then
    MODE="lan"
  elif [[ "$mode_arg" == "tunnel" ]]; then
    MODE="tunnel"
  else
    MODE="${ARC_EXPO_MODE:-tunnel}"
  fi

  echo -e "  ${D}mode: --${MODE}${N}"
  echo -e "${C}starting Expo...${N}"
  echo -e "$HR\n"

  cd "$PROJECT_DIR" || return 1

  local PKG
  if [[ -f pnpm-lock.yaml ]]; then
    PKG="pnpm"
  elif [[ -f yarn.lock ]]; then
    PKG="yarn"
  else
    PKG="npx"
  fi

  $PKG expo start --$MODE --clear
}


# ── Mirror ─────────────────────────────────────────────────────────────────────
cmd_mirror() {
  echo -e "$HR"
  echo -e "  ${C}${B}arc mirror${N}  —  push repo to k6 contingency"
  echo -e "$HR\n"

  local dir
  dir=$(git rev-parse --show-toplevel 2>/dev/null)
  if [[ -z "$dir" ]]; then
    echo -e "  ${R}✗${N}  not inside a git repo"
    echo -e "  ${D}cd into a repo first, then run arc mirror${N}"
    echo -e "$HR"
    return 1
  fi

  local name
  name=$(basename "$dir")
  local remote="git@github-k6:k6-bleedin6ed6e-k6/${name}.git"

  echo -e "  ${C}repo:${N}   ${name}"
  echo -e "  ${C}target:${N} ${remote}\n"

  echo -e "  ${C}pushing all branches...${N}"
  git -C "$dir" push "$remote" --all && echo -e "  ${G}✓${N}  branches pushed"

  echo -e "  ${C}pushing tags...${N}"
  git -C "$dir" push "$remote" --tags && echo -e "  ${G}✓${N}  tags pushed"

  echo -e "\n$HR"
}

# ── Wire ───────────────────────────────────────────────────────────────────────
cmd_wire() {
  echo -e "$HR"
  echo -e "  ${C}${B}arc wire${N}  —  wire dual-push for this repo"
  echo -e "$HR\n"

  local dir
  dir=$(git rev-parse --show-toplevel 2>/dev/null)
  if [[ -z "$dir" ]]; then
    echo -e "  ${R}✗${N}  not inside a git repo"
    echo -e "$HR"; return 1
  fi

  local name fetch_url
  name=$(basename "$dir")
  fetch_url=$(git -C "$dir" remote get-url origin 2>/dev/null)
  if [[ -z "$fetch_url" ]]; then
    echo -e "  ${R}✗${N}  no origin remote found"
    echo -e "$HR"; return 1
  fi

  local k6_url="git@github-k6:k6-bleedin6ed6e-k6/${name}.git"
  echo -e "  ${C}repo:${N}    ${name}"
  echo -e "  ${C}primary:${N} ${fetch_url}"
  echo -e "  ${C}k6:${N}      ${k6_url}\n"

  local push_urls
  push_urls=$(git -C "$dir" remote -v | grep '(push)' | awk '{print $2}')
  if echo "$push_urls" | grep -q "k6-bleedin6ed6e-k6"; then
    echo -e "  ${G}✓${N}  dual-push already wired"
    echo -e "$HR"; return 0
  fi

  git -C "$dir" remote set-url --push origin "$fetch_url" \
    && echo -e "  ${G}✓${N}  primary push: ${fetch_url}"
  git -C "$dir" remote set-url --push --add origin "$k6_url" \
    && echo -e "  ${G}✓${N}  k6 push:      ${k6_url}"

  echo -e "\n  ${D}verify: git remote -v${N}"
  echo -e "$HR"
}

# ── Day ────────────────────────────────────────────────────────────────────────
cmd_day() {
  echo -e "$HR"
  echo -e "  ${C}${B}arc day${N}  —  morning startup"
  echo -e "$HR\n"

  # ── SOP ack gate (soft) ────────────────────────────────────────────────────
  if ! arc-sop ack-today 2>/dev/null; then
    notify-send -u critical -i dialog-warning "arc · SOP gate" "No SOP acknowledgment recorded today. Run: arc sop ack" 2>/dev/null || true
    echo -e "  ${Y}⚠${N}  ${B}no SOP acknowledgment recorded today${N}"
    echo -e "  ${M}agents:${N}  read ${C}~/dev-notes/intel-ops/SOT.md${N}  then run ${C}arc sop ack${N}"
    echo -e "  ${D}MO V:${N}    log ${C}[STARTING]${N} ${D}in GAMEPLAN.md before any task${N}"
    echo -e ""
    printf "  ${D}press Enter to continue · Ctrl-C to abort:${N} "
    read -r _arc_sop_gate
    echo ""
  fi

  echo -e "  ${C}storage drive${N}"
  if storage_ok; then
    local usb_used usb_free
    usb_used=$(df -h /mnt/storage | awk 'NR==2 {print $3}')
    usb_free=$(df -h /mnt/storage | awk 'NR==2 {print $4}')
    echo -e "  ${G}✓${N}  /mnt/storage mounted  —  ${usb_used} used · ${usb_free} free"
  else
    echo -e "  ${R}✗${N}  USB not accessible — run ${C}arc mount${N}  ${D}(stale mount or unplugged)${N}"
    echo -e "\n$HR"
    return 1
  fi

  local STAMP="$HOME/.usb-bakup/.last-sync"
  echo ""
  echo -e "  ${C}backup${N}"
  if [[ -f "$STAMP" ]]; then
    echo -e "  ${D}·${N}  last sync: $(cat "$STAMP")"
  else
    echo -e "  ${Y}!${N}  no backup on record — run ${C}arc backup${N} before you start"
  fi

  echo ""
  echo -e "$HR"
  cmd_status

  echo ""
  echo -e "  ${C}SOP compliance check${N}"
  cmd_arc_check
}

# ── Backup ─────────────────────────────────────────────────────────────────────
cmd_backup() {
  echo -e "$HR"
  echo -e "  ${C}${B}arc backup${N}  —  sync local work → USB vault"
  echo -e "$HR\n"

  local BAKUP_SCRIPT
  BAKUP_SCRIPT=$(command -v bakup-usb 2>/dev/null)
  if [[ -z "$BAKUP_SCRIPT" ]]; then
    for p in "$HOME/local-dev/bakup-usb" "$HOME/.local/bin/bakup-usb"; do
      [[ -x "$p" ]] && BAKUP_SCRIPT="$p" && break
    done
  fi

  if [[ -z "$BAKUP_SCRIPT" ]]; then
    echo -e "  ${R}bakup-usb not found${N}"
    echo -e "  ${D}expected at ~/local-dev/bakup-usb${N}"
    echo -e "$HR"
    return 1
  fi

  bash "$BAKUP_SCRIPT"
  echo -e "$HR"
}

# ── Sync ───────────────────────────────────────────────────────────────────────
cmd_sync() {
  echo -e "$HR"
  echo -e "  ${C}${B}arc sync${N}  —  vault → MEGA cloud backup"
  echo -e "$HR\n"

  if ! storage_ok; then
    echo -e "  ${R}✗${N}  USB not accessible — cannot sync to MEGA  ${D}(stale mount or unplugged)${N}"
    echo -e "$HR"
    return 1
  fi

  echo -e "  ${C}syncing vault → MEGA...${N}"
  if sudo /usr/local/bin/vault-backup-mega; then
    echo -e "  ${G}✓${N}  MEGA vault sync complete"
    notify-send -i dialog-information "arc sync" "MEGA vault sync complete" 2>/dev/null || true

    local SIZE_LOG="/var/log/vault-mega-sizes.csv"
    if [[ -r "$SIZE_LOG" ]]; then
      local cur_bytes prev_bytes cur_gb
      cur_bytes=$(tail -1 "$SIZE_LOG" 2>/dev/null | cut -d',' -f2)
      prev_bytes=$(tail -2 "$SIZE_LOG" 2>/dev/null | head -1 | cut -d',' -f2)
      if [[ "$cur_bytes" =~ ^[0-9]+$ ]]; then
        cur_gb=$(echo "scale=2; $cur_bytes / 1073741824" | bc 2>/dev/null)
        if [[ "$prev_bytes" =~ ^[0-9]+$ ]] && (( prev_bytes > 0 )); then
          local pct=$(( (cur_bytes - prev_bytes) * 100 / prev_bytes ))
          if (( pct >= 15 )); then
            echo -e "  ${Y}⚠  vault grew ${pct}% since last sync — now ${cur_gb}G${N}"
          else
            echo -e "  ${D}vault size: ${cur_gb}G  (${pct}% vs last sync)${N}"
          fi
        else
          echo -e "  ${D}vault size: ${cur_gb}G${N}"
        fi
      fi
    fi
  else
    echo -e "  ${R}✗${N}  MEGA sync failed — check /var/log/vault-mega.log"
    notify-send -u critical -i dialog-error "arc sync" "MEGA sync failed — check /var/log/vault-mega.log" 2>/dev/null || true
  fi
  echo -e "\n$HR"
}

# ── MEGA browser ───────────────────────────────────────────────────────────────
cmd_mega() {
  local sub="${1:-}"
  local path="${2:-}"
  local remote="mega:${path:+/$path}"

  echo -e "$HR"
  echo -e "  ${C}${B}arc mega${N}  —  browse MEGA cloud contents"
  echo -e "$HR\n"

  case "$sub" in
    ls)
      echo -e "  ${D}rclone ls ${remote}${N}\n"
      rclone ls "$remote"
      ;;
    lsd)
      echo -e "  ${D}rclone lsd ${remote}${N}\n"
      rclone lsd "$remote"
      ;;
    tree)
      echo -e "  ${D}rclone tree ${remote}${N}\n"
      rclone tree "$remote"
      ;;
    *)
      echo -e "  ${D}subcommands:${N}"
      echo -e "  ${C}arc mega ls   ${D}[path]${N}    ${M}list files with sizes${N}"
      echo -e "  ${C}arc mega lsd  ${D}[path]${N}    ${M}list directories only${N}"
      echo -e "  ${C}arc mega tree ${D}[path]${N}    ${M}visual tree${N}"
      echo -e "\n  ${D}examples:${N}"
      echo -e "  ${D}arc mega ls${N}               ${D}# top-level files${N}"
      echo -e "  ${D}arc mega lsd${N}              ${D}# top-level dirs${N}"
      echo -e "  ${D}arc mega tree vault${N}       ${D}# tree of mega:/vault${N}"
      echo -e "  ${D}arc mega ls vault/forge${N}   ${D}# files in mega:/vault/forge${N}"
      ;;
  esac

  echo -e "\n$HR"
}

# ── Storage unmount kill switch ────────────────────────────────────────────────
# Auto-clears known/likely blockers before unmounting /mnt/storage so
# restart/safe-reboot/stop don't stall the way arc safe-reboot did on
# 2026-07-29 (notes-site.service's server had its cwd inside the mount,
# PID 3294, required manual diagnosis via lsof). Runs before every umount
# attempt, not as a retry-after-failure, so the existing umount call just
# succeeds. Only used by the local restart/reboot/stop workflows below —
# not a general permission bypass of anything (SOP gate is untouched).
_kill_storage_blockers() {
  if systemctl --user is-active --quiet notes-site.service 2>/dev/null; then
    systemctl --user stop notes-site.service 2>/dev/null \
      && echo -e "  ${G}✓${N}  stopped notes-site.service (was serving from inside the mount)"
  fi

  local blockers pid comm
  blockers=$(sudo lsof -t +D /mnt/storage 2>/dev/null | sort -u)
  if [[ -n "$blockers" ]]; then
    for pid in $blockers; do
      comm=$(ps -p "$pid" -o comm= 2>/dev/null)
      kill "$pid" 2>/dev/null && echo -e "  ${G}✓${N}  killed blocker: ${comm:-pid $pid} (pid $pid)"
    done
    sleep 1
  fi
}

# ── Restart ────────────────────────────────────────────────────────────────────
cmd_restart() {
  echo -e "$HR"
  echo -e "  ${C}${B}arc restart${N}  —  safe warm restart"
  echo -e "$HR\n"

  pgrep -f "eero-watch.py" &>/dev/null \
    && pkill -f "eero-watch.py" && echo -e "  ${G}✓${N}  eero-watch stopped"

  local killed=0
  for pat in "expo start" "metro" "npx expo" "node_modules/.bin/expo"; do
    if pgrep -f "$pat" &>/dev/null; then
      pkill -f "$pat" 2>/dev/null && echo -e "  ${G}✓${N}  killed: $pat" && killed=1
    fi
  done
  (( killed == 0 )) && echo -e "  ${D}·${N}  no dev servers running"

  echo ""
  if mountpoint -q /mnt/storage 2>/dev/null; then
    echo -e "  ${C}backing up before unmount...${N}"
    cmd_backup
    echo ""
    _kill_storage_blockers
    echo -e "  ${C}unmounting storage drive...${N}"
    if sudo umount /mnt/storage 2>/dev/null; then
      echo -e "  ${G}✓${N}  /mnt/storage unmounted"
      sudo cryptsetup close storage_crypt 2>/dev/null && \
        echo -e "  ${G}✓${N}  LUKS container closed"
    else
      echo -e "  ${R}✗${N}  unmount failed — check: lsof +D /mnt/storage"
      echo -e "  ${R}aborting restart${N}"
      return 1
    fi
  else
    echo -e "  ${D}·${N}  storage not mounted — skipping"
  fi

  echo ""
  for i in 5 4 3 2 1; do
    printf "\r  ${Y}logging out in ${i}s — Ctrl+C to abort${N}  "
    sleep 1
  done
  printf "\n"
  xfce4-session-logout --logout --fast
}

# ── Safe reboot ────────────────────────────────────────────────────────────────
cmd_safe_reboot() {
  echo -e "$HR"
  echo -e "  ${C}${B}arc safe-reboot${N}  —  clean shutdown + system reboot"
  echo -e "$HR\n"

  pgrep -f "eero-watch.py" &>/dev/null \
    && pkill -f "eero-watch.py" && echo -e "  ${G}✓${N}  eero-watch stopped"

  local killed=0
  for pat in "expo start" "metro" "npx expo" "node_modules/.bin/expo"; do
    if pgrep -f "$pat" &>/dev/null; then
      pkill -f "$pat" 2>/dev/null && echo -e "  ${G}✓${N}  killed: $pat" && killed=1
    fi
  done
  (( killed == 0 )) && echo -e "  ${D}·${N}  no dev servers running"

  echo ""
  if mountpoint -q /mnt/storage 2>/dev/null; then
    echo -e "  ${C}backing up before unmount...${N}"
    cmd_backup
    echo ""
    _kill_storage_blockers
    echo -e "  ${C}unmounting storage drive...${N}"
    if sudo umount /mnt/storage 2>/dev/null; then
      echo -e "  ${G}✓${N}  /mnt/storage unmounted"
      sudo cryptsetup close storage_crypt 2>/dev/null && \
        echo -e "  ${G}✓${N}  LUKS container closed"
    else
      echo -e "  ${R}✗${N}  unmount failed — check: lsof +D /mnt/storage"
      echo -e "  ${R}aborting reboot${N}"
      return 1
    fi
  else
    echo -e "  ${D}·${N}  storage not mounted — skipping"
  fi

  echo ""
  for i in 5 4 3 2 1; do
    printf "\r  ${Y}rebooting in ${i}s — Ctrl+C to abort${N}  "
    sleep 1
  done
  printf "\n"
  sudo reboot
}

# ── Browser Cache Clean ────────────────────────────────────────────────────────
cmd_browser_clean() {
  local FORCE=0
  [[ "${1:-}" == "--force" ]] && FORCE=1

  echo -e "$HR"
  echo -e "  ${C}${B}arc browser-clean${N}  —  clear Brave + Firefox caches"
  (( FORCE )) && echo -e "  ${Y}·${N}  --force: cleaning even if browsers are open"
  echo -e "$HR\n"

  local total_before total_after freed
  total_before=$(df / | awk 'NR==2 {print $3}')

  # ── Brave ──────────────────────────────────────────────────────────────────
  echo -e "  ${C}brave${N}"
  local BRAVE_BASE="$HOME/.config/BraveSoftware/Brave-Browser/Default"
  local BRAVE_CACHE_DIRS=(
    "Cache"
    "Code Cache"
    "GPUCache"
    "DawnGraphiteCache"
    "DawnWebGPUCache"
    "CacheStorage"
    "Service Worker"
  )

  if pgrep -x "brave-browser" &>/dev/null || pgrep -f "brave-browser" &>/dev/null; then
    if (( FORCE )); then
      echo -e "  ${Y}·${N}  brave is running — forcing clean anyway"
    else
      echo -e "  ${Y}·${N}  brave is running — skipping (use --force to override)"
      echo ""
    fi
  fi

  if ! pgrep -f "brave-browser" &>/dev/null || (( FORCE )); then
    local brave_cleaned=0
    for d in "${BRAVE_CACHE_DIRS[@]}"; do
      local full="$BRAVE_BASE/$d"
      if [[ -d "$full" ]]; then
        local sz; sz=$(du -sh "$full" 2>/dev/null | cut -f1)
        rm -rf "$full" 2>/dev/null && \
          echo -e "  ${G}✓${N}  cleared: ${D}${d}${N}  ${D}(${sz})${N}" && \
          (( brave_cleaned++ ))
      fi
    done
    (( brave_cleaned == 0 )) && echo -e "  ${D}·${N}  nothing to clean"
  fi

  # ── Firefox ────────────────────────────────────────────────────────────────
  echo ""
  echo -e "  ${C}firefox${N}"
  local FF_PROFILE="$HOME/.mozilla/firefox"

  if pgrep -x "firefox" &>/dev/null || pgrep -f "firefox-esr" &>/dev/null; then
    if (( FORCE )); then
      echo -e "  ${Y}·${N}  firefox is running — forcing clean anyway"
    else
      echo -e "  ${Y}·${N}  firefox is running — skipping (use --force to override)"
      echo ""
    fi
  fi

  if ! pgrep -f "firefox" &>/dev/null || (( FORCE )); then
    local ff_cleaned=0
    # per-profile cache dirs
    for profile_dir in "$FF_PROFILE"/*/; do
      [[ -d "$profile_dir" ]] || continue
      for subdir in cache2 startupCache minidumps crashes "saved-telemetry-pings" "sessionstore-logs"; do
        local target="$profile_dir$subdir"
        if [[ -d "$target" ]]; then
          local sz; sz=$(du -sh "$target" 2>/dev/null | cut -f1)
          rm -rf "$target" 2>/dev/null && \
            echo -e "  ${G}✓${N}  cleared: ${D}$(basename "$profile_dir")/${subdir}${N}  ${D}(${sz})${N}" && \
            (( ff_cleaned++ ))
        fi
      done
    done
    # top-level crash and telemetry dirs
    for d in "Crash Reports" "Pending Pings"; do
      local target="$FF_PROFILE/$d"
      if [[ -d "$target" ]]; then
        local sz; sz=$(du -sh "$target" 2>/dev/null | cut -f1)
        rm -rf "$target" 2>/dev/null && \
          echo -e "  ${G}✓${N}  cleared: ${D}${d}${N}  ${D}(${sz})${N}" && \
          (( ff_cleaned++ ))
      fi
    done
    (( ff_cleaned == 0 )) && echo -e "  ${D}·${N}  nothing to clean"
  fi

  echo ""
  total_after=$(df / | awk 'NR==2 {print $3}')
  freed=$(( total_before - total_after ))
  echo -e "$HR"
  if (( freed > 0 )); then
    echo -e "  ${G}freed: ~${freed}KB${N}"
  else
    echo -e "  ${D}freed: 0  (caches already empty or browsers were open)${N}"
  fi
  echo -e "$HR"
}

# ── Stop ───────────────────────────────────────────────────────────────────────
cmd_stop() {
  echo -e "$HR"
  echo -e "  ${C}${B}arc stop${N}  —  safe end-of-day shutdown"
  echo -e "$HR\n"

  # ── DONE-balance gate (soft) ────────────────────────────────────────────────
  if ! arc-sop done-balance 2>/dev/null; then
    notify-send -u critical -i dialog-warning "arc · stop gate" "Tasks without [DONE] in GAMEPLAN.md. Log before stopping." 2>/dev/null || true
    echo -e "  ${Y}⚠${N}  ${B}some tasks have no [DONE] entry in GAMEPLAN.md${N}"
    echo -e "  ${D}MO V: log [DONE] after every task before stopping${N}"
    echo -e ""
    printf "  ${D}press Enter to continue · Ctrl-C to go log it:${N} "
    read -r _arc_done_gate
    echo ""
  fi

  local killed=0
  for pat in "expo start" "metro" "npx expo" "node_modules/.bin/expo"; do
    if pgrep -f "$pat" &>/dev/null; then
      pkill -f "$pat" 2>/dev/null && echo -e "  ${G}✓${N}  killed: $pat" && killed=1
    fi
  done
  (( killed == 0 )) && echo -e "  ${D}·${N}  no dev servers running"

  echo ""
  echo -e "  ${C}running backup before unmount...${N}"
  cmd_backup

  echo ""
  if mountpoint -q /mnt/storage 2>/dev/null; then
    _kill_storage_blockers
    echo -e "  ${C}unmounting storage drive...${N}"
    if sudo umount /mnt/storage 2>/dev/null; then
      echo -e "  ${G}✓${N}  /mnt/storage unmounted"
      sudo cryptsetup close storage_crypt 2>/dev/null && \
        echo -e "  ${G}✓${N}  LUKS container closed"
      echo -e "\n  ${G}safe to unplug the drive.${N}"
    else
      echo -e "  ${R}✗${N}  unmount failed — check for open files"
      echo -e "     ${D}lsof +D /mnt/storage${N}"
    fi
  else
    echo -e "  ${D}·${N}  drive not mounted — nothing to unmount"
  fi

  echo ""
  echo -e "  ${C}SOP compliance check${N}"
  cmd_arc_check

  echo -e "\n$HR"
}

# ── Break ──────────────────────────────────────────────────────────────────────
BREAK_BIN="$HOME/.local/bin/arc-break"
BREAK_PID="$HOME/.local/share/arc-break/arc-break.pid"

cmd_break() {
  local sub="${1:-status}"
  shift 2>/dev/null

  case "$sub" in
    start)
      echo -e "$HR"
      echo -e "  ${C}${B}arc break start${N}"
      echo -e "$HR\n"
      if [[ -f "$BREAK_PID" ]] && kill -0 "$(cat "$BREAK_PID")" 2>/dev/null; then
        echo -e "  ${Y}!${N}  arc-break already running  —  PID $(cat "$BREAK_PID")"
        echo -e "$HR"; return 0
      fi
      # Runs as a systemd --user unit (not nohup/disown) so it survives the
      # terminal closing -- nohup only blocks SIGHUP, it doesn't detach from
      # the terminal's session, and desktop/terminal-emulator session teardown
      # can still reap it. A user service is supervised independently of any
      # terminal's lifecycle.
      systemctl --user start arc-break.service
      sleep 0.3
      local pid
      pid=$(cat "$BREAK_PID" 2>/dev/null || echo "?")
      echo -e "  ${G}✓${N}  arc-break started  —  PID ${pid}  (survives closing this terminal)"
      echo -e "  ${D}arc break status  ·  arc break stop  ·  arc break snooze${N}"
      echo -e "$HR"
      ;;

    stop)
      echo -e "$HR"
      echo -e "  ${C}${B}arc break stop${N}"
      echo -e "$HR\n"
      if [[ -f "$BREAK_PID" ]] && kill -0 "$(cat "$BREAK_PID")" 2>/dev/null; then
        systemctl --user stop arc-break.service 2>/dev/null
        echo -e "  ${G}✓${N}  arc-break stopped"
      else
        echo -e "  ${D}·${N}  not running"
      fi
      echo -e "$HR"
      ;;

    status)
      echo -e "$HR"
      echo -e "  ${C}${B}arc break status${N}"
      echo -e "$HR\n"
      if [[ ! -f "$BREAK_PID" ]] || ! kill -0 "$(cat "$BREAK_PID")" 2>/dev/null; then
        echo -e "  ${D}·${N}  not running  —  ${C}arc break start${N} to begin"
        echo -e "$HR"; return 0
      fi
      local info
      info=$(python3 "$BREAK_BIN" status 2>/dev/null)
      echo -e "  ${G}●${N}  ${M}${info}${N}"
      echo -e "$HR"
      ;;

    snooze)
      local mins="${1:-5}"
      python3 "$BREAK_BIN" snooze "$mins" 2>/dev/null \
        && echo -e "  ${G}✓${N}  break snoozed ${mins} min" \
        || echo -e "  ${R}✗${N}  arc-break not running"
      ;;

    skip)
      python3 "$BREAK_BIN" skip 2>/dev/null \
        && echo -e "  ${G}✓${N}  break skipped — work timer reset" \
        || echo -e "  ${R}✗${N}  arc-break not running"
      ;;

    config)
      echo -e "$HR"
      echo -e "  ${C}${B}arc break config${N}"
      echo -e "$HR\n"
      python3 "$BREAK_BIN" config 2>/dev/null | while IFS= read -r line; do
        echo -e "  ${D}·${N}  ${M}${line}${N}"
      done
      echo -e "$HR"
      ;;

    gui)
      if pgrep -f "arc-break gui" &>/dev/null; then
        echo -e "  ${Y}!${N}  arc-break gui already open"
      else
        nohup python3 "$BREAK_BIN" gui &>/dev/null &
        disown
        echo -e "  ${G}✓${N}  arc-break gui launched"
      fi
      ;;

    *)
      echo -e "  usage: arc break [start|stop|status|snooze [N]|skip|config|gui]"
      ;;
  esac
}

# ── Eero ───────────────────────────────────────────────────────────────────────
EERO_DIR="$HOME/dev-notes/surgery-tools/eero"
EERO_MGR="$EERO_DIR/eero-mgr.py"
EERO_WATCH="$EERO_DIR/eero-watch.py"
EERO_LOG="$EERO_DIR/eero-watch.log"
# aiohttp + the local eero/ package live in a venv -- system python3's pip is
# blocked on this machine (Debian ensurepip restriction), and there's no
# equivalent apt package for the hand-written eero/client.py module.
EERO_PY="$EERO_DIR/.venv/bin/python"

cmd_eero() {
  echo -e "$HR"
  echo -e "  ${C}${B}arc eero${N}  —  router manager"
  echo -e "$HR\n"

  if [[ ! -f "$EERO_MGR" ]]; then
    echo -e "  ${R}✗${N}  eero-mgr.py not found at ${EERO_MGR}"
    echo -e "$HR"
    return 1
  fi

  "$EERO_PY" "$EERO_MGR"
}

cmd_eero_watch() {
  echo -e "$HR"
  echo -e "  ${C}${B}arc eero-watch${N}  —  network monitor"
  echo -e "$HR\n"

  if [[ ! -f "$EERO_WATCH" ]]; then
    echo -e "  ${R}✗${N}  eero-watch.py not found at ${EERO_WATCH}"
    echo -e "$HR"
    return 1
  fi

  if pgrep -f "eero-watch.py" &>/dev/null; then
    echo -e "  ${Y}!${N}  monitor already running  —  use ${C}arc stop-eero${N} to stop it"
    echo -e "$HR"
    return 0
  fi

  nohup "$EERO_PY" "$EERO_WATCH" &>/dev/null &
  local pid=$!
  disown
  echo -e "  ${G}✓${N}  monitor started (background)  —  PID ${pid}"
  echo -e "  ${D}log:  ${EERO_LOG}${N}"
  echo -e "  ${D}view: arc eero-logs${N}"
  echo -e "$HR"
}

cmd_eero_logs() {
  echo -e "$HR"
  echo -e "  ${C}${B}arc eero-logs${N}  —  watch log"
  echo -e "$HR\n"

  if [[ ! -f "$EERO_LOG" ]]; then
    echo -e "  ${R}✗${N}  log not found at ${EERO_LOG}"
    echo -e "$HR"
    return 1
  fi

  if [[ ! -s "$EERO_LOG" ]]; then
    echo -e "  ${D}·${N}  log is empty"
    echo -e "$HR"
    return 0
  fi

  if command -v glow &>/dev/null; then
    glow "$EERO_LOG"
  else
    less "$EERO_LOG"
  fi

  echo -e "\n$HR"
  printf "  ${D}[c] clear log  ·  [enter] keep:${N} "
  read -r choice
  if [[ "$choice" == "c" ]]; then
    truncate -s 0 "$EERO_LOG"
    echo -e "  ${G}✓${N}  log cleared"
  fi
  echo -e "$HR"
}

cmd_stop_eero() {
  echo -e "$HR"
  echo -e "  ${C}${B}arc stop-eero${N}  —  stop network monitor"
  echo -e "$HR\n"

  if pgrep -f "eero-watch.py" &>/dev/null; then
    pkill -f "eero-watch.py" && echo -e "  ${G}✓${N}  monitor stopped"
  else
    echo -e "  ${D}·${N}  monitor not running"
  fi
  echo -e "$HR"
}

# ── Emoji ──────────────────────────────────────────────────────────────────────
EMOJI_LIST="$HOME/.config/emoji-pick/emojis.txt"
EMOJI_PICK="$HOME/.local/bin/emoji-pick"

cmd_emoji() {
  local sub="${1:-}"

  case "$sub" in
    add)
      shift 2>/dev/null
      local emoji="$1"; shift
      local words="$*"
      if [[ -z "$emoji" || -z "$words" ]]; then
        echo -e "$HR"
        echo -e "  ${R}usage:${N}  arc emoji add <emoji> <word1> [word2 ...]"
        echo -e "$HR"
        return 1
      fi
      mkdir -p "$(dirname "$EMOJI_LIST")"
      echo "$emoji $words" >> "$EMOJI_LIST"
      echo -e "$HR"
      echo -e "  ${G}✓${N}  added: ${emoji} ${D}${words}${N}"
      echo -e "$HR"
      ;;
    list)
      echo -e "$HR"
      echo -e "  ${C}${B}arc emoji list${N}  —  your emoji list"
      echo -e "$HR\n"
      if [[ ! -s "$EMOJI_LIST" ]]; then
        echo -e "  ${D}·${N}  list is empty — try: arc emoji add 🦊 fox animal"
      else
        cat "$EMOJI_LIST" | while IFS= read -r line; do
          echo -e "  ${D}·${N}  $line"
        done
      fi
      echo -e "\n$HR"
      ;;
    edit)
      mkdir -p "$(dirname "$EMOJI_LIST")"
      touch "$EMOJI_LIST"
      nano "$EMOJI_LIST"
      ;;
    '')
      echo -e "$HR"
      echo -e "  ${C}${B}arc emoji${N}  —  emoji picker"
      echo -e "$HR\n"
      if [[ ! -f "$EMOJI_PICK" ]]; then
        echo -e "  ${R}✗${N}  emoji-pick not found at ${EMOJI_PICK}"
        echo -e "  ${D}install the script first, then re-run${N}"
        echo -e "$HR"
        return 1
      fi
      "$EMOJI_PICK"
      ;;
    *)
      echo -e "${R}unknown:${N} arc emoji $sub  —  try: arc emoji · add · list · edit"
      return 1
      ;;
  esac
}

# ── Ref ────────────────────────────────────────────────────────────────────────
cmd_ref() {
  local ARCHIVE="${ARC_REF_DIR:-$HOME/archive}"
  local query="${1:-}"

  echo -e "$HR"
  echo -e "  ${C}${B}arc ref${N}  —  archived references"
  echo -e "$HR"

  if [[ ! -d "$ARCHIVE" ]]; then
    echo -e "  ${R}no archive found${N}"
    echo -e ""
    echo -e "  create a folder and drop files into it:"
    echo -e "  ${D}mkdir ~/archive${N}"
    echo -e ""
    echo -e "  or point arc at an existing folder:"
    echo -e "  ${D}export ARC_REF_DIR=\"\$HOME/your-folder\"  # add to ~/.bashrc${N}"
    echo -e "$HR"
    return 1
  fi

  if [[ -z "$query" ]]; then
    echo ""
    find "$ARCHIVE" -type f | sort | while IFS= read -r f; do
      local size rel
      size=$(wc -c < "$f" 2>/dev/null | tr -d ' ')
      rel="${f#$ARCHIVE/}"
      printf "  ${D}·${N}  %-48s  ${D}%s b${N}\n" "$rel" "$size"
    done
    echo ""
    echo -e "  ${D}arc ref <name>     — view a file by name${N}"
    echo -e "  ${D}arc ref <keyword>  — search across all files${N}"
  else
    local match
    match=$(find "$ARCHIVE" -type f -path "*${query}*" 2>/dev/null | head -1)
    if [[ -n "$match" ]]; then
      local rel="${match#$ARCHIVE/}"
      echo -e "\n  ${G}${rel}${N}\n"
      echo -e "$HR"
      case "$match" in
        *.docx|*.doc) echo -e "  ${D}binary — open manually:${N}\n  ${match}" ;;
        *)            cat "$match" ;;
      esac
    else
      echo -e "\n  ${C}searching: ${query}${N}\n"
      local hit=0
      while IFS= read -r f; do
        hit=1
        local rel="${f#$ARCHIVE/}"
        echo -e "  ${D}·${N}  ${W}${rel}${N}"
        grep -n "$query" "$f" 2>/dev/null | head -3 | while IFS= read -r line; do
          echo -e "       ${D}${line}${N}"
        done
      done < <(grep -rl "$query" "$ARCHIVE" 2>/dev/null)
      (( hit == 0 )) && echo -e "  ${D}nothing found for: ${query}${N}"
    fi
  fi
  echo -e "$HR"
}

# ── Find (cross-tree search) ────────────────────────────────────────────────────
cmd_find() {
  local query="$1"
  if [[ -z "$query" ]]; then
    echo -e "  usage: arc find <query>"
    return 1
  fi

  local labels=(arc-lt-cmc dev-notes khaos-lab vault/archive)
  local dirs=(
    "$HOME/arc-lt-cmc"
    "$HOME/dev-notes"
    "$HOME/khaos-lab"
    "${ARC_REF_DIR:-$HOME/links/vault/archive}"
  )

  echo -e "$HR"
  echo -e "  ${C}${B}arc find${N}  —  searching: ${W}${query}${N}"
  echo -e "$HR"

  local i found_any=0
  for i in "${!labels[@]}"; do
    local label="${labels[$i]}" dir="${dirs[$i]}"
    [[ -d "$dir" ]] || continue

    local content_hits name_hits
    content_hits=$(grep -rniI \
      --exclude-dir='.git' --exclude-dir='node_modules' --exclude-dir='__pycache__' \
      --exclude-dir='.arc-notes' --exclude-dir='master-archive' \
      -e "$query" "$dir" 2>/dev/null)
    name_hits=$(find "$dir" -iname "*${query}*" \
      -not -path '*/.git/*' -not -path '*/node_modules/*' -not -path '*/master-archive/*' 2>/dev/null)

    if [[ -n "$content_hits" || -n "$name_hits" ]]; then
      found_any=1
      echo -e "\n  ${C}${B}${label}${N}"

      if [[ -n "$name_hits" ]]; then
        echo -e "  ${D}filename matches${N}"
        while IFS= read -r f; do
          [[ -z "$f" ]] && continue
          echo -e "  ${G}·${N}  ${f#$dir/}"
        done <<< "$name_hits"
      fi

      if [[ -n "$content_hits" ]]; then
        echo -e "  ${D}content matches${N}"
        while IFS=: read -r file line rest; do
          [[ -z "$file" ]] && continue
          local snippet
          snippet=$(echo "$rest" | sed -e 's/^[[:space:]]*//' | cut -c1-80)
          printf "  ${D}·${N}  %-50s ${D}:%s${N}  %s\n" "${file#$dir/}" "$line" "$snippet"
        done <<< "$content_hits"
      fi
    fi
  done

  (( found_any == 0 )) && echo -e "\n  ${D}nothing found for: ${query}${N}"
  echo -e "\n$HR"
}

# ── Book (compiled reference archive) ───────────────────────────────────────────
cmd_book() {
  local sub="${1:-}"
  local BOOK="$HOME/khaos-lab/master-archive/master-book.md"

  case "$sub" in
    rebuild)
      echo -e "$HR"
      echo -e "  ${C}${B}arc book rebuild${N}  —  recompiling master-book.md"
      echo -e "$HR\n"
      if [[ -x "$HOME/.local/bin/build-master-book" ]]; then
        "$HOME/.local/bin/build-master-book"
      else
        echo -e "  ${R}✗${N}  build-master-book not found at ~/.local/bin/build-master-book"
        echo -e "$HR"
        return 1
      fi
      echo -e "\n$HR"
      ;;
    *)
      echo -e "$HR"
      echo -e "  ${C}${B}arc book${N}  —  compiled reference archive"
      echo -e "$HR\n"
      if [[ -f "$BOOK" ]]; then
        local size lines built
        size=$(du -h "$BOOK" | cut -f1)
        lines=$(wc -l < "$BOOK")
        built=$(date -r "$BOOK" "+%Y-%m-%d %H:%M")
        echo -e "  ${D}path${N}     ${M}${BOOK}${N}"
        echo -e "  ${D}size${N}     ${M}${size}${N}  ${D}·${N}  ${M}${lines}${N} lines"
        echo -e "  ${D}built${N}    ${M}${built}${N}"
      else
        echo -e "  ${R}not built yet${N}  ${D}— run: arc book rebuild${N}"
      fi
      echo -e "\n  ${D}arc book rebuild   — recompile from current dev-notes/khaos-lab/arc-lt-cmc${N}"
      echo -e "$HR"
      ;;
  esac
}

# ── Site (dashboard + browsable notes, lives in the vault) ──────────────────────
cmd_site() {
  local sub="${1:-}"
  local SITE="/mnt/storage/notes-site"

  case "$sub" in
    build)
      echo -e "$HR"
      echo -e "  ${C}${B}arc site build${N}  —  rebuilding dashboard + browse site"
      echo -e "$HR\n"
      if ! storage_ok; then
        echo -e "  ${R}✗${N}  vault not mounted — arc mount first"
        echo -e "$HR"
        return 1
      fi
      if [[ -x "$HOME/.local/bin/build-notes-site" ]]; then
        "$HOME/.local/bin/build-notes-site"
      else
        echo -e "  ${R}✗${N}  build-notes-site not found at ~/.local/bin/build-notes-site"
        echo -e "$HR"
        return 1
      fi
      echo -e "\n$HR"
      ;;
    open)
      if [[ ! -f "$SITE/index.html" ]]; then
        echo -e "  ${R}✗${N}  no site built yet — run: arc site build"
        return 1
      fi
      xdg-open "$SITE/index.html" 2>/dev/null &
      echo -e "  ${G}✓${N}  opened ${SITE}/index.html"
      ;;
    *)
      echo -e "$HR"
      echo -e "  ${C}${B}arc site${N}  —  dashboard + browsable notes (lives in the vault)"
      echo -e "$HR\n"
      if [[ -f "$SITE/index.html" ]]; then
        local size built
        size=$(du -sh "$SITE" 2>/dev/null | cut -f1)
        built=$(date -r "$SITE/index.html" "+%Y-%m-%d %H:%M")
        echo -e "  ${D}path${N}     ${M}${SITE}${N}"
        echo -e "  ${D}size${N}     ${M}${size}${N}"
        echo -e "  ${D}built${N}    ${M}${built}${N}"
      else
        echo -e "  ${R}not built yet${N}  ${D}— run: arc site build${N}"
      fi

      echo ""
      if systemctl --user is-active --quiet notes-site.service 2>/dev/null; then
        echo -e "  ${D}local server${N}  ${G}running${N}  ${D}(127.0.0.1:8642)${N}"
      else
        echo -e "  ${D}local server${N}  ${R}not running${N}  ${D}— systemctl --user start notes-site${N}"
      fi

      if systemctl is-active --quiet cloudflared 2>/dev/null; then
        local code
        code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 https://notes.kontor.studio 2>/dev/null)
        if [[ "$code" =~ ^(200|301|302|303)$ ]]; then
          echo -e "  ${D}tunnel route${N}  ${G}live${N}  ${D}(notes.kontor.studio → ${code})${N}"
        elif [[ -z "$code" ]]; then
          echo -e "  ${D}tunnel route${N}  ${Y}unverified${N}  ${D}(no response — check internet or DNS/Access setup)${N}"
        else
          echo -e "  ${D}tunnel route${N}  ${R}unexpected response${N}  ${D}(notes.kontor.studio → ${code})${N}"
        fi
      else
        echo -e "  ${D}tunnel route${N}  ${R}cloudflared not running${N}  ${D}— desktop/ssh tunnels are also down${N}"
      fi

      echo -e "\n  ${D}arc site build   — rebuild from current notes${N}"
      echo -e "  ${D}arc site open    — open the dashboard in your browser${N}"
      echo -e "$HR"
      ;;
  esac
}

# ── HQ ─────────────────────────────────────────────────────────────────────────
cmd_hq() {
  local arg="${1:-}"
  local HQ="$HOME/dev-notes/hq-main"

  # Named file views
  case "$arg" in
    ops|opsec) glow "$HQ/opsec-hardening.md"; return ;;
    ref)       glow "$HQ/reference.md"; return ;;
    "")        ;;  # fall through to dashboard
    *)         glow "$HQ/${arg}.md" 2>/dev/null \
                 || echo -e "  ${R}✗${N}  not found: $HQ/${arg}.md"
               return ;;
  esac

  # ── Dashboard ───────────────────────────────────────────────────────────────
  echo -e "$HR"
  echo -e "  ${C}${B}arc hq${N}  —  system cockpit"
  echo -e "$HR\n"

  # CPU load + temp
  local load1 load5 load15 temp_str=""
  read -r load1 load5 load15 _ < /proc/loadavg
  local max_temp
  max_temp=$(cat /sys/class/thermal/thermal_zone*/temp 2>/dev/null | sort -n | tail -1)
  if [[ -n "$max_temp" ]] && (( max_temp > 10000 )); then
    local temp_c
    temp_c=$(awk "BEGIN {printf \"%.1f\", $max_temp/1000}")
    temp_str="  ${D}·${N}  ${M}${temp_c}°C${N}"
  fi
  echo -e "  ${C}cpu${N}       ${D}load${N}  ${M}${load1}${N} ${D}·${N} ${M}${load5}${N} ${D}·${N} ${M}${load15}${N}${temp_str}"

  # RAM + swap
  local ram_used ram_free ram_total ram_pct swap_used swap_total
  ram_used=$(free -h  | awk '/Mem:/ {print $3}')
  ram_free=$(free -h  | awk '/Mem:/ {print $7}')
  ram_total=$(free -h | awk '/Mem:/ {print $2}')
  ram_pct=$(free      | awk '/Mem:/ {printf "%.0f%%", $3/$2*100}')
  swap_used=$(free -h  | awk '/Swap:/ {print $3}')
  swap_total=$(free -h | awk '/Swap:/ {print $2}')
  echo -e "  ${C}memory${N}    ${M}${ram_used}${N} used ${D}·${N} ${M}${ram_free}${N} free ${D}/${N} ${M}${ram_total}${N}  ${D}(${ram_pct})${N}"
  echo -e "  ${C}swap${N}      ${M}${swap_used}${N} ${D}/${N} ${M}${swap_total}${N}"

  echo ""

  # Disk
  echo -e "  ${C}disk${N}"
  local du_ df_ dt_ dp_
  du_=$(df -h / | awk 'NR==2 {print $3}')
  df_=$(df -h / | awk 'NR==2 {print $4}')
  dt_=$(df -h / | awk 'NR==2 {print $2}')
  dp_=$(df /    | awk 'NR==2 {print $5}')
  echo -e "  ${D}·${N}  internal   ${M}${du_}${N} used ${D}·${N} ${M}${df_}${N} free ${D}/${N} ${M}${dt_}${N}  ${D}(${dp_})${N}"
  if storage_ok; then
    local uu uf ut up
    uu=$(df -h /mnt/storage | awk 'NR==2 {print $3}')
    uf=$(df -h /mnt/storage | awk 'NR==2 {print $4}')
    ut=$(df -h /mnt/storage | awk 'NR==2 {print $2}')
    up=$(df /mnt/storage    | awk 'NR==2 {print $5}')
    echo -e "  ${G}·${N}  usb        ${M}${uu}${N} used ${D}·${N} ${M}${uf}${N} free ${D}/${N} ${M}${ut}${N}  ${D}(${up})${N}"
  else
    echo -e "  ${R}·${N}  usb        ${D}not accessible  — arc mount${N}"
  fi

  echo ""

  # Network
  echo -e "  ${C}network${N}"
  local iface local_ip
  iface=$(ip route get 1.1.1.1 2>/dev/null \
    | awk '{for(i=1;i<=NF;i++) if($i=="dev") print $(i+1)}' | head -1)
  local_ip=$(hostname -I 2>/dev/null | awk '{print $1}')
  echo -e "  ${D}·${N}  ${M}${iface:-?}${N}  ${D}·${N}  ${M}${local_ip:-none}${N}"

  if [[ -n "$iface" ]]; then
    local rx tx rx_h tx_h
    rx=$(awk -v dev="${iface}:" '$1==dev {print $2}' /proc/net/dev 2>/dev/null)
    tx=$(awk -v dev="${iface}:" '$1==dev {print $10}' /proc/net/dev 2>/dev/null)
    rx_h=$(awk "BEGIN {b=${rx:-0}+0; if(b>=1073741824) printf \"%.1f GB\",b/1073741824; else if(b>=1048576) printf \"%.1f MB\",b/1048576; else if(b>=1024) printf \"%.1f KB\",b/1024; else printf \"%d B\",b}")
    tx_h=$(awk "BEGIN {b=${tx:-0}+0; if(b>=1073741824) printf \"%.1f GB\",b/1073741824; else if(b>=1048576) printf \"%.1f MB\",b/1048576; else if(b>=1024) printf \"%.1f KB\",b/1024; else printf \"%d B\",b}")
    echo -e "  ${D}·${N}  rx ${M}${rx_h}${N}  ${D}·${N}  tx ${M}${tx_h}${N}  ${D}(since boot)${N}"
  fi

  # VPN
  local vpn_iface
  vpn_iface=$(ip link show 2>/dev/null | grep -oE '(tun[0-9]+|wg[0-9]+)' | head -1)
  if [[ -n "$vpn_iface" ]]; then
    echo -e "  ${D}·${N}  vpn  ${G}active${N}  ${D}(${vpn_iface})${N}"
  else
    echo -e "  ${D}·${N}  vpn  ${D}none${N}"
  fi

  # DNS
  if systemctl is-active --quiet nextdns 2>/dev/null; then
    echo -e "  ${D}·${N}  dns  ${G}nextdns active${N}"
  else
    local resolver
    resolver=$(grep '^nameserver' /etc/resolv.conf 2>/dev/null | head -1 | awk '{print $2}')
    echo -e "  ${D}·${N}  dns  ${Y}nextdns off${N}  ${D}·${N}  ${M}${resolver:-?}${N}"
  fi

  echo ""

  # Services
  echo -e "  ${C}services${N}"
  local svc
  for svc in nextdns fail2ban ufw apparmor; do
    if systemctl is-active --quiet "$svc" 2>/dev/null; then
      echo -e "  ${G}·${N}  ${M}${svc}${N}"
    else
      echo -e "  ${R}·${N}  ${M}${svc}${N}  ${D}(inactive)${N}"
    fi
  done

  echo ""

  # Listening ports
  echo -e "  ${C}ports${N}  ${D}(listening)${N}"
  ss -tlnp 2>/dev/null | tail -n +2 | while IFS= read -r line; do
    local addr proc
    addr=$(echo "$line" | awk '{print $4}')
    proc=$(echo "$line" | grep -oP 'users:\(\(".*?"' | grep -oP '"[^"]+' | head -1 | tr -d '"')
    [[ -n "$proc" ]] \
      && echo -e "  ${D}·${N}  ${M}${addr}${N}  ${D}${proc}${N}" \
      || echo -e "  ${D}·${N}  ${M}${addr}${N}"
  done

  echo ""

  # Top 5 processes by CPU
  echo -e "  ${C}processes${N}  ${D}(top 5 cpu)${N}"
  ps -eo pid,%cpu,%mem,comm --sort=-%cpu 2>/dev/null | tail -n +2 | head -5 \
    | while IFS= read -r line; do
        local pid cpu mem cmd
        pid=$(echo "$line" | awk '{print $1}')
        cpu=$(echo "$line" | awk '{print $2}')
        mem=$(echo "$line" | awk '{print $3}')
        cmd=$(echo "$line" | awk '{print $4}')
        echo -e "  ${D}·${N}  cpu ${M}${cpu}%${N}  mem ${M}${mem}%${N}  ${D}${cmd}  [${pid}]${N}"
      done

  echo ""
  echo -e "$HR"
  echo -e "  ${D}arc hq ref    — reference.md${N}"
  echo -e "  ${D}arc hq ops    — opsec-hardening.md${N}"
  echo -e "$HR"
}

# ── Top ────────────────────────────────────────────────────────────────────────
cmd_top() {
  if command -v btop &>/dev/null; then
    btop
  else
    echo -e "${R}✗${N}  btop not installed — run: sudo apt install btop"
  fi
}

# ── Net monitors ───────────────────────────────────────────────────────────────
cmd_net() {
  local sub="${1:-}"
  shift 2>/dev/null

  case "$sub" in
    bandwhich)
      echo -e "$HR"
      echo -e "  ${C}${B}arc net bandwhich${N}  —  bandwidth by process + remote address"
      echo -e "$HR\n"
      if ! command -v bandwhich &>/dev/null; then
        echo -e "  ${R}✗${N}  bandwhich not installed — run: sudo apt install bandwhich"
        echo -e "$HR"; return 1
      fi
      sudo bandwhich "$@"
      ;;
    iftop)
      echo -e "$HR"
      echo -e "  ${C}${B}arc net iftop${N}  —  bandwidth by connection pair"
      echo -e "$HR\n"
      if ! command -v iftop &>/dev/null; then
        echo -e "  ${R}✗${N}  iftop not installed — run: sudo apt install iftop"
        echo -e "$HR"; return 1
      fi
      sudo iftop "$@"
      ;;
    nethogs)
      echo -e "$HR"
      echo -e "  ${C}${B}arc net nethogs${N}  —  bandwidth by process / PID"
      echo -e "$HR\n"
      if ! command -v nethogs &>/dev/null; then
        echo -e "  ${R}✗${N}  nethogs not installed — run: sudo apt install nethogs"
        echo -e "$HR"; return 1
      fi
      sudo nethogs "$@"
      ;;
    stats)
      echo -e "$HR"
      echo -e "  ${C}${B}arc net stats${N}  —  interface rx/tx since boot"
      echo -e "$HR\n"
      awk 'NR>2 {
        iface = $1; gsub(":", "", iface)
        if (iface == "lo") next
        rx = $2+0; tx = $10+0
        if (rx + tx == 0) next
        split("B KB MB GB TB", u)
        rv=rx; ri=1; while(rv>=1024 && ri<5){rv/=1024; ri++}
        tv=tx; ti=1; while(tv>=1024 && ti<5){tv/=1024; ti++}
        printf "  \033[0;90m·\033[0m  \033[38;5;250m%-14s\033[0m  rx \033[38;5;250m%6.1f %-2s\033[0m  tx \033[38;5;250m%6.1f %-2s\033[0m\n",
          iface, rv, u[ri], tv, u[ti]
      }' /proc/net/dev
      echo -e "\n$HR"
      ;;
    '')
      echo -e "$HR"
      echo -e "  ${C}${B}arc net${N}  —  network monitors"
      echo -e "$HR\n"

      echo -e "  ${C}bandwhich${N}  ${D}—  bandwidth per process + remote address (TUI, needs sudo)${N}"
      echo -e "  ${W}arc net bandwhich${N}              all interfaces, all processes"
      echo -e "  ${D}·  -i wlp1s0${N}                   specific interface"
      echo -e "  ${D}·  -r${N}                           resolve DNS names"
      echo -e "  ${D}·  -p${N}                           processes only"
      echo -e "  ${D}·  -c${N}                           connections only"
      echo -e "  ${D}  ctrl-c to exit${N}"

      echo ""
      echo -e "  ${C}iftop${N}  ${D}—  live bandwidth per connection pair (ncurses, needs sudo)${N}"
      echo -e "  ${W}arc net iftop${N}                  monitor default interface"
      echo -e "  ${D}·  -i wlp1s0${N}                   specific interface"
      echo -e "  ${D}·  -n${N}                           no DNS resolution (faster)"
      echo -e "  ${D}·  -N${N}                           no port name resolution"
      echo -e "  ${D}·  -P${N}                           show port numbers"
      echo -e "  ${D}·  -t${N}                           text mode (no ncurses)"
      echo -e "  ${D}·  -s <n>${N}                       quit after n seconds"
      echo -e "  ${D}  keys: p=ports  n=DNS  s/d=src/dst  l=limit  q=quit${N}"

      echo ""
      echo -e "  ${C}nethogs${N}  ${D}—  bandwidth per PID / process (ncurses, needs sudo)${N}"
      echo -e "  ${W}arc net nethogs${N}                all interfaces"
      echo -e "  ${D}·  wlp1s0${N}                      specific interface"
      echo -e "  ${D}·  -d <n>${N}                       refresh every n seconds (default: 1)"
      echo -e "  ${D}·  -p${N}                           PID-only output"
      echo -e "  ${D}·  -t${N}                           tracemode (non-interactive)"
      echo -e "  ${D}·  -b${N}                           bytes mode (not bits)"
      echo -e "  ${D}  keys: q=quit  s=sort-sent  r=sort-recv  m=toggle units${N}"

      echo ""
      echo -e "  ${C}stats${N}  ${D}—  quick rx/tx snapshot per interface (no TUI, no sudo)${N}"
      echo -e "  ${W}arc net stats${N}                  bytes since boot, all active interfaces"

      echo -e "\n$HR"
      ;;
    *)
      echo -e "${R}unknown:${N} arc net $sub"
      echo -e "${D}options: bandwhich · iftop · nethogs · stats${N}"
      return 1
      ;;
  esac
}

# ── Auth ───────────────────────────────────────────────────────────────────────
cmd_auth() {
  local bin="${ARC_AUTH_APP:-$HOME/.local/bin/ente-auth}"
  if [[ ! -x "$bin" ]]; then
    echo -e "  ${R}✗${N}  ente-auth not found at ${bin}"
    return 1
  fi
  echo -e "  ${G}✓${N}  launching Ente Auth"
  "$bin" &>/dev/null &
  disown
}

# ── DNS ────────────────────────────────────────────────────────────────────────
cmd_dns() {
  ~/.local/bin/arc-dns "${1:-status}" "${2:-}"
}

# ── Fix ────────────────────────────────────────────────────────────────────────
cmd_fix() {
  local what="${1:-}"
  echo -e "$HR"
  case "$what" in
    brave)
      echo -e "  ${C}${B}arc fix brave${N}  —  kill + relaunch"
      echo -e "$HR\n"
      if pkill -f brave-browser 2>/dev/null; then
        echo -e "  ${G}✓${N}  Brave killed"
      else
        echo -e "  ${D}·${N}  Brave was not running"
      fi
      sleep 1
      brave-browser &>/dev/null &
      disown
      echo -e "  ${G}✓${N}  Brave relaunched"
      ;;
    display)
      echo -e "  ${C}${B}arc fix display${N}  —  restart compositor"
      echo -e "$HR\n"
      xfwm4 --replace &>/dev/null &
      disown
      echo -e "  ${G}✓${N}  xfwm4 compositor restarted"
      ;;
    wifi)
      echo -e "  ${C}${B}arc fix wifi${N}  —  toggle off → on"
      echo -e "$HR\n"
      echo -e "  ${C}wifi off...${N}"
      nmcli radio wifi off
      sleep 3
      echo -e "  ${C}wifi on...${N}"
      nmcli radio wifi on
      sleep 2
      # Real bug found 2026-08-22: grabbing the first line of "all active
      # connections" used to work when wifi was normally the only one, but
      # with ProtonVPN now regularly connected, its own connections
      # (pvpn-killswitch, the WireGuard one) can sort first -- reported the
      # VPN's name instead of the actual wifi SSID. Query the wlan0 device
      # specifically instead of guessing from an unordered list.
      local ssid
      ssid=$(nmcli -g GENERAL.CONNECTION device show wlan0 2>/dev/null)
      [[ -n "$ssid" && "$ssid" != "--" ]] && echo -e "  ${G}✓${N}  connected: ${ssid}" || echo -e "  ${Y}!${N}  wifi on — reconnecting..."
      ;;
    screen)
      echo -e "  ${C}${B}arc fix screen${N}  —  reset terminal + restart shell"
      echo -e "$HR\n"
      reset
      exec "${SHELL:-bash}"
      ;;
    audio)
      echo -e "  ${C}${B}arc fix audio${N}  —  revert stuck audio profile + refresh panel"
      echo -e "$HR\n"
      # Zoom (and similar apps) can push PipeWire into 'Pro Audio' card
      # profile, which exposes raw multichannel sub-devices instead of the
      # real speaker output — sounds thin/quiet, not muted. Check + revert
      # that first; this used to be panel-only and never touched the actual
      # audio cause (real symptom hit 2026-07-23).
      local card active
      card=$(pactl list cards short 2>/dev/null | awk '{print $2}' | head -1)
      active=$(pactl list cards 2>/dev/null | grep "Active Profile" | awk '{print $NF}')
      if [[ -n "$card" && "$active" == "pro-audio" ]]; then
        pactl set-card-profile "$card" output:analog-stereo+input:analog-stereo 2>/dev/null
        sleep 1
        active=$(pactl list cards 2>/dev/null | grep "Active Profile" | awk '{print $NF}')
        [[ "$active" != "pro-audio" ]] \
          && echo -e "  ${G}✓${N}  audio profile was stuck on pro-audio (thin/quiet sound), reverted to analog-stereo" \
          || echo -e "  ${R}✗${N}  audio profile revert failed — still on pro-audio"
      else
        echo -e "  ${D}·${N}  audio profile: ${active:-unknown} (not stuck)"
      fi
      echo ""
      # 'xfce4-panel -r' only signals an already-running panel over D-Bus —
      # if it's not cleanly reachable, the signal fails outright instead of
      # falling back to launching one. Try the fast path first, then
      # kill-and-relaunch fresh.
      if xfce4-panel -r 2>/dev/null; then
        echo -e "  ${G}✓${N}  panel restarted, volume applet refreshed"
      else
        pkill -x xfce4-panel 2>/dev/null
        sleep 1
        xfce4-panel &>/dev/null &
        disown
        sleep 1
        if pgrep -x xfce4-panel &>/dev/null; then
          echo -e "  ${G}✓${N}  panel restarted fresh (was unreachable via IPC), volume applet refreshed"
        else
          echo -e "  ${R}✗${N}  xfce4-panel restart failed"
        fi
      fi
      ;;
    panel)
      echo -e "  ${C}${B}arc fix panel${N}  —  refresh/restart the taskbar panel"
      echo -e "$HR\n"
      # Same reliable pattern as 'arc fix audio': try the live D-Bus reload
      # first (picks up plugin/theme/layout changes without losing panel
      # state), fall back to kill-and-relaunch if the panel isn't cleanly
      # reachable over IPC.
      if xfce4-panel -r 2>/dev/null; then
        echo -e "  ${G}✓${N}  panel refreshed"
      else
        pkill -x xfce4-panel 2>/dev/null
        sleep 1
        xfce4-panel &>/dev/null &
        disown
        sleep 1
        if pgrep -x xfce4-panel &>/dev/null; then
          echo -e "  ${G}✓${N}  panel restarted fresh (was unreachable via IPC)"
        else
          echo -e "  ${R}✗${N}  xfce4-panel restart failed"
        fi
      fi
      ;;
    '')
      echo -e "  ${C}${B}arc fix${N}  —  system repair"
      echo -e "$HR"
      echo -e "  ${W}arc fix brave${N}      kill + relaunch Brave"
      echo -e "  ${W}arc fix display${N}    restart xfwm4 compositor"
      echo -e "  ${W}arc fix wifi${N}       toggle wifi off → on"
      echo -e "  ${W}arc fix screen${N}     reset terminal + restart shell"
      echo -e "  ${W}arc fix audio${N}      revert stuck pro-audio profile + refresh panel"
      echo -e "  ${W}arc fix panel${N}      refresh/restart the taskbar panel"
      echo -e "$HR"
      return 0
      ;;
    *)
      echo -e "  ${R}unknown:${N} arc fix ${what}"
      echo -e "  ${D}options: brave · display · wifi · screen · audio · panel${N}"
      ;;
  esac
  echo -e "$HR"
}

# ── Sec ────────────────────────────────────────────────────────────────────────
_sec_hdr() {
  echo -e "$HR"
  echo -e "  ${C}${B}${1}${N}"
  echo -e "$HR\n"
}

_sec_lynis() {
  _sec_hdr "lynis  —  full system hardening audit"

  # Explicit paths, not assumed defaults — this sudoers config has env_reset
  # without always_set_home, so `sudo` preserves $HOME instead of switching to
  # root's, and lynis falls back to $HOME over /var/log when not told otherwise
  # (even running as root). --logfile/--report-file are real CLI flags (verified
  # via man lynis), not .prf directives — that earlier attempt was invalid syntax.
  sudo lynis audit system -Q --logfile /var/log/lynis.log --report-file /var/log/lynis-report.dat 2>/dev/null

  echo -e "\n$HR"
  echo -e "  ${D}full log:${N}     /var/log/lynis.log"
  echo -e "  ${D}report data:${N}  /var/log/lynis-report.dat"
  echo -e "  ${D}review:${N}       less /var/log/lynis.log  ·  lynis show details <TEST-ID>"
  echo -e "$HR"
}

_sec_docker_bench() {
  _sec_hdr "docker-bench-security  —  CIS Docker Benchmark"

  local dir="$HOME/khaos-lab/docker-bench-security"
  if [[ ! -f "$dir/docker-bench-security.sh" ]]; then
    echo -e "  ${R}✗${N}  not found — expected ${dir}/docker-bench-security.sh"
    echo -e "\n$HR"
    return 1
  fi

  if ! sudo -v 2>/dev/null; then
    echo -e "  ${R}✗${N}  sudo failed — no scan ran"
    echo -e "\n$HR"
    return 1
  fi

  # -l appends rather than overwrites -- confirmed live 2026-08-31 (a scan
  # from 10 days earlier was still in the file, forcing a manual
  # `grep -n "^Initializing"` just to isolate the latest run). Rotate the
  # previous run out of the way first so each invocation's log is exactly
  # one scan, no boundary-hunting required to read it.
  [[ -f /var/log/docker-bench-security.log ]] && sudo mv /var/log/docker-bench-security.log /var/log/docker-bench-security.log.previous

  # Needs cwd == repo root: the script sources ./functions/*.sh via a
  # relative LIBEXEC path, not an absolute one -- fails silently-ish
  # (missing-function errors) if called from anywhere else. Prints its own
  # PASS/WARN/INFO report live to the terminal (that's the actual point of
  # this tool, unlike lynis) -- -l also logs the same to disk for later.
  ( cd "$dir" && sudo ./docker-bench-security.sh -l /var/log/docker-bench-security.log )

  echo -e "\n$HR"
  echo -e "  ${D}full log:${N}  /var/log/docker-bench-security.log"
  echo -e "  ${D}previous run:${N}  /var/log/docker-bench-security.log.previous"
  echo -e "$HR"
}

_sec_aide() {
  _sec_hdr "aide  —  file integrity check"

  if ! sudo -v 2>/dev/null; then
    echo -e "  ${R}✗${N}  sudo failed — no scan ran"
    echo -e "\n$HR"
    return 1
  fi

  # Watches system paths (Debian's stock aide.conf.d rules) plus this
  # machine's own critical user-owned surface (~/.local/bin,
  # ~/.config/systemd/user, etc. -- see /etc/aide/aide.conf.d/90_arc_home_critical)
  # against the baseline built 2026-08-22. arc-aide-watch runs this same
  # check daily via a user timer and only pages you (arc-pine-notify) on
  # real drift -- this is the on-demand version, always shows full output.
  sudo /usr/bin/aide --config /etc/aide/aide.conf --check 2>&1

  echo -e "\n$HR"
  echo -e "  ${D}daily timer:${N}  systemctl --user status arc-aide-watch.timer"
  echo -e "  ${D}last daily run:${N}  ~/.local/share/arc-aide/last-check.log"
  echo -e "  ${D}rebuild baseline after an intentional change:${N}  sudo aideinit -y -f"
  echo -e "$HR"
}

_sec_chkrootkit() {
  _sec_hdr "chkrootkit  —  rootkit scan"

  local sudo_out
  sudo_out=$(sudo bash -c 'chkrootkit > /var/log/chkrootkit.log 2>&1' 2>&1)
  if echo "$sudo_out" | grep -qi "password is required\|terminal is required\|incorrect password"; then
    echo -e "  ${R}✗${N}  sudo failed — no scan ran, this is a STALE log below, not a fresh result"
    echo "$sudo_out"
    echo -e "\n$HR"
    return 1
  fi

  local warnings
  warnings=$(grep -c "WARNING\|INFECTED" /var/log/chkrootkit.log 2>/dev/null)
  warnings=${warnings:-0}

  if [[ "$warnings" -gt 0 ]]; then
    echo -e "  ${Y}⚠${N}  ${warnings} warning(s) — review below\n"
    grep -B2 "WARNING\|INFECTED" /var/log/chkrootkit.log
  else
    echo -e "  ${G}✓${N}  clean — no warnings"
  fi

  echo -e "\n$HR"
  echo -e "  ${D}full log:${N}  /var/log/chkrootkit.log"
  echo -e "$HR"
}

_sec_rkhunter() {
  _sec_hdr "rkhunter  —  rootkit hunter scan"

  if ! command -v rkhunter &>/dev/null; then
    echo -e "  ${R}✗${N}  rkhunter not installed — sudo apt-get install -y rkhunter"
    echo -e "\n$HR"
    return 1
  fi

  local sudo_out
  sudo_out=$(sudo bash -c 'rkhunter --check --sk --rwo' 2>&1)
  # sudo itself exits 1 when it can't get a password -- the SAME code
  # rkhunter uses for "warnings found", so the exit code alone can't tell
  # "sudo failed, nothing ran" apart from "ran fine, found something."
  # Check the actual output for sudo's own failure text first.
  if echo "$sudo_out" | grep -qi "password is required\|terminal is required\|incorrect password"; then
    echo -e "  ${R}✗${N}  sudo failed — no scan ran, this is a STALE log below, not a fresh result"
    echo "$sudo_out"
    echo -e "\n$HR"
    return 1
  fi

  local warnings
  warnings=$(sudo grep -c "^Warning: " /var/log/rkhunter.log 2>/dev/null)
  warnings=${warnings:-0}
  if [[ "$warnings" -gt 0 ]]; then
    echo -e "  ${Y}⚠${N}  ${warnings} warning(s) — review below\n"
    sudo grep "^Warning: " /var/log/rkhunter.log
  else
    echo -e "  ${G}✓${N}  clean — no warnings"
  fi

  echo -e "\n$HR"
  echo -e "  ${D}full log:${N}  /var/log/rkhunter.log"
  echo -e "$HR"
}

_sec_clamav() {
  local sub="${1:-}"
  case "$sub" in
    status)
      _sec_hdr "clamav  —  last scan status"
      if pgrep -f "clamscan -r" &>/dev/null; then
        echo -e "  ${C}→${N}  scan currently running — check back later"
      elif [[ -f /var/log/clamav-home-scan.log ]]; then
        tail -12 /var/log/clamav-home-scan.log
      else
        echo -e "  ${D}·${N}  no scan has been run yet — ${C}arc sec clamav${N} to start one"
      fi
      echo -e "\n$HR"
      ;;
    '')
      _sec_hdr "clamav  —  home directory scan"
      if pgrep -f "clamscan -r" &>/dev/null; then
        echo -e "  ${Y}!${N}  a scan is already running — ${C}arc sec clamav status${N} to check it"
        echo -e "$HR"
        return 0
      fi
      echo -e "  ${C}→${N}  starting background scan of \$HOME (this takes 20-30+ min)..."
      nohup sudo bash -c "clamscan -r -i \
        --exclude-dir='^${HOME}/.cache' \
        --exclude-dir='^${HOME}/khaos-lab/vbox-vms' \
        '${HOME}' > /var/log/clamav-home-scan.log 2>&1" &
      disown
      echo -e "  ${G}✓${N}  launched — ${C}arc sec clamav status${N} to check progress/results"
      echo -e "$HR"
      ;;
    *)
      echo -e "${R}unknown:${N} arc sec clamav $sub"
      echo -e "${D}options: (none) · status${N}"
      ;;
  esac
}

_sec_suricata() {
  _sec_hdr "suricata  —  network IDS status"

  local state
  state=$(systemctl is-active suricata 2>/dev/null)
  if [[ "$state" == "active" ]]; then
    # Read the real configured interface instead of a hardcoded label --
    # was stuck on a stale "wlp2s0" placeholder while capture had already
    # been fixed to the real interface (wlan0) 2026-08-15, silently
    # mismatched ever since. Reads it live so it can't go stale again the
    # same way if the interface ever changes.
    local iface
    iface=$(awk '/^af-packet:/{f=1} f && /- interface:/{print $NF; exit}' /etc/suricata/suricata.yaml 2>/dev/null)
    echo -e "  ${G}●${N}  running  ${D}(watching ${iface:-unknown})${N}"
  else
    echo -e "  ${R}○${N}  ${state}"
  fi

  echo ""
  echo -e "  ${C}alerts today${N}"
  local today count
  today=$(date +%Y-%m-%d)
  if sudo test -r /var/log/suricata/eve.json 2>/dev/null; then
    count=$(sudo grep -c "\"event_type\":\"alert\"" /var/log/suricata/eve.json 2>/dev/null)
    count=${count:-0}
    echo -e "  ${D}·${N}  ${count} total alert event(s) logged (all-time, log not yet rotated)"
    echo ""
    echo -e "  ${C}most recent 5${N}"
    sudo grep "\"event_type\":\"alert\"" /var/log/suricata/eve.json 2>/dev/null | tail -5 \
      | python3 -c "
import json,sys
for line in sys.stdin:
    try:
        d = json.loads(line)
        a = d.get('alert', {})
        print(f\"  {d.get('timestamp','?')[:19]}  {a.get('signature','?')}  ({d.get('src_ip','?')} -> {d.get('dest_ip','?')})\")
    except Exception:
        pass
"
  else
    echo -e "  ${D}·${N}  can't read eve.json (needs sudo)"
  fi

  echo -e "\n$HR"
  echo -e "  ${D}rule count:${N}  sudo suricata-update  ${D}(refresh ruleset)${N}"
  echo -e "  ${D}full log:${N}    /var/log/suricata/eve.json"
  echo -e "$HR"
}

_sec_users() {
  _sec_hdr "users  —  accounts · sessions · auth"

  echo -e "  ${C}local accounts  ${D}(uid ≥ 1000)${N}"
  awk -F: '$3 >= 1000 && $3 < 65534 {printf "%-20s uid=%-6s %s\n", $1, $3, $7}' /etc/passwd \
    | while IFS= read -r line; do echo -e "  ${D}·${N}  $line"; done

  echo ""
  echo -e "  ${C}sudo group${N}"
  getent group sudo 2>/dev/null | awk -F: '{print $4}' | tr ',' '\n' \
    | while IFS= read -r u; do [[ -n "$u" ]] && echo -e "  ${Y}·${N}  $u"; done

  echo ""
  echo -e "  ${C}active sessions${N}"
  local sess
  sess=$(who 2>/dev/null)
  if [[ -n "$sess" ]]; then
    echo "$sess" | while IFS= read -r line; do echo -e "  ${G}·${N}  $line"; done
  else
    echo -e "  ${D}·${N}  none"
  fi

  echo ""
  echo -e "  ${C}last logins  ${D}(8)${N}"
  last -n 8 2>/dev/null | head -8 | while IFS= read -r line; do
    echo -e "  ${D}·${N}  $line"
  done

  echo ""
  echo -e "  ${C}failed auth  ${D}(last 10)${N}"
  local fails
  fails=$(grep -E "authentication failure|Failed password|Invalid user" /var/log/auth.log 2>/dev/null | tail -10)
  if [[ -n "$fails" ]]; then
    echo "$fails" | while IFS= read -r line; do echo -e "  ${R}·${N}  $line"; done
  else
    echo -e "  ${G}·${N}  none found"
  fi

  echo -e "\n$HR"
}

_sec_net() {
  _sec_hdr "network  —  ports · connections · dns · arp"

  echo -e "  ${C}wifi${N}"
  local wstate
  wstate=$(nmcli radio wifi 2>/dev/null)
  [[ "$wstate" == "enabled" ]] \
    && echo -e "  ${G}·${N}  radio: enabled" \
    || echo -e "  ${Y}·${N}  radio: ${wstate}"
  nmcli -t -f NAME,TYPE,STATE connection show --active 2>/dev/null \
    | while IFS= read -r line; do echo -e "  ${D}·${N}  $line"; done

  echo ""
  echo -e "  ${C}listening ports${N}"
  ss -tlnp 2>/dev/null | tail -n +2 \
    | while IFS= read -r line; do echo -e "  ${D}·${N}  $line"; done

  echo ""
  echo -e "  ${C}established connections${N}"
  ss -tnp state established 2>/dev/null | tail -n +2 | head -15 \
    | while IFS= read -r line; do echo -e "  ${D}·${N}  $line"; done

  echo ""
  echo -e "  ${C}dns${N}"
  grep '^nameserver' /etc/resolv.conf 2>/dev/null \
    | while IFS= read -r line; do echo -e "  ${D}·${N}  $line"; done
  if systemctl is-active --quiet nextdns 2>/dev/null; then
    echo -e "  ${G}·${N}  nextdns: active"
  else
    echo -e "  ${Y}·${N}  nextdns: inactive"
  fi
  resolvectl status 2>/dev/null | grep -E 'Current DNS Server|DNS Servers' | head -3 \
    | while IFS= read -r line; do echo -e "  ${D}·${N}  ${line## }"; done

  echo ""
  echo -e "  ${C}arp neighbors${N}"
  arp -n 2>/dev/null | tail -n +2 \
    | while IFS= read -r line; do echo -e "  ${D}·${N}  $line"; done

  echo -e "\n$HR"
}

_sec_firewall() {
  local sub="${1:-}"
  shift 2>/dev/null

  case "$sub" in

    allow)
      local rule="$*"
      _sec_hdr "firewall  —  allow"
      if [[ -z "$rule" ]]; then
        echo -e "  ${R}usage:${N} arc sec firewall allow <port>[/tcp|udp]"
        echo -e "  ${D}example: arc sec firewall allow 8080/tcp${N}"
        echo -e "\n$HR"; return 1
      fi
      sudo ufw allow "$rule" \
        && echo -e "  ${G}✓${N}  allowed: $rule" \
        || echo -e "  ${R}✗${N}  failed"
      echo -e "\n$HR"
      ;;

    deny)
      local rule="$*"
      _sec_hdr "firewall  —  deny"
      if [[ -z "$rule" ]]; then
        echo -e "  ${R}usage:${N} arc sec firewall deny <port>[/tcp|udp]"
        echo -e "\n$HR"; return 1
      fi
      sudo ufw deny "$rule" \
        && echo -e "  ${G}✓${N}  denied: $rule" \
        || echo -e "  ${R}✗${N}  failed"
      echo -e "\n$HR"
      ;;

    delete)
      local rule="$*"
      _sec_hdr "firewall  —  delete rule"
      if [[ -z "$rule" ]]; then
        echo -e "  ${R}usage:${N} arc sec firewall delete <rule>"
        echo -e "  ${D}tip: run 'arc sec firewall' first to see numbered rules${N}"
        echo -e "\n$HR"; return 1
      fi
      sudo ufw delete "$rule" \
        && echo -e "  ${G}✓${N}  deleted: $rule" \
        || echo -e "  ${R}✗${N}  failed"
      echo -e "\n$HR"
      ;;

    numbered)
      _sec_hdr "firewall  —  numbered rules"
      sudo ufw status numbered 2>/dev/null | while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        echo -e "  ${D}·${N}  $line"
      done
      echo -e "\n  ${D}to delete: arc sec firewall delete <number>${N}"
      echo -e "\n$HR"
      ;;

    reload)
      _sec_hdr "firewall  —  reload"
      sudo ufw reload \
        && echo -e "  ${G}✓${N}  ufw reloaded" \
        || echo -e "  ${R}✗${N}  reload failed"
      echo -e "\n$HR"
      ;;

    reset)
      _sec_hdr "firewall  —  reset  ${R}(destructive)${N}"
      echo -e "  ${R}!${N}  this wipes ALL ufw rules and disables the firewall"
      printf "  ${Y}type 'yes' to confirm:${N} "
      read -r confirm
      if [[ "$confirm" == "yes" ]]; then
        sudo ufw --force reset \
          && echo -e "  ${G}✓${N}  reset complete — re-enable with: sudo ufw enable" \
          || echo -e "  ${R}✗${N}  reset failed"
      else
        echo -e "  ${D}·${N}  aborted"
      fi
      echo -e "\n$HR"
      ;;

    logs)
      _sec_hdr "firewall  —  ufw blocks  ${D}(last 20)${N}"
      local blocks
      blocks=$(grep "UFW BLOCK" /var/log/ufw.log 2>/dev/null | tail -20)
      if [[ -n "$blocks" ]]; then
        echo "$blocks" | while IFS= read -r line; do
          echo -e "  ${R}·${N}  $line"
        done
      else
        echo -e "  ${D}·${N}  none  ${D}(ufw.log empty or not found)${N}"
      fi
      echo -e "\n$HR"
      ;;

    '')
      _sec_hdr "firewall  —  ufw status & rules"

      local out
      out=$(sudo ufw status verbose 2>/dev/null)
      if [[ -n "$out" ]]; then
        echo "$out" | while IFS= read -r line; do
          [[ -z "$line" ]] && continue
          echo -e "  ${D}·${N}  $line"
        done
      else
        echo -e "  ${Y}!${N}  ufw not installed or not accessible"
      fi

      echo ""
      echo -e "$HR"
      echo -e "  ${D}arc sec firewall allow <port>   — open a port${N}"
      echo -e "  ${D}arc sec firewall deny <port>    — block a port${N}"
      echo -e "  ${D}arc sec firewall numbered       — list rules by number${N}"
      echo -e "  ${D}arc sec firewall delete <num>   — remove rule by number${N}"
      echo -e "  ${D}arc sec firewall logs           — recent blocked attempts${N}"
      echo -e "  ${D}arc sec firewall reload         — reload rules${N}"
      echo -e "  ${D}arc sec firewall reset          — wipe all rules (asks confirm)${N}"
      echo -e "$HR"
      ;;

    *)
      echo -e "${R}unknown:${N} arc sec firewall $sub"
      echo -e "${D}options: allow · deny · numbered · delete · logs · reload · reset${N}"
      ;;
  esac
}

_sec_apps() {
  _sec_hdr "apps  —  installed · removed · snap · flatpak"

  echo -e "  ${C}recently installed  ${D}(apt, last 15)${N}"
  grep " install " /var/log/dpkg.log 2>/dev/null | tail -15 \
    | awk '{print $1, $2, $4}' \
    | while IFS= read -r line; do echo -e "  ${G}·${N}  $line"; done

  echo ""
  echo -e "  ${C}recently removed  ${D}(apt, last 5)${N}"
  local removed
  removed=$(grep " remove " /var/log/dpkg.log 2>/dev/null | tail -5)
  if [[ -n "$removed" ]]; then
    echo "$removed" | awk '{print $1, $2, $4}' \
      | while IFS= read -r line; do echo -e "  ${R}·${N}  $line"; done
  else
    echo -e "  ${D}·${N}  none"
  fi

  echo ""
  echo -e "  ${C}snap${N}"
  if snap list 2>/dev/null | tail -n +2 | grep -q .; then
    snap list 2>/dev/null | tail -n +2 \
      | while IFS= read -r line; do echo -e "  ${D}·${N}  $line"; done
  else
    echo -e "  ${D}·${N}  none"
  fi

  echo ""
  echo -e "  ${C}flatpak${N}"
  if flatpak list 2>/dev/null | grep -q .; then
    flatpak list 2>/dev/null \
      | while IFS= read -r line; do echo -e "  ${D}·${N}  $line"; done
  else
    echo -e "  ${D}·${N}  none"
  fi

  echo -e "\n$HR"
}

_sec_logs() {
  _sec_hdr "logs  —  auth · sudo · ufw · journal"

  echo -e "  ${C}auth failures  ${D}(last 15)${N}"
  local fails
  fails=$(grep -E "FAILED|authentication failure|Invalid user|refused connect" \
    /var/log/auth.log 2>/dev/null | tail -15)
  if [[ -n "$fails" ]]; then
    echo "$fails" | while IFS= read -r line; do echo -e "  ${R}·${N}  $line"; done
  else
    echo -e "  ${G}·${N}  none"
  fi

  echo ""
  echo -e "  ${C}sudo usage  ${D}(last 10)${N}"
  grep "COMMAND=" /var/log/auth.log 2>/dev/null | tail -10 \
    | while IFS= read -r line; do echo -e "  ${Y}·${N}  $line"; done

  echo ""
  echo -e "  ${C}ufw blocks  ${D}(last 10)${N}"
  local blocks
  blocks=$(grep "UFW BLOCK" /var/log/ufw.log 2>/dev/null | tail -10)
  if [[ -n "$blocks" ]]; then
    echo "$blocks" | while IFS= read -r line; do echo -e "  ${R}·${N}  $line"; done
  else
    echo -e "  ${D}·${N}  none  ${D}(ufw.log empty or not found)${N}"
  fi

  echo ""
  echo -e "  ${C}journal errors  ${D}(last 10)${N}"
  journalctl -p err -n 10 --no-pager 2>/dev/null \
    | while IFS= read -r line; do echo -e "  ${Y}·${N}  $line"; done

  echo -e "\n$HR"
}

cmd_snap() {
  echo -e "$HR"
  echo -e "  ${C}${B}arc snap${N}  —  manual snapshot"
  echo -e "$HR\n"

  # 2026-07-28: snapshots moved off the 26GB USB (too small for a from-scratch
  # full snapshot) to the internal disk — pre-check now reflects that.
  local free used free_pct
  free=$(df -h / 2>/dev/null | awk 'NR==2{print $4}')
  used=$(df -h / 2>/dev/null | awk 'NR==2{print $3}')
  free_pct=$(df / 2>/dev/null | awk 'NR==2 { gsub("%","",$5); print 100-$5 }')
  echo -e "  ${C}disk${N}  used: ${W}${used}${N}  free: ${G}${free}${N}\n"

  if [[ -n "$free_pct" ]] && (( free_pct < 15 )); then
    echo -e "  ${R}⚠  ${free_pct}% free — below the 15% floor.${N}"
    echo -e "  ${D}timeshift-check will refuse to snapshot until you free space (arc disk).${N}\n"
  fi

  echo -e "  ${D}starting snapshot — this takes ~10 min, ctrl-c will NOT abort it${N}\n"
  sudo /usr/local/bin/timeshift-check --manual

  local rc=$?
  echo ""
  if [[ $rc -eq 0 ]]; then
    echo -e "  ${G}✓${N}  snapshot saved"
    notify-send -i dialog-information "arc snap" "Snapshot saved" 2>/dev/null || true
  else
    echo -e "  ${R}✗${N}  timeshift-check exited with code $rc — check arc logs ts"
    notify-send -u critical -i dialog-error "arc snap" "Snapshot failed (code $rc) — check: arc logs ts" 2>/dev/null || true
  fi
  echo -e "$HR"
}

cmd_logs() {
  case "${1:-}" in
    tail)
      echo -e "$HR"
      echo -e "  ${C}${B}arc logs tail${N}  —  live  ${D}(ctrl-c to exit)${N}"
      echo -e "$HR\n"
      tail -f /var/log/auth.log /var/log/ufw.log 2>/dev/null
      ;;
    ts)
      echo -e "$HR"
      echo -e "  ${C}${B}arc logs ts${N}  —  timeshift"
      echo -e "$HR\n"
      local tsdir="/var/log/timeshift"
      if [[ ! -d "$tsdir" ]]; then
        echo -e "  ${D}·${N}  /var/log/timeshift not found"; echo -e "\n$HR"; return
      fi
      # Was *backup.log -- real filenames are timestamp-prefixed with
      # _ondemand/_delete/_gui/_list-snapshots suffixes, never "backup.log",
      # so this glob never matched a single real file. Filenames sort
      # chronologically, so plain *.log + sort picks the true latest.
      local latest
      latest=$(ls "$tsdir"/*.log 2>/dev/null | sort | tail -1)
      if [[ -n "$latest" ]]; then
        echo -e "  ${C}latest:${N}  ${D}$(basename "$latest")${N}\n"
        tail -60 "$latest" | while IFS= read -r line; do
          if echo "$line" | grep -qiE "error|fail|MEGA|warn"; then
            echo -e "  ${R}·${N}  $line"
          else
            echo -e "  ${D}·${N}  $line"
          fi
        done
      else
        echo -e "  ${D}·${N}  no backup logs found in $tsdir"
        ls "$tsdir/" 2>/dev/null | while IFS= read -r f; do echo -e "  ${D}·${N}  $f"; done
      fi
      echo -e "\n$HR"
      ;;
    suricata)
      echo -e "$HR"
      echo -e "  ${C}${B}arc logs suricata${N}  —  live  ${D}(ctrl-c to exit)${N}"
      echo -e "$HR\n"
      sudo tail -f -n0 /var/log/suricata/eve.json 2>/dev/null | while IFS= read -r line; do
        echo "$line" | python3 -c "
import json,sys
try:
    d = json.loads(sys.stdin.readline())
except Exception:
    sys.exit(0)
if d.get('event_type') != 'alert':
    sys.exit(0)
a = d.get('alert', {})
print(f\"  {d.get('timestamp','?')[:19]}  {a.get('signature','?')}  ({d.get('src_ip','?')} -> {d.get('dest_ip','?')})\")
"
      done
      ;;
    clamav)
      echo -e "$HR"
      echo -e "  ${C}${B}arc logs clamav${N}  —  last scan"
      echo -e "$HR\n"
      if [[ -f /var/log/clamav-home-scan.log ]]; then
        tail -20 /var/log/clamav-home-scan.log
      else
        echo -e "  ${D}·${N}  no scan has been run yet — ${C}arc sec clamav${N} to start one"
      fi
      echo -e "\n$HR"
      ;;
    chkrootkit)
      echo -e "$HR"
      echo -e "  ${C}${B}arc logs chkrootkit${N}  —  last scan"
      echo -e "$HR\n"
      if [[ -f /var/log/chkrootkit.log ]]; then
        cat /var/log/chkrootkit.log
      else
        echo -e "  ${D}·${N}  no scan has been run yet — ${C}arc sec chkrootkit${N} to run one"
      fi
      echo -e "\n$HR"
      ;;
    rkhunter)
      echo -e "$HR"
      echo -e "  ${C}${B}arc logs rkhunter${N}  —  last scan"
      echo -e "$HR\n"
      if sudo test -f /var/log/rkhunter.log 2>/dev/null; then
        sudo cat /var/log/rkhunter.log
      else
        echo -e "  ${D}·${N}  no scan has been run yet — ${C}arc sec rkhunter${N} to run one"
      fi
      echo -e "\n$HR"
      ;;
    '')
      _sec_logs
      ;;
    *)
      echo -e "  ${D}arc logs${N}              snapshot: auth · sudo · ufw · journal"
      echo -e "  ${D}arc logs tail${N}         live tail: auth.log + ufw.log"
      echo -e "  ${D}arc logs ts${N}           timeshift log"
      echo -e "  ${D}arc logs suricata${N}     live tail: IDS alerts (ctrl-c to exit)"
      echo -e "  ${D}arc logs clamav${N}       last antivirus scan log"
      echo -e "  ${D}arc logs chkrootkit${N}   last rootkit scan log"
      echo -e "  ${D}arc logs rkhunter${N}     last rootkit hunter scan log"
      ;;
  esac
}

_sec_f2b() {
  local sub="${1:-}"
  shift 2>/dev/null

  case "$sub" in

    restart)
      _sec_hdr "fail2ban  —  restart"
      sudo systemctl restart fail2ban
      sleep 1
      sudo fail2ban-client status
      echo -e "\n$HR"
      ;;

    check)
      _sec_hdr "fail2ban  —  config test"
      local out
      out=$(sudo fail2ban-client -t 2>&1)
      if echo "$out" | grep -q "OK\|Configuration OK"; then
        echo -e "  ${G}✓${N}  configuration ok"
      else
        echo "$out" | while IFS= read -r line; do
          echo -e "  ${R}·${N}  $line"
        done
      fi
      echo -e "\n$HR"
      ;;

    ban)
      local ip="${1:-}"
      _sec_hdr "fail2ban  —  manual ban"
      if [[ -z "$ip" ]]; then
        echo -e "  ${R}usage:${N} arc sec f2b ban <ip>"; echo -e "\n$HR"; return 1
      fi
      sudo fail2ban-client set sshd banip "$ip" \
        && echo -e "  ${G}✓${N}  banned: $ip" \
        || echo -e "  ${R}✗${N}  ban failed"
      echo -e "\n$HR"
      ;;

    unban)
      local ip="${1:-}"
      _sec_hdr "fail2ban  —  unban"
      if [[ -z "$ip" ]]; then
        echo -e "  ${R}usage:${N} arc sec f2b unban <ip>"; echo -e "\n$HR"; return 1
      fi
      sudo fail2ban-client unban "$ip" \
        && echo -e "  ${G}✓${N}  unbanned: $ip" \
        || echo -e "  ${R}✗${N}  unban failed — is that IP actually banned?"
      echo -e "\n$HR"
      ;;

    banned)
      _sec_hdr "fail2ban  —  all banned IPs"
      local jails
      jails=$(sudo fail2ban-client status 2>/dev/null | grep "Jail list" | cut -d: -f2 | tr -d ' ')
      if [[ -z "$jails" ]]; then
        echo -e "  ${R}✗${N}  fail2ban not running"; echo -e "\n$HR"; return
      fi
      IFS=',' read -ra jail_list <<< "$jails"
      local any=0
      for jail in "${jail_list[@]}"; do
        [[ -z "$jail" ]] && continue
        local ips
        ips=$(sudo fail2ban-client get "$jail" banip 2>/dev/null)
        if [[ -n "$ips" && "$ips" != "0" ]]; then
          any=1
          echo -e "  ${C}${jail}${N}"
          echo "$ips" | tr ' ' '\n' | while IFS= read -r ip; do
            [[ -n "$ip" ]] && echo -e "  ${R}·${N}  $ip"
          done
          echo ""
        fi
      done
      (( any == 0 )) && echo -e "  ${G}·${N}  no IPs currently banned"
      echo -e "\n$HR"
      ;;

    patch)
      _sec_hdr "fail2ban  —  patch  ${D}(edit jail.local)${N}"
      sudo nano /etc/fail2ban/jail.local
      echo -e "\n  ${C}testing config...${N}"
      local out
      out=$(sudo fail2ban-client -t 2>&1)
      if echo "$out" | grep -q "OK\|Configuration OK"; then
        echo -e "  ${G}✓${N}  config ok — reloading..."
        sudo fail2ban-client reload
      else
        echo -e "  ${R}✗${N}  config error:"
        echo "$out" | while IFS= read -r line; do echo -e "  ${R}·${N}  $line"; done
        echo -e "  ${Y}!${N}  fix the error then run: arc sec f2b restart"
      fi
      echo -e "\n$HR"
      ;;

    logs)
      _sec_hdr "fail2ban  —  log  ${D}(last 30)${N}"
      sudo tail -30 /var/log/fail2ban.log 2>/dev/null | while IFS= read -r line; do
        if echo "$line" | grep -qi "ban\|block"; then
          echo -e "  ${R}·${N}  $line"
        elif echo "$line" | grep -qi "unban\|restore"; then
          echo -e "  ${Y}·${N}  $line"
        else
          echo -e "  ${D}·${N}  $line"
        fi
      done
      echo -e "\n$HR"
      ;;

    '')
      _sec_hdr "fail2ban  —  brute force protection"

      local status
      status=$(sudo fail2ban-client status 2>/dev/null)
      if [[ -z "$status" ]]; then
        echo -e "  ${R}✗${N}  fail2ban not running"
        echo -e "  ${D}·${N}  start with: arc sec f2b restart"
        echo -e "\n$HR"; return
      fi

      local jails
      jails=$(echo "$status" | grep "Jail list" | cut -d: -f2 | tr -d ' ')
      echo -e "  ${C}jails${N}"
      IFS=',' read -ra jail_list <<< "$jails"
      for jail in "${jail_list[@]}"; do
        [[ -z "$jail" ]] && continue
        local j_status failed banned
        j_status=$(sudo fail2ban-client status "$jail" 2>/dev/null)
        failed=$(echo "$j_status" | grep "Currently failed" | awk '{print $NF}')
        banned=$(echo "$j_status" | grep "Currently banned" | awk '{print $NF}')
        if (( banned > 0 )); then
          echo -e "  ${R}·${N}  ${jail}  ${D}·${N}  failed: ${failed}  ${D}·${N}  banned: ${R}${banned}${N}"
        else
          echo -e "  ${G}·${N}  ${jail}  ${D}·${N}  failed: ${failed}  ${D}·${N}  banned: ${banned}"
        fi
      done

      echo ""
      echo -e "$HR"
      echo -e "  ${D}arc sec f2b banned          — full banned IP list${N}"
      echo -e "  ${D}arc sec f2b ban <ip>        — manual ban${N}"
      echo -e "  ${D}arc sec f2b unban <ip>      — surgical unban${N}"
      echo -e "  ${D}arc sec f2b logs            — recent log tail${N}"
      echo -e "  ${D}arc sec f2b check           — test config${N}"
      echo -e "  ${D}arc sec f2b patch           — edit jail.local + auto-test${N}"
      echo -e "  ${D}arc sec f2b restart         — reload + restart${N}"
      echo -e "$HR"
      ;;

    *)
      echo -e "${R}unknown:${N} arc sec f2b $sub"
      echo -e "${D}options: banned · ban · unban · logs · check · patch · restart${N}"
      ;;
  esac
}

_sec_overview() {
  echo -e "$HR"
  echo -e "  ${C}${B}arc sec${N}  —  security overview"
  echo -e "$HR\n"

  # Users
  echo -e "  ${C}users${N}"
  local sudoers sessions fail_count
  sudoers=$(getent group sudo 2>/dev/null | awk -F: '{print $4}')
  sessions=$(who 2>/dev/null | wc -l | tr -d ' ')
  fail_count=$(grep -cE "authentication failure|Failed password" /var/log/auth.log 2>/dev/null)
  fail_count=${fail_count:-0}
  echo -e "  ${D}·${N}  sudo group:      ${W}${sudoers:-none}${N}"
  echo -e "  ${D}·${N}  active sessions: ${sessions}"
  (( fail_count > 0 )) \
    && echo -e "  ${R}·${N}  auth failures:   ${fail_count}" \
    || echo -e "  ${G}·${N}  auth failures:   ${fail_count}"

  echo ""
  # Network
  echo -e "  ${C}network${N}"
  local wstate resolver
  wstate=$(nmcli radio wifi 2>/dev/null)
  resolver=$(grep '^nameserver' /etc/resolv.conf 2>/dev/null | head -1 | awk '{print $2}')
  local ports
  ports=$(ss -tlnp 2>/dev/null | tail -n +2 | wc -l | tr -d ' ')
  echo -e "  ${D}·${N}  wifi:            ${wstate}"
  echo -e "  ${D}·${N}  listening ports: ${ports}"
  if systemctl is-active --quiet nextdns 2>/dev/null; then
    echo -e "  ${G}·${N}  nextdns:         active  ${D}(${resolver})${N}"
  else
    echo -e "  ${Y}·${N}  nextdns:         inactive  ${D}(${resolver})${N}"
  fi

  echo ""
  # Firewall
  echo -e "  ${C}firewall${N}"
  local ufw_out ufw_line
  ufw_out=$(sudo ufw status 2>&1)
  # sudo failing non-interactively (no password/no terminal) and ufw
  # genuinely not being installed/running both look like "empty output" if
  # stderr is swallowed -- can't tell them apart. Check sudo's own failure
  # text first, same pattern as the chkrootkit/rkhunter fix (2026-07-30).
  if echo "$ufw_out" | grep -qi "password is required\|terminal is required\|incorrect password"; then
    echo -e "  ${Y}·${N}  sudo failed — can't check (not the same as 'not found')"
  else
    ufw_line=$(echo "$ufw_out" | head -1)
    echo -e "  ${D}·${N}  ufw:             ${ufw_line:-not found}"
  fi

  echo ""
  # Fail2ban
  echo -e "  ${C}fail2ban${N}"
  local f2b_out f2b_jails f2b_banned
  f2b_out=$(sudo fail2ban-client status 2>&1)
  if echo "$f2b_out" | grep -qi "password is required\|terminal is required\|incorrect password"; then
    echo -e "  ${Y}·${N}  sudo failed — can't check (not the same as 'not running')"
  else
    f2b_jails=$(echo "$f2b_out" | grep "Jail list" | cut -d: -f2 | tr -d ' ')
    if [[ -n "$f2b_jails" ]]; then
      f2b_banned=$(sudo fail2ban-client status sshd 2>/dev/null | grep "Currently banned" | awk '{print $NF}')
      echo -e "  ${G}·${N}  running  ${D}·${N}  jails: ${W}${f2b_jails}${N}  ${D}·${N}  banned: ${f2b_banned:-0}"
    else
      echo -e "  ${R}·${N}  not running"
    fi
  fi

  echo ""
  # Encryption
  echo -e "  ${C}encryption${N}"
  if [[ -b /dev/mapper/storage_crypt ]]; then
    echo -e "  ${G}·${N}  usb luks:        open"
  else
    echo -e "  ${Y}·${N}  usb luks:        closed"
  fi

  echo ""
  # SOC lab (Docker: Sagan correlation engine + EveBox triage UI)
  echo -e "  ${C}soc lab${N}"
  local sagan_state evebox_state
  sagan_state=$(docker inspect --format '{{.State.Status}}' sagan 2>/dev/null)
  evebox_state=$(docker inspect --format '{{.State.Status}}' evebox 2>/dev/null)
  [[ "$sagan_state" == "running" ]] \
    && echo -e "  ${G}·${N}  sagan:           running" \
    || echo -e "  ${R}·${N}  sagan:           ${sagan_state:-not found}"
  [[ "$evebox_state" == "running" ]] \
    && echo -e "  ${G}·${N}  evebox:          running  ${D}(http://127.0.0.1:5636)${N}" \
    || echo -e "  ${R}·${N}  evebox:          ${evebox_state:-not found}"

  echo ""
  echo -e "$HR"
  echo -e "  ${D}arc sec audit     — workstation hardening scan${N}"
  echo -e "  ${D}arc sec users     — accounts · sessions · failed auth${N}"
  echo -e "  ${D}arc sec net       — ports · connections · dns · arp${N}"
  echo -e "  ${D}arc sec firewall  — ufw rules${N}"
  echo -e "  ${D}arc sec f2b       — fail2ban jails + banned IPs${N}"
  echo -e "  ${D}arc sec apps      — apt · snap · flatpak${N}"
  echo -e "  ${D}arc sec logs      — auth · sudo · ufw blocks · journal${N}"
  echo -e "  ${D}arc sec lynis     — full lynis hardening audit${N}"
  echo -e "  ${D}arc sec docker-bench — CIS Docker Benchmark against every container currently running${N}"
  echo -e "  ${D}arc sec aide      — file integrity check (daily timer + arc-pine alert on drift)${N}"
  echo -e "  ${D}arc sec chkrootkit — rootkit scan${N}"
  echo -e "  ${D}arc sec rkhunter  — rootkit hunter scan${N}"
  echo -e "  ${D}arc sec clamav    — antivirus scan of \$HOME (background)${N}"
  echo -e "  ${D}arc sec suricata  — network IDS status + recent alerts${N}"
  echo -e "  ${D}arc sagan/evebox  — SOC lab: correlated alerts (fail2ban+ufw feed in too now)${N}"
  echo -e "  ${D}arc soc-lab       — Splunk lab (local Docker, khaos-lab/soc-lab -- SQL Server + Nessus both purged, see 2026-08-31/08-25)${N}"
  echo -e "  ${D}arc gvm           — GVM/OpenVAS vuln scanner (native services, manual-start, needs 4GB+ free RAM)${N}"
  echo -e "  ${D}arc zap           — OWASP ZAP web app scanner (manual-start, lab-only targets by default)${N}"
  echo -e "  ${D}arc darkstat      — live traffic dashboard (manual-start, loopback only)${N}"
  echo -e "$HR"
}

cmd_sec() {
  case "${1:-}" in
    audit)    ~/.local/bin/arc-sec-audit ;;
    users)    _sec_users ;;
    net)      _sec_net ;;
    firewall) _sec_firewall "${2:-}" "${@:3}" ;;
    apps)     _sec_apps ;;
    logs)     _sec_logs ;;
    f2b)      _sec_f2b "${2:-}" "${@:3}" ;;
    lynis)    _sec_lynis ;;
    docker-bench) _sec_docker_bench ;;
    aide)     _sec_aide ;;
    chkrootkit) _sec_chkrootkit ;;
    rkhunter) _sec_rkhunter ;;
    clamav)   _sec_clamav "${2:-}" ;;
    suricata) _sec_suricata ;;
    '')       _sec_overview ;;
    *)
      echo -e "${R}unknown:${N} arc sec $1"
      echo -e "${D}options: audit · users · net · firewall · apps · logs · f2b · lynis · docker-bench · aide · chkrootkit · rkhunter · clamav · suricata${N}"
      return 1
      ;;
  esac
}

# ── Users ──────────────────────────────────────────────────────────────────────
# Defensive helpers — validate before any write operation

_users_validate() {
  local user="$1"
  # Only allow lowercase letters, digits, dash, underscore; 1-32 chars
  if [[ ! "$user" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]]; then
    echo -e "  ${R}✗${N}  invalid username: '${user}'"
    return 1
  fi
  if ! id "$user" &>/dev/null; then
    echo -e "  ${R}✗${N}  user not found: ${user}"
    return 1
  fi
  return 0
}

_users_no_root() {
  local user="$1"
  local uid
  uid=$(id -u "$user" 2>/dev/null)
  if [[ "$user" == "root" || "$uid" == "0" ]]; then
    echo -e "  ${R}✗${N}  refusing to modify root — not allowed"
    return 1
  fi
  return 0
}

_users_no_sys() {
  local user="$1"
  local uid
  uid=$(id -u "$user" 2>/dev/null)
  if (( uid < 1000 )); then
    echo -e "  ${R}✗${N}  refusing to modify system user (uid=${uid})"
    return 1
  fi
  return 0
}

_users_confirm() {
  local msg="$1"
  printf "  ${Y}?${N}  %s  [y/N] " "$msg" >&2
  local ans
  read -r ans < /dev/tty
  [[ "$ans" =~ ^[yY]$ ]]
}

_users_overview() {
  echo -e "$HR"
  echo -e "  ${C}${B}arc users${N}  —  user administration"
  echo -e "$HR\n"

  echo -e "  ${C}accounts  ${D}(uid 1000+)${N}"
  while IFS=: read -r name _ uid _ _ _ shell; do
    (( uid >= 1000 && uid < 65534 )) || continue
    local shell_str
    if [[ "$shell" == "/usr/sbin/nologin" || "$shell" == "/bin/false" ]]; then
      shell_str="${D}nologin${N}"
    else
      shell_str="${M}${shell}${N}"
    fi
    echo -e "  ${D}·${N}  ${M}${name}${N}  ${D}uid=${uid}${N}  ${shell_str}"
  done < /etc/passwd

  echo ""
  echo -e "  ${C}sudo members${N}"
  getent group sudo 2>/dev/null | awk -F: '{print $4}' | tr ',' '\n' \
    | while IFS= read -r u; do
        [[ -n "$u" ]] && echo -e "  ${Y}·${N}  ${u}"
      done

  echo ""
  echo -e "  ${C}active sessions${N}"
  local sess
  sess=$(who 2>/dev/null)
  if [[ -n "$sess" ]]; then
    echo "$sess" | while IFS= read -r line; do echo -e "  ${G}·${N}  ${line}"; done
  else
    echo -e "  ${D}·${N}  none"
  fi

  echo ""
  echo -e "  ${C}recent logins  ${D}(last 5)${N}"
  last -n 5 2>/dev/null | head -5 | while IFS= read -r line; do
    echo -e "  ${D}·${N}  ${line}"
  done

  echo ""
  echo -e "$HR"
  echo -e "  ${D}check · lock · unlock · groups · add-group · rm-group · shell · sessions · passwd-age${N}"
  echo -e "  ${D}add · del · groupadd · groupdel · chmod · chown · chgrp${N}"
  echo -e "$HR"
}

_users_check() {
  echo -e "$HR"
  echo -e "  ${C}${B}arc users check${N}  —  account security audit"
  echo -e "$HR\n"

  echo -e "  ${C}login shells${N}"
  while IFS=: read -r name _ uid _ _ _ shell; do
    (( uid >= 1000 && uid < 65534 )) || continue
    if [[ "$shell" == "/usr/sbin/nologin" || "$shell" == "/bin/false" ]]; then
      echo -e "  ${G}·${N}  ${M}${name}${N}  ${D}${shell}${N}"
    else
      echo -e "  ${Y}·${N}  ${M}${name}${N}  ${shell}"
    fi
  done < /etc/passwd

  echo ""
  echo -e "  ${C}password status${N}"
  while IFS=: read -r name _ uid _ _ _ _; do
    (( uid >= 1000 && uid < 65534 )) || continue
    local pstat
    pstat=$(sudo passwd -S "$name" 2>/dev/null | awk '{print $2}')
    case "$pstat" in
      P)  echo -e "  ${G}·${N}  ${M}${name}${N}  ${D}set${N}" ;;
      L)  echo -e "  ${R}·${N}  ${M}${name}${N}  locked" ;;
      NP) echo -e "  ${R}·${N}  ${M}${name}${N}  ${R}no password — risk${N}" ;;
      *)  echo -e "  ${D}·${N}  ${M}${name}${N}  ${D}${pstat:-unknown}${N}" ;;
    esac
  done < /etc/passwd

  echo ""
  echo -e "  ${C}group memberships  ${D}(human users)${N}"
  while IFS=: read -r name _ uid _ _ _ _; do
    (( uid >= 1000 && uid < 65534 )) || continue
    local grps
    grps=$(id -Gn "$name" 2>/dev/null | tr ' ' ',')
    echo -e "  ${D}·${N}  ${M}${name}${N}  ${D}${grps}${N}"
  done < /etc/passwd

  echo ""
  echo -e "  ${C}privileged groups${N}"
  local g
  for g in sudo adm; do
    local members
    members=$(getent group "$g" 2>/dev/null | awk -F: '{print $4}')
    if [[ -n "$members" ]]; then
      echo -e "  ${Y}·${N}  ${g}: ${members}"
    else
      echo -e "  ${D}·${N}  ${g}: ${D}empty${N}"
    fi
  done

  echo ""
  echo -e "  ${C}sudoers overrides  ${D}(/etc/sudoers.d/)${N}"
  if [[ -d /etc/sudoers.d ]]; then
    local f found=0
    for f in /etc/sudoers.d/*; do
      [[ -f "$f" ]] && echo -e "  ${D}·${N}  ${f##*/}" && found=1
    done
    (( found == 0 )) && echo -e "  ${D}·${N}  none"
  else
    echo -e "  ${D}·${N}  /etc/sudoers.d not found"
  fi

  echo ""
  echo -e "  ${C}password age  ${D}(human users)${N}"
  while IFS=: read -r name _ uid _ _ _ _; do
    (( uid >= 1000 && uid < 65534 )) || continue
    local last_chg expires
    last_chg=$(chage -l "$name" 2>/dev/null | grep "Last password change" | cut -d: -f2- | xargs)
    expires=$(chage -l "$name" 2>/dev/null | grep "Password expires" | cut -d: -f2- | xargs)
    echo -e "  ${D}·${N}  ${M}${name}${N}  last: ${D}${last_chg:-?}${N}  expires: ${D}${expires:-never}${N}"
  done < /etc/passwd

  echo -e "\n$HR"
}

_users_lock() {
  local user="${1:-}"
  echo -e "$HR"
  echo -e "  ${C}${B}arc users lock${N}  —  lock account"
  echo -e "$HR\n"
  if [[ -z "$user" ]]; then
    echo -e "  ${R}✗${N}  usage: arc users lock <username>"
    echo -e "$HR"; return 1
  fi
  _users_validate "$user" || { echo -e "$HR"; return 1; }
  _users_no_root "$user"   || { echo -e "$HR"; return 1; }
  _users_no_sys "$user"    || { echo -e "$HR"; return 1; }
  if [[ "$user" == "$(whoami)" ]]; then
    echo -e "  ${R}✗${N}  cannot lock your own active account"
    echo -e "$HR"; return 1
  fi
  local pstat
  pstat=$(sudo passwd -S "$user" 2>/dev/null | awk '{print $2}')
  if [[ "$pstat" == "L" ]]; then
    echo -e "  ${Y}!${N}  ${user} is already locked"
    echo -e "$HR"; return 0
  fi
  echo -e "  ${D}·${N}  user: ${M}${user}${N}  status: ${D}${pstat}${N}"
  _users_confirm "Lock account '${user}'?" || { echo -e "  ${D}aborted${N}"; echo -e "$HR"; return 0; }
  if sudo passwd -l "$user" &>/dev/null; then
    echo -e "  ${G}✓${N}  ${user} locked"
  else
    echo -e "  ${R}✗${N}  failed — check sudoers"
  fi
  echo -e "$HR"
}

_users_unlock() {
  local user="${1:-}"
  echo -e "$HR"
  echo -e "  ${C}${B}arc users unlock${N}  —  unlock account"
  echo -e "$HR\n"
  if [[ -z "$user" ]]; then
    echo -e "  ${R}✗${N}  usage: arc users unlock <username>"
    echo -e "$HR"; return 1
  fi
  _users_validate "$user" || { echo -e "$HR"; return 1; }
  _users_no_root "$user"   || { echo -e "$HR"; return 1; }
  _users_no_sys "$user"    || { echo -e "$HR"; return 1; }
  local pstat
  pstat=$(sudo passwd -S "$user" 2>/dev/null | awk '{print $2}')
  if [[ "$pstat" != "L" ]]; then
    echo -e "  ${Y}!${N}  ${user} is not locked  ${D}(status: ${pstat})${N}"
    echo -e "$HR"; return 0
  fi
  echo -e "  ${D}·${N}  user: ${M}${user}${N}  status: ${R}locked${N}"
  _users_confirm "Unlock account '${user}'?" || { echo -e "  ${D}aborted${N}"; echo -e "$HR"; return 0; }
  if sudo passwd -u "$user" &>/dev/null; then
    echo -e "  ${G}✓${N}  ${user} unlocked"
  else
    echo -e "  ${R}✗${N}  failed — check sudoers"
  fi
  echo -e "$HR"
}

_users_groups() {
  local user="${1:-$(whoami)}"
  echo -e "$HR"
  echo -e "  ${C}${B}arc users groups${N}  —  group memberships"
  echo -e "$HR\n"
  _users_validate "$user" || { echo -e "$HR"; return 1; }
  echo -e "  ${M}${user}${N}"
  id -Gn "$user" 2>/dev/null | tr ' ' '\n' | sort | while IFS= read -r g; do
    local gid
    gid=$(getent group "$g" 2>/dev/null | awk -F: '{print $3}')
    if [[ "$g" == "sudo" || "$g" == "adm" ]]; then
      echo -e "  ${Y}·${N}  ${g}  ${D}(gid=${gid})${N}  ${Y}privileged${N}"
    else
      echo -e "  ${D}·${N}  ${g}  ${D}(gid=${gid})${N}"
    fi
  done
  echo -e "\n$HR"
}

_users_add_group() {
  local user="${1:-}" grp="${2:-}"
  local -a ALLOWED_GROUPS=(adm audio cdrom dialout floppy netdev plugdev sudo video)
  echo -e "$HR"
  echo -e "  ${C}${B}arc users add-group${N}  —  add user to group"
  echo -e "$HR\n"
  if [[ -z "$user" || -z "$grp" ]]; then
    echo -e "  ${R}✗${N}  usage: arc users add-group <username> <group>"
    echo -e "  ${D}allowed groups: ${ALLOWED_GROUPS[*]}${N}"
    echo -e "$HR"; return 1
  fi
  _users_validate "$user" || { echo -e "$HR"; return 1; }
  _users_no_root "$user"   || { echo -e "$HR"; return 1; }
  _users_no_sys "$user"    || { echo -e "$HR"; return 1; }
  # Group name must be in whitelist — no arbitrary group adds
  local ok=0 g
  for g in "${ALLOWED_GROUPS[@]}"; do
    [[ "$g" == "$grp" ]] && ok=1 && break
  done
  if (( ok == 0 )); then
    echo -e "  ${R}✗${N}  group not in allowlist: '${grp}'"
    echo -e "  ${D}allowed: ${ALLOWED_GROUPS[*]}${N}"
    echo -e "$HR"; return 1
  fi
  if ! getent group "$grp" &>/dev/null; then
    echo -e "  ${R}✗${N}  group does not exist on this system: ${grp}"
    echo -e "$HR"; return 1
  fi
  if id -Gn "$user" 2>/dev/null | grep -qw "$grp"; then
    echo -e "  ${Y}!${N}  ${user} is already in ${grp}"
    echo -e "$HR"; return 0
  fi
  echo -e "  ${D}·${N}  add ${M}${user}${N} to group ${Y}${grp}${N}"
  [[ "$grp" == "sudo" || "$grp" == "adm" ]] \
    && echo -e "  ${R}⚠${N}  this grants elevated privileges"
  _users_confirm "Add '${user}' to '${grp}'?" || { echo -e "  ${D}aborted${N}"; echo -e "$HR"; return 0; }
  if sudo usermod -aG "$grp" "$user"; then
    echo -e "  ${G}✓${N}  done  ${D}(re-login required)${N}"
  else
    echo -e "  ${R}✗${N}  usermod failed"
  fi
  echo -e "$HR"
}

_users_rm_group() {
  local user="${1:-}" grp="${2:-}"
  echo -e "$HR"
  echo -e "  ${C}${B}arc users rm-group${N}  —  remove user from group"
  echo -e "$HR\n"
  if [[ -z "$user" || -z "$grp" ]]; then
    echo -e "  ${R}✗${N}  usage: arc users rm-group <username> <group>"
    echo -e "$HR"; return 1
  fi
  _users_validate "$user" || { echo -e "$HR"; return 1; }
  _users_no_root "$user"   || { echo -e "$HR"; return 1; }
  _users_no_sys "$user"    || { echo -e "$HR"; return 1; }
  # Group name: same safe charset as username
  if [[ ! "$grp" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]]; then
    echo -e "  ${R}✗${N}  invalid group name: '${grp}'"
    echo -e "$HR"; return 1
  fi
  local primary
  primary=$(id -gn "$user" 2>/dev/null)
  if [[ "$grp" == "$primary" ]]; then
    echo -e "  ${R}✗${N}  cannot remove ${user} from their primary group (${grp})"
    echo -e "$HR"; return 1
  fi
  if ! id -Gn "$user" 2>/dev/null | grep -qw "$grp"; then
    echo -e "  ${Y}!${N}  ${user} is not in group ${grp}"
    echo -e "$HR"; return 0
  fi
  echo -e "  ${D}·${N}  remove ${M}${user}${N} from group ${Y}${grp}${N}"
  [[ "$grp" == "sudo" ]] \
    && echo -e "  ${Y}⚠${N}  this removes sudo access from ${user}"
  _users_confirm "Remove '${user}' from '${grp}'?" || { echo -e "  ${D}aborted${N}"; echo -e "$HR"; return 0; }
  if sudo gpasswd -d "$user" "$grp" &>/dev/null; then
    echo -e "  ${G}✓${N}  done  ${D}(re-login required)${N}"
  else
    echo -e "  ${R}✗${N}  gpasswd failed"
  fi
  echo -e "$HR"
}

_users_shell() {
  local user="${1:-}" new_shell="${2:-}"
  local -a ALLOWED_SHELLS=(/bin/bash /bin/zsh /usr/bin/bash /usr/bin/zsh /usr/sbin/nologin /bin/false)
  echo -e "$HR"
  echo -e "  ${C}${B}arc users shell${N}  —  view or set login shell"
  echo -e "$HR\n"
  if [[ -z "$user" ]]; then
    echo -e "  ${R}✗${N}  usage: arc users shell <username> [shell]"
    echo -e "  ${D}allowed shells: ${ALLOWED_SHELLS[*]}${N}"
    echo -e "$HR"; return 1
  fi
  _users_validate "$user" || { echo -e "$HR"; return 1; }
  _users_no_root "$user"   || { echo -e "$HR"; return 1; }
  _users_no_sys "$user"    || { echo -e "$HR"; return 1; }
  local current
  current=$(getent passwd "$user" 2>/dev/null | awk -F: '{print $7}')
  if [[ -z "$new_shell" ]]; then
    echo -e "  ${M}${user}${N}  shell: ${D}${current}${N}"
    echo -e "\n  ${D}to change: arc users shell ${user} /usr/sbin/nologin${N}"
    echo -e "  ${D}allowed: ${ALLOWED_SHELLS[*]}${N}"
    echo -e "$HR"; return 0
  fi
  # Validate shell is in whitelist — no arbitrary shell setting
  local ok=0 s
  for s in "${ALLOWED_SHELLS[@]}"; do
    [[ "$s" == "$new_shell" ]] && ok=1 && break
  done
  if (( ok == 0 )); then
    echo -e "  ${R}✗${N}  shell not in allowlist: '${new_shell}'"
    echo -e "  ${D}allowed: ${ALLOWED_SHELLS[*]}${N}"
    echo -e "$HR"; return 1
  fi
  if [[ ! -x "$new_shell" ]]; then
    echo -e "  ${R}✗${N}  shell not found or not executable: ${new_shell}"
    echo -e "$HR"; return 1
  fi
  echo -e "  ${D}·${N}  ${M}${user}${N}  ${D}${current}${N}  →  ${M}${new_shell}${N}"
  _users_confirm "Set shell for '${user}' to '${new_shell}'?" \
    || { echo -e "  ${D}aborted${N}"; echo -e "$HR"; return 0; }
  if sudo usermod -s "$new_shell" "$user"; then
    echo -e "  ${G}✓${N}  shell updated"
  else
    echo -e "  ${R}✗${N}  usermod failed"
  fi
  echo -e "$HR"
}

_users_add() {
  local user="${1:-}" new_shell="${2:-/bin/bash}"
  local -a ALLOWED_SHELLS=(/bin/bash /bin/zsh /usr/bin/bash /usr/bin/zsh /usr/sbin/nologin /bin/false)
  local -a RESERVED=(root admin administrator toor daemon bin sys sync games man lp mail news uucp proxy www-data backup list irc gnats nobody systemd-network systemd-resolve messagebus sshd bonesaw)
  echo -e "$HR"
  echo -e "  ${C}${B}arc users add${N}  —  create account"
  echo -e "$HR\n"
  if [[ -z "$user" ]]; then
    echo -e "  ${R}✗${N}  usage: arc users add <username> [shell]"
    echo -e "  ${D}allowed shells: ${ALLOWED_SHELLS[*]}  (default: /bin/bash)${N}"
    echo -e "$HR"; return 1
  fi
  if [[ ! "$user" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]]; then
    echo -e "  ${R}✗${N}  invalid username: '${user}'"
    echo -e "$HR"; return 1
  fi
  local r
  for r in "${RESERVED[@]}"; do
    if [[ "$user" == "$r" ]]; then
      echo -e "  ${R}✗${N}  refusing reserved/system-style name: '${user}'"
      echo -e "$HR"; return 1
    fi
  done
  if id "$user" &>/dev/null; then
    echo -e "  ${R}✗${N}  user already exists: ${user}"
    echo -e "$HR"; return 1
  fi
  local ok=0 s
  for s in "${ALLOWED_SHELLS[@]}"; do
    [[ "$s" == "$new_shell" ]] && ok=1 && break
  done
  if (( ok == 0 )); then
    echo -e "  ${R}✗${N}  shell not in allowlist: '${new_shell}'"
    echo -e "  ${D}allowed: ${ALLOWED_SHELLS[*]}${N}"
    echo -e "$HR"; return 1
  fi
  echo -e "  ${D}·${N}  create ${M}${user}${N}  shell: ${Y}${new_shell}${N}"
  echo -e "  ${D}·${N}  no password will be set — account stays locked until: ${C}sudo passwd ${user}${N}"
  _users_confirm "Create account '${user}'?" || { echo -e "  ${D}aborted${N}"; echo -e "$HR"; return 0; }
  if sudo adduser --disabled-password --gecos "" --shell "$new_shell" "$user" &>/dev/null; then
    echo -e "  ${G}✓${N}  ${user} created  ${D}(home: /home/${user})${N}"
    echo -e "  ${D}next: sudo passwd ${user}   ·   arc users add-group ${user} <group>${N}"
  else
    echo -e "  ${R}✗${N}  adduser failed"
  fi
  echo -e "$HR"
}

_users_del() {
  local user="${1:-}"
  echo -e "$HR"
  echo -e "  ${C}${B}arc users del${N}  —  delete account"
  echo -e "$HR\n"
  if [[ -z "$user" ]]; then
    echo -e "  ${R}✗${N}  usage: arc users del <username>"
    echo -e "$HR"; return 1
  fi
  _users_validate "$user" || { echo -e "$HR"; return 1; }
  _users_no_root "$user"   || { echo -e "$HR"; return 1; }
  _users_no_sys "$user"    || { echo -e "$HR"; return 1; }
  if [[ "$user" == "$(whoami)" ]]; then
    echo -e "  ${R}✗${N}  cannot delete your own active account"
    echo -e "$HR"; return 1
  fi
  if who 2>/dev/null | awk '{print $1}' | grep -qx "$user"; then
    echo -e "  ${R}✗${N}  ${user} has an active session — log them out first"
    echo -e "$HR"; return 1
  fi
  local home; home=$(getent passwd "$user" | awk -F: '{print $6}')
  echo -e "  ${R}⚠${N}  this will delete account ${M}${user}${N}  ${D}(home: ${home})${N}"
  _users_confirm "Delete account '${user}'?" || { echo -e "  ${D}aborted${N}"; echo -e "$HR"; return 0; }
  local typed
  printf "  ${Y}?${N}  type the username to confirm: " >&2
  read -r typed < /dev/tty
  if [[ "$typed" != "$user" ]]; then
    echo -e "  ${D}aborted — typed value did not match${N}"
    echo -e "$HR"; return 0
  fi
  local rm_home=0
  _users_confirm "Also delete home directory (${home})?" && rm_home=1
  if (( rm_home )); then
    if sudo deluser --remove-home "$user" &>/dev/null; then
      echo -e "  ${G}✓${N}  ${user} deleted, home removed"
    else
      echo -e "  ${R}✗${N}  deluser failed"
    fi
  else
    if sudo deluser "$user" &>/dev/null; then
      echo -e "  ${G}✓${N}  ${user} deleted, home kept at ${home}"
    else
      echo -e "  ${R}✗${N}  deluser failed"
    fi
  fi
  echo -e "$HR"
}

_users_groupadd() {
  local grp="${1:-}"
  echo -e "$HR"
  echo -e "  ${C}${B}arc users groupadd${N}  —  create group"
  echo -e "$HR\n"
  if [[ -z "$grp" ]]; then
    echo -e "  ${R}✗${N}  usage: arc users groupadd <group>"
    echo -e "$HR"; return 1
  fi
  if [[ ! "$grp" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]]; then
    echo -e "  ${R}✗${N}  invalid group name: '${grp}'"
    echo -e "$HR"; return 1
  fi
  if getent group "$grp" &>/dev/null; then
    echo -e "  ${R}✗${N}  group already exists: ${grp}"
    echo -e "$HR"; return 1
  fi
  echo -e "  ${D}·${N}  create group ${Y}${grp}${N}"
  _users_confirm "Create group '${grp}'?" || { echo -e "  ${D}aborted${N}"; echo -e "$HR"; return 0; }
  if sudo groupadd "$grp"; then
    echo -e "  ${G}✓${N}  group created"
  else
    echo -e "  ${R}✗${N}  groupadd failed"
  fi
  echo -e "$HR"
}

_users_groupdel() {
  local grp="${1:-}"
  local -a PROTECTED_GROUPS=(root sudo adm sys daemon disk wheel shadow staff docker systemd-journal netdev plugdev audio video cdrom dialout floppy users nogroup)
  echo -e "$HR"
  echo -e "  ${C}${B}arc users groupdel${N}  —  delete group"
  echo -e "$HR\n"
  if [[ -z "$grp" ]]; then
    echo -e "  ${R}✗${N}  usage: arc users groupdel <group>"
    echo -e "$HR"; return 1
  fi
  if ! getent group "$grp" &>/dev/null; then
    echo -e "  ${R}✗${N}  group does not exist: ${grp}"
    echo -e "$HR"; return 1
  fi
  local p
  for p in "${PROTECTED_GROUPS[@]}"; do
    if [[ "$grp" == "$p" ]]; then
      echo -e "  ${R}✗${N}  refusing to delete protected system group: ${grp}"
      echo -e "$HR"; return 1
    fi
  done
  local gid; gid=$(getent group "$grp" | awk -F: '{print $3}')
  if (( gid < 1000 )); then
    echo -e "  ${R}✗${N}  refusing to delete system group (gid=${gid})"
    echo -e "$HR"; return 1
  fi
  local members
  members=$(getent passwd | awk -F: -v g="$gid" '$4==g {print $1}')
  if [[ -n "$members" ]]; then
    echo -e "  ${R}✗${N}  refusing — ${grp} is still the primary group for: $(echo "$members" | tr '\n' ' ')"
    echo -e "$HR"; return 1
  fi
  echo -e "  ${D}·${N}  delete group ${Y}${grp}${N}  ${D}(gid=${gid})${N}"
  _users_confirm "Delete group '${grp}'?" || { echo -e "  ${D}aborted${N}"; echo -e "$HR"; return 0; }
  if sudo groupdel "$grp"; then
    echo -e "  ${G}✓${N}  group deleted"
  else
    echo -e "  ${R}✗${N}  groupdel failed  ${D}(still a secondary member somewhere?)${N}"
  fi
  echo -e "$HR"
}

# Resolve + restrict a target path to $HOME or /mnt/storage; rejects flags (no -R/recursive)
_users_safe_path() {
  local path="${1:-}"
  _SAFE_REAL_PATH=""
  if [[ -z "$path" ]]; then
    echo -e "  ${R}✗${N}  path required"
    return 1
  fi
  if [[ "$path" == -* ]]; then
    echo -e "  ${R}✗${N}  flags not allowed — target a single path only (no -R / recursive)"
    return 1
  fi
  if [[ ! -e "$path" ]]; then
    echo -e "  ${R}✗${N}  path not found: ${path}"
    return 1
  fi
  local real; real=$(realpath -m "$path" 2>/dev/null)
  if [[ "$real" != "$HOME" && "$real" != "$HOME"/* && "$real" != "/mnt/storage" && "$real" != "/mnt/storage"/* ]]; then
    echo -e "  ${R}✗${N}  outside sanitized zone (only \$HOME or /mnt/storage) — refusing: ${real}"
    return 1
  fi
  _SAFE_REAL_PATH="$real"
  return 0
}

# Octal permission digits (last 3) → rwx string, e.g. 755 → rwxr-xr-x
_octal_to_rwx() {
  local perm="${1: -3}" out="" i c
  for (( i=0; i<3; i++ )); do
    c="${perm:$i:1}"
    case "$c" in
      0) out+="---" ;; 1) out+="--x" ;; 2) out+="-w-" ;; 3) out+="-wx" ;;
      4) out+="r--" ;; 5) out+="r-x" ;; 6) out+="rw-" ;; 7) out+="rwx" ;;
      *) out+="???" ;;
    esac
  done
  printf '%s' "$out"
}

_users_chmod() {
  local path="${1:-}" mode="${2:-}"
  echo -e "$HR"
  echo -e "  ${C}${B}arc users chmod${N}  —  guarded permission change"
  echo -e "$HR\n"
  if [[ -z "$path" || -z "$mode" ]]; then
    echo -e "  ${R}✗${N}  usage: arc users chmod <path> <mode>"
    echo -e "  ${D}mode is numeric octal only (e.g. 644, 755) — symbolic (u+x) not supported${N}"
    echo -e "  ${D}scope: \$HOME or /mnt/storage only · no -R/recursive · single target${N}"
    echo -e "$HR"; return 1
  fi
  _users_safe_path "$path" || { echo -e "$HR"; return 1; }
  local real="$_SAFE_REAL_PATH"
  if [[ ! "$mode" =~ ^[0-7]{3,4}$ ]]; then
    echo -e "  ${R}✗${N}  mode must be numeric octal, 3 or 4 digits (e.g. 644, 755, 0644)"
    echo -e "$HR"; return 1
  fi
  local perm="${mode: -3}"
  if [[ ${#mode} -eq 4 && "${mode:0:1}" =~ [234567] ]]; then
    echo -e "  ${R}✗${N}  refusing setuid/setgid mode (${mode}) — not permitted by this guard"
    echo -e "$HR"; return 1
  fi
  local rwx; rwx=$(_octal_to_rwx "$mode")
  local cur_mode; cur_mode=$(stat -c '%a' "$real" 2>/dev/null)
  local cur_rwx; cur_rwx=$(_octal_to_rwx "$cur_mode")
  echo -e "  ${D}·${N}  ${M}${real}${N}"
  echo -e "  ${D}·${N}  ${D}${cur_mode} (${cur_rwx})${N}  →  ${Y}${mode} (${rwx})${N}"
  if [[ "$perm" == "777" ]]; then
    echo -e "  ${R}⚠⚠${N}  777 = rwxrwxrwx — read/write/execute for owner, group, AND everyone else. Rarely correct outside a shared temp dir."
  elif [[ "$perm" == "000" ]]; then
    echo -e "  ${Y}⚠${N}  000 = ---------- — nobody gets access, including yourself, until you chmod it back"
  elif (( ${perm: -1} & 2 )); then
    echo -e "  ${Y}⚠${N}  other/world has write access (${rwx}) — unusual for a personal file"
  fi
  _users_confirm "Apply chmod ${mode} to '${real}'?" || { echo -e "  ${D}aborted${N}"; echo -e "$HR"; return 0; }
  if sudo chmod "$mode" "$real"; then
    echo -e "  ${G}✓${N}  done"
  else
    echo -e "  ${R}✗${N}  chmod failed"
  fi
  echo -e "$HR"
}

_users_chown() {
  local path="${1:-}" owner_spec="${2:-}"
  echo -e "$HR"
  echo -e "  ${C}${B}arc users chown${N}  —  guarded ownership change"
  echo -e "$HR\n"
  if [[ -z "$path" || -z "$owner_spec" ]]; then
    echo -e "  ${R}✗${N}  usage: arc users chown <path> <user>[:<group>]"
    echo -e "  ${D}scope: \$HOME or /mnt/storage only · no -R/recursive · single target${N}"
    echo -e "$HR"; return 1
  fi
  _users_safe_path "$path" || { echo -e "$HR"; return 1; }
  local real="$_SAFE_REAL_PATH"
  local new_user="${owner_spec%%:*}"
  local new_group=""
  [[ "$owner_spec" == *:* ]] && new_group="${owner_spec#*:}"
  if ! id "$new_user" &>/dev/null; then
    echo -e "  ${R}✗${N}  user does not exist: ${new_user}"
    echo -e "$HR"; return 1
  fi
  if [[ -n "$new_group" ]] && ! getent group "$new_group" &>/dev/null; then
    echo -e "  ${R}✗${N}  group does not exist: ${new_group}"
    echo -e "$HR"; return 1
  fi
  local cur_owner; cur_owner=$(stat -c '%U:%G' "$real" 2>/dev/null)
  echo -e "  ${D}·${N}  ${M}${real}${N}"
  echo -e "  ${D}·${N}  ${D}${cur_owner}${N}  →  ${Y}${owner_spec}${N}"
  local uid_new; uid_new=$(id -u "$new_user")
  (( uid_new < 1000 )) && echo -e "  ${Y}⚠${N}  target is a system account (uid=${uid_new})"
  _users_confirm "Apply chown ${owner_spec} to '${real}'?" || { echo -e "  ${D}aborted${N}"; echo -e "$HR"; return 0; }
  if sudo chown "$owner_spec" "$real"; then
    echo -e "  ${G}✓${N}  done"
  else
    echo -e "  ${R}✗${N}  chown failed"
  fi
  echo -e "$HR"
}

_users_chgrp() {
  local path="${1:-}" grp="${2:-}"
  echo -e "$HR"
  echo -e "  ${C}${B}arc users chgrp${N}  —  guarded group ownership change"
  echo -e "$HR\n"
  if [[ -z "$path" || -z "$grp" ]]; then
    echo -e "  ${R}✗${N}  usage: arc users chgrp <path> <group>"
    echo -e "  ${D}scope: \$HOME or /mnt/storage only · no -R/recursive · single target${N}"
    echo -e "$HR"; return 1
  fi
  _users_safe_path "$path" || { echo -e "$HR"; return 1; }
  local real="$_SAFE_REAL_PATH"
  if ! getent group "$grp" &>/dev/null; then
    echo -e "  ${R}✗${N}  group does not exist: ${grp}"
    echo -e "$HR"; return 1
  fi
  local cur_grp; cur_grp=$(stat -c '%G' "$real" 2>/dev/null)
  echo -e "  ${D}·${N}  ${M}${real}${N}"
  echo -e "  ${D}·${N}  ${D}${cur_grp}${N}  →  ${Y}${grp}${N}"
  _users_confirm "Apply chgrp ${grp} to '${real}'?" || { echo -e "  ${D}aborted${N}"; echo -e "$HR"; return 0; }
  if sudo chgrp "$grp" "$real"; then
    echo -e "  ${G}✓${N}  done"
  else
    echo -e "  ${R}✗${N}  chgrp failed"
  fi
  echo -e "$HR"
}

_users_sessions() {
  echo -e "$HR"
  echo -e "  ${C}${B}arc users sessions${N}  —  active + recent logins"
  echo -e "$HR\n"

  echo -e "  ${C}active sessions${N}"
  local sess
  sess=$(who -a 2>/dev/null | grep -v '^\s*$')
  if [[ -n "$sess" ]]; then
    echo "$sess" | while IFS= read -r line; do echo -e "  ${G}·${N}  ${line}"; done
  else
    echo -e "  ${D}·${N}  none"
  fi

  echo ""
  echo -e "  ${C}last logins  ${D}(20)${N}"
  last -n 20 2>/dev/null | while IFS= read -r line; do
    [[ "$line" == wtmp* ]] && continue
    echo -e "  ${D}·${N}  ${line}"
  done

  echo ""
  echo -e "  ${C}failed logins  ${D}(last 15)${N}"
  local btmp
  btmp=$(sudo lastb -n 15 2>/dev/null)
  if [[ -n "$btmp" ]]; then
    echo "$btmp" | while IFS= read -r line; do
      [[ "$line" == btmp* ]] && continue
      echo -e "  ${R}·${N}  ${line}"
    done
  else
    echo -e "  ${D}·${N}  none on record"
  fi

  echo -e "\n$HR"
}

_users_passwd_age() {
  local user="${1:-}"
  echo -e "$HR"
  echo -e "  ${C}${B}arc users passwd-age${N}  —  password age and expiry"
  echo -e "$HR\n"
  if [[ -z "$user" ]]; then
    while IFS=: read -r name _ uid _ _ _ _; do
      (( uid >= 1000 && uid < 65534 )) || continue
      echo -e "  ${M}${name}${N}"
      chage -l "$name" 2>/dev/null | while IFS= read -r line; do
        echo -e "    ${D}${line}${N}"
      done
      echo ""
    done < /etc/passwd
  else
    _users_validate "$user" || { echo -e "$HR"; return 1; }
    echo -e "  ${M}${user}${N}"
    chage -l "$user" 2>/dev/null | while IFS= read -r line; do
      echo -e "  ${D}${line}${N}"
    done
  fi
  echo -e "$HR"
}

cmd_users() {
  local sub="${1:-}"
  case "$sub" in
    check)      _users_check ;;
    lock)       _users_lock "${2:-}" ;;
    unlock)     _users_unlock "${2:-}" ;;
    groups)     _users_groups "${2:-}" ;;
    add-group)  _users_add_group "${2:-}" "${3:-}" ;;
    rm-group)   _users_rm_group "${2:-}" "${3:-}" ;;
    shell)      _users_shell "${2:-}" "${3:-}" ;;
    sessions)   _users_sessions ;;
    passwd-age) _users_passwd_age "${2:-}" ;;
    add)        _users_add "${2:-}" "${3:-}" ;;
    del)        _users_del "${2:-}" ;;
    groupadd)   _users_groupadd "${2:-}" ;;
    groupdel)   _users_groupdel "${2:-}" ;;
    chmod)      _users_chmod "${2:-}" "${3:-}" ;;
    chown)      _users_chown "${2:-}" "${3:-}" ;;
    chgrp)      _users_chgrp "${2:-}" "${3:-}" ;;
    '')         _users_overview ;;
    *)
      echo -e "  ${R}unknown:${N} arc users ${sub}"
      echo -e "  ${D}options: check · lock <u> · unlock <u> · groups [u] · add-group <u> <g>${N}"
      echo -e "  ${D}         rm-group <u> <g> · shell <u> [sh] · sessions · passwd-age [u]${N}"
      echo -e "  ${D}         add <u> [sh] · del <u> · groupadd <g> · groupdel <g>${N}"
      echo -e "  ${D}         chmod <path> <mode> · chown <path> <u>[:g] · chgrp <path> <g>${N}"
      return 1
      ;;
  esac
}

