#!/bin/bash
# arc-dns — NextDNS toggle for kontor studio
# Usage: arc dns on | off | status | profile <id>

# SOP gate bridge: same audit policy as interactive shells, non-blocking --
# never gates this script, just logs it under the same DB the gate reads.
# Was missing entirely -- meant arc-dns-boot.service's every-login run left
# zero trace in the SOP log. Found 2026-08-17 during the arc-sop coverage audit.
{ command -v arc-sop >/dev/null 2>&1 && arc-sop ack-auto "arc-dns" >/dev/null 2>&1; } || true

PROFILE_FILE="$HOME/.config/nextdns-profile"
CMD="${1:-status}"

_profile_id() {
    [ -f "$PROFILE_FILE" ] && cat "$PROFILE_FILE" || echo ""
}

_require_profile() {
    local id
    id=$(_profile_id)
    if [ -z "$id" ]; then
        echo "  no profile set. run: arc dns profile <your-6-char-id>"
        echo "  get your ID at: https://my.nextdns.io → Setup tab"
        exit 1
    fi
    echo "$id"
}

case "$CMD" in
    profile)
        ID="${2:-}"
        if [ -z "$ID" ]; then
            current=$(_profile_id)
            [ -n "$current" ] && echo "  current profile: $current" || echo "  no profile set"
            exit 0
        fi
        if ! echo "$ID" | grep -qE '^[a-z0-9]{6}$'; then
            echo "  invalid profile ID — must be 6 lowercase alphanumeric chars (example: a1b2c3)"
            exit 1
        fi
        mkdir -p "$(dirname "$PROFILE_FILE")"
        echo "$ID" > "$PROFILE_FILE"
        echo "  profile set: $ID"
        if sudo nextdns config set --profile="$ID" 2>/dev/null; then
            echo "  profile applied to nextdns daemon"
        else
            echo "  saved — will apply on next 'arc dns on'"
        fi
        ;;

    on)
        PROFILE=$(_require_profile)
        echo "  activating NextDNS (profile: $PROFILE)..."
        sudo nextdns config set --profile="$PROFILE"
        sudo nextdns activate
        RESOLVER=$(cat /etc/resolv.conf 2>/dev/null | grep '^nameserver' | head -1 | awk '{print $2}')
        echo "  NextDNS ON  →  resolver: $RESOLVER"
        ;;

    off)
        echo "  deactivating NextDNS — restoring system defaults..."
        sudo nextdns deactivate
        RESOLVER=$(cat /etc/resolv.conf 2>/dev/null | grep '^nameserver' | head -1 | awk '{print $2}')
        # NetworkManager.conf has dns=none (2026-08-15, fixes a DNS-leak-on-reconnect
        # bug) — NM no longer writes resolv.conf itself, so if nextdns's own restore
        # (from its one-time /etc/resolv.conf.nextdns-bak snapshot) doesn't leave a
        # real nameserver, nothing else will either. Explicit fallback rather than a
        # stale snapshot, so this stays correct on any network, not just the one
        # active when the snapshot was taken.
        if [ -z "$RESOLVER" ] || [ "$RESOLVER" = "127.0.0.1" ]; then
            echo "  ! no nameserver after deactivate — writing fallback (1.1.1.1/1.0.0.1)"
            printf 'nameserver 1.1.1.1\nnameserver 1.0.0.1\n' | sudo tee /etc/resolv.conf >/dev/null
            # re-read reality rather than assume the write succeeded (sudo failing
            # here — wrong password, no TTY — would otherwise get silently reported
            # as success below)
            RESOLVER=$(cat /etc/resolv.conf 2>/dev/null | grep '^nameserver' | head -1 | awk '{print $2}')
            if [ -z "$RESOLVER" ] || [ "$RESOLVER" = "127.0.0.1" ]; then
                echo "  ✗  fallback write failed — DNS may be broken. Check: sudo cat /etc/resolv.conf"
            fi
        fi
        echo "  NextDNS OFF →  resolver: $RESOLVER"
        ;;

    status)
        echo ""
        echo "  ── DNS STATUS ──────────────────────────"
        if systemctl is-active --quiet nextdns 2>/dev/null; then
            echo "  nextdns daemon:  running (v$(nextdns version 2>/dev/null | awk '{print $NF}'))"
        else
            echo "  nextdns daemon:  stopped"
        fi
        PROFILE=$(_profile_id)
        [ -n "$PROFILE" ] && echo "  profile:         $PROFILE" || echo "  profile:         not set"
        # resolvectl (systemd-resolved) is no longer present on this machine
        # as of some point after 2026-08-02 -- nextdns manages
        # /etc/resolv.conf directly instead now, so that's the real source
        # of truth for "what resolver does this box actually use," not a
        # tool that no longer exists.
        RESOLVER=$(awk '/^nameserver/{print $2; exit}' /etc/resolv.conf 2>/dev/null)
        echo "  resolv.conf:     ${RESOLVER:-none}"
        if [ "$RESOLVER" = "127.0.0.1" ]; then
            echo "  mode:            NextDNS ACTIVE"
        elif [ -n "$RESOLVER" ]; then
            echo "  mode:            direct → $RESOLVER"
        else
            echo "  mode:            unknown"
        fi
        echo "  ────────────────────────────────────────"
        echo ""
        ;;

    flush)
        # nextdns's own caching is disabled on this profile (cache-size 0) --
        # confirmed via `nextdns config`, not assumed -- and resolvectl
        # (which used to own the OS-level cache-flush path) doesn't exist on
        # this system anymore. There is genuinely no DNS cache layer left to
        # flush. Closest real, honest equivalent: restart the daemon, which
        # clears any in-memory state and forces fresh upstream connections.
        echo "  no DNS cache layer exists to flush (nextdns caching is off, resolvectl is gone) —"
        echo "  restarting the daemon instead, the closest real equivalent..."
        sudo systemctl restart nextdns
        sleep 1
        if systemctl is-active --quiet nextdns 2>/dev/null; then
            echo "  ✓  nextdns restarted"
        else
            echo "  ✗  restart failed — run: arc dns status"
        fi
        ;;

    restart)
        echo "  restarting NextDNS..."
        sudo systemctl restart nextdns
        sleep 1
        if systemctl is-active --quiet nextdns 2>/dev/null; then
            echo "  ✓  NextDNS restarted"
        else
            echo "  ✗  NextDNS failed to restart — run: arc dns status"
        fi
        ;;

    check)
        echo ""
        echo "  ── DNS CHECK ───────────────────────────"
        if systemctl is-active --quiet nextdns 2>/dev/null; then
            echo "  daemon:    running"
        else
            echo "  daemon:    STOPPED"
        fi
        RESOLVER=$(awk '/^nameserver/{print $2; exit}' /etc/resolv.conf 2>/dev/null)
        if [ "$RESOLVER" = "127.0.0.1" ]; then
            echo "  resolv.conf: wired → NextDNS stub"
        else
            echo "  resolv.conf: NOT wired  (nameserver: ${RESOLVER:-none} — queries may bypass NextDNS)"
        fi
        # Real leak check, rewritten 2026-08-22 -- resolvectl (which the old
        # version of this check depended on entirely) no longer exists on
        # this system. Rewritten around ground truth instead of a specific
        # tool: if a WireGuard-type interface is up (ProtonVPN or similar),
        # confirm nextdns's own live upstream connections are actually
        # sourced from that tunnel's IP, not the physical interface's --
        # verified this exact technique live against a real ProtonVPN
        # connection on 2026-08-22 (source IP correctly matched proton0's
        # assigned address). Tool-independent: works whether or not
        # systemd-resolved, NetworkManager, or any specific VPN client is
        # what's managing the network at the time.
        VPN_IFACE=$(ip -o link show type wireguard 2>/dev/null | awk -F': ' '{print $2}' | head -1)
        NEXTDNS_PID=$(systemctl show nextdns --property=MainPID --value 2>/dev/null)
        if [ -n "$VPN_IFACE" ]; then
            VPN_IP=$(ip -4 -o addr show dev "$VPN_IFACE" 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1)
            if [ -z "$NEXTDNS_PID" ] || [ "$NEXTDNS_PID" = "0" ]; then
                echo "  routing:   can't check — nextdns daemon not running"
            else
                # Confirmed live (2026-08-22): unprivileged ss -tnp doesn't
                # reliably show the process-owner column on this system --
                # needs sudo -n unconditionally, no unprivileged-first
                # attempt (that silently returned empty rather than an
                # error, which had masked this). Grep "ESTAB" from the
                # plain (unfiltered) command rather than `ss ... state
                # established`, which drops the leading State column from
                # its output and shifts every field left by one -- $4 would
                # silently grab the PEER address instead of Local, a real
                # bug caught live the first time this ran. IPv4-only (-4):
                # IPv6 addresses are bracketed with their own internal
                # colons ([addr]:port), which the IPv4-style "cut -d: -f1"
                # mangles, and this VPN client's IPv6 traffic never
                # establishes anyway (blocked by its own leak-prevention
                # dummy interface).
                CONN_SRCS=$(sudo -n ss -4tnp 2>/dev/null | grep "ESTAB.*pid=$NEXTDNS_PID" | awk '{print $4}' | cut -d: -f1 | sort -u)
                N_SRCS=$(printf '%s\n' "$CONN_SRCS" | grep -c .)
                if [ -z "$CONN_SRCS" ]; then
                    echo "  routing:   VPN up ($VPN_IFACE) — no active nextdns connections to check right now, try after a query"
                elif [ "$N_SRCS" -eq 1 ] && [ "$CONN_SRCS" = "$VPN_IP" ]; then
                    echo "  routing:   wired → all NextDNS traffic correctly routed through $VPN_IFACE ($VPN_IP)"
                elif printf '%s\n' "$CONN_SRCS" | grep -qx "$VPN_IP"; then
                    OTHER=$(printf '%s\n' "$CONN_SRCS" | grep -vx "$VPN_IP" | tr '\n' ',' | sed 's/,$//')
                    echo "  routing:   PARTIAL LEAK — some NextDNS connections still on ${OTHER} (pre-dates the VPN connecting, TCP doesn't migrate) — fix: arc dns restart"
                else
                    echo "  routing:   NOT wired  — VPN is up but nextdns traffic is sourced from ${CONN_SRCS} instead of ${VPN_IFACE}'s ${VPN_IP} (real leak)"
                fi
            fi
        else
            echo "  routing:   no VPN active — NextDNS traffic goes via the physical interface (expected)"
        fi
        result=$(dig +short +time=3 nextdns.io @127.0.0.1 2>/dev/null | head -1)
        if printf '%s' "$result" | grep -qE '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$'; then
            echo "  query:     OK  ($result)"
        else
            echo "  query:     FAILED${result:+ ($result)}"
        fi
        echo "  ────────────────────────────────────────"
        echo ""
        ;;

    blocklists|lists)
        PROFILE=$(_profile_id)
        [ -z "$PROFILE" ] && PROFILE="<your-profile>"
        URL="https://my.nextdns.io/${PROFILE}/privacy/blocklists"
        echo ""
        echo "  ── BLOCKLIST PRESETS ───────────────────"
        echo "  daily driver (arc-dns-cold):"
        echo "    → NextDNS Ads & Trackers Blocklist"
        echo "    → StevenBlack"
        echo "    → oisd (small)"
        echo ""
        echo "  aggressive (arc-dns-hot):"
        echo "    → everything above PLUS:"
        echo "    → oisd (big)"
        echo "    → NoCoin"
        echo "    → notracking"
        echo "    → The Block List Project (abuse, malware, phishing, ransomware, scams)"
        echo ""
        echo "  manage blocklists: ${URL}"
        echo "  ────────────────────────────────────────"
        echo ""
        if command -v xdg-open >/dev/null 2>&1; then
            echo "  opening blocklists page..."
            xdg-open "$URL" >/dev/null 2>&1
        fi
        ;;

    *)
        echo "usage: arc dns on | off | restart | flush | check | status | profile | blocklists [<6-char-id>]"
        ;;
esac
