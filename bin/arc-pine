#!/usr/bin/env python3
"""
arc-pine — notification history browser.

Rebuilt from scratch (original source lost with the Tails USB). Fresh,
functional design rather than a port of the old one: one clean theme
(Rose Pine Moon, matching this system's existing GTK/terminal theme) instead
of three, search-as-you-type, delete individual entries, purge by age or by
app. Reads the same history.db that arc-pined writes to.
"""

import sqlite3
import sys
import time
import tkinter as tk
from tkinter import ttk
from pathlib import Path
from datetime import datetime, timedelta

sys.path.insert(0, str(Path(__file__).resolve().parent))
import _arc_pine_common as pine
import _arc_ui as ui

DB_PATH     = pine.DB_PATH
ICON_PATH   = Path.home() / ".local/share/arc-pine/icon.png"

# Bubble themes arc-pine-bubbles renders with. These swatches preview popup
# choices; the console itself follows the shared live circadian palette.
THEMES = {
    "rose-pine-moon": {"bg": "#2a273f", "accent": "#eb6f92", "fg": "#e0def4"},
    "nord":           {"bg": "#3b4252", "accent": "#bf616a", "fg": "#eceff4"},
    "dracula":        {"bg": "#282a36", "accent": "#ff5555", "fg": "#f8f8f2"},
    "gruvbox":        {"bg": "#3c3836", "accent": "#fb4934", "fg": "#ebdbb2"},
    # Not a fixed palette like the four above -- arc-pine-bubbles resolves
    # this one live per-bubble via _resolve_theme(), so it always reflects
    # the actual time of day a notification appears, not a snapshot. This
    # entry only exists so the dropdown below has something to select.
    "circadian":      {"bg": "#232136", "accent": "#c4a7e7", "fg": "#e0def4"},
}

# Circadian startup palette; ArcPine refreshes it from _arc_ui.py every minute.
_circadian = ui.circadian()
BG       = _circadian["bg"]
SURFACE  = _circadian["surface"]
OVERLAY  = _circadian["overlay"]
FG       = _circadian["fg"]
FG_MUTED = _circadian["fg_muted"]
BORDER   = ui._lerp_hex(SURFACE, FG_MUTED, 0.28)
GOLD     = ui.GOLD
ROSE     = ui.ROSE
PINE     = ui.PINE
TEAL     = ui.TEAL

URGENCY_COLOR = {0: FG_MUTED, 1: TEAL, 2: ROSE}


def db_query(sql, params=()):
    if not DB_PATH.exists():
        return []
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    rows = conn.execute(sql, params).fetchall()
    conn.close()
    return rows


def db_exec(sql, params=()):
    if not DB_PATH.exists():
        return
    conn = sqlite3.connect(DB_PATH)
    conn.execute(sql, params)
    conn.commit()
    conn.close()


class ArcPine(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("khaos☠️pine · notification console")
        screen_w, screen_h = self.winfo_screenwidth(), self.winfo_screenheight()
        width = min(980, max(560, int(screen_w * 0.82)))
        height = min(820, max(480, int(screen_h * 0.82)))
        self.geometry(f"{width}x{height}")
        self.minsize(min(440, max(360, screen_w - 32)), min(420, max(360, screen_h - 48)))
        self.configure(bg=BG)
        self._palette = {"BG": BG, "SURFACE": SURFACE, "OVERLAY": OVERLAY,
                         "BORDER": BORDER, "FG": FG, "FG_MUTED": FG_MUTED}
        self._last_palette_minute = None

        if ICON_PATH.exists():
            try:
                self._icon = tk.PhotoImage(file=str(ICON_PATH))
                self.iconphoto(True, self._icon)
            except Exception:
                pass

        self.search_var = tk.StringVar()
        self.search_var.trace_add("write", lambda *_: self.refresh())

        self.config = pine.load_config()
        self.view = "history"

        self._build_ui()
        self._ttk_style = ttk.Style(self)
        try:
            self._ttk_style.theme_use("clam")
        except tk.TclError:
            pass
        self._style_combobox()
        self.refresh()
        self.after(1000, self._tick_circadian)

    def _build_ui(self):
        top = tk.Frame(self, bg=BG)
        top.pack(fill="x", padx=16, pady=(12, 5))
        brand = tk.Frame(top, bg=BG)
        brand.pack(side="left")
        tk.Label(brand, text="khaos / pine", font=("JetBrains Mono", 14, "bold"),
                 bg=BG, fg=GOLD).pack(anchor="w")
        tk.Label(brand, text="NOTIFICATION CONSOLE", font=("JetBrains Mono", 8),
                 bg=BG, fg=FG_MUTED).pack(anchor="w", pady=(1, 0))

        # Snooze is set from the CLI (arc-pine-snooze) with nothing in this
        # GUI that visibly reflects it -- found during a 2026-09-10 bug
        # sweep as a real "why did bubbles stop, is something broken"
        # trap. Hidden by default (pack_forget), shown only while a
        # snooze is actually active.
        self.snooze_lbl = tk.Label(top, text="😴 snoozed", font=("JetBrains Mono", 9, "bold"),
                                    bg=BG, fg=ROSE)

        self.settings_btn = ui.button(
            top, "Settings", command=lambda: self.set_view("settings"),
            font=("JetBrains Mono", 9), bg=SURFACE, fg=TEAL, hover_bg=OVERLAY,
            padx=10, pady=5,
        )
        self.settings_btn.pack(side="right", padx=(4, 0))

        self.insights_btn = ui.button(
            top, "Insights", command=lambda: self.set_view("insights"),
            font=("JetBrains Mono", 9), bg=SURFACE, fg=TEAL, hover_bg=OVERLAY,
            padx=10, pady=5,
        )
        self.insights_btn.pack(side="right", padx=(4, 0))

        self.history_btn = ui.button(
            top, "History", command=lambda: self.set_view("history"),
            font=("JetBrains Mono", 9), bg=OVERLAY, fg=TEAL, hover_bg=OVERLAY,
            padx=10, pady=5,
        )
        self.history_btn.pack(side="right", padx=(4, 0))

        search_row = tk.Frame(self, bg=BG)
        search_row.pack(fill="x", padx=16, pady=(4, 10))
        self.search_entry = tk.Entry(search_row, textvariable=self.search_var, font=("JetBrains Mono", 10),
                                      bg=SURFACE, fg=FG, insertbackground=FG, relief="flat",
                                      highlightthickness=1, highlightbackground=BORDER,
                                      highlightcolor=TEAL)
        self.search_entry.pack(fill="x", ipady=7)
        tk.Frame(self, bg=BORDER, height=1).pack(fill="x", padx=16, pady=(0, 6))
        self.search_entry.focus()

        # Body: history/insights/settings views share the same slot, only
        # one packed at a time -- simplest way to keep this single-window,
        # no extra Toplevel/dialog clutter.
        self.body = tk.Frame(self, bg=BG)
        self.body.pack(fill="both", expand=True)

        self.statusbar = tk.Frame(self, bg=BG)
        self.statusbar.pack(fill="x", padx=16, pady=(5, 11))
        self.status_marker = tk.Frame(self.statusbar, bg=TEAL, width=3)
        self.status_marker.pack(side="left", fill="y", padx=(0, 8))
        self.status_lbl = tk.Label(self.statusbar, text="", font=("JetBrains Mono", 8),
                                   bg=BG, fg=FG_MUTED, anchor="w")
        self.status_lbl.pack(side="left")
        self.phase_lbl = tk.Label(self.statusbar, text="", font=("JetBrains Mono", 8),
                                  bg=BG, fg=TEAL, anchor="e")
        self.phase_lbl.pack(side="right")

        self._build_history_view()
        self._build_insights_view()
        self._build_settings_view()
        self._update_nav_buttons()

    def _view_frame(self, name):
        return {"history": self.history_view, "insights": self.insights_view,
                "settings": self.settings_view}[name]

    def set_view(self, name):
        if name == self.view:
            name = "history"  # clicking the active view's icon returns home
        self._view_frame(self.view).pack_forget()
        self.view = name
        self._view_frame(name).pack(fill="both", expand=True)
        if name == "settings":
            self._load_settings_into_ui()
        elif name == "insights":
            self._refresh_insights()
        self._update_nav_buttons()

    def _update_nav_buttons(self):
        for name, button in (("history", self.history_btn), ("insights", self.insights_btn),
                             ("settings", self.settings_btn)):
            button.set_look(bg=OVERLAY if self.view == name else SURFACE,
                            fg=TEAL if self.view == name else FG_MUTED)

    def _style_combobox(self):
        self._ttk_style.configure("ArcPine.TCombobox", fieldbackground=SURFACE,
                                  background=OVERLAY, foreground=FG, bordercolor=BORDER,
                                  lightcolor=BORDER, darkcolor=BORDER, arrowcolor=TEAL)
        self._ttk_style.map("ArcPine.TCombobox",
                            fieldbackground=[("readonly", SURFACE), ("focus", OVERLAY)],
                            foreground=[("readonly", FG)])

    def _build_history_view(self):
        self.history_view = tk.Frame(self.body, bg=BG)
        self.history_view.pack(fill="both", expand=True)

        # Scrollable list
        container = tk.Frame(self.history_view, bg=BG)
        container.pack(fill="both", expand=True, padx=10)

        canvas = self.history_canvas = tk.Canvas(container, bg=BG, highlightthickness=0)
        scrollbar = tk.Scrollbar(container, orient="vertical", command=canvas.yview,
                                 bg=OVERLAY, troughcolor=BG, activebackground=TEAL,
                                 bd=0, highlightthickness=0, width=11)
        self.list_frame = tk.Frame(canvas, bg=BG)
        self._card_text_labels = []

        self.list_frame.bind(
            "<Configure>", lambda e: canvas.configure(scrollregion=canvas.bbox("all"))
        )
        self.list_window = canvas.create_window((8, 0), window=self.list_frame, anchor="nw", width=1)
        canvas.configure(yscrollcommand=scrollbar.set)
        canvas.bind("<Configure>", self._resize_history)
        canvas.bind("<MouseWheel>", self._history_wheel)
        canvas.bind("<Button-4>", lambda _e: canvas.yview_scroll(-1, "units"))
        canvas.bind("<Button-5>", lambda _e: canvas.yview_scroll(1, "units"))

        canvas.pack(side="left", fill="both", expand=True)
        scrollbar.pack(side="right", fill="y")

        # Bottom action bar
        bottom = tk.Frame(self.history_view, bg=BG)
        bottom.pack(fill="x", padx=16, pady=(5, 10))

        BTN = dict(font=("JetBrains Mono", 9), bg=SURFACE, fg=TEAL, hover_bg=OVERLAY, padx=8, pady=4)

        ui.button(bottom, "purge >7d", command=lambda: self.purge_age(7), **BTN).pack(side="left", padx=2)
        ui.button(bottom, "purge >30d", command=lambda: self.purge_age(30), **BTN).pack(side="left", padx=2)
        ui.button(bottom, "clear all", command=self.purge_all, **{**BTN, "fg": ROSE}).pack(side="left", padx=2)

        self.count_lbl = tk.Label(bottom, text="", font=("JetBrains Mono", 9), bg=BG, fg=FG_MUTED)
        self.count_lbl.pack(side="right")

    def _resize_history(self, event):
        width = max(1, event.width - 16)
        self.history_canvas.itemconfigure(self.list_window, width=width)
        for label in self._card_text_labels:
            try:
                label.configure(wraplength=max(240, width - 24))
            except tk.TclError:
                pass
        bbox = self.history_canvas.bbox("all")
        if bbox:
            self.history_canvas.configure(scrollregion=bbox)

    def _history_wheel(self, event):
        delta = -1 if event.delta > 0 else 1
        self.history_canvas.yview_scroll(delta * max(1, abs(event.delta) // 120), "units")
        return "break"

    def _settings_wheel(self, event):
        if getattr(event, "num", None) == 4:
            delta, steps = -1, 1
        elif getattr(event, "num", None) == 5:
            delta, steps = 1, 1
        else:
            delta, steps = (-1 if event.delta > 0 else 1), max(1, abs(event.delta) // 120)
        self.settings_canvas.yview_scroll(delta * steps, "units")
        return "break"

    def _rules_wheel(self, event):
        if getattr(event, "num", None) == 4:
            delta, steps = -1, 1
        elif getattr(event, "num", None) == 5:
            delta, steps = 1, 1
        else:
            delta, steps = (-1 if event.delta > 0 else 1), max(1, abs(event.delta) // 120)
        self.rules_canvas.yview_scroll(delta * steps, "units")
        return "break"

    def _bind_history_wheel(self, widget):
        for sequence in ("<MouseWheel>", "<Button-4>", "<Button-5>"):
            widget.bind(sequence, self._history_wheel, add="+")
        for child in widget.winfo_children():
            self._bind_history_wheel(child)

    def _bind_settings_wheel(self, widget):
        if widget is getattr(self, "rules_canvas", None):
            self._bind_rules_wheel(widget)
            self._bind_rules_wheel(self.rules_list)
            return
        for sequence in ("<MouseWheel>", "<Button-4>", "<Button-5>"):
            widget.bind(sequence, self._settings_wheel, add="+")
        for child in widget.winfo_children():
            self._bind_settings_wheel(child)

    def _bind_rules_wheel(self, widget):
        for sequence in ("<MouseWheel>", "<Button-4>", "<Button-5>"):
            widget.bind(sequence, self._rules_wheel, add="+")
        for child in widget.winfo_children():
            self._bind_rules_wheel(child)

    def _build_insights_view(self):
        self.insights_view = tk.Frame(self.body, bg=BG)
        # not packed yet -- history view shows first

        tk.Label(self.insights_view, text="last 7 days", font=("JetBrains Mono", 10, "bold"),
                 bg=BG, fg=GOLD, anchor="w").pack(fill="x", padx=14, pady=(14, 4))

        self.insights_total_lbl = tk.Label(self.insights_view, text="", font=("JetBrains Mono", 9),
                                            bg=BG, fg=FG_MUTED, anchor="w")
        self.insights_total_lbl.pack(fill="x", padx=14)

        tk.Label(self.insights_view, text="noisiest apps", font=("JetBrains Mono", 10, "bold"),
                 bg=BG, fg=GOLD, anchor="w").pack(fill="x", padx=14, pady=(16, 6))

        self.insights_bars = tk.Frame(self.insights_view, bg=BG)
        self.insights_bars.pack(fill="both", expand=True, padx=14)

    def _refresh_insights(self):
        for w in self.insights_bars.winfo_children():
            w.destroy()

        cutoff = (datetime.now() - timedelta(days=7)).strftime("%Y-%m-%d %H:%M:%S")
        total_row = db_query("SELECT COUNT(*) as c FROM notifications WHERE timestamp >= ?", (cutoff,))
        total = total_row[0]["c"] if total_row else 0
        self.insights_total_lbl.configure(text=f"{total} notifications")

        rows = db_query(
            "SELECT app_name, COUNT(*) as c FROM notifications WHERE timestamp >= ? "
            "GROUP BY app_name ORDER BY c DESC LIMIT 8",
            (cutoff,),
        )

        if not rows:
            tk.Label(self.insights_bars, text="no notifications in the last 7 days",
                     font=("JetBrains Mono", 9), bg=BG, fg=FG_MUTED).pack(pady=10)
            return

        max_c = max(r["c"] for r in rows)
        for r in rows:
            row = tk.Frame(self.insights_bars, bg=BG)
            row.pack(fill="x", pady=3)
            tk.Label(row, text=r["app_name"], font=("JetBrains Mono", 9), bg=BG, fg=FG,
                     width=18, anchor="w").pack(side="left")
            bar_track = tk.Frame(row, bg=SURFACE, height=14)
            bar_track.pack(side="left", fill="x", expand=True, padx=(6, 6))
            bar_track.pack_propagate(False)
            frac = r["c"] / max_c if max_c else 0
            tk.Frame(bar_track, bg=PINE, height=14, width=max(int(220 * frac), 3)
                     ).place(x=0, y=0, relheight=1)
            tk.Label(row, text=str(r["c"]), font=("JetBrains Mono", 9), bg=BG, fg=FG_MUTED,
                     width=4, anchor="e").pack(side="left")

    def _build_settings_view(self):
        self.settings_view = tk.Frame(self.body, bg=BG)
        # not packed yet -- history view shows first

        scroll_wrap = tk.Frame(self.settings_view, bg=BG)
        scroll_wrap.pack(fill="both", expand=True, padx=10, pady=(4, 0))
        self.settings_canvas = tk.Canvas(scroll_wrap, bg=BG, highlightthickness=0)
        settings_scroll = tk.Scrollbar(scroll_wrap, orient="vertical", command=self.settings_canvas.yview,
                                       bg=OVERLAY, troughcolor=BG, activebackground=TEAL,
                                       bd=0, highlightthickness=0, width=11)
        self.settings_content = tk.Frame(self.settings_canvas, bg=BG)
        self.settings_window = self.settings_canvas.create_window(
            (8, 0), window=self.settings_content, anchor="nw", width=1)
        self.settings_content.bind(
            "<Configure>", lambda _e: self.settings_canvas.configure(
                scrollregion=self.settings_canvas.bbox("all")))
        self.settings_canvas.bind(
            "<Configure>", lambda e: self.settings_canvas.itemconfigure(
                self.settings_window, width=max(1, e.width - 16)))
        self.settings_canvas.configure(yscrollcommand=settings_scroll.set)
        self.settings_canvas.bind("<MouseWheel>", self._settings_wheel)
        self.settings_canvas.bind("<Button-4>", lambda _e: self.settings_canvas.yview_scroll(-1, "units"))
        self.settings_canvas.bind("<Button-5>", lambda _e: self.settings_canvas.yview_scroll(1, "units"))
        self.settings_canvas.pack(side="left", fill="both", expand=True)
        settings_scroll.pack(side="right", fill="y")

        pad = dict(padx=14, pady=(14, 4))

        def section(text):
            tk.Label(self.settings_content, text=text, font=("JetBrains Mono", 10, "bold"),
                      bg=BG, fg=GOLD, anchor="w").pack(fill="x", **pad)

        def row():
            r = tk.Frame(self.settings_content, bg=BG)
            r.pack(fill="x", padx=14, pady=2)
            return r

        # -- Bubble popups --
        section("bubble popups")

        r = row()
        tk.Label(r, text="theme", font=("JetBrains Mono", 9), bg=BG, fg=FG, width=16, anchor="w").pack(side="left")
        self.theme_var = tk.StringVar()
        theme_menu = ttk.Combobox(r, textvariable=self.theme_var, values=list(THEMES.keys()),
                                   state="readonly", font=("JetBrains Mono", 9), width=18,
                                   style="ArcPine.TCombobox")
        theme_menu.pack(side="left")
        theme_menu.bind("<<ComboboxSelected>>", lambda e: self._save_setting("bubble_theme", self.theme_var.get()))

        r = row()
        tk.Label(r, text="max visible", font=("JetBrains Mono", 9), bg=BG, fg=FG, width=16, anchor="w").pack(side="left")
        self.max_visible_var = tk.IntVar()
        tk.Spinbox(r, from_=1, to=10, textvariable=self.max_visible_var, width=6,
                   font=("JetBrains Mono", 9), bg=SURFACE, fg=FG, insertbackground=FG,
                   relief="flat", command=lambda: self._save_setting("bubble_max_visible", self.max_visible_var.get())
                   ).pack(side="left")

        r = row()
        tk.Label(r, text="duration (sec)", font=("JetBrains Mono", 9), bg=BG, fg=FG, width=16, anchor="w").pack(side="left")
        self.duration_var = tk.IntVar()
        tk.Spinbox(r, from_=3, to=60, textvariable=self.duration_var, width=6,
                   font=("JetBrains Mono", 9), bg=SURFACE, fg=FG, insertbackground=FG,
                   relief="flat",
                   command=lambda: self._save_setting("bubble_duration_ms", self.duration_var.get() * 1000)
                   ).pack(side="left")
        tk.Label(r, text="always auto-clears, never sticks around", font=("JetBrains Mono", 8),
                  bg=BG, fg=FG_MUTED).pack(side="left", padx=(10, 0))

        # -- Sound & voice --
        section("sound & voice")

        r = row()
        self.sound_var = tk.BooleanVar()
        tk.Checkbutton(r, text="sound on new notification", variable=self.sound_var,
                       font=("JetBrains Mono", 9), bg=BG, fg=FG, selectcolor=SURFACE,
                       activebackground=BG, activeforeground=FG, anchor="w",
                       command=lambda: self._save_setting("sound_enabled", self.sound_var.get())
                       ).pack(side="left")

        r = row()
        self.speak_var = tk.BooleanVar()
        tk.Checkbutton(r, text="speak notifications (arc-break only)", variable=self.speak_var,
                       font=("JetBrains Mono", 9), bg=BG, fg=FG, selectcolor=SURFACE,
                       activebackground=BG, activeforeground=FG, anchor="w",
                       command=lambda: self._save_setting("speak_enabled", self.speak_var.get())
                       ).pack(side="left")

        # -- Quiet hours --
        section("quiet hours  (mutes sound + speech only -- still logs, still shows a bubble)")
        r = row()
        self.dnd_var = tk.BooleanVar()
        tk.Checkbutton(r, text="enabled", variable=self.dnd_var,
                       font=("JetBrains Mono", 9), bg=BG, fg=FG, selectcolor=SURFACE,
                       activebackground=BG, activeforeground=FG,
                       command=lambda: self._save_setting("dnd_enabled", self.dnd_var.get())
                       ).pack(side="left")
        r = row()
        tk.Label(r, text="from", font=("JetBrains Mono", 9), bg=BG, fg=FG_MUTED).pack(side="left")
        self.dnd_start_var = tk.StringVar()
        dnd_start_entry = tk.Entry(r, textvariable=self.dnd_start_var, font=("JetBrains Mono", 9),
                                    bg=SURFACE, fg=FG, insertbackground=FG, relief="flat", width=6)
        dnd_start_entry.pack(side="left", padx=(6, 12))
        tk.Label(r, text="to", font=("JetBrains Mono", 9), bg=BG, fg=FG_MUTED).pack(side="left")
        self.dnd_end_var = tk.StringVar()
        dnd_end_entry = tk.Entry(r, textvariable=self.dnd_end_var, font=("JetBrains Mono", 9),
                                  bg=SURFACE, fg=FG, insertbackground=FG, relief="flat", width=6)
        dnd_end_entry.pack(side="left", padx=(6, 0))
        tk.Label(r, text="HH:MM, 24h", font=("JetBrains Mono", 8), bg=BG, fg=FG_MUTED).pack(side="left", padx=(10, 0))

        def _save_dnd_times(*_):
            self._save_setting("dnd_start", self.dnd_start_var.get().strip())
            self._save_setting("dnd_end", self.dnd_end_var.get().strip())
        dnd_start_entry.bind("<FocusOut>", _save_dnd_times)
        dnd_end_entry.bind("<FocusOut>", _save_dnd_times)

        # -- Per-app rules --
        section("per-app rules")
        tk.Label(self.settings_content, text="apps seen in history, plus any you add below",
                 font=("JetBrains Mono", 8), bg=BG, fg=FG_MUTED, anchor="w").pack(fill="x", padx=14)

        rules_container = tk.Frame(self.settings_content, bg=BG)
        rules_container.pack(fill="both", expand=True, padx=14, pady=(6, 0))
        rules_canvas = self.rules_canvas = tk.Canvas(rules_container, bg=BG, highlightthickness=0, height=160)
        rules_scroll = tk.Scrollbar(rules_container, orient="vertical", command=rules_canvas.yview,
                                   bg=OVERLAY, troughcolor=BG, activebackground=TEAL,
                                   bd=0, highlightthickness=0, width=9)
        self.rules_list = tk.Frame(rules_canvas, bg=BG)
        self.rules_list.bind("<Configure>", lambda e: rules_canvas.configure(scrollregion=rules_canvas.bbox("all")))
        rules_window = rules_canvas.create_window((0, 0), window=self.rules_list, anchor="nw", width=1)
        rules_canvas.bind("<Configure>", lambda e: rules_canvas.itemconfigure(
            rules_window, width=max(1, e.width - 4)))
        rules_canvas.configure(yscrollcommand=rules_scroll.set)
        rules_canvas.pack(side="left", fill="both", expand=True)
        rules_scroll.pack(side="right", fill="y")

        r = row()
        tk.Label(r, text="add app:", font=("JetBrains Mono", 9), bg=BG, fg=FG_MUTED).pack(side="left")
        self.add_app_var = tk.StringVar()
        add_entry = tk.Entry(r, textvariable=self.add_app_var, font=("JetBrains Mono", 9),
                              bg=SURFACE, fg=FG, insertbackground=FG, relief="flat")
        add_entry.pack(side="left", fill="x", expand=True, padx=(6, 6))

        def add_app():
            name = self.add_app_var.get().strip()
            if not name:
                return
            self.config.setdefault("app_rules", {}).setdefault(name, {})
            pine.save_config(self.config)
            self.add_app_var.set("")
            self._rebuild_rules_list()
        add_entry.bind("<Return>", lambda e: add_app())
        ui.button(r, "+", command=add_app, font=("JetBrains Mono", 9), bg=SURFACE, fg=TEAL,
                  hover_bg=OVERLAY, padx=8, pady=0).pack(side="left")

        tk.Label(self.settings_content, text="changes apply live -- no restart needed",
                 font=("JetBrains Mono", 8), bg=BG, fg=FG_MUTED).pack(anchor="w", padx=14, pady=(10, 10))
        self._bind_settings_wheel(self.settings_content)

    def _known_apps(self):
        rows = db_query("SELECT DISTINCT app_name FROM notifications ORDER BY app_name")
        seen = {r["app_name"] for r in rows}
        seen |= set(self.config.get("app_rules", {}).keys())
        return sorted(seen)

    def _rebuild_rules_list(self):
        for w in self.rules_list.winfo_children():
            w.destroy()

        apps = self._known_apps()
        if not apps:
            tk.Label(self.rules_list, text="no apps seen yet", font=("JetBrains Mono", 9),
                     bg=BG, fg=FG_MUTED).pack(pady=10)
            return

        for app in apps:
            rule = self.config.get("app_rules", {}).get(app, {})
            r = tk.Frame(self.rules_list, bg=BG)
            r.pack(fill="x", pady=1)
            tk.Label(r, text=app, font=("JetBrains Mono", 9), bg=BG, fg=FG,
                     width=22, anchor="w").pack(side="left")

            mute_var = tk.BooleanVar(value=bool(rule.get("mute", False)))
            speak_var = tk.BooleanVar(value=bool(rule.get("speak", False)))

            def on_toggle(app=app, mute_var=mute_var, speak_var=speak_var):
                pine.set_app_rule(self.config, app, mute=mute_var.get(), speak=speak_var.get())
                pine.save_config(self.config)

            tk.Checkbutton(r, text="mute", variable=mute_var, command=on_toggle,
                           font=("JetBrains Mono", 9), bg=BG, fg=FG, selectcolor=SURFACE,
                           activebackground=BG, activeforeground=FG).pack(side="left", padx=(0, 10))
            tk.Checkbutton(r, text="speak", variable=speak_var, command=on_toggle,
                           font=("JetBrains Mono", 9), bg=BG, fg=FG, selectcolor=SURFACE,
                           activebackground=BG, activeforeground=FG).pack(side="left")
        self._bind_rules_wheel(self.rules_list)

    def _load_settings_into_ui(self):
        self.config = pine.load_config()
        self.theme_var.set(self.config.get("bubble_theme", "rose-pine-moon"))
        self.max_visible_var.set(self.config.get("bubble_max_visible", 4))
        self.duration_var.set(self.config.get("bubble_duration_ms", 12000) // 1000)
        self.sound_var.set(self.config.get("sound_enabled", True))
        self.speak_var.set(self.config.get("speak_enabled", True))
        self.dnd_var.set(self.config.get("dnd_enabled", False))
        self.dnd_start_var.set(self.config.get("dnd_start", "23:00"))
        self.dnd_end_var.set(self.config.get("dnd_end", "07:00"))
        self._rebuild_rules_list()

    def _save_setting(self, key, value):
        self.config[key] = value
        pine.save_config(self.config)

    def _update_snooze_indicator(self):
        snoozed = pine.is_snoozed(pine.load_config())
        if snoozed:
            self.snooze_lbl.pack(side="left", padx=(10, 0))
        else:
            self.snooze_lbl.pack_forget()
        if hasattr(self, "status_lbl"):
            total = db_query("SELECT COUNT(*) as c FROM notifications")
            count = total[0]["c"] if total else 0
            self.status_lbl.configure(text=f"{count} saved  ·  {'snoozed' if snoozed else 'live'}")

    def _tick_circadian(self):
        minute = int(time.time() // 60)
        if minute != self._last_palette_minute:
            self._last_palette_minute = minute
            self._apply_circadian_palette()
        self._update_snooze_indicator()
        self.after(30000, self._tick_circadian)

    def _apply_circadian_palette(self):
        """Let the console colors drift with the shared, continuous day cycle."""
        ambient = ui.circadian()
        palette = {
            "BG": ambient["bg"], "SURFACE": ambient["surface"],
            "OVERLAY": ambient["overlay"],
            "BORDER": ui._lerp_hex(ambient["surface"], ambient["fg_muted"], 0.28),
            "FG": ambient["fg"], "FG_MUTED": ambient["fg_muted"],
        }
        role_map = {self._palette[key]: value for key, value in palette.items()}
        self._palette = palette
        globals().update(palette)
        globals()["URGENCY_COLOR"] = {0: FG_MUTED, 1: TEAL, 2: ROSE}
        _phase, accent = ui.phase_info()
        self.phase_lbl.configure(text=f"{ambient['phase'].upper()}  ·  {time.strftime('%H:%M')}", fg=accent)
        self.status_marker.configure(bg=accent)

        def repaint(widget):
            if callable(getattr(widget, "retime", None)):
                try:
                    widget.retheme(bg=role_map.get(widget.cget("bg"), widget.cget("bg")),
                                   hover_bg=OVERLAY)
                except tk.TclError:
                    pass
            else:
                for option in ("background", "foreground", "insertbackground", "highlightbackground",
                               "highlightcolor", "activebackground", "activeforeground", "selectbackground",
                               "troughcolor"):
                    try:
                        value = widget.cget(option)
                        if value in role_map:
                            widget.configure(**{option: role_map[value]})
                    except (tk.TclError, TypeError):
                        pass
            try:
                for child in widget.winfo_children():
                    repaint(child)
            except tk.TclError:
                pass

        self.configure(bg=BG)
        repaint(self)
        self._update_nav_buttons()
        self._style_combobox()

    def refresh(self):
        self._update_snooze_indicator()
        for w in self.list_frame.winfo_children():
            w.destroy()
        self._card_text_labels.clear()

        q = self.search_var.get().strip()
        if q:
            rows = db_query(
                "SELECT * FROM notifications WHERE app_name LIKE ? OR summary LIKE ? OR body LIKE ? "
                "ORDER BY id DESC LIMIT 200",
                (f"%{q}%", f"%{q}%", f"%{q}%"),
            )
        else:
            rows = db_query("SELECT * FROM notifications ORDER BY id DESC LIMIT 200")

        if not rows:
            tk.Label(self.list_frame, text="no notifications", font=("JetBrains Mono", 10),
                     bg=BG, fg=FG_MUTED).pack(pady=20)

        for row in rows:
            self._add_card(row)

        total = db_query("SELECT COUNT(*) as c FROM notifications")
        self.count_lbl.configure(text=f"{total[0]['c'] if total else 0} total")
        self._update_snooze_indicator()
        self._bind_history_wheel(self.list_frame)

    def _add_card(self, row):
        # highlightthickness border -- a real edge without Canvas
        # rounding's per-card performance cost at this scale (up to 200
        # cards), same technique used in khaos-lab's tiles/action rows.
        card = tk.Frame(self.list_frame, bg=SURFACE, highlightthickness=1, highlightbackground=BORDER)
        card.pack(fill="x", pady=4, padx=1)

        color = URGENCY_COLOR.get(row["urgency"], TEAL)

        header = tk.Frame(card, bg=SURFACE)
        header.pack(fill="x", padx=8, pady=(6, 0))
        tk.Label(header, text=row["app_name"], font=("JetBrains Mono", 9, "bold"),
                 bg=SURFACE, fg=color).pack(side="left")
        tk.Label(header, text=row["timestamp"], font=("JetBrains Mono", 8),
                 bg=SURFACE, fg=FG_MUTED).pack(side="right")

        wrap = max(240, self.history_canvas.winfo_width() - 52)
        summary_lbl = tk.Label(card, text=row["summary"], font=("JetBrains Mono", 10),
                               bg=SURFACE, fg=FG, anchor="w", wraplength=wrap, justify="left")
        summary_lbl.pack(fill="x", padx=8, pady=(2, 0))
        self._card_text_labels.append(summary_lbl)

        if row["body"]:
            body_lbl = tk.Label(card, text=row["body"], font=("JetBrains Mono", 9),
                                bg=SURFACE, fg=FG_MUTED, anchor="w", wraplength=wrap, justify="left")
            body_lbl.pack(fill="x", padx=8, pady=(0, 4))
            self._card_text_labels.append(body_lbl)

        actions = tk.Frame(card, bg=SURFACE)
        actions.pack(fill="x", padx=8, pady=(0, 6))

        def do_copy(text=f"{row['summary']} {row['body']}".strip()):
            self.clipboard_clear()
            self.clipboard_append(text)

        def do_delete(nid=row["id"]):
            db_exec("DELETE FROM notifications WHERE id = ?", (nid,))
            self.refresh()

        # Card itself deliberately stays a flat tk.Frame, not
        # ui.rounded_frame() -- up to 200 of these render per view (LIMIT
        # 200 above), and 200 live Canvas widgets each redrawing on their
        # own <Configure> is real, untested performance risk for a
        # cosmetic gain, same reasoning khaos-lab's per-action rows used.
        # The buttons themselves are cheap either way.
        ui.button(actions, "copy", command=do_copy, font=("JetBrains Mono", 8),
                  bg=OVERLAY, fg=TEAL, hover_bg=BG, padx=6, pady=0).pack(side="left")
        ui.button(actions, "delete", command=do_delete, font=("JetBrains Mono", 8),
                  bg=OVERLAY, fg=ROSE, hover_bg=BG, padx=6, pady=0).pack(side="left", padx=(4, 0))

    def purge_age(self, days):
        cutoff = (datetime.now() - timedelta(days=days)).strftime("%Y-%m-%d %H:%M:%S")
        db_exec("DELETE FROM notifications WHERE timestamp < ?", (cutoff,))
        self.refresh()

    def purge_all(self):
        db_exec("DELETE FROM notifications")
        self.refresh()


if __name__ == "__main__":
    ArcPine().mainloop()
