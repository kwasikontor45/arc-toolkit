#!/usr/bin/env bash
# arc-quiet-clean — conservative periodic maintenance (user timer, every 3 days).
# Unattended deletion is limited to regenerable Python bytecode caches. User
# caches, editor/browser backups, security logs, and archives are preserved.
set -uo pipefail

# Record this unattended run with the SOP ledger when the adapter supports it.
{ command -v arc-sop >/dev/null 2>&1 && arc-sop ack-auto "arc-quiet-clean" >/dev/null 2>&1; } || true

LOG="$HOME/.local/share/arc/quiet-clean.log"
SWEEP="$HOME/.local/bin/arc-home-sweep"
mkdir -p "$(dirname "$LOG")"
_log() { printf '%s  %s\n' "$(date '+%F %T')" "$*" >> "$LOG"; }

_log '--- quiet-clean start ---'

# The sweep's purge mode removes only __pycache__; it reports editor backups
# and empty directories without touching them.
if [[ -x "$SWEEP" ]]; then
  if "$SWEEP" --purge >> "$LOG" 2>&1; then
    _log 'home-sweep: complete'
  else
    _log 'home-sweep: one or more cache removals failed'
  fi
else
  _log "home-sweep: missing executable at $SWEEP — skipped"
fi

# Report cache sizes for deliberate, user-timed cleanup. Do not clear caches,
# truncate security logs, prune browser exports, or age-delete archive content
# in this unattended job; those operations can destroy useful recovery data.
cache_bytes=$(du -sb "$HOME/.cache" 2>/dev/null | awk 'NR==1 {print $1}')
npm_bytes=$(du -sb "$HOME/.npm" 2>/dev/null | awk 'NR==1 {print $1}')
_log "preserved user caches: ${cache_bytes:-unknown} bytes; npm cache: ${npm_bytes:-unknown} bytes"
_log 'preserved security logs, browser exports, old tool versions, and all archive content'
_log '--- quiet-clean done ---'
