#!/usr/bin/env bash
# arc-home-sweep — conservative HOME review and bytecode-cache cleanup.
# Only __pycache__ directories are purgeable. Backups, swap files, and empty
# user directories are review-only; hidden directories are never candidates.
set -uo pipefail

MODE="dry-run"
case "${1:-}" in
  --purge)     MODE="purge" ;;
  --dry-run)   MODE="dry-run" ;;
  --status)    MODE="status" ;;
  "")          MODE="dry-run" ;;
  *)           echo "usage: arc-home-sweep [--purge|--dry-run|--status]" >&2; exit 1 ;;
esac

_log() { printf '  sweep: %s\n' "$*"; }

safe_found=0
review_found=0
removed=0
failed=0

safe_candidate() {
  local path="$1"
  safe_found=$((safe_found + 1))
  case "$MODE" in
    purge)
      if rm -rf -- "$path"; then
        _log "removed regenerable cache: $path"
        removed=$((removed + 1))
      else
        _log "failed to remove cache: $path"
        failed=$((failed + 1))
      fi
      ;;
    dry-run) _log "(dry-run) would remove regenerable cache: $path" ;;
    status)  _log "safe cache candidate: $path" ;;
  esac
}

review_candidate() {
  local path="$1"
  review_found=$((review_found + 1))
  [[ "$MODE" == "purge" ]] && _log "kept for review: $path" || _log "review only: $path"
}

# Python bytecode is regenerable. Do not traverse the mounted vault or project
# tree, where active work and intentionally staged artifacts may exist.
while IFS= read -r -d '' path; do
  safe_candidate "$path"
done < <(find "$HOME" -maxdepth 4 -type d -name '__pycache__' \
  -not -path "$HOME/links/vault/*" -not -path "$HOME/khaos-lab/*" -print0 2>/dev/null)

# Editor backups and swap files may contain recoverable work. Report, never
# purge them automatically.
while IFS= read -r -d '' path; do
  review_candidate "$path"
done < <(find "$HOME" -maxdepth 3 -type f \
  \( -name '*~' -o -name '*.swp' -o -name '*.swo' \) -print0 2>/dev/null)

# Empty directories can be intentional structure. Report visible HOME-level
# candidates only; hidden configuration and repository directories are never
# considered cleanup targets.
while IFS= read -r -d '' path; do
  base="$(basename "$path")"
  case "$base" in
    .*|Desktop|Documents|Downloads|Music|Pictures|Videos|Templates|Public|Projects) continue ;;
  esac
  review_candidate "$path"
done < <(find "$HOME" -maxdepth 1 -mindepth 1 -type d -empty -print0 2>/dev/null)

case "$MODE" in
  status) _log "done — $safe_found safe cache candidate(s); $review_found review-only item(s)" ;;
  dry-run) _log "done — $safe_found safe cache candidate(s) would be removed; $review_found review-only item(s); nothing changed" ;;
  purge)
    _log "done — $removed/$safe_found safe cache candidate(s) removed; $review_found review-only item(s) kept"
    (( failed == 0 )) || exit 1
    ;;
esac
