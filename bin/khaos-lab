        )
        self.level_scale.pack(fill="x", padx=10, pady=(0, 0))
        button_row = tk.Frame(controls, bg=OVERLAY)
        button_row.pack(fill="x", padx=12, pady=(0, 7))
        self.level_hint = tk.Label(button_row, text="", font=self.app.f.small, bg=OVERLAY,
                                   fg=FG_MUTED, anchor="w")
        self.level_hint.pack(side="left", fill="x", expand=True)
