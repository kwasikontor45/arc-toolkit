#!/usr/bin/env bash
# Moves files ≥10MB from ~/downloads to /mnt/storage/cargo/
# Safe to run with no USB — exits clean if not mounted

THRESHOLD_MB=10
SRC="$HOME/downloads"
DEST="/mnt/storage/cargo"
LOG="$HOME/.local/share/arc/large-file-mover.log"

if ! mountpoint -q /mnt/storage 2>/dev/null; then
  exit 0
fi

mkdir -p "$DEST" "$(dirname "$LOG")"

moved=0
while IFS= read -r -d '' f; do
  fname="$(basename "$f")"
  dest_path="$DEST/$fname"
  if [[ -e "$dest_path" ]]; then
    dest_path="$DEST/$(date +%s)_$fname"
  fi
  mv -- "$f" "$dest_path" && {
    echo "$(date '+%F %T')  moved  $fname  ($(du -sh "$dest_path" | cut -f1))" >> "$LOG"
    (( moved++ ))
  }
done < <(find "$SRC" -maxdepth 2 -type f -size +"${THRESHOLD_MB}M" -print0 2>/dev/null)

[[ $moved -gt 0 ]] && echo "$(date '+%F %T')  total moved: $moved file(s)" >> "$LOG"
exit 0
