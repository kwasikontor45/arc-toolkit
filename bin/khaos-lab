# ── text helpers ─────────────────────────────────────────────────────────────
_ANSI_RE = re.compile(r"\x1b\[[0-9;]*[a-zA-Z]")


def strip_ansi(text):
    """arc's subcommands print real ANSI colors for terminals; a Tk Text shows
    them as literal garbage. Strip before displaying output anywhere."""
    return _ANSI_RE.sub("", text)


def strip_banner(text, cmd=None):
    """Most `arc` subcommands wrap output in a decorative rule/title header and
    footer meant for a full-width terminal. In a small tile that's clutter --
    drop rule-only lines, blanks, and the command's own title echo."""
    title = cmd.strip().lower() if cmd else None
    lines = []
    for line in text.splitlines():
        s = line.strip()
        if not s or all(ch in "─-—= " for ch in s):
            continue
        if title and s.lower() == title:
            continue
        lines.append(s)
    return "\n".join(lines)


def load_image(path):
    """PhotoImage or None. Callers must keep the result referenced (a local that
    goes out of scope is garbage-collected and the image just vanishes)."""
    if not path.exists():
        return None
    try:
        return tk.PhotoImage(file=str(path))
    except Exception:
        return None


def get_upcoming_events(limit=4):
    """Next appointments and due to-dos from Orage's local iCalendar file.

    This intentionally reads titles and dates only; descriptions can contain
    private notes and do not belong in a glanceable operations panel. Supports
    floating, UTC, and TZID timestamps, all-day entries, and common daily or
    weekly recurrence rules without an additional iCalendar dependency.
    """
    if not ORAGE_ICS_PATH.exists():
        return []
    try:
        raw = ORAGE_ICS_PATH.read_text()
    except Exception:
        return []

    lines = []
    for line in raw.replace("\r\n", "\n").replace("\r", "\n").split("\n"):
        if line.startswith((" ", "\t")) and lines:
            lines[-1] += line[1:]
        else:
            lines.append(line)

    def unescape(value):
        return (value.replace(r"\n", " ").replace(r"\N", " ")
                     .replace(r"\,", ",").replace(r"\;", ";").replace(r"\\", "\\").strip())

    def parse_time(params, value):
        try:
            all_day = "VALUE=DATE" in params or (len(value) == 8 and "T" not in value)
            if all_day:
                return datetime.strptime(value[:8], "%Y%m%d").date(), True
            if value.endswith("Z"):
                return datetime.strptime(value, "%Y%m%dT%H%M%SZ").replace(tzinfo=timezone.utc), False
            dt = datetime.strptime(value[:15], "%Y%m%dT%H%M%S")
            tzid = next((part.split("=", 1)[1] for part in params if part.startswith("TZID=")), None)
            if tzid:
                try:
                    dt = dt.replace(tzinfo=ZoneInfo(tzid))
                except ZoneInfoNotFoundError:
                    dt = dt.replace(tzinfo=datetime.now().astimezone().tzinfo)
            else:
                dt = dt.replace(tzinfo=datetime.now().astimezone().tzinfo)
            return dt, False
        except (ValueError, TypeError):
            return None, False

    def next_time(dt, all_day, rule):
        if not rule:
            return dt
        parts = dict(part.split("=", 1) for part in rule.split(";") if "=" in part)
        freq = parts.get("FREQ", "").upper()
        interval = max(1, int(parts.get("INTERVAL", "1") or 1))
        if all_day:
            now = datetime.now().date()
        else:
            now = datetime.now(dt.tzinfo) if dt.tzinfo else datetime.now()
        if dt >= now:
            candidate = dt
        elif freq == "DAILY":
            days = max(0, (now.date() - dt.date()).days)
            steps = (days + interval - 1) // interval
            candidate = dt + timedelta(days=steps * interval)
            while candidate < now:
                candidate += timedelta(days=interval)
        elif freq == "WEEKLY":
            weekdays = {"MO": 0, "TU": 1, "WE": 2, "TH": 3, "FR": 4, "SA": 5, "SU": 6}
            byday = {weekdays[x[-2:]] for x in parts.get("BYDAY", "").split(",") if x[-2:] in weekdays}
            if not byday:
                byday = {dt.weekday()}
            anchor = dt.date() - timedelta(days=dt.weekday())
            candidate = dt
            for _ in range(3700):
                weeks = (candidate.date() - anchor).days // 7
                active_week = weeks >= 0 and weeks % interval == 0
                if candidate >= now and active_week and (not byday or candidate.weekday() in byday):
                    break
                candidate += timedelta(days=1)
            else:
                return None
        else:
            return None
        until = parts.get("UNTIL")
        if until:
            end, _ = parse_time([], until)
            if end and candidate > end:
                return None
        return candidate

    items, current, depth = [], None, 0
    for line in lines:
        if line in ("BEGIN:VEVENT", "BEGIN:VTODO") and current is None:
            current = {"kind": "EVENT" if line == "BEGIN:VEVENT" else "TODO", "fields": {}}
            depth = 1
            continue
        if current is None:
            continue
        if line.startswith("BEGIN:"):
            depth += 1
            continue
        if line.startswith("END:"):
            depth -= 1
            if depth == 0:
                fields = current["fields"]
                if fields.get("STATUS", "").upper() not in ("CANCELLED", "COMPLETED"):
                    title = fields.get("SUMMARY")
                    prop, value = fields.get("DUE", (None, None)) if current["kind"] == "TODO" else (None, None)
                    if not value:
                        prop, value = fields.get("DTSTART", (None, None))
                    dt, all_day = parse_time(prop or [], value or "")
                    if title and dt:
                        rule = fields.get("RRULE", "")
                        dt = next_time(dt, all_day, rule)
                        if dt:
                            if all_day:
                                overdue = dt < datetime.now().date()
                            else:
                                now = datetime.now(dt.tzinfo) if dt.tzinfo else datetime.now()
                                overdue = dt < now
                            if not (current["kind"] == "EVENT" and overdue):
                                items.append((dt, all_day, current["kind"], title,
                                              fields.get("UID", ""), overdue))
                current = None
            continue
        if depth != 1 or ":" not in line:
            continue
        prop_name, value = line.split(":", 1)
        bits = prop_name.split(";")
        name = bits[0].upper()
        if name in ("SUMMARY", "UID", "RRULE", "STATUS", "PRIORITY", "CATEGORIES"):
            current["fields"][name] = unescape(value)
        elif name in ("DTSTART", "DUE"):
            current["fields"][name] = (bits[1:], value)

    # A repeated UID represents the same series; retain the earliest copy only.
    unique, seen = [], set()
    for item in items:
        key = item[4] or (item[0], item[2], item[3])
        if key not in seen:
            unique.append(item)
            seen.add(key)
    def sort_key(item):
        dt, all_day, kind, _title, _uid, overdue = item
        if all_day:
            local_tz = datetime.now().astimezone().tzinfo
            dt = datetime.combine(dt, datetime.min.time(), tzinfo=local_tz)
        elif dt.tzinfo is None:
            dt = dt.replace(tzinfo=datetime.now().astimezone().tzinfo)
        return (0 if overdue else 1, dt.astimezone(timezone.utc),
                0 if kind == "EVENT" else 1)

    unique.sort(key=sort_key)
    out = []
    for dt, all_day, kind, title, _uid, overdue in unique[:limit]:
        if all_day:
            when = dt.strftime("%a %b %d")
        else:
            shown = dt.astimezone() if dt.tzinfo else dt
            when = shown.strftime("%a %b %d, %I:%M %p").replace(" 0", " ")
        label = "EVENT" if kind == "EVENT" else ("OVERDUE TO-DO" if overdue else "TO-DO")
        title = title if len(title) <= 46 else title[:45].rstrip() + "…"
        out.append(f"{label} · {when} — {title}")
    return out


def calendar_status_lines(items, now=None, limit=4):
    """Summarize the Hub's shared check marks without calling completed tasks overdue."""
    now = now or datetime.now().astimezone()
    rows = []
    done_count = overdue_count = 0
    for item in items:
        kind = item.get('kind', 'To-do')
        done = bool(item.get('done'))
        due = None
        try:
            due = datetime.fromisoformat(item['date']) if item.get('date') else None
        except (TypeError, ValueError):
            pass
        overdue = False
        if kind == 'To-do' and not done and due:
            if item.get('all_day'):
                overdue = due.date() < now.date()
            elif due.tzinfo:
                overdue = due < now.astimezone(due.tzinfo)
            else:
                overdue = due < now.replace(tzinfo=None)
        if done:
            done_count += 1
            rank = 2
            label = 'DONE'
        elif overdue:
            overdue_count += 1
            rank = 0
            label = 'OVERDUE TO-DO'
        else:
            rank = 1
            label = kind.upper()
        stamp = item.get('when') or 'No due date'
        title = str(item.get('title') or 'Untitled')
        if len(title) > 46:
            title = title[:45].rstrip() + '…'
        date_key = due.timestamp() if due else float('inf')
        rows.append((rank, -date_key if done else date_key,
                     f"{label} · {stamp} — {title}"))
    rows.sort(key=lambda row: (row[0], row[1]))
    if overdue_count:
        summary = f"OVERDUE · {overdue_count} open · DONE · {done_count} checked"
    elif done_count:
        summary = f"DONE · {done_count} checked · no overdue"
    else:
        summary = 'no overdue to-dos'
    return [summary, *(row[2] for row in rows[:limit])]


def read_lt_board():
    """Read lt's existing personal files without creating or changing them."""
    try:
        with LT_TASKS_PATH.open("rb") as stream:
            raw_tasks = stream.read(256_001)
        if len(raw_tasks) > 256_000:
            raise OSError("task list exceeds the 256 KB read limit")
        with LT_FOCUS_PATH.open("rb") as stream:
            focus = stream.read(2048).decode("utf-8", "replace").strip()
        try:
            with LT_NOTES_PATH.open("rb") as stream:
                stream.seek(0, os.SEEK_END)
                size = stream.tell()
                stream.seek(max(0, size - 32_000))
                raw_notes = stream.read(32_000).decode("utf-8", "replace")
        except FileNotFoundError:
            raw_notes = ""
    except FileNotFoundError:
        return {"available": False, "focus": "", "pending": [], "done": [], "note": ""}
    except OSError as exc:
        return {"available": False, "error": str(exc), "focus": "", "pending": [],
                "done": [], "note": ""}

    def clean(value, limit=240):
        value = "".join(ch for ch in value
                        if ch == "\t" or (ord(ch) >= 32 and not 127 <= ord(ch) <= 159))
        return value.strip()[:limit]

    pending, done = [], []
    for line in raw_tasks.decode("utf-8", "replace").splitlines():
        if line.startswith("pending "):
            pending.append(clean(line[8:]))
        elif line.startswith("done "):
            done.append(clean(line[5:]))
    latest_note = ""
    note_lines = raw_notes.splitlines()
    if note_lines:
        latest_note = clean(note_lines[-1].partition("|")[2], 180)
    return {"available": True, "focus": clean(focus), "pending": pending,
            "done": done, "note": latest_note}


def lt_status_text(board):
    if not board.get("available"):
        return "board unavailable" if board.get("error") else "no local board yet"
    focus = board.get("focus") or "no focus set"
    return f"focus · {focus}\n{len(board.get('pending', []))} pending  ·  {len(board.get('done', []))} done"


