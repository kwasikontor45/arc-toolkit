  echo -e "  ${D}arc ${C}emoji add ${W}<e> <words>${N} ${M}add emoji with search keywords${N}"
  echo -e "  ${D}arc ${C}emoji list${N}            ${M}show your emoji list${N}"
  echo -e "  ${D}arc ${C}emoji edit${N}            ${M}bulk edit list in nano${N}"

  echo -e "\n  ${Y}fixes & patches${N}"
  echo -e "  ${D}──${N}"
  echo -e "  ${D}arc ${C}fix brave${N}             ${M}kill + relaunch Brave${N}"
  echo -e "  ${D}arc ${C}fix display${N}           ${M}restart xfwm4 compositor${N}"
  echo -e "  ${D}arc ${C}fix wifi${N}              ${M}toggle wifi off → on${N}"
  echo -e "  ${D}arc ${C}fix screen${N}            ${M}reset terminal + restart shell${N}"
