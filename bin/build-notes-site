    "arc-lt-cmc": HOME / "arc-lt-cmc",
    "dev-notes": HOME / "dev-notes",
    "khaos-lab": HOME / "khaos-lab",
    "vault/archive": Path("/mnt/storage/Persistent/archive"),
}

