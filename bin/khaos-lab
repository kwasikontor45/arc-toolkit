        self.mute_button = ui.button(
            controls, "Mute output", command=self.set_mute, font=self.app.f.small,
            bg=BG, fg=GOLD, hover_bg=BORDER, padx=12, pady=6,
        )
        self.mute_button.pack(anchor="w", padx=12, pady=(0, 10))
        self.apply_button.set_enabled(False)
        self.mute_button.set_enabled(False)

        profile_shell, profile = ui.rounded_frame(self.frame, SURFACE, bg=OVERLAY, radius=16)
        profile_shell.pack(fill="x", pady=6)
        tk.Label(profile, text="SPEAKER CLARITY PROFILE", font=self.app.f.small,
                 bg=OVERLAY, fg=FG_MUTED, anchor="w").pack(fill="x", padx=12, pady=(10, 3))
        configured = bool(self._eq_info.get("available"))
        profile_text = ("PipeWire profile configured locally" if configured
                        else self._eq_info.get("error", "No local speaker EQ profile found"))
        self.profile_status = tk.Label(profile, text=profile_text, font=self.app.f.label,
                                       bg=OVERLAY, fg=TEAL if configured else GOLD, anchor="w")
        self.profile_status.pack(fill="x", padx=12)
        tk.Label(
            profile,
            text=("The panel reports the profile file; PipeWire manages playback processing. "
                  "Notifications routed to this output follow its volume and mute state."),
            font=self.app.f.small, bg=OVERLAY, fg=FG_MUTED, anchor="w", justify="left",
            wraplength=640,
        ).pack(fill="x", padx=12, pady=(3, 10))
        profile.bind("<Configure>", lambda event, p=profile: [
            child.configure(wraplength=max(event.width - 32, 140))
            for child in p.winfo_children() if isinstance(child, tk.Label)
        ], add="+")

        eq_shell, eq_frame = ui.rounded_frame(self.frame, SURFACE, bg=OVERLAY, radius=16)
        eq_shell.pack(fill="x", pady=6)
        tk.Label(eq_frame, text="TONE  ·  SPEAKER EQ", font=self.app.f.small,
                 bg=OVERLAY, fg=FG_MUTED, anchor="w").pack(fill="x", padx=12, pady=(10, 3))
        tk.Label(eq_frame, text="Five bands · preview first · ±3 dB", font=self.app.f.label,
                 bg=OVERLAY, fg=FG, anchor="w").pack(fill="x", padx=12)
        tk.Label(eq_frame,
                 text="Sliders only preview. Apply may briefly pause all output, including notifications. "
                      "Extra positive gain lowers automatic headroom to reduce clipping.",
                 font=self.app.f.small, bg=OVERLAY, fg=FG_MUTED, anchor="w", justify="left",
                 wraplength=640).pack(fill="x", padx=12, pady=(3, 7))
        eq_frame.bind("<Configure>", lambda event, p=eq_frame: [
            child.configure(wraplength=max(event.width - 32, 140))
            for child in p.winfo_children() if isinstance(child, tk.Label)
        ], add="+")

        self.eq_value_labels = {}
        self.eq_scale_widgets = {}
        for name, label, freq, _q, _filter in EQ_BANDS:
            row = tk.Frame(eq_frame, bg=OVERLAY)
            row.pack(fill="x", padx=10, pady=1)
            freq_label = f"{freq / 1000:g} kHz" if freq >= 1000 else f"{freq:g} Hz"
            tk.Label(row, text=f"{label}  ·  {freq_label}", font=self.app.f.small,
                     bg=OVERLAY, fg=FG, anchor="w", width=19).pack(side="left")
            scale = tk.Scale(
                row, from_=-3.0, to=3.0, resolution=0.1, orient="horizontal",
                showvalue=False,
                command=lambda raw, key=name: self._preview_eq(key, raw),
                bg=OVERLAY, fg=FG, troughcolor=BORDER,
                activebackground=self.app.phase_accent, highlightthickness=0,
                bd=0, sliderlength=16, width=8,
            )
            scale.pack(side="left", fill="x", expand=True, padx=(4, 8))
            self.eq_scale_widgets[name] = scale
            value_label = tk.Label(row, text="0.0 dB", font=self.app.f.small,
                                   bg=OVERLAY, fg=TEAL, anchor="e", width=7)
            value_label.pack(side="right")
            self.eq_value_labels[name] = value_label

        self.eq_status = tk.Label(eq_frame, text="Reading speaker profile…",
                                  font=self.app.f.small, bg=OVERLAY, fg=FG_MUTED,
                                  anchor="w", justify="left", wraplength=640)
        self.eq_status.pack(fill="x", padx=12, pady=(4, 5))
        eq_buttons = tk.Frame(eq_frame, bg=OVERLAY)
        eq_buttons.pack(fill="x", padx=12, pady=(0, 10))
        self.eq_apply_button = ui.button(
            eq_buttons, "Apply EQ", command=self.apply_eq,
            font=self.app.f.small, bg=BG, fg=TEAL, hover_bg=BORDER, padx=12, pady=6,
        )
        self.eq_apply_button.pack(side="left")
        self.eq_reload_button = ui.button(
            eq_buttons, "Reload profile", command=self.reload_eq,
            font=self.app.f.small, bg=BG, fg=FG, hover_bg=BORDER, padx=12, pady=6,
        )
        self.eq_reload_button.pack(side="left", padx=(7, 0))
        self.eq_reset_button = ui.button(
            eq_buttons, "Reset to original", command=self.reset_eq,
            font=self.app.f.small, bg=BG, fg=GOLD, hover_bg=BORDER, padx=12, pady=6,
        )
        self.eq_reset_button.pack(side="right")
        self._set_eq_info(self._eq_info, force=True)

        tools_shell, tools_frame = ui.rounded_frame(self.frame, SURFACE, bg=OVERLAY, radius=16)
        tools_shell.pack(fill="x", pady=6)
        tk.Label(tools_frame, text="MORE CONTROLS", font=self.app.f.small, bg=OVERLAY,
                 fg=FG_MUTED, anchor="w").pack(fill="x", padx=12, pady=(10, 4))
        action_row = tk.Frame(tools_frame, bg=OVERLAY)
        action_row.pack(fill="x", padx=8, pady=(0, 7))
        self._audio_action_buttons = []
        for action in CATEGORIES["Audio"]:
            button = ui.button(action_row, action.label,
                               command=lambda a=action: self.app.run_action(a),
                               font=self.app.f.small, bg=BG, fg=TEAL, hover_bg=BORDER,
                               padx=10, pady=6)
            self._audio_action_buttons.append(button)
        action_row.bind("<Configure>", self._layout_audio_tools, add="+")
        self._layout_audio_tools(SimpleNamespace(width=max(action_row.winfo_width(), 520)))
        self.poll(self.NAME, self.EVERY,
                  lambda: read_audio_snapshot(self.app.runner), self.apply_snapshot)

    def _layout_audio_tools(self, event):
        buttons = getattr(self, "_audio_action_buttons", [])
        if not buttons:
            return
        columns = 1 if getattr(event, "width", 520) < 560 else 2
        for index, button in enumerate(buttons):
            button.grid(row=index // columns, column=index % columns,
                        sticky="ew", padx=4, pady=3)
        for column in range(2):
            self._audio_action_buttons[0].master.grid_columnconfigure(
                column, weight=1 if column < columns else 0)

    def _preview_level(self, raw_value):
        if self._loading_scale:
            return
        try:
            value = max(0, min(100, int(float(raw_value))))
        except (TypeError, ValueError):
            return
        self._level_dirty = True
        self.level_hint.configure(text=f"Selected {value}%")
        self.apply_button.configure(text=f"Set {value}%")

    def apply_level(self):
        if not self.snapshot or not self.snapshot.get("available"):
            return
        value = max(0, min(100, int(self.level_var.get())))
        self._level_dirty = False
        self.app.run_async(
            f"pactl set-sink-volume @DEFAULT_SINK@ {value}%",
            timeout=8,
            on_done=lambda: self.kick(self.NAME) if self.alive() else None,
        )

    def set_mute(self):
        if not self.snapshot or not self.snapshot.get("available"):
            return
        currently_muted = self.snapshot["muted"]
        volume = self.snapshot["volume"]
        if currently_muted and volume > 100:
            self.app.console.log(
                "Lower the output to 100% or less before unmuting it from this panel.", GOLD)
            return
        target = "0" if currently_muted else "1"
        self.app.run_async(
            f"pactl set-sink-mute @DEFAULT_SINK@ {target}",
            timeout=8,
            on_done=lambda: self.kick(self.NAME) if self.alive() else None,
        )

    def apply_snapshot(self, snapshot):
        self.snapshot = snapshot
        eq_info = snapshot.get("eq")
        if eq_info:
            self._set_eq_info(eq_info)
        configured = bool(eq_info and eq_info.get("available"))
        self.profile_status.configure(
            text=("PipeWire profile configured locally" if configured
                  else (eq_info or {}).get("error", "No local speaker EQ profile found")),
            fg=TEAL if configured else GOLD,
        )
        if not snapshot.get("available"):
            detail = snapshot.get("error") or "audio service unavailable"
            self.output_name.configure(text="Default output unavailable", fg=GOLD)
            self.output_state.configure(text=detail, fg=FG_MUTED)
            self.level_hint.configure(text="Waiting for an available audio output")
            self.apply_button.set_enabled(False)
            self.mute_button.configure(text="Mute output")
            self.mute_button.set_enabled(False)
            return

        volume = snapshot["volume"]
        muted = snapshot["muted"]
        self.output_name.configure(text=snapshot["sink"], fg=FG)
        state = "MUTED" if muted else "LIVE"
        over_cap = volume > 100
        detail = f"{state}  ·  {volume}%"
        if over_cap:
            detail += "  ·  above the panel's 100% limit"
        self.output_state.configure(text=detail, fg=GOLD if muted or over_cap else TEAL)
        if not self._level_dirty:
            self._loading_scale = True
            self.level_var.set(min(volume, 100))
            self._loading_scale = False
            self.level_hint.configure(text=f"Current {volume}%")
            self.apply_button.configure(text="Apply level")
        self.apply_button.set_enabled(True)
        self.mute_button.configure(text="Unmute output" if muted else "Mute output")
        self.mute_button.set_enabled(not (muted and over_cap))
        if muted and over_cap:
            self.mute_button.configure(text="Lower to 100% before unmuting")

    def _set_eq_info(self, info, force=False):
        if not isinstance(info, dict) or not info.get("available"):
            self._eq_info = info if isinstance(info, dict) else {"available": False}
            if self._eq_dirty and not force:
                self._eq_stale = True
                self.eq_status.configure(
                    text="Profile is unavailable or changed outside the panel. Reload before applying.",
                    fg=GOLD)
                self._update_eq_buttons()
            else:
                self._eq_loaded_hash = None
                self._eq_stale = False
                self.eq_status.configure(text=self._eq_info.get("error", "Speaker EQ unavailable"),
                                          fg=GOLD)
                for scale in self.eq_scale_widgets.values():
                    scale.configure(state="disabled")
                self._update_eq_buttons()
            return
        if not force and self._eq_dirty:
            if self._eq_loaded_hash and info.get("sha256") != self._eq_loaded_hash:
                self._eq_stale = True
                self.eq_status.configure(
                    text="Profile changed outside this panel. Reload before applying.", fg=GOLD)
                self._update_eq_buttons()
            else:
                self._eq_info = info
                self._eq_stale = False
                self.eq_status.configure(
                    text="Preview only · current profile is unchanged until Apply EQ.", fg=TEAL)
                self._update_eq_buttons()
            return
        self._eq_info = info
        self._eq_loaded_hash = info.get("sha256")
        self._eq_stale = False
        self._loading_eq = True
        for name, *_ in EQ_BANDS:
            value = float(info["gains"][name])
            self.eq_scale_widgets[name].set(value)
            self.eq_value_labels[name].configure(text=f"{value:+.1f} dB")
            self.eq_scale_widgets[name].configure(state="normal")
        self._loading_eq = False
        if force:
            self._eq_dirty = False
        self.eq_status.configure(text="Current curve loaded · slider changes are preview only.",
                                  fg=FG_MUTED)
        self._update_eq_buttons()

    def _preview_eq(self, name, raw_value):
        if getattr(self, "_loading_eq", False):
            return
        try:
            value = max(-3.0, min(3.0, round(float(raw_value) * 10) / 10))
        except (TypeError, ValueError):
            return
        self.eq_value_labels[name].configure(text=f"{value:+.1f} dB")
        self._eq_dirty = True
        self.eq_status.configure(text="Preview only · current profile is unchanged until Apply EQ.",
                                  fg=TEAL)
        self._update_eq_buttons()

    def _update_eq_buttons(self):
        available = bool(self._eq_info and self._eq_info.get("available"))
        self.eq_apply_button.set_enabled(
            available and self._eq_dirty and not self._eq_stale and not self._eq_busy)
        self.eq_reload_button.set_enabled(not self._eq_busy)
        baseline_exists = AUDIO_EQ_BASELINE.exists() or AUDIO_EQ_BASELINE.is_symlink()
        self.eq_reset_button.set_enabled(
            baseline_exists and available and not self._eq_busy and not self._eq_stale)
        for scale in self.eq_scale_widgets.values():
            scale.configure(state="disabled" if self._eq_busy or not available else "normal")

    def reload_eq(self):
        if self._eq_busy:
            return
        self._set_eq_info(read_speaker_eq_snapshot(), force=True)
        self._eq_dirty = False
        self._update_eq_buttons()

    def apply_eq(self):
        self._run_eq_change(reset=False)

    def reset_eq(self):
        self._run_eq_change(reset=True)

    def _run_eq_change(self, reset=False):
        if self._eq_busy or not self._eq_info.get("available"):
            return
        if self._eq_stale:
            self.eq_status.configure(text="Reload the changed profile before applying.", fg=GOLD)
            return
        if reset and not (AUDIO_EQ_BASELINE.exists() or AUDIO_EQ_BASELINE.is_symlink()):
            self.eq_status.configure(text="Apply a curve once to save the original curve first.", fg=GOLD)
            return
        action = "reset speaker EQ to its saved original curve" if reset else "apply speaker EQ changes"
        if not self.app.require_ops_gate(action):
            return
        prompt = ("Restore the speaker profile saved before the first EQ change?\n\n"
                  "If PipeWire is active, audio output may pause briefly while it restarts."
                  if reset else
                  "Apply these five EQ bands to the speaker profile?\n\n"
                  "If PipeWire is active, audio output may pause briefly while it restarts. "
                  "Notifications on the same output pause too.")
        if not messagebox.askyesno("Speaker EQ", prompt, parent=self.app.root):
            return
        gains = {name: float(scale.get()) for name, scale in self.eq_scale_widgets.items()}
        expected_hash = self._eq_loaded_hash
        self._eq_busy = True
        self.eq_status.configure(text="Applying profile…", fg=FG_MUTED)
        self._update_eq_buttons()
        self.app.console.log(f"$ {action}", TEAL)

        def work():
            try:
                return {"ok": True, **apply_speaker_eq(gains, expected_hash, reset=reset)}
            except Exception as exc:
                return {"ok": False, "error": str(exc)}

        def done(result):
            self._eq_busy = False
            if result.get("ok"):
                self.app.console.log(result["message"], PINE)
                values = result["values"]
                info = {"available": True, "gains": values["gains"], "mult": values["mult"],
                        "sha256": result["sha256"], "error": ""}
                if self.alive():
                    self._eq_dirty = False
                    self._set_eq_info(info, force=True)
                    self._update_eq_buttons()
                    if not result.get("active"):
                        self.eq_status.configure(text=result["message"], fg=GOLD)
                    self.kick(self.NAME)
            else:
                self.app.console.log(result.get("error", "speaker EQ change failed"), ROSE)
                if self.alive():
                    if "changed outside this panel" in result.get("error", ""):
                        self._eq_stale = True
                    self.eq_status.configure(text=result.get("error", "EQ change failed"), fg=GOLD)
                    self._update_eq_buttons()

        self.app.bg(work, done)

    def destroy(self):
        # Tcl variable cleanup calls into Tk. Release these references here on
        # the UI thread before a stopped poll worker can release the view.
        super().destroy()
        self.eq_scale_widgets.clear()
        self.level_var = None


class StatusView(TileView):
    NAME = "status"
    EVERY = 15000

    def build(self):
        super().build()
        self.poll('status-calendar-live', 2000, self.calendar_status, self.apply_calendar_status)
        self.poll('status-lt-live', 5000,
                  lambda: lt_status_text(read_lt_board()), self.apply_lt_status)
        tile = self.labels['calendar'].master
        ui.button(tile, 'Check events / to-dos', command=lambda: self.app.select('Calendar'),
                  font=self.app.f.small, bg=OVERLAY, fg=TEAL, hover_bg=BG,
                  padx=12, pady=5).pack(anchor='w', padx=10, pady=(0, 8))
        lt_tile = self.labels['lt'].master
        ui.button(lt_tile, 'Open personal LT board', command=lambda: self.app.select('LT'),
                  font=self.app.f.small, bg=OVERLAY, fg=TEAL, hover_bg=BG,
                  padx=12, pady=5).pack(anchor='w', padx=10, pady=(0, 8))
        audio_tile = self.labels['audio'].master
        ui.button(audio_tile, 'Open audio controls', command=lambda: self.app.select('Audio'),
                  font=self.app.f.small, bg=OVERLAY, fg=TEAL, hover_bg=BG,
                  padx=12, pady=5).pack(anchor='w', padx=10, pady=(0, 8))

    def calendar_status(self):
        try:
            data = CalendarView.request('/api/calendar')
            rows = calendar_status_lines(data.get('items', []))
            return '\n'.join(rows) if rows else 'nothing scheduled'
        except Exception:
            return 'calendar unavailable · local Hub not responding'

    def apply_calendar_status(self, text):
        color = self.color_for('calendar', text)
        self._apply_one('calendar', text, color)

    def apply_lt_status(self, text):
        self._apply_one('lt', text, self.color_for('lt', text))
    TILES = [
        (0, 0, "dns", "DNS"), (0, 1, "break", "Break timer"),
        (1, 0, "disk", "Disk"), (1, 1, "services", "Failed services"),
        (2, 0, "uptime", "Uptime / load"), (2, 1, "selfheal", "Self-heal (arc-heal)"),
        (3, 0, "idsips", "IDS/IPS"), (3, 1, "calendar", "Calendar · events / to-dos"),
        (4, 0, "awslab", "AWS lab (gvm / soclab / wazuh)"), (4, 1, "inventory", "Inventory (arc inv)"),
        (5, 0, "notify", "Notify stack (voice · bubbles · site)"),
        (5, 1, "waydroid", "Waydroid · Android sandbox"),
        (6, 0, "lt", "LT · personal board"), (6, 1, "audio", "Sound output"),
    ]

    def checks(self):
        r = self.app.runner.run

        def dns():
            ok, out = r("arc dns status", timeout=10)
            line = next((l for l in out.splitlines() if "mode:" in l), "")
            return line.split("mode:")[-1].strip() if line else (out[:60] or "unavailable")

        def brk():
            ok, out = r("arc-break-taskbar --status", timeout=5)
            return out.strip() if ok else 'Taskbar timer unavailable'

        def disk():
            ok, out = r("df -h / --output=used,avail,pcent", timeout=8)
            lines = out.splitlines()
            return lines[-1].strip() if len(lines) > 1 else "unavailable"

        def services():
            _, a = r("systemctl --failed --no-legend", timeout=8)
            _, b = r("systemctl --user --failed --no-legend", timeout=8)
            n = len([l for l in (a + "\n" + b).splitlines() if l.strip()])
            return f"{n} failed" if n else "all healthy"

        def uptime():
            ok, out = r("uptime -p && uptime | grep -oP 'load average: \\K.*'", timeout=8)
            return out.replace("\n", "  ·  ") or "unavailable"

        def selfheal():
            # A plain read of arc-heal's last result, not a fresh run (that's 20s+ and cron already
            # runs it every 3h) -- keeps the 15s refresh cheap.
            try:
                text = HEAL_LOG_PATH.read_text()
            except Exception:
                return "no runs on record yet"
            ts = re.search(r"— (\d{8}T\d{6}Z)", text)
            sm = re.search(r"Run took .*", text)
            summary = sm.group(0) if sm else "unrecognized log format"
            if not ts:
                return summary
            epoch = calendar.timegm(time.strptime(ts.group(1), "%Y%m%dT%H%M%SZ"))
            return f"{summary}  ·  {fmt_age(max(0, (time.time() - epoch) / 60))}"

        def idsips():
            _, sur = r("systemctl is-active suricata", timeout=5)
            ok1, sag = r("docker inspect --format '{{.State.Status}}' sagan", timeout=5)
            ok2, eve = r("docker inspect --format '{{.State.Status}}' evebox", timeout=5)
            return (f"suricata {sur.strip() or 'unknown'}  ·  sagan {sag.strip() if ok1 else 'missing'}"
                    f"  ·  evebox {eve.strip() if ok2 else 'missing'}")

        def awslab():
            return self.app.cloudlab.snapshot()

        def inventory():
            return InventoryData.summary(InventoryData.load())

        def notify():
            _, out = r("systemctl --user is-active arc-pined arc-pine-bubbles notes-site", timeout=8)
            s = out.split()
            names = ["voice", "bubbles", "site"]
            if len(s) != 3:
                return "unavailable"
            return "  ·  ".join(f"{n} {'ok' if v == 'active' else v}" for n, v in zip(names, s))

        def waydroid():
            ok, out = r("arc-waydroid status", timeout=12)
            if not ok:
                return "status unavailable"
            service = re.search(r"^Container service: (.+)$", out, re.MULTILINE)
            if not service:
                return "status unavailable"
            if service.group(1) == "stopped":
                return "stopped · manual start"
            session = re.search(r"^Session: (.+)$", out, re.MULTILINE)
            weston = re.search(r"^Khaos Weston window: (.+)$", out, re.MULTILINE)
            detail = f"Android {session.group(1).lower()}" if session else "Android status unknown"
            if weston:
                detail += f" · Weston {weston.group(1)}"
            return f"container {service.group(1)} · {detail}"

        def lt_board():
            return lt_status_text(read_lt_board())

        def audio():
            return audio_status_line(read_audio_snapshot(r))

        return {"dns": dns, "break": brk, "disk": disk, "services": services, "uptime": uptime,
                "selfheal": selfheal, "idsips": idsips,
                "awslab": awslab, "inventory": inventory, "notify": notify, "waydroid": waydroid,
                "lt": lt_board, "audio": audio}

    def color_for(self, key, val):
        if key == "services":
            return ROSE if "failed" in val and not val.startswith("0 ") and val != "all healthy" else FG
        if key == "selfheal":
            fl, he = re.search(r"(\d+) flagged", val), re.search(r"(\d+) healed", val)
            if fl and int(fl.group(1)) > 0:
                return ROSE
            if he and int(he.group(1)) > 0:
                return TEAL
            return FG
        if key == "idsips":
            # exact-word checks: "inactive" contains "active"
            return TEAL if "suricata active" in val and val.count("running") == 2 else ROSE
        if key == "notify":
            return TEAL if val.count(" ok") == 3 else ROSE
        if key == "calendar":
            if "OVERDUE" in val:
                return ROSE
            if "unavailable" in val:
                return FG_MUTED
            return TEAL if val and val != "nothing scheduled" else FG_MUTED
        if key == "waydroid":
            if val.startswith("container running"):
                return TEAL
            if val.startswith("stopped"):
                return GOLD
            return ROSE
        if key == "lt":
            if "unavailable" in val:
                return ROSE
            return TEAL if " pending" in val else FG_MUTED
        if key == "audio":
            if "unavailable" in val:
                return FG_MUTED
            if "muted" in val:
                return GOLD
            return TEAL
        return FG


class CalendarView(View):
    scrollable = True

    def build(self):
        self.signature = None
        self.latest_update = ''
        self.busy = False
        self.checks = []
        tk.Label(self.frame, text='Events & to-dos', bg=SURFACE, fg=FG,
                 font=self.app.f.label).pack(anchor='w', padx=16, pady=(14, 7))
        tk.Label(self.frame, text='Appointments, events, and to-dos stay grouped. Repeating tasks are checked one occurrence at a time; completed items can be tucked away without deleting them.',
                 wraplength=520, justify='left', bg=SURFACE, fg=FG_MUTED).pack(anchor='w', padx=16)
        ui.button(self.frame, 'Open Khaos Hub', command=lambda: webbrowser.open('http://127.0.0.1:8766/'),
                  font=self.app.f.small, bg=OVERLAY, fg=TEAL, hover_bg=BG,
                  padx=13, pady=5).pack(anchor='w', padx=16, pady=9)
        self.message = tk.Label(self.frame, text='Loading calendar…', bg=SURFACE, fg=FG_MUTED)
        self.message.pack(anchor='w', padx=16)
        self.rows = tk.Frame(self.frame, bg=SURFACE)
        self.rows.pack(fill='both', expand=True, padx=16, pady=8)
        self.show_completed = tk.BooleanVar(value=False)
        self.expanded_groups = {'To-dos'}
        self.expanded_rows = set()
        self.poll('calendar-live', 2000, self.read_calendar, self.apply_calendar)

    def _set_checks_enabled(self, enabled):
        for check in self.checks:
            try:
                check.configure(state='normal' if enabled else 'disabled')
            except tk.TclError:
                pass

    @staticmethod
    def request(path, data=None, token=None):
        headers = {'Origin': 'http://127.0.0.1:8766'}
        if token:
            headers['X-Hub-Token'] = token
        if data is not None:
            headers['Content-Type'] = 'application/json'
        request = urllib.request.Request('http://127.0.0.1:8766' + path,
                  data=json.dumps(data).encode() if data is not None else None, headers=headers)
        with urllib.request.urlopen(request, timeout=3) as response:
            return json.load(response)

    def read_calendar(self):
        try:
            return self.request('/api/calendar')
        except Exception:
            return {'error': 'Local Hub calendar unavailable. Orage remains available from System.'}

    def apply_calendar(self, data):
        if not self.alive() or self.busy:
            return
        if 'error' in data:
            self.message.configure(text=data['error'], fg=ROSE)
            self._set_checks_enabled(False)
            self.signature = None
            return
        if data.get('updated', '') < self.latest_update:
            return
        self.latest_update = data.get('updated', '')
        self.message.configure(text='Live · updates every 2 seconds', fg=TEAL)
        signature = json.dumps(data['items'], sort_keys=True)
        if signature == self.signature:
            return
        self.signature = signature
        for widget in self.rows.winfo_children():
            widget.destroy()
        self.checks = []
        items = data['items']
        active_items = [item for item in items if not item['done']]
        done_items = [item for item in items if item['done']]
        grouped = [('To-dos', [i for i in active_items if i['kind'] == 'To-do']),
                   ('Appointments', [i for i in active_items if i['kind'] == 'Appointment']),
                   ('Events', [i for i in active_items if i['kind'] == 'Event'])]
        for heading, group in grouped:
            expanded = heading in self.expanded_groups
            ui.button(self.rows, f"{'−' if expanded else '+'}  {heading}  ·  {len(group)}",
                      command=lambda h=heading: self._toggle_group(data, h),
                      font=self.app.f.label, bg=SURFACE, fg=FG,
                      hover_bg=OVERLAY, padx=4, pady=5).pack(anchor='w', pady=(10, 2))
            visible = group if heading in self.expanded_rows else group[:10]
            if expanded:
                if group:
                    for item in visible:
                        self._calendar_row(item)
                else:
                    tk.Label(self.rows, text='Nothing scheduled in this two-week window.',
                             bg=SURFACE, fg=FG_MUTED, font=self.app.f.small).pack(anchor='w', padx=4, pady=5)
            if expanded and len(group) > 10:
                ui.button(self.rows, f"{'Show fewer' if heading in self.expanded_rows else f'Show all · {len(group)-10} more'}",
                          command=lambda h=heading: self._toggle_all_rows(data, h),
                          font=self.app.f.small, bg=SURFACE, fg=FG_MUTED,
                          hover_bg=OVERLAY, padx=4, pady=4).pack(anchor='w', pady=(2, 5))
        if done_items:
            ui.button(self.rows, f"{'Hide' if self.show_completed.get() else 'Show'} completed  ·  {len(done_items)}",
                      command=lambda: self._toggle_completed(data), font=self.app.f.small,
                      bg=OVERLAY, fg=FG_MUTED, hover_bg=BG, padx=10, pady=4).pack(anchor='w', pady=(14, 4))
            if self.show_completed.get():
                visible_done = done_items if 'Completed' in self.expanded_rows else done_items[:10]
                for item in visible_done:
                    self._calendar_row(item)
                if len(done_items) > 10:
                    ui.button(self.rows, f"{'Show fewer' if 'Completed' in self.expanded_rows else f'Show all completed · {len(done_items)-10} more'}",
                              command=lambda: self._toggle_all_rows(data, 'Completed'),
                              font=self.app.f.small, bg=SURFACE, fg=FG_MUTED,
                              hover_bg=OVERLAY, padx=4, pady=4).pack(anchor='w', pady=(2, 5))
        if not active_items and not done_items:
            self.message.configure(text='Nothing scheduled in the next two weeks.')
        elif not active_items:
            self.message.configure(text='All caught up. Completed items are tucked away below.')
        self.app.refresh_scroll(self.frame)

    def _toggle_completed(self, data):
        self.show_completed.set(not self.show_completed.get())
        # Force a render without waiting for the next poll.
        self.signature = None
        self.apply_calendar(data)

    def _toggle_group(self, data, name):
        if name in self.expanded_groups:
            self.expanded_groups.remove(name)
        else:
            self.expanded_groups.add(name)
        self.signature = None
        self.apply_calendar(data)

    def _toggle_all_rows(self, data, name):
        if name in self.expanded_rows:
            self.expanded_rows.remove(name)
        else:
            self.expanded_rows.add(name)
        self.signature = None
        self.apply_calendar(data)

    def _calendar_row(self, item):
            value = tk.BooleanVar(value=item['done'])
            body = tk.Frame(self.rows, bg=SURFACE)
            body.pack(fill='x', anchor='w', pady=(2, 0), padx=2)
            line = tk.Frame(body, bg=SURFACE)
            line.pack(fill='x', padx=3, pady=(4, 0))
            check = tk.Checkbutton(line, text=item['title'], variable=value,
                      command=lambda i=item, v=value: self.toggle(i, v),
                      bg=SURFACE, fg=FG, selectcolor=BG, activebackground=SURFACE,
                      activeforeground=TEAL, anchor='w', justify='left', wraplength=420,
                      font=self.app.f.label, padx=5, pady=4, relief='flat', bd=0)
            check.pack(side='left', fill='x', expand=True)
            kind = str(item['kind']).upper()
            badge = tk.Label(line, text=kind, font=self.app.f.small,
                             bg=SURFACE, fg=GOLD if 'APPOINTMENT' in kind or 'EVENT' in kind else TEAL)
            badge.pack(side='right', padx=(8, 2))
            tk.Label(body, text=item['when'] + ('  ·  repeats' if item.get('repeating') else ''), bg=SURFACE, fg=FG_MUTED,
                     font=self.app.f.small, anchor='w', wraplength=460,
                     justify='left').pack(anchor='w', padx=45, pady=(0, 6))
            tk.Frame(body, bg=BORDER, height=1).pack(fill='x', padx=5)
            check._value = value
            self.checks.append(check)

    def toggle(self, item, value):
        if self.busy:
            value.set(item['done'])
            return
        self.busy = True
        self.message.configure(text='Saving…')
        desired = value.get()
        self._set_checks_enabled(False)
        def save():
            try:
                token = self.request('/api/session')['token']
                result = self.request('/api/calendar/check',
                       {'id': item['id'], 'done': desired, 'revision': item['revision']}, token)
            except Exception:
                result = {'error': 'Change not saved. Refresh and retry; another view may have changed it.'}
            self.app.bridge.post(self.saved, result)
        threading.Thread(target=save, daemon=True).start()

    def saved(self, data):
        self.busy = False
        if not self.alive():
            return
        self.signature = None
        if 'error' in data:
            self.message.configure(text=data['error'], fg=ROSE)
            self.kick('calendar-live')
        else:
            self.apply_calendar(data)

    def refresh(self):
        self.kick('calendar-live')


class LtView(View):
    """A live window onto the existing local lt board and its own CLI actions."""

    scrollable = True
    EVERY = 5000

    def build(self):
        f = self.app.f
        self.signature = None
        self.state = {"available": False, "focus": "", "pending": [], "done": [], "note": ""}

        hero, body = ui.rounded_frame(self.frame, SURFACE, bg=BG, radius=16)
        hero.pack(fill="x", pady=(0, 10))
        accent = tk.Frame(body, bg=self.app.phase_accent, height=2)
        accent.pack(fill="x")
        self.app.phase_lines.append(accent)
        tk.Label(body, text="lt  ·  architect-of-chaos", font=f.big, bg=BG, fg=FG,
                 anchor="w").pack(fill="x", padx=16, pady=(13, 2))
        tk.Label(body, text="PERSONAL BOARD  ·  live from ~/.local/share/lt", font=f.small,
                 bg=BG, fg=self.app.phase_accent, anchor="w").pack(fill="x", padx=16, pady=(0, 10))

        focus_card, focus = ui.rounded_frame(self.frame, SURFACE, bg=OVERLAY, radius=14)
        focus_card.pack(fill="x", pady=(0, 9))
        tk.Label(focus, text="IN FOCUS", font=f.small, bg=OVERLAY, fg=FG_MUTED,
                 anchor="w").pack(fill="x", padx=14, pady=(10, 2))
        self.focus_label = tk.Label(focus, text="loading…", font=f.label, bg=OVERLAY,
                                    fg=FG, anchor="w", justify="left", wraplength=640)
        self.focus_label.pack(fill="x", padx=14, pady=(0, 10))
        focus.bind("<Configure>", lambda e: self.focus_label.configure(
            wraplength=max(e.width - 32, 120)), add="+")

        self.counts = tk.Label(self.frame, text="", font=f.small, bg=SURFACE, fg=TEAL,
                               anchor="w")
        self.counts.pack(fill="x", padx=4, pady=(1, 7))
        self.queue = tk.Frame(self.frame, bg=SURFACE)
        self.queue.pack(fill="x", pady=(0, 8))

        actions = tk.Frame(self.frame, bg=SURFACE)
        actions.pack(fill="x", pady=(3, 8))
        self.complete_button = ui.button(actions, "Mark focus done", command=self.confirm_done,
                                         font=f.small, bg=OVERLAY, fg=GOLD, hover_bg=BG,
                                         padx=12, pady=7)
        self.complete_button.pack(side="left", padx=(0, 7))
        ui.button(actions, "Refresh", command=lambda: self.kick("lt-board-live"),
                  font=f.small, bg=OVERLAY, fg=TEAL, hover_bg=BG,
                  padx=12, pady=7).pack(side="right")

        add_row = tk.Frame(self.frame, bg=SURFACE)
        add_row.pack(fill="x", pady=(0, 8))
        self.add_var = tk.StringVar()
        self.add_entry = tk.Entry(add_row, textvariable=self.add_var, font=f.label,
                                  bg=OVERLAY, fg=FG, insertbackground=FG, relief="flat",
                                  highlightthickness=1, highlightbackground=BORDER,
                                  highlightcolor=TEAL)
        self.add_entry.pack(side="left", fill="x", expand=True, ipady=7, padx=(0, 8))
        self.add_entry.bind("<Return>", lambda _e: self.add_task())
        self.add_button = ui.button(add_row, "Add task", command=self.add_task,
                                    font=f.small, bg=OVERLAY, fg=TEAL, hover_bg=BG,
                                    padx=12, pady=7)
        self.add_button.pack(side="right")

        self.note_label = tk.Label(self.frame, text="", font=f.small, bg=SURFACE,
                                   fg=FG_MUTED, anchor="w", justify="left", wraplength=660)
        self.note_label.pack(fill="x", padx=4, pady=(4, 8))
        tk.Label(self.frame, text="The panel reads the same local board and delegates changes to `lt`; it keeps no second copy.",
                 font=f.small, bg=SURFACE, fg=FG_MUTED, anchor="w", justify="left",
                 wraplength=680).pack(fill="x", padx=4, pady=(4, 10))
        self.poll("lt-board-live", self.EVERY, read_lt_board, self.apply_board)
        self.kick("lt-board-live")

    def apply_board(self, board):
        if not self.alive():
            return
        signature = json.dumps(board, ensure_ascii=False, sort_keys=True)
        if signature == self.signature:
            return
        self.signature = signature
        self.state = board
        if not board.get("available"):
            self.focus_label.configure(
                text=board.get("error") or "No local lt board was found yet. Open `lt` once to initialize it.",
                fg=ROSE if board.get("error") else FG_MUTED)
            self.counts.configure(text="LT data is missing or unreadable · no files were created by this view.",
                                  fg=ROSE if board.get("error") else FG_MUTED)
            self.complete_button.set_enabled(False)
            self.add_button.set_enabled(False)
            self.note_label.configure(text="")
            for widget in self.queue.winfo_children():
                widget.destroy()
            self.app.refresh_scroll(self.frame)
            return

        focus = board.get("focus", "")
        pending, done = board.get("pending", []), board.get("done", [])
        self.focus_label.configure(text=focus or "No focus set", fg=FG if focus else FG_MUTED)
        self.counts.configure(text=f"{len(pending)} pending  ·  {len(done)} completed", fg=TEAL)
        self.complete_button.set_enabled(bool(focus and focus in pending))
        self.add_button.set_enabled(True)

        for widget in self.queue.winfo_children():
            widget.destroy()
        if pending:
            tk.Label(self.queue, text="UP NEXT", font=self.app.f.small, bg=SURFACE,
                     fg=FG_MUTED, anchor="w").pack(fill="x", pady=(3, 3))
            for item in pending[:8]:
                marker = "→" if item == focus else "·"
                color = self.app.phase_accent if item == focus else FG
                row = tk.Frame(self.queue, bg=OVERLAY)
                row.pack(fill="x", pady=2)
                tk.Label(row, text=marker, font=self.app.f.label, bg=OVERLAY, fg=color,
                         width=2).pack(side="left", padx=(7, 2), pady=5)
                tk.Label(row, text=item or "(empty task)", font=self.app.f.label,
                         bg=OVERLAY, fg=color, anchor="w", justify="left", wraplength=650
                         ).pack(side="left", fill="x", expand=True, padx=(0, 9), pady=5)
            if len(pending) > 8:
                tk.Label(self.queue, text=f"+ {len(pending) - 8} more · run `lt tasks` for the full list",
                         font=self.app.f.small, bg=SURFACE, fg=FG_MUTED,
                         anchor="w").pack(fill="x", pady=(3, 1))
        else:
            tk.Label(self.queue, text="All clear · no pending tasks", font=self.app.f.small,
                     bg=SURFACE, fg=FG_MUTED, anchor="w").pack(fill="x", pady=5)

        note = board.get("note", "")
        self.note_label.configure(text=f"LATEST NOTE  ·  {note}" if note else "")
        self.app.refresh_scroll(self.frame)

    def confirm_done(self):
        focus = self.state.get("focus", "")
        if not focus or focus not in self.state.get("pending", []):
            self.app.console.log("current focus is not a pending LT task; nothing changed", GOLD)
            return
        dialog = Dialog(self.app, "complete LT task")
        dialog.label(f"Mark this task complete and advance focus?\n\n{focus}",
                     fg=GOLD, font=self.app.f.small, wrap=520, pady=(4, 14))
        cmd = shlex.join([LT_COMMAND, "done"])
        def complete_if_current():
            latest = read_lt_board()
            if latest.get("focus") != focus or focus not in latest.get("pending", []):
                self.apply_board(latest)
                self.app.console.log("LT changed while the confirmation was open; refreshed without completing anything", GOLD)
                return
            self.app.run_async(cmd, timeout=10,
                               on_done=lambda: self.kick("lt-board-live"))

        dialog.buttons([("complete task", GOLD, complete_if_current),
                        ("cancel", FG_MUTED, None)])

    def add_task(self):
        task = self.add_var.get().strip()
        if not task:
            self.app.console.log("enter a short task before adding it to LT", GOLD)
            self.add_entry.focus_set()
            return
        if len(task) > 180 or any(ord(ch) < 32 or 127 <= ord(ch) <= 159 for ch in task):
            self.app.console.log("LT tasks must be 180 characters or fewer and contain no control characters", ROSE)
            self.add_entry.focus_set()
            return
        cmd = shlex.join([LT_COMMAND, "do", task])
        if not self.app.require_ops_gate(cmd):
            return
        self.add_button.set_enabled(False)

        def added():
            self.add_var.set("")
            self.add_button.set_enabled(True)
            self.kick("lt-board-live")

        self.app.run_async(cmd, timeout=10, on_done=added)


class CommandsView(View):
    """Complete, guarded access to commands not represented by dedicated controls."""

    scrollable = True

    def build(self):
        f = self.app.f
        self.mode = "arc"
        self.catalog_rows = []
        self.filtered_rows = []
        self.signature = None

        hero_shell, hero = ui.rounded_frame(self.frame, SURFACE, bg=BG, radius=16)
        hero_shell.pack(fill="x", pady=(0, 10))
        accent = tk.Frame(hero, bg=self.app.phase_accent, height=2)
        accent.pack(fill="x")
        self.app.phase_lines.append(accent)
        tk.Label(hero, text="COMMAND DECK", font=f.small, bg=BG,
                 fg=self.app.phase_accent, anchor="w").pack(fill="x", padx=15, pady=(12, 2))
        tk.Label(hero, text="Every `arc` and `lt` command, in one guarded place.",
                 font=f.big, bg=BG, fg=FG, anchor="w", wraplength=680,
                 justify="left").pack(fill="x", padx=15, pady=(0, 12))

        modes = tk.Frame(self.frame, bg=SURFACE)
        modes.pack(fill="x", pady=(0, 8))
        self.mode_buttons = {}
        for name in ("arc", "lt"):
            self.mode_buttons[name] = ui.button(
                modes, name.upper(), command=lambda n=name: self.set_mode(n),
                font=f.small, bg=OVERLAY, fg=TEAL, hover_bg=BG, padx=14, pady=6)
            self.mode_buttons[name].pack(side="left", padx=(0, 7))

        tk.Label(self.frame, text="Find a documented command", font=f.small, bg=SURFACE,
                 fg=FG_MUTED, anchor="w").pack(fill="x", padx=3, pady=(4, 3))
        self.filter_var = tk.StringVar()
        self.filter_entry = tk.Entry(self.frame, textvariable=self.filter_var, font=f.small,
                                      bg=OVERLAY, fg=FG, insertbackground=FG, relief="flat",
                                      highlightthickness=1, highlightbackground=BORDER,
                                      highlightcolor=TEAL)
        self.filter_entry.pack(fill="x", ipady=6, pady=(0, 7))
        self.filter_var.trace_add("write", lambda *_: self.filter_catalog())

        list_frame = tk.Frame(self.frame, bg=SURFACE)
        list_frame.pack(fill="both", expand=True, pady=(0, 8))
        self.catalog = tk.Listbox(list_frame, height=12, exportselection=False,
                                  bg=OVERLAY, fg=FG, selectbackground=BORDER,
                                  selectforeground=TEAL, activestyle="none",
                                  font=f.small, relief="flat", highlightthickness=0)
        self.catalog.pack(side="left", fill="both", expand=True)
        scroll = ui.PillScrollbar(list_frame, orient="vertical", command=self.catalog.yview,
                                  bg=OVERLAY, troughcolor=BG, activebackground=TEAL,
                                  bd=0, highlightthickness=0, width=13)
        scroll.pack(side="right", fill="y")
        self.catalog.configure(yscrollcommand=scroll.set)
        self.catalog.bind("<<ListboxSelect>>", self.use_selected)
        self.catalog.bind("<Double-Button-1>", self.use_selected)

        tk.Label(self.frame, text="Command line  ·  shell operators are never evaluated",
                 font=f.small, bg=SURFACE, fg=FG_MUTED, anchor="w").pack(fill="x", padx=3, pady=(2, 3))
        self.command_var = tk.StringVar()
        self.command_entry = tk.Entry(self.frame, textvariable=self.command_var, font=f.label,
                                      bg=OVERLAY, fg=FG, insertbackground=FG, relief="flat",
                                      highlightthickness=1, highlightbackground=BORDER,
                                      highlightcolor=TEAL)
        self.command_entry.pack(fill="x", ipady=8, pady=(0, 8))
        self.command_entry.bind("<Return>", lambda _e: self.confirm_command())

        actions = tk.Frame(self.frame, bg=SURFACE)
        actions.pack(fill="x", pady=(0, 6))
        ui.button(actions, "Run in panel", command=lambda: self.confirm_command("panel"),
                  font=f.small, bg=OVERLAY, fg=TEAL, hover_bg=BG,
                  padx=12, pady=7).pack(side="left", padx=(0, 7))
        ui.button(actions, "Open in terminal", command=lambda: self.confirm_command("terminal"),
                  font=f.small, bg=OVERLAY, fg=GOLD, hover_bg=BG,
                  padx=12, pady=7).pack(side="left")
        ui.button(actions, "Refresh catalog", command=lambda: self.set_mode(self.mode),
                  font=f.small, bg=OVERLAY, fg=FG_MUTED, hover_bg=BG,
                  padx=12, pady=7).pack(side="right")
        tk.Label(self.frame, text="Every command is confirmed and checked against the session SOP gate. Use the terminal for prompts, long jobs, and commands that may restart or shut down the workstation.",
                 font=f.small, bg=SURFACE, fg=FG_MUTED, anchor="w", justify="left",
                 wraplength=680).pack(fill="x", padx=3, pady=(3, 10))
        self.set_mode("arc")

    def set_mode(self, mode="arc"):
        if mode not in ("arc", "lt"):
            mode = self.mode
        self.mode = mode
        for name, button in self.mode_buttons.items():
            button.set_look(bg=OVERLAY if name == mode else SURFACE,
                            fg=self.app.phase_accent if name == mode else FG_MUTED)
        self.filter_var.set("")
        self.catalog.delete(0, "end")
        if mode == "lt":
            self.catalog_rows = [(usage, desc, self._template(usage))
                                 for usage, desc in LT_COMMAND_CATALOG]
            self.filter_catalog()
            return
        self.catalog_rows = []
        self.catalog.insert("end", "Loading arc help index…")
        self.app.bg(self._load_arc_catalog, self._apply_arc_catalog)

    @staticmethod
    def _template(usage):
        try:
            tokens = shlex.split(usage)
        except ValueError:
            return usage
        clean = []
        needs_arg = False
        for token in tokens:
            if token.startswith(("<", "[")) or any(mark in token for mark in ("|", "/")):
                needs_arg = True
                break
            clean.append(token)
        template = shlex.join(clean)
        return template + (" " if needs_arg and template else "")

    def _load_arc_catalog(self):
        return self.app.runner.run("arc help all", timeout=12)

    def _apply_arc_catalog(self, result):
        if not self.alive() or self.mode != "arc":
            return
        ok, output = result
        self.catalog_rows = parse_arc_catalog(output) if ok else []
        if not self.catalog_rows:
            self.catalog.delete(0, "end")
            self.catalog.insert("end", "Arc help index unavailable · enter an arc command below")
            self.app.console.log(output or "arc help all returned no command entries", GOLD)
            return
        self.filter_catalog()

    def filter_catalog(self):
        if not hasattr(self, "catalog"):
            return
        query = self.filter_var.get().strip().lower()
        self.filtered_rows = [row for row in self.catalog_rows
                              if not query or query in " ".join(row).lower()]
        self.catalog.delete(0, "end")
        for usage, description, _command in self.filtered_rows:
            self.catalog.insert("end", f"{usage}  ·  {description}")

    def use_selected(self, _event=None):
        selected = self.catalog.curselection()
        if not selected or selected[0] >= len(self.filtered_rows):
            return
        template = self.filtered_rows[selected[0]][2]
        self.command_var.set(template)
        self.command_entry.focus_set()
        self.command_entry.icursor("end")

    def confirm_command(self, destination=None):
        raw = self.command_var.get().strip()
        if not raw:
            self.app.console.log("choose a command or enter an arc/lt command first", GOLD)
            self.command_entry.focus_set()
            return
        if len(raw) > 2048 or any(ord(ch) < 32 or 127 <= ord(ch) <= 159 for ch in raw):
            self.app.console.log("command must be 2,048 characters or fewer and contain no control characters", ROSE)
            return
        try:
            argv = shlex.split(raw, posix=True)
        except ValueError as exc:
            self.app.console.log(f"command quoting error: {exc}", ROSE)
            return
        if not argv or argv[0] not in COMMAND_FAMILIES:
            self.app.console.log("only arc, lt, and the two documented arc-dns profiles can run here", ROSE)
            return
        if len(argv) > 64 or not shutil.which(argv[0]):
            self.app.console.log("command is too long or its arc/lt executable is unavailable", ROSE)
            return
        cmd = shlex.join(argv)
        if not self.app.require_ops_gate(cmd):
            return
        terminal_only = tuple(argv[:3]) in TERMINAL_ONLY_COMMANDS
        if terminal_only and destination == "panel":
            self.app.console.log("this command may display a private connection URL; run it in Konsole instead", GOLD)
            return
        dialog = Dialog(self.app, "confirm command", resizable=True)
        dialog.label("Run this command? It will use the existing arc/lt behavior.",
                     fg=FG_MUTED, font=self.app.f.small, wrap=600, pady=(4, 6))
        dialog.label(cmd, fg=GOLD, font=self.app.f.mono, wrap=620, pady=(0, 14))
        choices = []
        if destination in (None, "panel") and not terminal_only:
            choices.append(("run in panel", TEAL,
                            lambda: self.app.run_async(cmd, timeout=120)))
        if destination in (None, "terminal"):
            choices.append(("open in terminal", GOLD,
                            lambda args=argv: self.open_terminal(args)))
        choices.append(("cancel", FG_MUTED, None))
        dialog.buttons(choices)

    def open_terminal(self, argv):
        if not self.app.require_ops_gate(shlex.join(argv)):
            return
        terminal = shutil.which("konsole")
        if not terminal:
            self.app.console.log("Konsole is unavailable; use Run in panel for short non-interactive commands", ROSE)
            return
        command = shlex.join([terminal, "--hold", "-e", *argv])
        self.app.ensure_console_room()
        self.app.console.log(f"$ {shlex.join(argv)}  (opens in Konsole)", TEAL)
        ok, message = self.app.runner.detach(command)
        self.app.console.log(f"[{'ok' if ok else 'failed'}] {message}", PINE if ok else ROSE)


class CockpitView(TileView):
    NAME = "cockpit"
    EVERY = 60000
    TILES = [
        (0, 0, "vpn", "VPN (ProtonVPN)"), (0, 1, "dns", "DNS + leak check"),
        (1, 0, "netstats", "Network (wlan0, since boot)"), (1, 1, "eero", "Eero"),
        (2, 0, "cloudlab", "Cloud lab (gvm / soclab / wazuh)"), (2, 1, "kismet", "Kismet (wireless recon)"),
        (3, 0, "tailscale", "Tailscale (remote access)"), (3, 1, "site", "Private notes site"),
    ]

    def checks(self):
        r = self.app.runner.run

        def vpn():
            # 2026-09-22, user's follow-up: "add additional details for vpn and dns info...
            # place/point of current connection." `arc vpn status` already returns Server/
            # Protocol/Load -- this tile was discarding all three, showing only the bare
            # "Connected" word. Server is the actual point of connection (ProtonVPN's own
            # naming, e.g. "US-FREE#22 in Seattle, United States").
            ok, out = r("arc vpn status", timeout=20)
            status = re.search(r"Status:\s*(.+)", out)
            if not status:
                return out.strip()[:60] or "unavailable"
            head = status.group(1).strip()
            server = re.search(r"Server:\s*(.+)", out)
            protocol = re.search(r"Protocol:\s*(.+)", out)
            load = re.search(r"Load:\s*(.+)", out)
            if not server:
                return head  # disconnected -- no point of connection to show
            if protocol:
                head += f"  ·  {protocol.group(1).strip()}"
            line2 = server.group(1).strip()
            if load:
                line2 += f"  ·  {load.group(1).strip()} load"
            return f"{head}\n{line2}"

        def dns():
            # Same follow-up -- `query:` here was regex-captured as just the first token ("OK"),
            # silently dropping the "(<resolving IP>)" that arc dns check already prints right
            # next to it. That IP is DNS's own point-of-connection equivalent (which NextDNS
            # anycast edge actually answered), so it's worth keeping instead of throwing away.
            ok, out = r("arc dns check", timeout=20)
            d = re.search(r"daemon:\s*(\S+)", out)
            ro = re.search(r"routing:\s*(.+)", out)
            q = re.search(r"query:\s*(\S+)(?:\s*\(([^)]+)\))?", out)
            if d and q:
                qtext = q.group(1) + (f" ({q.group(2)})" if q.group(2) else "")
                return f"daemon {d.group(1)}  ·  query {qtext}\n{(ro.group(1).strip() if ro else '')[:60]}"
            return "unavailable"

        def netstats():
            ok, out = r("arc net stats", timeout=8)
            return next((l.strip() for l in out.splitlines() if "wlan0" in l), "") or "unavailable"

        def eero():
            ok, out = r("arc eero-summary", timeout=20)
            if "auth: ok" in out:
                d = {}
                for line in out.splitlines():
                    if ":" in line:
                        k, v = line.split(":", 1)
                        d[k.strip()] = v.strip()
                return (f"{d.get('internet', '?')}  ·  {d.get('clients', '?')} clients  ·  {d.get('nodes', '?')} node(s)"
                        f"\ndns {d.get('dns', '?')}  ·  {d.get('public_ip', '?')}")
            return "not signed in — arc eero" if "not signed in" in out else "unavailable"

        def cloudlab():
            return self.app.cloudlab.snapshot()

        def kismet():
            ok, out = r("arc kismet status", timeout=8)
            return strip_banner(out, cmd="arc kismet status") or "unavailable"

        def tailscale():
            ok, out = r("tailscale status --json", timeout=10)
            d = json.loads(out)
            me = d.get("Self", {})
            peers = list((d.get("Peer") or {}).values())
            on = [p for p in peers if p.get("Online")]
            off = [p.get("HostName", "?").strip() for p in peers if not p.get("Online")]
            head = f"{'online' if me.get('Online') else 'OFFLINE'}  ·  {len(on)}/{len(peers)} peers online"
            return head + (f"\noffline: {', '.join(off)}" if off else "")

        def site():
            ok, out = r("arc site", timeout=20)
            g = lambda k: (re.search(rf"^\s*{k}\s+(.+?)(?:\s{{2}}|$)", out, re.M) or [None, "?"])[1].strip()
            return f"server {g('server')}  ·  tailnet {g('tailnet')}  ·  funnel {g('funnel')}"

        return {"vpn": vpn, "dns": dns, "netstats": netstats, "eero": eero, "cloudlab": cloudlab,
                "kismet": kismet, "tailscale": tailscale, "site": site}

    def color_for(self, key, val):
        low = val.lower()
        if key == "vpn":
            return TEAL if "connected" in low and "disconnected" not in low else FG_MUTED
        if key == "dns":
            return ROSE if "unavailable" in low else FG
        if key == "eero":
            return ROSE if ("down" in low or "unavailable" in low) else FG
        if key == "tailscale":
            return ROSE if "unavailable" in low or "offline" in low.split("\n")[0] else (GOLD if "offline:" in low else TEAL)
        if key == "site":
            if "funnel off" not in low:
                return ROSE                       # anything but "off" = possible public exposure
            return TEAL if "server running" in low and "tailnet exposed" in low else FG_MUTED
        return FG


class InventoryView(View):
    """register vs reality (arc inv): counts, what needs attention, the
    unregistered queue, scan freshness, and a Scan button. Reads the generated
    inventory.json; drift rows provide guided review and a safe, read-only
    inspection action instead of guessing how to repair live state."""

    scrollable = True
    HEALTH_COLOR = {"ok": TEAL, "attention": GOLD, "drift": ROSE, "unknown": FG_MUTED, "info": FG_MUTED}
    ORDER = {"drift": 0, "attention": 1, "unknown": 2}

    def build(self):
        f = self.app.f
        top = tk.Frame(self.frame, bg=SURFACE)
        top.pack(fill="x", padx=4, pady=(4, 6))
        for text, fg, cmd, to in (("scan now", TEAL, "arc inv scan --quiet", 180), ("verify ledger", GOLD, "arc inv verify", 30),
                                  ("list all", GOLD, "arc inv list", 30), ("history", GOLD, "arc inv history", 30)):
            ui.button(top, text, command=lambda c=cmd, t=to: self.app.run_async(c, timeout=t, on_done=self.reload),
                      font=f.small, bg=OVERLAY, fg=fg, hover_bg=BG, padx=12, pady=5).pack(side="right", padx=3)
        # packed AFTER the buttons: when the row is narrow the label gets squeezed, never a button
        self.fresh = tk.Label(top, text="", font=f.small, bg=SURFACE, fg=FG_MUTED, anchor="w", justify="left")
        self.fresh.pack(side="left", fill="x", expand=True)
        top.bind("<Configure>", lambda e: self.fresh.configure(wraplength=max(e.width - 340, 120)))
        self.counts = tk.Frame(self.frame, bg=SURFACE)
        self.counts.pack(fill="x", padx=4, pady=(0, 6))
        self.body = tk.Frame(self.frame, bg=SURFACE)
        self.body.pack(fill="both", expand=True)
        self.poll("inventory-view", 30000, InventoryData.load, self.render)

    def reload(self):
        if self.alive():
            self.kick("inventory-view")

    def _section(self, title):
        tk.Label(self.body, text=title, font=self.app.f.small, bg=SURFACE, fg=GOLD, anchor="w").pack(
            fill="x", padx=6, pady=(10, 3))

    def _row(self, tag, tag_color, main, sub="", drift=None, review=None):
        f = self.app.f
        row = tk.Frame(self.body, bg=OVERLAY, highlightthickness=1, highlightbackground=BORDER)
        row.pack(fill="x", pady=1, padx=4)
        tk.Label(row, text=tag, font=f.small, bg=OVERLAY, fg=tag_color, width=10, anchor="w").pack(
            side="left", padx=(8, 4), pady=5)
        col = tk.Frame(row, bg=OVERLAY)
        col.pack(side="left", fill="x", expand=True, pady=4)
        tk.Label(col, text=main, font=f.label, bg=OVERLAY, fg=FG, anchor="w").pack(fill="x")
        if sub:
            tk.Label(col, text=sub, font=f.small, bg=OVERLAY, fg=FG_MUTED, anchor="w", justify="left",
                     wraplength=430).pack(fill="x")

        if drift:
            ui.button(row, "manage", command=lambda a=drift: self.review_drift(a), font=f.small,
                      bg=SURFACE, fg=GOLD, hover_bg=BG, padx=10, pady=5).pack(side="right", padx=8)
        elif review:
            ui.button(row, "review", command=lambda a=review: self.attest_asset(a), font=f.small,
                      bg=SURFACE, fg=GOLD, hover_bg=BG, padx=10, pady=5).pack(side="right", padx=8)

    def attest_asset(self, asset):
        name = asset.get("name", asset.get("id", "asset"))
        dialog = Dialog(self.app, f"review · {name}")
        dialog.label(f"{asset.get('id')}  ·  {asset.get('kind', 'asset')}", fg=TEAL)
        dialog.label(f"Goal: {asset.get('status', 'unknown')}  ·  observed: {asset.get('observed', 'unknown')}\n"
                     f"{asset.get('detail', '')}\n\n{'; '.join(asset.get('problems') or [])}",
                     font=self.app.f.small, wrap=520)
        dialog.label("Mark reviewed only after checking this evidence. The action is recorded in the ledger.",
                     fg=FG_MUTED, font=self.app.f.small, wrap=520)
        aid = shlex.quote(str(asset.get("id", "")))
        dialog.buttons([
            ("mark reviewed today", GOLD,
             lambda: self.app.run_async(f"arc inv review {aid}", on_done=self.reload)),
            ("close", FG_MUTED, None),
        ])

    def ignore_untracked(self, item):
        identity = str(item.get("identity", ""))
        dialog = Dialog(self.app, "manage unregistered item", resizable=True)
        dialog.label(identity, fg=TEAL, wrap=520)
        dialog.label(f"{item.get('detail', '')}\n\nIgnoring records this discovery as intentionally unmanaged."
                     " Give a short reason; the choice is written to the inventory ledger.",
                     font=self.app.f.small, wrap=520)
        reason = tk.StringVar(value="")
        entry = tk.Entry(dialog.shell, textvariable=reason, font=self.app.f.small, width=54,
                         bg=OVERLAY, fg=FG, insertbackground=FG, relief="flat")
        entry.pack(padx=20, pady=(2, 12), fill="x")

        def submit():
            why = reason.get().strip()
            if not why:
                dialog.label("Enter a reason before ignoring this item.", fg=ROSE,
                             font=self.app.f.small, wrap=500)
                return
            cmd = f"arc inv ignore {shlex.quote(identity)} --reason {shlex.quote(why)}"
            self.app.run_async(cmd, on_done=self.reload)

        dialog.buttons([("ignore with reason", GOLD, submit), ("close", FG_MUTED, None)])
        entry.focus_set()

    def review_drift(self, asset):
        """Explain a mismatch and offer confirmed, asset-scoped ways to resolve it."""
        desired = asset.get("status", "unknown")
        observed = asset.get("observed", "unknown")
        detail = asset.get("detail", "no probe detail")
        probe = asset.get("probe") or {}
        problems = "; ".join(asset.get("problems") or []) or "reported state differs from desired state"

        if desired == "retired":
            if probe.get("type") == "http":
                evidence = (
                    f"The URL check reports {observed} ({detail}); a failed URL request does not "
                    "prove that the underlying provider resource is gone."
                )
            else:
                evidence = f"The latest probe reports {observed} ({detail}), not confirmed absence."
            guidance = (
                "Retired means the resource should be absent. " + evidence + " Check the provider "
                "resource and any attached domain. If it should remain, update the desired "
                "lifecycle state in the inventory. If retirement is still intended, remove the "
                "resource through its provider, then make sure the probe can confirm absence "
                "before scanning again."
            )
        elif probe.get("type") == "systemd" and observed == "stopped":
            unit = probe.get("unit", "the reported unit")
            scope = "--user " if probe.get("scope") == "user" else ""
            guidance = (
                f"The register expects this service to be {desired}, but it is stopped. "
                f"Inspect it with: systemctl {scope}status {unit}. If it should be running, "
                "review its status and logs, then restart it. If stopped is intentional, "
                "change the desired lifecycle state in the inventory."
            )
        else:
            guidance = (
                f"The register expects {desired}; the latest probe reports {observed} ({detail}). "
                "Decide which state is intended: repair the real resource to match the register, "
                "or update the desired state in the inventory. Then run an inventory scan to "
                "confirm the result."
            )

        title = asset.get("name", asset.get("id", "asset"))
        dialog = Dialog(self.app, f"review drift · {title}", resizable=True)
        dialog.label(f"{asset.get('id', 'unknown asset')}  ·  {asset.get('provider', asset.get('kind', 'asset'))}",
                     fg=TEAL, wrap=600, pady=(16, 8))
        dialog.label("Drift means the recorded goal and the latest check disagree.",
                     fg=FG, font=self.app.f.small, wrap=600, pady=(0, 8))
        dialog.label(f"Recorded goal: {desired}     Latest check: {observed} ({detail})\nIssue: {problems}",
                     fg=FG, font=self.app.f.small, wrap=600, pady=(0, 10))
        dialog.label(guidance, fg=FG, font=self.app.f.small, wrap=600, pady=(0, 10))
        if asset.get("id") == "svc.storage-mount" and probe.get("type") == "systemd":
            dialog.label("This unit is bound to the USB vault device. On-demand is the expected lifecycle: "
                         "systemd starts it when the drive appears and it may remain stopped when unplugged.",
                         fg=GOLD, font=self.app.f.small, wrap=600, pady=(0, 12))
            dialog.label("Changing desired state updates the register and tamper-evident ledger; it does not start or stop the service.",
                         fg=FG_MUTED, font=self.app.f.small, wrap=600, pady=(0, 14))
        else:
            dialog.label("Lifecycle actions update the register and ledger only. A repair action starts only the named local service/container; provider resources need provider-side repair.",
                         fg=FG_MUTED, font=self.app.f.small, wrap=600, pady=(0, 14))
        inspect_cmd = f"arc inv show {shlex.quote(str(asset.get('id', '')))}"

        def copy_inspect():
            self.app.root.clipboard_clear()
            self.app.root.clipboard_append(inspect_cmd)
            self.app.console.log("copied safe inventory inspect command", TEAL)

        def open_register():
            if not self.app.require_ops_gate("open inventory register"):
                return
            cmd = f"xdg-open {shlex.quote(str(INVENTORY_REGISTRY))}"
            ok, result = self.app.runner.detach(cmd)
            self.app.console.log("opened inventory register" if ok else result, TEAL if ok else ROSE)

        aid = str(asset.get("id", ""))

        def set_lifecycle(status, reason):
            cmd = (f"arc inv set-status {shlex.quote(aid)} {status} "
                   f"--reason {shlex.quote(reason)} && arc inv scan --quiet")
            self.app.run_async(cmd, timeout=180, on_done=self.reload)

        def choose_lifecycle():
            edit = Dialog(self.app, "set intended lifecycle", resizable=True)
            edit.label(f"{aid} · current goal: {desired} · observed: {observed}", fg=TEAL, wrap=520)
            edit.label("Choose the intended lifecycle. This changes inventory only; it will not start, stop, or delete anything.",
                       fg=FG_MUTED, font=self.app.f.small, wrap=520)
            reason = tk.StringVar(value="")
            entry = tk.Entry(edit.win, textvariable=reason, font=self.app.f.small, width=54,
                             bg=OVERLAY, fg=FG, insertbackground=FG, relief="flat")
            entry.pack(padx=20, pady=(2, 12), fill="x")

            def choose(status):
                why = reason.get().strip()
                if not why:
                    edit.label("Add a short reason so the decision is recorded in the ledger.",
                               fg=ROSE, font=self.app.f.small, wrap=500)
                    entry.focus_set()
                    return
                edit.close()
                set_lifecycle(status, why)

            edit.buttons([(state, GOLD, lambda state=state: choose(state))
                          for state in ("active", "on-demand", "standby", "planned")] +
                         [("cancel", FG_MUTED, None)])
            entry.focus_set()

        def confirm_standby():
            confirm = Dialog(self.app, "confirm intentional standby")
            confirm.label(f"Mark {aid} as standby?", fg=GOLD)
            confirm.label("This records that the resource may be intentionally stopped, then scans to confirm. "
                          "It will not start or stop the resource.", font=self.app.f.small, wrap=520)
            # Keep the action behind an explicit click; don't run until the confirm button is pressed.
            cmd = (f"arc inv set-status {shlex.quote(aid)} standby --reason "
                   f"{shlex.quote('Operator confirmed intentional standby from Khaos Lab drift manager')} "
                   "&& arc inv scan --quiet")
            confirm.buttons([("set standby + scan", GOLD,
                              lambda: self.app.run_async(cmd, timeout=180, on_done=self.reload)),
                             ("cancel", FG_MUTED, None)])

        # Only offer live repair actions whose operator command is explicit and local.
        repair = {
            "ctr.sagan": ("start Sagan + scan", "arc sagan start && arc inv scan --quiet"),
            "ctr.evebox": ("start EveBox + scan", "arc evebox start && arc inv scan --quiet"),
        }.get(aid)

        actions = []
        if repair and desired == "active" and observed in ("stopped", "down", "absent"):
            actions.append((repair[0], ROSE,
                            lambda cmd=repair[1]: self._confirm_drift_action(aid, cmd)))
        if (aid != "svc.storage-mount" and probe.get("type") in ("docker", "systemd")
                and observed in ("stopped", "down")):
            actions.append(("mark standby + scan", GOLD, confirm_standby))
        elif aid == "svc.storage-mount" and probe.get("type") == "systemd":
            actions.append(("set on-demand + scan", GOLD,
                            lambda: self._confirm_lifecycle_action(aid, "on-demand",
                                "USB-bound unit starts when vault drive is present; stopped while unplugged")))
        choose = ("choose intended state…", GOLD, choose_lifecycle)
        close = ("close", FG_MUTED, None)
        support = [("inspect record", TEAL, lambda: self.app.run_async(inspect_cmd)),
                   ("copy inspect command", GOLD, copy_inspect),
                   ("open inventory register", GOLD, open_register)]
        dialog.button_rows([actions + [choose, close], support])

    def _confirm_drift_action(self, aid, cmd):
        confirm = Dialog(self.app, "confirm live repair")
        confirm.label(f"Start {aid}?", fg=GOLD)
        confirm.label("This changes the live resource and then scans inventory. Use this only when it should be running.",
                      font=self.app.f.small, wrap=520)
        confirm.buttons([("start + scan", ROSE,
                          lambda: self.app.run_async(cmd, timeout=180, on_done=self.reload)),
                         ("cancel", FG_MUTED, None)])

    def _confirm_lifecycle_action(self, aid, status, reason):
        confirm = Dialog(self.app, "confirm desired state")
        confirm.label(f"Set {aid} desired state to {status}?", fg=GOLD)
        confirm.label("This updates the register and ledger only; no system resource will be started or stopped.",
                      font=self.app.f.small, wrap=520)
        cmd = (f"arc inv set-status {shlex.quote(aid)} {status} --reason {shlex.quote(reason)} "
               "&& arc inv scan --quiet")
        confirm.buttons([("update + scan", GOLD,
                          lambda: self.app.run_async(cmd, timeout=180, on_done=self.reload)),
                         ("cancel", FG_MUTED, None)])

    def render(self, d):
        for w in self.counts.winfo_children():
            w.destroy()
        for w in self.body.winfo_children():
            w.destroy()
        f = self.app.f
        if not d:
            self.fresh.configure(text="no inventory yet — click scan now", fg=GOLD)
            self.app.refresh_scroll(self.frame)
            return
        age = InventoryData.age_minutes(d)
        stale = age is None or age > 90
        led = d.get("ledger", {})
        self.fresh.configure(
            text=f"{len(d['assets'])} assets  ·  scanned {fmt_age(age)}"
                 f"{'  (STALE — timer not firing?)' if stale else ''}  ·  ledger "
                 f"{'verified' if led.get('verified') else 'BROKEN'} ({led.get('entries', 0)})",
            fg=GOLD if stale or not led.get("verified") else FG_MUTED)
        for k in ("ok", "attention", "drift", "unknown", "info"):
            n = d.get("counts", {}).get(k, 0)
            tk.Label(self.counts, text=f"{k} {n}", font=f.label, bg=SURFACE,
                     fg=self.HEALTH_COLOR[k] if n else FG_MUTED).pack(side="left", padx=(6, 14))
        if d.get("untracked"):
            tk.Label(self.counts, text=f"unregistered {len(d['untracked'])}", font=f.label, bg=SURFACE,
                     fg=GOLD).pack(side="left", padx=(6, 14))
        bad = sorted((a for a in d["assets"] if a["health"] in self.ORDER),
                     key=lambda a: (self.ORDER[a["health"]], a["id"]))
        self._assets = d["assets"]
        self._section(f"needs attention ({len(bad)})")
        if not bad:
            tk.Label(self.body, text="  nothing — every registered asset matches its desired state",
                     font=f.small, bg=SURFACE, fg=TEAL, anchor="w").pack(fill="x", padx=6)
        for a in bad[:40]:
            self._row(a["health"], self.HEALTH_COLOR[a["health"]], a.get("name", a["id"]),
                      "; ".join(a.get("problems") or []) or f"observed {a.get('observed', '?')} ({a.get('detail', '')})",
                      drift=a if a["health"] == "drift" else None,
                      review=a if a["health"] == "attention" else None)
        if len(bad) > 40:
            tk.Label(self.body, text=f"  +{len(bad) - 40} more — arc inv drift", font=f.small, bg=SURFACE,
                     fg=FG_MUTED, anchor="w").pack(fill="x", padx=6)
        if d.get("untracked"):
            self._section(f"unregistered — found by discovery, nobody wrote it down ({len(d['untracked'])})")
            for u in d["untracked"][:20]:
                self._row("untracked", GOLD, u["identity"], f"{u.get('detail', '')}  ·  review before adopting or ignoring")
                # Attach the guided, reason-required ignore action to this row.
                row = self.body.winfo_children()[-1]
                ui.button(row, "manage", command=lambda item=u: self.ignore_untracked(item), font=f.small,
                          bg=SURFACE, fg=GOLD, hover_bg=BG, padx=10, pady=5).pack(side="right", padx=8)
        self._section("recent changes (tamper-evident ledger)")
        for e in d.get("recent", [])[:8]:
            self._row(e["ts"][5:16].replace("T", " "), FG_MUTED, f"{e['event']}  ·  {e['id'] or '—'}")
        tk.Label(self.body, text="Manage controls update the inventory ledger; system and provider resources require their own confirmed action. "
                                 "Register: ~/dev-notes/intel-ops/inventory/registry.toml",
                 font=f.small, bg=SURFACE, fg=FG_MUTED, anchor="w", justify="left", wraplength=500).pack(
            fill="x", padx=6, pady=(12, 4))
        self.app.refresh_scroll(self.frame)


class LogsView(View):
    """Click a log, review real content, purge (clears the actual file on disk,
    not just the display) or keep. Built after a real complaint: a heal
    notification said "1 thing healed... see the log" with zero detail."""

    def build(self):
        f = self.app.f
        for src in LOG_SOURCES:
            row = tk.Frame(self.frame, bg=OVERLAY)
            row.pack(fill="x", padx=8, pady=5)
            left = tk.Frame(row, bg=OVERLAY)
            left.pack(side="left", fill="x", expand=True, padx=12, pady=10)
            tk.Label(left, text=src["name"], font=f.label, bg=OVERLAY, fg=FG).pack(anchor="w")
            stat = tk.Label(left, text=self._stat(src["path"]), font=f.small, bg=OVERLAY, fg=FG_MUTED)
            stat.pack(anchor="w")
            btns = tk.Frame(row, bg=OVERLAY)
            btns.pack(side="right", padx=12)
            ui.button(btns, "view", command=lambda s=src: self._view(s), font=f.small, bg=SURFACE, fg=TEAL,
                      hover_bg=BG, padx=10, pady=5).pack(side="left", padx=4)
            # ui.button captures `command` at creation (a Label has no -command), so it must be
            # passed here -- a later .configure(command=...) can't work.
            ui.button(btns, "purge", command=lambda s=src, l=stat: self._purge(s, l), font=f.small,
                      bg=SURFACE, fg=ROSE, hover_bg=BG, padx=10, pady=5).pack(side="left", padx=4)

    @staticmethod
    def _stat(path):
        try:
            st = path.stat()
        except FileNotFoundError:
            return "not found"
        except PermissionError:
            return "permission denied"
        size = float(st.st_size)
        for unit in ("B", "KB", "MB", "GB"):
            if size < 1024 or unit == "GB":
                s = f"{size:.0f}B" if unit == "B" else f"{size:.1f}{unit}"
                break
            size /= 1024
        return f"{s}  ·  {datetime.fromtimestamp(st.st_mtime).strftime('%Y-%m-%d %H:%M')}"

    def _tail(self, src):
        run, p = self.app.runner.run, shlex.quote(str(src["path"]))
        if src["kind"] == "sqlite":
            ok, out = run(f'sqlite3 -separator " | " {p} "SELECT timestamp, app_name, summary, body '
                          f'FROM notifications ORDER BY id DESC LIMIT 50;"', timeout=10)
        else:
            ok, out = run(f"tail -n 200 {p}", timeout=10)
        return out if ok else f"(couldn't read {src['path']} — {out})"

    def _view(self, src):
        f = self.app.f
        d = Dialog(self.app, src["name"], resizable=True, geometry="900x600")
        tk.Label(d.shell, text=f"{src['name']}  —  {src['path']}", font=f.small, bg=SURFACE, fg=FG_MUTED,
                 anchor="w").pack(fill="x", padx=14, pady=(12, 4))
        tf = tk.Frame(d.shell, bg=SURFACE)
        tf.pack(fill="both", expand=True, padx=14, pady=(0, 8))
        sb = ui.PillScrollbar(tf)
        sb.pack(side="right", fill="y")
        box = tk.Text(tf, bg=SURFACE, fg=FG, font=("JetBrains Mono", 10), wrap="word",
                      yscrollcommand=sb.set, relief="flat")
        box.pack(side="left", fill="both", expand=True)
        sb.configure(command=box.yview)
        box.insert("1.0", "loading…")
        box.configure(state="disabled")
        ui.button(d.shell, "close", command=d.close, font=f.small, bg=OVERLAY, fg=FG_MUTED, hover_bg=BG,
                  padx=14, pady=8).pack(pady=(0, 12))

        def show(text):
            try:
                box.configure(state="normal")
                box.delete("1.0", "end")
                box.insert("1.0", text or "(empty)")
                box.configure(state="disabled")
                box.see("end")
            except tk.TclError:
                pass                      # dialog closed while loading
        self.app.bg(lambda: self._tail(src), show)

    def _purge(self, src, stat_lbl):
        d = Dialog(self.app, "confirm")
        d.label(f"clear {src['name']}?")
        d.label("This deletes the real file's content — cannot be undone.", fg=ROSE, font=self.app.f.small)

        def go():
            if not self.app.require_ops_gate(f"purge {src['name']}"):
                return
            p = shlex.quote(str(src["path"]))
            if src["kind"] == "sqlite":
                cmd = f'sqlite3 {p} "DELETE FROM notifications; VACUUM;"'
            elif src["sudo"]:
                cmd = f"sudo -n truncate -s 0 {p}"
            else:
                cmd = f"truncate -s 0 {p}"

            def done(res):
                ok, out = res
                if self.alive():
                    stat_lbl.configure(text=self._stat(src["path"]))
                if not ok:
                    e = Dialog(self.app, "purge failed")
                    e.label(f"couldn't clear {src['name']}", fg=ROSE)
                    e.label((out or "")[:300] + ("\n\nlikely needs: arc sot install-sudoers"
                                                 if "password" in (out or "") else ""),
                            fg=FG_MUTED, font=self.app.f.small, wrap=380)
                    e.buttons([("ok", FG_MUTED, None)])
            self.app.bg(lambda: self.app.runner.run(cmd, timeout=15), done)
        d.buttons([("yes, clear it", ROSE, go), ("cancel (keep)", FG_MUTED, None)])


class FindView(View):
    """`arc find <query>` across arc-lt-cmc + dev-notes + khaos-lab +
    vault/archive, plus `arc ref` -- the literal answer to "surface the notes"."""

    scrollable = True

    def build(self):
        f = self.app.f
        top = tk.Frame(self.frame, bg=SURFACE)
        top.pack(fill="x", padx=4, pady=(4, 10))
        tk.Label(top, text="search arc-lt-cmc + dev-notes + khaos-lab + vault/archive", font=f.small, bg=SURFACE,
                 fg=FG_MUTED, anchor="w").pack(fill="x", pady=(0, 6))
        er = tk.Frame(top, bg=SURFACE)
        er.pack(fill="x")
        self.q = tk.StringVar()
        entry = tk.Entry(er, textvariable=self.q, font=f.label, bg=OVERLAY, fg=FG, insertbackground=FG, relief="flat")
        entry.pack(side="left", fill="x", expand=True, ipady=6, padx=(0, 8))
        entry.bind("<Return>", lambda _e: self._search())
        ui.button(er, "search", command=self._search, font=f.small, bg=OVERLAY, fg=TEAL, hover_bg=BG,
                  padx=14, pady=6).pack(side="left", padx=(0, 6))
        ui.button(er, "browse refs (arc ref)", command=self._refs, font=f.small, bg=OVERLAY, fg=GOLD,
                  hover_bg=BG, padx=14, pady=6).pack(side="left")
        tf = tk.Frame(self.frame, bg=BG)
        tf.pack(fill="both", expand=True, padx=4, pady=(0, 4))
        sb = ui.PillScrollbar(tf)
        sb.pack(side="right", fill="y")
        self.box = tk.Text(tf, bg=SURFACE, fg=FG, font=("JetBrains Mono", 10), wrap="word",
                           yscrollcommand=sb.set, relief="flat", height=24)
        self.box.pack(side="left", fill="both", expand=True)
        sb.configure(command=self.box.yview)
        self._show("type a query, press enter or click search")
        entry.focus_set()

    def _show(self, text):
        if not self.alive():
            return
        self.box.configure(state="normal")
        self.box.delete("1.0", "end")
        self.box.insert("1.0", text or "(no results)")
        self.box.configure(state="disabled")
        self.box.see("1.0")

    def _search(self):
        q = self.q.get().strip()
        if not q:
            return
        self._show(f"searching for '{q}'…")
        self.app.bg(lambda: self.app.runner.run(f"arc find {shlex.quote(q)}", timeout=25),
                    lambda res: self._show(res[1] if res[0] else f"(search failed) {res[1]}"))

    def _refs(self):
        self._show("loading archived references…")
        self.app.bg(lambda: self.app.runner.run("arc ref", timeout=20),
                    lambda res: self._show(res[1] if res[0] else f"(failed) {res[1]}"))


