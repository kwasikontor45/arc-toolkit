#!/usr/bin/env python3
"""
arc-break — background break reminder daemon.

Runs silently in the background. No tray icon. No panel widget.
Fires notify-send alerts when it's time to rest, then when break is over.
Sound/voice on those alerts is handled entirely by arc-pine over D-Bus —
arc-break itself stays silent.

Commands (via arc break):
  arc break start          — start daemon
  arc break stop           — stop daemon
  arc break status         — show phase + time remaining
  arc break snooze [N]     — delay next break by N min (default 5)
  arc break skip           — skip current break, restart work timer
  arc break config         — show current config
  arc break gui            — open live timer window
  arc break genmon         — panel display (called by genmon, not by hand)
  arc break panel-click    — panel click target (called by genmon, not by hand)
"""

import json
import os
import signal
import subprocess
import sys
import threading
import time
from pathlib import Path

# ── Paths ──────────────────────────────────────────────────────────────────────
STATE_DIR    = Path.home() / ".local/share/arc-break"
STATE_PATH   = STATE_DIR / "state.json"
PID_PATH     = STATE_DIR / "arc-break.pid"
GUI_PID_PATH = STATE_DIR / "arc-break-gui.pid"
ICON_PATH    = STATE_DIR / "icon.png"
CONFIG_DIR   = Path.home() / ".config/arc-break"
CONFIG_PATH  = CONFIG_DIR / "config.json"
SNOOZE_PATH  = STATE_DIR / "snooze"
SKIP_PATH    = STATE_DIR / "skip"

DEFAULT_CONFIG = {
    "work_minutes":  30,
    "break_minutes": 5,
    "gui_enabled":   False,
}

# ── Config ─────────────────────────────────────────────────────────────────────
def load_config():
    if CONFIG_PATH.exists():
        try:
            with open(CONFIG_PATH) as f:
                return {**DEFAULT_CONFIG, **json.load(f)}
        except Exception:
            pass
    return DEFAULT_CONFIG.copy()


def save_config(updates: dict):
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    cfg = load_config()
    cfg.update(updates)
    with open(CONFIG_PATH, "w") as f:
        json.dump(cfg, f, indent=2)


# ── BreakTimer ─────────────────────────────────────────────────────────────────
class BreakTimer:
    """Single source of truth for reading/controlling arc-break's running
    state. Built 2026-09-11 to close a real coupling gap: the panel display
    (arc-break-panel), its click handler (arc-break-panel-menu), and its
    login-time property fix (arc-break-panel-fix) used to be three separate
    shell scripts, each independently re-deriving "is it running" /
    "start/stop/reset" via their own PID-file checks and systemctl calls --
    coupled only by convention, not by any shared object. All three are gone
    now; `genmon`/`panel-click`/`ensure-panel` below are subcommands of this
    one file, and everything they need lives on this one class.
    """

    def is_running(self):
        if not PID_PATH.exists():
            return False
        try:
            os.kill(int(PID_PATH.read_text().strip()), 0)
            return True
        except Exception:
            return False

    def current(self):
        """dict(phase, remaining, total, pid) if running and state is
        readable, else None -- callers (genmon display, GUI tick) treat
        None as the single "not running / unknown" case, not two."""
        if not self.is_running():
            return None
        try:
            state = json.loads(STATE_PATH.read_text())
            remaining = max(0, int(state["phase_end"] - time.time()))
            total = max(1, int(state["phase_end"] - state["phase_start"]))
            return {
                "phase": state["phase"],
                "remaining": remaining,
                "total": total,
                "pid": PID_PATH.read_text().strip(),
            }
        except Exception:
            return None

    def start(self):
        subprocess.run(["systemctl", "--user", "start", "arc-break.service"],
                        capture_output=True)

    def stop(self):
        subprocess.run(["systemctl", "--user", "stop", "arc-break.service"],
                        capture_output=True)

    def reset(self):
        self.stop()
        time.sleep(1)
        self.start()

    def ensure_panel_config(self):
        """Folds arc-break-panel-fix's whole job into this class -- genmon
        resets its OWN xfconf properties to factory defaults every time its
        widget is freshly created (panel restart/reboot/login), a confirmed
        upstream quirk, not a one-off. Previously fought by a separate
        autostart script 10s after login; now just the first thing the
        daemon does on its own startup, no separate script/autostart entry
        needed. Real bug this class's predecessor script had, fixed here
        too: the re-asserted update-period was hardcoded to 5000ms from
        whenever it was first written, silently overwriting the actually-
        wanted 1000ms (real-time feel) every login."""
        def xq(*args):
            return subprocess.run(["xfconf-query", "-c", "xfce4-panel", *args],
                                   capture_output=True, text=True)

        listing = xq("-p", "/plugins", "-lv").stdout
        plugin_id = None
        for line in listing.splitlines():
            parts = line.split(None, 1)
            if len(parts) == 2 and parts[1].strip() == "genmon":
                path = parts[0]
                if path.rsplit("/", 1)[-1].replace("plugin-", "").isdigit() \
                   and path.count("/") == 2:
                    plugin_id = path.rsplit("-", 1)[-1]
                    break
        if plugin_id is None:
            return  # no genmon plugin on this panel -- nothing to fix

        def _set(prop, type_, val):
            r = xq("-p", f"/plugins/plugin-{plugin_id}/{prop}", "-s", val)
            if r.returncode != 0:
                xq("-p", f"/plugins/plugin-{plugin_id}/{prop}", "-n", "-t", type_, "-s", val)

        _set("command", "string", f"{sys.executable} {os.path.abspath(__file__)} genmon")
        _set("update-period", "uint", "1000")
        _set("use-label", "bool", "false")


# ── Helpers ────────────────────────────────────────────────────────────────────
def notify(title, body, urgency="normal"):
    subprocess.run(
        ["notify-send", "-u", urgency, "-a", "arc-break",
         f"arc · {title}", body],
        capture_output=True
    )


def boot_id():
    # Unique per boot session, stable within one -- the standard Linux way
    # to answer "has the machine rebooted since X" without any clock-skew
    # reasoning. Used to fix a real bug (2026-08-26): state.json used to be
    # treated as resumable on ANY restart, reboot or not, because a SIGTERM
    # from a reboot and one from a deliberate `arc break stop` look
    # identical from inside the signal handler -- there was no way to tell
    # them apart. That made a manual stop+restart wrongly "pick up where it
    # left off" instead of starting fresh, which is what a user stopping
    # and restarting a timer actually expects. Comparing boot_id at
    # save-time vs. resume-time distinguishes the two cases directly instead
    # of trying to infer them from signal handling.
    try:
        return Path("/proc/sys/kernel/random/boot_id").read_text().strip()
    except Exception:
        return None


def write_state(phase, phase_end):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    STATE_PATH.write_text(json.dumps({
        "phase":       phase,
        "phase_start": time.time(),
        "phase_end":   phase_end,
        "boot_id":     boot_id(),
    }))


def resumable_state():
    """Returns (phase, phase_end) if a genuinely reboot-interrupted session
    is waiting to be resumed, else (None, None). Only true across a real
    reboot (boot_id changed since the state was saved) -- a same-boot
    restart (manual stop, then start again) always starts fresh, matching
    what a user stopping/restarting a timer actually expects."""
    if not STATE_PATH.exists():
        return None, None
    try:
        saved = json.loads(STATE_PATH.read_text())
        saved_boot = saved.get("boot_id")
        # Live-caught bug while testing this same fix: a leftover state.json
        # from before boot_id existed (or any other reason it's missing) has
        # saved_boot=None, and None != a real current boot_id -- so a naive
        # equality check here would treat "we don't actually know" as "yes,
        # definitely a different boot," and wrongly resume it. Require an
        # explicit, present, DIFFERENT boot_id before resuming -- anything
        # else (missing, or matching) means don't resume.
        if not saved_boot or saved_boot == boot_id():
            return None, None
        remaining = saved["phase_end"] - time.time()
        if remaining > 0 and saved.get("phase") in ("work", "break"):
            return saved["phase"], saved["phase_end"]
    except Exception:
        pass
    return None, None


def write_pid():
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    PID_PATH.write_text(str(os.getpid()))


def cleanup(signum=None, frame=None):
    # state.json is deliberately left in place here (only the PID file is
    # removed) -- this is what lets main() resume the same phase/countdown
    # on the next `arc break start` instead of always restarting from a
    # full work_minutes block. A reboot sends the same SIGTERM a deliberate
    # `arc break stop` does, so there's no reliable way to tell them apart
    # from inside the signal handler -- resuming on either is the simpler,
    # more useful behavior (see main()'s resume check for the actual logic
    # and the staleness guard that keeps this from reviving a truly old,
    # already-expired session).
    PID_PATH.unlink(missing_ok=True)
    sys.exit(0)


def interruptible_sleep(total_seconds):
    elapsed = 0
    deadline = total_seconds
    while elapsed < deadline:
        time.sleep(1)
        elapsed += 1
        if SKIP_PATH.exists():
            SKIP_PATH.unlink(missing_ok=True)
            return "skip"
        if SNOOZE_PATH.exists():
            try:
                extra = int(SNOOZE_PATH.read_text().strip()) * 60
            except Exception:
                extra = 5 * 60
            SNOOZE_PATH.unlink(missing_ok=True)
            deadline += extra
            notify("snoozed", f"Break delayed {extra // 60} min.", "low")
    return "done"


def launch_gui():
    subprocess.Popen(
        [sys.executable, __file__, "gui"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


# ── GUI ────────────────────────────────────────────────────────────────────────
def run_gui():
    try:
        import tkinter as tk
    except ImportError:
        print("tkinter not available — run: sudo apt install python3-tk", file=sys.stderr)
        sys.exit(1)

    sys.path.insert(0, str(Path(__file__).resolve().parent))
    import _arc_ui as ui

    GUI_PID_PATH.parent.mkdir(parents=True, exist_ok=True)
    GUI_PID_PATH.write_text(str(os.getpid()))

    # Shared design system as of 2026-09-11 -- was its own copy-pasted Rose
    # Pine Moon palette + flat tk.Button styling before, one of three
    # near-identical copies across khaos-lab/arc-pine/arc-break that had
    # already started drifting. See _arc_ui.py for the why.
    BG, SURFACE = ui.BG, ui.SURFACE
    FG_WORK, FG_BREAK = ui.COLOR_WORK, ui.COLOR_BREAK
    FG_MUTED, FG_STOP, FG_TEAL = ui.FG_MUTED, ui.OVERLAY, ui.TEAL

    root = tk.Tk()
    root.title("arc · break")
    root.resizable(False, False)
    root.attributes("-topmost", True)
    root.configure(bg=BG)
    root.geometry("260x330+20+20")

    if ICON_PATH.exists():
        try:
            _icon = tk.PhotoImage(file=str(ICON_PATH))
            root.iconphoto(True, _icon)
        except Exception:
            pass

    f = ui.fonts()
    big_font, small_font, btn_font = f["big"], f["small"], f["small"]

    # ── Status display -- now a real rounded card, not a flat rectangle ─────────
    status_outer, status_card = ui.rounded_frame(root, parent_bg=BG, bg=SURFACE, radius=12)
    status_outer.pack(padx=ui.SPACE_MD, pady=(ui.SPACE_MD, ui.SPACE_SM))

    phase_lbl = tk.Label(status_card, text="WORK",   font=big_font,  bg=SURFACE, fg=FG_WORK)
    time_lbl  = tk.Label(status_card, text="--:--",  font=big_font,  bg=SURFACE, fg=FG_WORK)
    phase_lbl.pack(pady=(ui.SPACE_MD, 0))
    time_lbl.pack()

    status_lbl = tk.Label(status_card, text="loading…", font=small_font, bg=SURFACE, fg=FG_MUTED)
    status_lbl.pack(pady=(3, ui.SPACE_MD))

    # ── Daemon helpers ─────────────────────────────────────────────────────────
    def daemon_running():
        if not PID_PATH.exists():
            return False
        try:
            os.kill(int(PID_PATH.read_text().strip()), 0)
            return True
        except Exception:
            return False

    def do_start():
        if daemon_running():
            return
        # Goes through systemd (arc-break.service), same as `arc break start` --
        # NOT a raw subprocess.Popen. A directly-spawned child here used to be
        # its own session/process group with no supervisor, so closing this
        # GUI's own terminal (if it had one) or various panel/session restarts
        # could orphan or silently lose track of it. systemd is the single
        # source of truth for "is the timer running" now, from either CLI or
        # GUI (2026-08-17 redesign).
        subprocess.run(["systemctl", "--user", "start", "arc-break.service"],
                        capture_output=True)
        root.after(800, update_btn_states)

    def do_stop():
        if not daemon_running():
            return
        subprocess.run(["systemctl", "--user", "stop", "arc-break.service"],
                        capture_output=True)
        root.after(600, update_btn_states)

    def do_reset():
        do_stop()
        root.after(1200, do_start)

    def do_skip():
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        SKIP_PATH.write_text("1")

    def do_snooze():
        try:
            n = int(snooze_var.get())
        except Exception:
            n = 5
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        SNOOZE_PATH.write_text(str(n))

    # Config used to be a separate tk.Toplevel popup stacked below the main
    # window -- a second floating window just to change two numbers felt
    # disconnected from the app it belonged to. Folded directly into the
    # main window instead (2026-09-11): one window, one surface, no popup.
    cfg_now = load_config()

    config_outer, config_card = ui.rounded_frame(root, parent_bg=BG, bg=SURFACE, radius=10)
    config_card.columnconfigure(1, weight=1)

    tk.Label(config_card, text="work",  font=small_font, bg=SURFACE, fg=FG_MUTED).grid(
        row=0, column=0, padx=(10, 4), pady=(8, 4), sticky="w")
    work_var = tk.StringVar(value=str(cfg_now["work_minutes"]))
    tk.Entry(config_card, textvariable=work_var, width=4, font=btn_font,
             bg=BG, fg=FG_WORK, insertbackground=FG_WORK, relief="flat", justify="center"
             ).grid(row=0, column=1, padx=4, pady=(8, 4), sticky="w")

    tk.Label(config_card, text="break", font=small_font, bg=SURFACE, fg=FG_MUTED).grid(
        row=1, column=0, padx=(10, 4), pady=(0, 8), sticky="w")
    break_var = tk.StringVar(value=str(cfg_now["break_minutes"]))
    tk.Entry(config_card, textvariable=break_var, width=4, font=btn_font,
             bg=BG, fg=FG_WORK, insertbackground=FG_WORK, relief="flat", justify="center"
             ).grid(row=1, column=1, padx=4, pady=(0, 8), sticky="w")

    def do_config_apply():
        try:
            save_config({
                "work_minutes":  int(work_var.get()),
                "break_minutes": int(break_var.get()),
            })
            config_status.configure(text="saved — restart to take effect", fg=FG_TEAL)
        except ValueError:
            config_status.configure(text="work/break must be whole numbers", fg=FG_BREAK)

    btn_apply = ui.button(config_card, "apply", command=do_config_apply,
                           font=small_font, bg=BG, fg=FG_TEAL, hover_bg=FG_STOP)
    btn_apply.grid(row=0, column=2, rowspan=2, padx=(6, 10), pady=8, sticky="ns")

    config_status = tk.Label(config_card, text="minutes", font=small_font, bg=SURFACE, fg=FG_MUTED)
    config_status.grid(row=2, column=0, columnspan=3, padx=10, pady=(0, 8), sticky="w")

    # ── Button rows -- ui.button() gives a real hover-state transition
    # instead of the old flat tk.Button (static until an actual click) ──────────
    BTN = dict(font=btn_font, bg=SURFACE, hover_bg=FG_STOP)

    # Row 1: start · stop · reset
    row1 = tk.Frame(root, bg=BG)
    row1.pack(fill="x", padx=6)
    for c in range(3):
        row1.columnconfigure(c, weight=1)

    btn_start = ui.button(row1, "▶ start", command=do_start, fg=FG_TEAL,  **BTN)
    btn_stop  = ui.button(row1, "■ stop",  command=do_stop,  fg=FG_BREAK, **BTN)
    btn_reset = ui.button(row1, "↺ reset", command=do_reset, fg=FG_MUTED, **BTN)
    btn_start.grid(row=0, column=0, padx=2, pady=2, sticky="ew")
    btn_stop.grid( row=0, column=1, padx=2, pady=2, sticky="ew")
    btn_reset.grid(row=0, column=2, padx=2, pady=2, sticky="ew")

    # Row 2: skip · N spinbox · snooze
    row2 = tk.Frame(root, bg=BG)
    row2.pack(fill="x", padx=6)
    row2.columnconfigure(0, weight=1)
    row2.columnconfigure(2, weight=1)

    snooze_var = tk.StringVar(value="5")
    btn_skip   = ui.button(row2, "⏭ skip",   command=do_skip,   fg=FG_WORK,  **BTN)
    snooze_spin = tk.Spinbox(
        row2, from_=1, to=60, width=3, textvariable=snooze_var,
        font=btn_font, bg=SURFACE, fg=FG_MUTED, relief="flat",
        buttonbackground=SURFACE, insertbackground=FG_MUTED,
    )
    btn_snooze = ui.button(row2, "💤 snooze", command=do_snooze, fg=FG_MUTED, **BTN)
    btn_skip.grid(   row=0, column=0, padx=2, pady=2, sticky="ew")
    snooze_spin.grid(row=0, column=1, padx=2, pady=2)
    btn_snooze.grid( row=0, column=2, padx=2, pady=2, sticky="ew")

    # Row 3: config card, inline (was a separate popup window, see note above)
    config_outer.pack(fill="x", padx=6, pady=(2, 6))

    # ── Button state sync ─────────────────────────────────────────────────────
    def update_btn_states():
        running = daemon_running()
        btn_start.set_enabled(not running)
        btn_stop.set_enabled(running)
        btn_skip.set_enabled(running)
        btn_snooze.set_enabled(running)
        snooze_spin.configure(state="normal" if running else "disabled")
        btn_reset.set_enabled(True)

    # ── Circadian retheme ─────────────────────────────────────────────────────
    # The user's own signature design language, ported from Kataleya's
    # circadian phase engine (choice/still-pine/desire/nyx) -- ambient
    # colors drift continuously against the real clock rather than being
    # fixed at launch. Only the *ambient* bg/surface/overlay move; each
    # widget's own semantic fg (gold=work, rose=break, muted=stopped)
    # stays exactly as tick() already drives it -- circadian for mood,
    # not for meaning, matching Kataleya's own "useful over pretty" rule.
    def retheme():
        c = ui.circadian()
        root.configure(bg=c["bg"])
        for row in (row1, row2):
            row.configure(bg=c["bg"])
        status_outer.retheme(new_bg=c["surface"], new_parent_bg=c["bg"])
        config_outer.retheme(new_bg=c["surface"], new_parent_bg=c["bg"])
        phase_lbl.configure(bg=c["surface"])
        time_lbl.configure(bg=c["surface"])
        status_lbl.configure(bg=c["surface"], fg=c["fg_muted"])
        for b in (btn_start, btn_stop, btn_reset, btn_skip, btn_snooze, btn_apply):
            b.retheme(bg=c["surface"], hover_bg=c["overlay"])
        snooze_spin.configure(bg=c["surface"], fg=c["fg_muted"])
        config_card.configure(bg=c["surface"])
        for w in config_card.winfo_children():
            if isinstance(w, tk.Label):
                w.configure(bg=c["surface"])
            elif isinstance(w, tk.Entry):
                w.configure(bg=c["bg"])
        root.after(60_000, retheme)

    retheme()

    # ── Tick ───────────────────────────────────────────────────────────────────
    def tick():
        update_btn_states()
        # Real bug, 2026-08-26: this used to check STATE_PATH.exists() to
        # decide "is it running", which was correct back when cleanup()
        # deleted state.json on every stop. Once the reboot-resume fix
        # made cleanup() deliberately KEEP state.json after a stop (so a
        # later start can resume it), this check went stale -- the GUI
        # kept displaying the last-known phase/countdown off the leftover
        # file even with the daemon dead, looking like it was stuck
        # looping/still running. daemon_running() (an actual PID liveness
        # check, already used for the button states two lines up) is the
        # real "is it running" signal -- use that instead.
        if not daemon_running():
            phase_lbl.configure(text="STOP", fg=FG_STOP)
            time_lbl.configure( text="--:--", fg=FG_STOP)
            status_lbl.configure(text="not running")
            root.title("arc · break")
        else:
            try:
                state = json.loads(STATE_PATH.read_text())
                phase = state["phase"].upper()
                remaining = max(0, int(state["phase_end"] - time.time()))
                mins, secs = divmod(remaining, 60)
                color = FG_BREAK if phase == "BREAK" else FG_WORK
                phase_lbl.configure(text=phase,                    fg=color)
                time_lbl.configure( text=f"{mins:02d}:{secs:02d}", fg=color)
                pid_txt = PID_PATH.read_text().strip() if PID_PATH.exists() else "?"
                status_lbl.configure(text=f"pid {pid_txt}")
                # Mirror the countdown into the window title so it's visible
                # in the taskbar/window-list without the window being focused.
                root.title(f"{phase} {mins:02d}:{secs:02d} — arc break")
            except Exception:
                phase_lbl.configure(text="ERR",   fg=FG_MUTED)
                time_lbl.configure( text="--:--",  fg=FG_MUTED)
                status_lbl.configure(text="state read error")
                root.title("arc · break")
        root.after(1000, tick)

    tick()

    def on_close():
        # Window close/minimize is purely a GUI concern -- neither one calls
        # do_stop(), so the arc-break.service daemon (and its countdown) keeps
        # running exactly as it was. This window is a *view* onto that daemon,
        # not its owner: closing this window only destroys the window and its
        # own PID file, nothing about the timer itself. The genmon panel
        # widget (arc-break-panel) is the persistent, always-visible view of
        # the same running daemon, so there's no need for this window itself
        # to linger. The only things that actually stop the timer are the
        # Stop button above (do_stop, now via `systemctl --user stop
        # arc-break.service`) or `arc break stop` from the CLI -- both paths
        # converge on the same systemd unit, so "stopped" means the same
        # thing everywhere. Minimize needs no extra handling here at all: the
        # window manager's own iconify is a pure GUI-level operation that
        # never reaches this process's Python code, so it can't touch the
        # daemon by construction. (Redesigned 2026-08-17: unified GUI/CLI
        # daemon control onto systemd; this close behavior itself was already
        # correct since a 2026-08-13 revert, kept as-is.)
        GUI_PID_PATH.unlink(missing_ok=True)
        root.destroy()

    root.protocol("WM_DELETE_WINDOW", on_close)
    root.mainloop()
    GUI_PID_PATH.unlink(missing_ok=True)


# ── Panel display + click (replaces arc-break-panel / arc-break-panel-menu) ─────
_EMOJI_WORK  = ["🚀","🧠","💻","⌨️","📝","🎯","🔍","👀","⏰","⚡","😤","🔔"]
_PCT_WORK    = [93, 83, 73, 63, 53, 43, 33, 23, 17, 10, 3]
_EMOJI_BREAK = ["🌿","☕","🧘","💤","🔔"]
_PCT_BREAK   = [80, 60, 40, 20]


def _phase_emoji(phase, pct):
    table, cuts = (_EMOJI_WORK, _PCT_WORK) if phase == "work" else (_EMOJI_BREAK, _PCT_BREAK)
    for cut, emoji in zip(cuts, table):
        if pct >= cut:
            return emoji
    return table[-1]


def cmd_genmon():
    """Emits genmon's XML. Replaces the old separate arc-break-panel
    script -- same BreakTimer.current() a `status`/the GUI's tick() use,
    not an independently-drifting third reading of state.json."""
    self_path = f"{sys.executable} {os.path.abspath(__file__)}"
    cur = BreakTimer().current()
    if not cur:
        print("<txt>💀 --:--</txt>")
        print(f"<click>{self_path} panel-click</click>")
        print(f"<txtclick>{self_path} panel-click</txtclick>")
        return
    mins, secs = divmod(cur["remaining"], 60)
    pct = cur["remaining"] * 100 // cur["total"]
    emoji = _phase_emoji(cur["phase"], pct)
    print(f"<txt>{emoji} {mins:02d}:{secs:02d}</txt>")
    print(f"<click>{self_path} panel-click</click>")
    print(f"<txtclick>{self_path} panel-click</txtclick>")


def cmd_panel_click():
    """The genmon widget's click target -- replaces arc-break-panel-menu.
    Not running: starts it (unchanged, simplest case). Running: a small
    native Tkinter popup menu (open/reset/stop) -- no rofi, no separate
    dispatcher script, just this class's own methods called directly."""
    bt = BreakTimer()
    if not bt.is_running():
        bt.start()
        return

    import tkinter as tk
    root = tk.Tk()
    root.withdraw()

    menu = tk.Menu(root, tearoff=0)
    menu.add_command(label="⚙ open",  command=launch_gui)
    menu.add_command(label="↺ reset", command=bt.reset)
    menu.add_command(label="■ stop",  command=bt.stop)

    state = {"was_open": False}

    def _watch():
        if menu.winfo_ismapped():
            state["was_open"] = True
        elif state["was_open"]:
            root.quit()
            return
        root.after(100, _watch)

    x, y = root.winfo_pointerx(), root.winfo_pointery()
    menu.tk_popup(x, y)
    root.after(100, _watch)
    root.mainloop()
    root.destroy()


# ── Main loop ──────────────────────────────────────────────────────────────────
def main():
    signal.signal(signal.SIGTERM, cleanup)
    signal.signal(signal.SIGINT, cleanup)

    write_pid()

    # Real, confirmed upstream behavior (not a one-off): this genmon plugin
    # overwrites ITS OWN command/update-period/use-label properties back to
    # a remembered stale value on every fresh widget creation -- not just at
    # login, any panel restart or crash does it, live-confirmed by directly
    # watching the on-disk xfconf XML flip back the instant the panel
    # restarted, even seconds after this exact fix had already been written
    # and flushed to disk. One-shot healing (startup only) can't win that
    # race by construction -- the widget can reset again at any later,
    # unpredictable moment. A background thread that just re-checks
    # periodically is the honest fix: still this one process, no separate
    # script/autostart entry, just bounding "how stale can it get" to one
    # poll interval instead of "until the daemon happens to restart."
    def _panel_heal_loop():
        bt = BreakTimer()
        while True:
            bt.ensure_panel_config()
            time.sleep(15)

    threading.Thread(target=_panel_heal_loop, daemon=True).start()

    cfg = load_config()
    work_sec  = cfg["work_minutes"]  * 60
    break_sec = cfg["break_minutes"] * 60

    print(f"arc-break running  ·  work {cfg['work_minutes']}min · break {cfg['break_minutes']}min")
    print(f"  pid: {os.getpid()}")

    if cfg.get("gui_enabled"):
        gui_alive = False
        if GUI_PID_PATH.exists():
            try:
                os.kill(int(GUI_PID_PATH.read_text().strip()), 0)
                gui_alive = True
            except Exception:
                pass
        if not gui_alive:
            launch_gui()

    # Resume a leftover phase, but only across a genuine reboot -- see
    # resumable_state()'s own docstring for why a same-boot restart must
    # NOT resume. phase_end is an absolute wall-clock timestamp, so if
    # it's still in the future the remaining time is just phase_end - now
    # -- no need to track "how long was the machine down."
    resume_phase, resume_end = resumable_state()
    if resume_phase:
        remaining = resume_end - time.time()
        mins, secs = divmod(int(remaining), 60)
        time_txt = f"{mins} min" if mins else f"{secs} sec"
        notify(
            "resumed",
            f"{resume_phase} timer picked up where it left off — {time_txt} remaining.",
            "low"
        )
        write_state(resume_phase, resume_end)
        result = interruptible_sleep(int(remaining))
        if resume_phase == "work" and result != "skip":
            notify(
                "break time",
                f"{cfg['work_minutes']} min up — step away for {cfg['break_minutes']} min.",
                "critical"
            )
            write_state("break", time.time() + break_sec)
            interruptible_sleep(break_sec)
            notify("back to work", f"Break over — {cfg['work_minutes']} min on the clock.", "normal")
        elif resume_phase == "break":
            notify("back to work", f"Break over — {cfg['work_minutes']} min on the clock.", "normal")

    while True:
        write_state("work", time.time() + work_sec)
        result = interruptible_sleep(work_sec)

        if result == "skip":
            continue

        notify(
            "break time",
            f"{cfg['work_minutes']} min up — step away for {cfg['break_minutes']} min.",
            "critical"
        )

        write_state("break", time.time() + break_sec)
        interruptible_sleep(break_sec)

        notify("back to work", f"Break over — {cfg['work_minutes']} min on the clock.", "normal")


if __name__ == "__main__":
    if len(sys.argv) > 1:
        cmd = sys.argv[1]

        if cmd == "gui":
            run_gui()

        elif cmd == "genmon":
            cmd_genmon()

        elif cmd == "panel-click":
            cmd_panel_click()

        elif cmd == "status":
            if not PID_PATH.exists():
                print("stopped")
                sys.exit(0)
            pid = PID_PATH.read_text().strip()
            if not STATE_PATH.exists():
                print(f"running (pid {pid}) — state unknown")
                sys.exit(0)
            state = json.loads(STATE_PATH.read_text())
            remaining = max(0, int(state["phase_end"] - time.time()))
            mins, secs = divmod(remaining, 60)
            print(f"{state['phase']}  ·  {mins:02d}:{secs:02d} remaining  ·  pid {pid}")

        elif cmd == "snooze":
            minutes = sys.argv[2] if len(sys.argv) > 2 else "5"
            STATE_DIR.mkdir(parents=True, exist_ok=True)
            SNOOZE_PATH.write_text(minutes)
            print(f"snooze signal sent ({minutes} min)")

        elif cmd == "skip":
            STATE_DIR.mkdir(parents=True, exist_ok=True)
            SKIP_PATH.write_text("1")
            print("skip signal sent")

        elif cmd == "config":
            cfg = load_config()
            print(f"work:  {cfg['work_minutes']} min")
            print(f"break: {cfg['break_minutes']} min")
            print(f"gui:   {cfg.get('gui_enabled', False)}")
            print(f"config: {CONFIG_PATH}")

        elif cmd == "boot-check":
            # Called from an XFCE autostart entry, not by hand. Deliberately
            # NOT "always start on login" -- that would violate the standing
            # manual-start-only policy (feedback_manual_start_tools). This
            # only starts the daemon if a real, still-unexpired session was
            # genuinely interrupted (state.json exists with phase_end still
            # in the future) -- i.e. it was actually running before the
            # reboot/logout, not "start something new just because login
            # happened." No resumable state = silent no-op, same as if this
            # entry didn't exist at all.
            already_running = False
            if PID_PATH.exists():
                try:
                    os.kill(int(PID_PATH.read_text().strip()), 0)
                    already_running = True
                except Exception:
                    pass
            if already_running:
                sys.exit(0)
            # Same resumable_state() check main() uses -- one shared
            # definition of "is this actually resumable" instead of two
            # separate copies that could quietly drift apart.
            resume_phase, _ = resumable_state()
            if resume_phase:
                subprocess.run(["systemctl", "--user", "start", "arc-break.service"],
                               capture_output=True)
            sys.exit(0)

        else:
            print(f"unknown command: {cmd}", file=sys.stderr)
            sys.exit(1)

        sys.exit(0)

    main()
