#!/usr/bin/env python3
"""
arc-sop-gate-hook — agent PreToolUse hook, real enforcement point.

Blocks operational tool calls until arc-sop confirms a same-day, session-scoped
acceptance bound to the exact current SOT.md and MO.md. Before acknowledgment,
read-only discovery and one standalone SOP setup command are allowed. Unknown
tools fail closed.
"""
import json
import os
import shlex
import subprocess
import sys

def self_serve(command: str) -> bool:
    """Allow a single SOP command before acknowledgment, never a command chain."""
    if not isinstance(command, str) or not command.strip():
        return False
    # Parse shell operators as syntax, not as plain characters, so a quoted
    # task like "repair X & Y" is accepted while `start task; unsafe` is not.
    if any(ch in command for ch in ("`", chr(10), chr(13))) or "$(" in command or "${" in command:
        return False
    try:
        lexer = shlex.shlex(command, posix=True, punctuation_chars=";&|<>")
        lexer.whitespace_split = True
        argv = list(lexer)
    except ValueError:
        return False
    if any(token and all(ch in ";&|<>" for ch in token) for token in argv):
        return False
    if not argv:
        return False
    if os.path.basename(argv[0]) == "sudo":
        argv = argv[1:]
        if argv and argv[0] == "-n":
            argv = argv[1:]
    if not argv:
        return False
    binary, args = os.path.basename(argv[0]).lower(), argv[1:]
    if binary == "arc-sop" and args:
        verb = args[0].lower()
        return ((verb == "start" and len(args) >= 2)
                or (verb in {"status", "check", "verify", "gate-status", "recover"} and len(args) == 1)
                or (verb == "violations" and args[1:] in ([], ["--watch"]))
                or (verb == "record-violation" and len(args) == 3
                    and args[1] in {"pre-ack-shell-operation", "pre-ack-tool-operation"})
                or (verb == "emergency" and len(args) == 1)
                or (verb == "gate-enable" and len(args) == 1))
    if binary == "arc" and len(args) >= 2 and args[0].lower() == "sop":
        verb = args[1].lower()
        return ((verb == "start" and len(args) >= 3)
                or (verb in {"status", "check", "verify", "recover"} and len(args) == 2)
                or (verb == "violations" and args[2:] in ([], ["--watch"]))
                or (verb == "record-violation" and len(args) == 4
                    and args[2] in {"pre-ack-shell-operation", "pre-ack-tool-operation"})
                or (verb == "emergency" and len(args) == 2)
                or (verb == "gate-enable" and len(args) == 2))
    return False


def _notify(title: str, message: str):
    try:
        subprocess.run(
            ["notify-send", "--urgency=critical", "--app-name=arc-sop", title, message],
            check=False, timeout=10, capture_output=True,
        )
    except Exception:
        pass


def main():
    raw = sys.stdin.read()
    try:
        data = json.loads(raw)
    except (json.JSONDecodeError, TypeError):
        print(json.dumps({"decision": "deny", "reason": "Malformed SOP gate hook input."}),
              file=sys.stderr)
        sys.exit(2)

    if not isinstance(data, dict):
        print(json.dumps({"decision": "deny", "reason": "Malformed SOP gate hook input."}),
              file=sys.stderr)
        sys.exit(2)
    tool_name = data.get("tool_name")
    tool_input = data.get("tool_input")
    if tool_name in {"Read", "Grep", "Glob", "ListDir", "Search"}:
        sys.exit(0)
    # Codex supplies the authoritative session id in the hook payload. The
    # spawned hook process may not inherit the session environment variable,
    # which otherwise makes `gate-check` identify its parent Konsole shell
    # instead of the Codex session that recorded the acknowledgment.
    hook_session_id = data.get("session_id")
    hook_env = os.environ.copy()
    if isinstance(hook_session_id, str) and hook_session_id.strip():
        hook_env["CODEX_SESSION_ID"] = hook_session_id.strip()

    arc_sop = "/home/architect-of-chaos/.local/bin/arc-sop"
    if os.getuid() == 0:
        # Root-native agent session (this machine's normal admin mode) --
        # drop to the real user so arc-sop's paths/DB/GAMEPLAN.md resolve
        # correctly and any writes stay correctly owned, instead of silently
        # operating on a nonexistent parallel /root/... tree. --preserve-env is
        # explicit because sudo resets the environment by default and would
        # otherwise strip the session id, making every session misreport as a
        # fresh, unscoped "human" run instead of this specific agent session.
        cmd = [
            "sudo", "-u", "architect-of-chaos", "-H",
            "--preserve-env=CODEX_SESSION_ID,CLAUDE_CODE_SESSION_ID,CLAUDE_CODE_BRIDGE_SESSION_ID,KIMI_SESSION_ID,ARC_SESSION_ID,AGENT_SESSION_ID,AGENT_ID",
            arc_sop, "gate-check",
        ]
    else:
        cmd = [arc_sop, "gate-check"]

    result = subprocess.run(
        cmd,
        capture_output=True, text=True, timeout=10,
        env=hook_env,
    )
    if result.returncode == 0:
        sys.exit(0)

    if tool_name == "Bash":
        command = tool_input.get("command", "") if isinstance(tool_input, dict) else ""
        if self_serve(command):
            sys.exit(0)
        # Reuse the interactive shell read allowlist, but suppress its own
        # denial event: this hook records the authoritative Codex-session event
        # below, so one denied call must produce one ledger row.
        guard = "/home/architect-of-chaos/.local/bin/arc-sop-shell-guard"
        guard_env = hook_env.copy()
        guard_env["ARC_SOP_NO_RECORD"] = "1"
        try:
            read_result = subprocess.run([guard, command], capture_output=True,
                                         text=True, timeout=5, env=guard_env)
            if read_result.returncode == 0:
                sys.exit(0)
        except (OSError, subprocess.TimeoutExpired):
            pass

    reason = result.stdout.strip() or "SOP gate not satisfied"
    # Persist a secret-safe violation event immediately. Only the tool name is
    # recorded, never tool arguments, which may contain private data.
    record_cmd = cmd[:-1] + ["record-violation", "pre-ack-tool-operation",
                            str(tool_name or "unknown")[:64]]
    try:
        subprocess.run(record_cmd, capture_output=True, text=True, timeout=10, env=hook_env)
    except (OSError, subprocess.TimeoutExpired):
        pass
    print(json.dumps({"decision": "deny", "reason": f"{tool_name or 'unknown tool'} blocked: {reason}"}), file=sys.stderr)
    sys.exit(2)


if __name__ == "__main__":
    main()
