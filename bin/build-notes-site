  <p><a href="notes/resources-in-place-4326e6739be1.html">resources-in-place.md</a> &mdash; the master "what's live right now" snapshot (this page's own source).</p>
  <p><a href="browse.html">browse // search</a> &mdash; full-text search across every note on this machine.</p>
</div>
"""


def main():
    OUT.mkdir(parents=True, exist_ok=True)
    notes_dir = OUT / "notes"
    # Slugs hash the full source path -- a moved/renamed file gets a new
    # slug, and the old rendered page for its previous path was otherwise
    # never cleaned up, silently accumulating stale orphans every time
    # something in the four source trees moves. Full rebuild each run
    # anyway, so wiping first is correct, not just tidy.
    if notes_dir.exists():
        for f in notes_dir.glob("*.html"):
            f.unlink()
    notes_dir.mkdir(exist_ok=True)

    notes = collect_notes()
    print(f"found {len(notes)} notes across {len(TREES)} trees")

    index_entries = []
    for n in notes:
        slug = slug_for(n["path"])
        out_file = OUT / "notes" / slug
        body_html = render_markdown(n["content"])
        title = f"{n['tree']}/{n['rel']}"
        page_body = f"<div class='panel'><span class='tag'>{html.escape(n['tree'])}</span>{body_html}</div>"
        page = page_shell(title, page_body, active="browse")
        out_file.write_text(page, encoding="utf-8")

        index_entries.append({
            "tree": n["tree"],
            "rel": n["rel"],
            "href": f"notes/{slug}",
            "content": n["content"][:4000],
        })

    # Browse page
    index_json = json.dumps(index_entries)
    browse_body = """
    <div class="panel">
      <span class="tag">browse // search</span>
      <p style="color:var(--text-mid);font-size:11px;margin-bottom:14px;">
        Searches across arc-lt-cmc, dev-notes, khaos-lab, vault/archive &mdash; titles and content.
      </p>
      <input class="searchbox" id="q" type="text" placeholder="search everything...">
      <div class="stats" id="stats"></div>
      <div id="results"></div>
    </div>
    """
    browse_script = "<script>const INDEX = " + index_json + ";\n" + SEARCH_JS + "</script>"
    (OUT / "browse.html").write_text(
        page_shell("ARCHIVE_SEARCH", browse_body, active="browse", extra_script=browse_script),
        encoding="utf-8",
    )

    # Dashboard (home) page, from resources-in-place.md
    if DASHBOARD_SOURCE.exists():
        dash_html = render_markdown(DASHBOARD_SOURCE.read_text(encoding="utf-8", errors="ignore"))
    else:
        dash_html = "<p>resources-in-place.md not found.</p>"

    dash_body = f"""
    <div class="panel hero">
      <h1>SITES &amp; SERVERS</h1>
      <p class="hero-sub">the living blueprint &mdash; resources-in-place.md, rendered</p>
    </div>
    <div class="panel">{dash_html}</div>
    """
    (OUT / "index.html").write_text(
        page_shell("NOTES_ARCHIVE", dash_body, active="home"),
        encoding="utf-8",
    )

    (OUT / "blueprint.html").write_text(
        page_shell("BLUEPRINT", BLUEPRINT_BODY, active="blueprint"),
        encoding="utf-8",
    )

    (OUT / "style.css").write_text(CSS, encoding="utf-8")

    print(f"built: {OUT}/index.html (dashboard), {OUT}/browse.html (search), {OUT}/blueprint.html")
    print(f"{len(notes)} notes indexed")


if __name__ == "__main__":
    main()
