#!/usr/bin/env python3
"""Local Hub calendar: Orage is read-only; this service owns check marks."""
import argparse
import base64
import hashlib
import json
import os
import re
import secrets
import sqlite3
import tempfile
import threading
import time
from contextlib import contextmanager
from datetime import datetime, timedelta, timezone
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import urlsplit

from dateutil import rrule, tz

HOME = Path.home()
SOURCE = HOME / '.local/share/orage/orage.ics'
STATE = HOME / '.local/share/khaos-hub'
WEB = Path(__file__).resolve().parent.parent / 'apps/khaos-hub/web'
GARAGE_APP = Path(__file__).resolve().parent.parent / 'apps/surgery-workshop/garage.html'
PORT = 8766
ORIGIN = f'http://127.0.0.1:{PORT}'
TOKEN = secrets.token_urlsafe(32)
LOCK = threading.Lock()
LIBRARY_IMPORTS = {}
LIBRARY_IMPORT_LIMIT = 10000
LIBRARY_BODY_LIMIT = 8 * 1024 * 1024
READING_FOLDER = re.compile(r'\b(read\s*later|reading\s*list|to\s*read|pocket|articles?)\b', re.I)


def parse_date(prop, value):
    zone = tz.tzlocal()
    for param in prop.split(';')[1:]:
        if param.startswith('TZID='):
            zone = tz.gettz(param[5:].strip('"')) or zone
    if value.endswith('Z'):
        return datetime.strptime(value, '%Y%m%dT%H%M%SZ').replace(tzinfo=timezone.utc)
    if len(value) == 8:
        return datetime.strptime(value, '%Y%m%d').replace(tzinfo=zone)
    return datetime.strptime(value, '%Y%m%dT%H%M%S').replace(tzinfo=zone)


def calendar_items(source=None, now=None):
    source = source or SOURCE
    now = now or datetime.now(tz.tzlocal())
    today = now.replace(hour=0, minute=0, second=0, microsecond=0)
    lines = []
    raw = source.read_text()
    if not raw.lstrip().startswith('BEGIN:VCALENDAR') or not raw.rstrip().endswith('END:VCALENDAR'):
        raise OSError('Calendar is being rewritten; retry')
    for line in raw.splitlines():
        if line.startswith((' ', '\t')) and lines:
            lines[-1] += line[1:]
        else:
            lines.append(line)
    components, current, depth = [], None, 0
    for line in lines:
        if line in ('BEGIN:VEVENT', 'BEGIN:VTODO') and current is None:
            current = {'kind': line[6:], 'fields': {}}
            depth = 1
        elif current is not None:
            if line.startswith('BEGIN:'):
                depth += 1
            elif line.startswith('END:'):
                depth -= 1
                if depth == 0:
                    components.append(current)
                    current = None
            elif depth == 1 and ':' in line:
                prop, value = line.split(':', 1)
                current['fields'].setdefault(prop.split(';')[0].upper(), []).append((prop, value))
    items, seen, overrides = [], set(), set()
    for component in components:
        fields = component['fields']
        if 'RECURRENCE-ID' in fields and 'UID' in fields:
            try:
                overrides.add((fields['UID'][0][1], parse_date(*fields['RECURRENCE-ID'][0]).isoformat()))
            except ValueError:
                pass
    for component in components:
        f = component['fields']
        value = lambda key, default='': f.get(key, [('', default)])[0][1]
        uid, title = value('UID'), value('SUMMARY')
        if not uid or not title or value('STATUS') == 'CANCELLED':
            continue
        title = title.replace(r'\n', ' ').replace(r'\,', ',').replace(r'\;', ';').replace(r'\\', '\\')
        date_field = f.get('DUE', f.get('DTSTART', [])) if component['kind'] == 'VTODO' else f.get('DTSTART', [])
        try:
            start = parse_date(*date_field[0]) if date_field else None
            dates = [start]
            if value('RRULE') and start and 'RECURRENCE-ID' not in f:
                series = rrule.rruleset()
                series.rrule(rrule.rrulestr(value('RRULE'), dtstart=start))
                for prop, vals in f.get('EXDATE', []):
                    for val in vals.split(','):
                        series.exdate(parse_date(prop, val))
                for prop, vals in f.get('RDATE', []):
                    for val in vals.split(','):
                        series.rdate(parse_date(prop, val))
                dates = []
                for occurrence in series.xafter(today, count=60, inc=True):
                    if occurrence > today + timedelta(days=14):
                        break
                    dates.append(occurrence)
            for date in dates:
                if component['kind'] == 'VEVENT' and (date is None or date < today or date > today + timedelta(days=14)):
                    continue
                stamp = date.isoformat() if date and (value('RRULE') or 'RECURRENCE-ID' in f) else ''
                if 'RECURRENCE-ID' in f:
                    stamp = parse_date(*f['RECURRENCE-ID'][0]).isoformat()
                if 'RECURRENCE-ID' not in f and date and (uid, date.isoformat()) in overrides:
                    continue
                key = hashlib.sha256((uid + '\0' + stamp).encode()).hexdigest()
                if key in seen:
                    continue
                seen.add(key)
                if component['kind'] == 'VTODO':
                    kind = 'To-do'
                else:
                    # Orage stores timed VEVENTs as appointments and date-only
                    # VEVENTs as events. Keep that distinction visible to both UIs.
                    start_prop = date_field[0][0] if date_field else ''
                    kind = 'Appointment' if date and 'VALUE=DATE' not in start_prop and len(date_field[0][1]) > 8 else 'Event'
                all_day = bool(date_field and ('VALUE=DATE' in date_field[0][0] or len(date_field[0][1]) == 8))
                when = (date.strftime('%a %b %d') if date and all_day else
                        date.astimezone().strftime('%a %b %d · %H:%M') if date else 'No due date')
                items.append({'id': key, 'title': title, 'kind': kind,
                              'when': when,
                              'date': date.isoformat() if date else '',
                              'all_day': all_day,
                              'repeating': bool(value('RRULE')),
                              'source_done': value('STATUS') == 'COMPLETED'})
        except (ValueError, TypeError, OverflowError):
            continue
    return sorted(items, key=lambda item: (item['date'] or '9999', item['kind'], item['title']))


@contextmanager
def connection():
    STATE.mkdir(mode=0o700, parents=True, exist_ok=True)
    db = sqlite3.connect(STATE / 'checks.db', timeout=5)
    db.execute('CREATE TABLE IF NOT EXISTS checks (id TEXT PRIMARY KEY, done INTEGER NOT NULL, revision INTEGER NOT NULL)')
    try:
        with db:
            yield db
    finally:
        db.close()


def snapshot():
    items = calendar_items()
    with connection() as db:
        marks = dict((key, (bool(done), revision)) for key, done, revision in db.execute('SELECT id,done,revision FROM checks'))
    for item in items:
        item['done'], item['revision'] = marks.get(item['id'], (item.pop('source_done'), 0))
        item.pop('source_done', None)
    return {'items': items, 'updated': datetime.now().isoformat(), 'scope': 'Shared Hub/Lab check marks; Orage appointments and alarms stay unchanged.'}


def set_checked(data):
    if type(data.get('done')) is not bool or type(data.get('revision')) is not int:
        raise ValueError('Invalid check mark')
    with LOCK:
        item = next((i for i in snapshot()['items'] if i['id'] == data.get('id')), None)
        if not item:
            raise ValueError('Appointment is no longer available')
        if item['revision'] != data['revision']:
            raise RuntimeError('Changed in another view. Refresh and retry.')
        with connection() as db:
            db.execute('INSERT INTO checks VALUES (?,?,?) ON CONFLICT(id) DO UPDATE SET done=excluded.done,revision=excluded.revision',
                       (item['id'], int(data['done']), item['revision'] + 1))
        return snapshot()


@contextmanager
def library_connection():
    STATE.mkdir(mode=0o700, parents=True, exist_ok=True)
    path = STATE / 'library.sqlite3'
    db = sqlite3.connect(path, timeout=5)
    try:
        os.chmod(STATE, 0o700)
        os.chmod(path, 0o600)
    except OSError:
        pass
    db.execute(
        "CREATE TABLE IF NOT EXISTS library ("
        "id TEXT PRIMARY KEY, title TEXT NOT NULL, url TEXT NOT NULL, "
        "kind TEXT NOT NULL, tags TEXT NOT NULL, note TEXT NOT NULL, "
        "created TEXT NOT NULL, updated TEXT NOT NULL, sources TEXT NOT NULL DEFAULT '[]')"
    )
    columns = {row[1] for row in db.execute('PRAGMA table_info(library)')}
    if 'sources' not in columns:
        db.execute("ALTER TABLE library ADD COLUMN sources TEXT NOT NULL DEFAULT '[]'")
    try:
        yield db
        db.commit()
    except Exception:
        db.rollback()
        raise
    finally:
        db.close()


def library_list():
    with library_connection() as db:
        rows = db.execute(
            "SELECT id,title,url,kind,tags,note,created,updated,sources "
            "FROM library ORDER BY updated DESC"
        ).fetchall()
    keys = ('id', 'title', 'url', 'kind', 'tags', 'note', 'created', 'updated', 'sources')
    items = []
    for row in rows:
        item = dict(zip(keys, row))
        try:
            item['sources'] = json.loads(item['sources'])
        except (TypeError, json.JSONDecodeError):
            item['sources'] = []
        items.append(item)
    counts = {kind: sum(item['kind'] == kind for item in items) for kind in
              ('bookmark', 'reading', 'tutorial', 'research', 'incident')}
    return {'items': items, 'stats': {'total': len(items), **counts}}


def validate_library_item(data, allow_id=True):
    if not isinstance(data, dict):
        raise ValueError('Invalid item')
    fields = ('title', 'url', 'kind', 'tags', 'note')
    if any(key in data and not isinstance(data[key], str) for key in fields):
        raise ValueError('Library fields must be text')
    title = data.get('title', '').strip()
    url = data.get('url', '').strip()
    kind = data.get('kind', 'bookmark')
    tags = data.get('tags', '').strip()
    note = data.get('note', '').strip()
    if not title or len(title) > 180:
        raise ValueError('Title required (180 characters max)')
    parsed = urlsplit(url) if url else None
    if len(url) > 2048 or (url and (
        parsed.scheme.lower() not in ('http', 'https') or not parsed.hostname
        or parsed.username or parsed.password
        or any(ord(char) < 32 for char in url)
    )):
        raise ValueError('Use a valid http or https URL without embedded credentials')
    if kind not in ('bookmark', 'reading', 'tutorial', 'research', 'incident'):
        raise ValueError('Invalid library type')
    if len(tags) > 240 or len(note) > 4000:
        raise ValueError('Tags or note are too long')
    item_id = data.get('id') if allow_id else None
    if item_id is not None and (not isinstance(item_id, str) or len(item_id) > 40
                                or not item_id.replace('-', '').replace('_', '').isalnum()):
        raise ValueError('Invalid item identifier')
    return {'id': item_id, 'title': title, 'url': url, 'kind': kind, 'tags': tags, 'note': note}


def normalized_library_url(url):
    if not url:
        return ''
    parsed = urlsplit(url)
    scheme = parsed.scheme.lower()
    hostname = (parsed.hostname or '').lower()
    try:
        port = parsed.port
    except ValueError:
        return url
    host = f'[{hostname}]' if ':' in hostname else hostname
    if port and not ((scheme == 'http' and port == 80) or (scheme == 'https' and port == 443)):
        host += f':{port}'
    path = parsed.path or ''
    if path == '/':
        path = ''
    return f'{scheme}://{host}{path}' + (f'?{parsed.query}' if parsed.query else '') + (f'#{parsed.fragment}' if parsed.fragment else '')


def _source_record(value, fallback_title=''):
    if not isinstance(value, dict):
        return None
    clean = {}
    for key, limit in (('browser', 40), ('profile', 80), ('folder', 512), ('title', 180)):
        item = value.get(key, '')
        if not isinstance(item, str):
            return None
        clean[key] = item.strip()[:limit]
    if not clean['browser']:
        return None
    if not clean['title']:
        clean['title'] = fallback_title[:180]
    return clean


def library_backup():
    source = STATE / 'library.sqlite3'
    if not source.exists() or source.stat().st_size == 0:
        return ''
    backup_dir = STATE / 'backups'
    backup_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(backup_dir, 0o700)
    stamp = datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%SZ')
    target = backup_dir / f'library-{stamp}-{secrets.token_hex(3)}.sqlite3'
    src = sqlite3.connect(f'file:{source}?mode=ro', uri=True, timeout=5)
    dst = sqlite3.connect(target, timeout=5)
    try:
        src.backup(dst)
        check = dst.execute('PRAGMA quick_check').fetchone()
        if not check or check[0] != 'ok':
            raise sqlite3.DatabaseError('Library backup verification failed')
    finally:
        dst.close()
        src.close()
    os.chmod(target, 0o600)
    backups = sorted(backup_dir.glob('library-*.sqlite3'), key=lambda item: item.stat().st_mtime, reverse=True)
    for old in backups[5:]:
        old.unlink(missing_ok=True)
    return str(target)


def library_save(data):
    item = validate_library_item(data)
    title, url, kind, tags, note = (item[key] for key in ('title', 'url', 'kind', 'tags', 'note'))
    item_id = item['id'] or secrets.token_urlsafe(12)
    now = datetime.now(timezone.utc).isoformat(timespec='seconds')
    with library_connection() as db:
        exists = db.execute('SELECT 1 FROM library WHERE id=?', (item_id,)).fetchone()
        if exists:
            db.execute(
                'UPDATE library SET title=?,url=?,kind=?,tags=?,note=?,updated=? WHERE id=?',
                (title, url, kind, tags, note, now, item_id),
            )
        else:
            db.execute(
                'INSERT INTO library(id,title,url,kind,tags,note,created,updated,sources) VALUES (?,?,?,?,?,?,?,?,?)',
                (item_id, title, url, kind, tags, note, now, now, '[]'),
            )
    return library_list()


def library_import_items(items, source_label='JSON import'):
    if not isinstance(items, list) or len(items) > LIBRARY_IMPORT_LIMIT:
        raise ValueError(f'Import must contain at most {LIBRARY_IMPORT_LIMIT} items')
    grouped = {}
    blank_urls = []
    duplicate_in_batch = 0
    for raw in items:
        item = validate_library_item(raw, allow_id=False)
        source_values = raw.get('sources', []) if isinstance(raw, dict) else []
        if not isinstance(source_values, list) or len(source_values) > 100:
            raise ValueError('Invalid source details')
        sources = [record for record in (_source_record(value, item['title']) for value in source_values) if record]
        if source_label:
            sources.append({'browser': source_label, 'profile': '', 'folder': '', 'title': item['title']})
        key = normalized_library_url(item['url'])
        if not key:
            blank_urls.append((item, sources))
            continue
        if key in grouped:
            duplicate_in_batch += 1
            previous = grouped[key]
            previous['sources'].extend(sources)
            if item['kind'] == 'reading' and previous['item']['kind'] == 'bookmark':
                previous['item']['kind'] = 'reading'
        else:
            grouped[key] = {'item': item, 'sources': sources}
    now = datetime.now(timezone.utc).isoformat(timespec='seconds')
    backup = library_backup()
    added = merged = 0
    with library_connection() as db:
        db.execute('BEGIN IMMEDIATE')
        rows = db.execute('SELECT id,title,url,kind,tags,note,created,updated,sources FROM library').fetchall()
        existing = {normalized_library_url(row[2]): row for row in rows if row[2]}
        for key, group in grouped.items():
            item, sources = group['item'], group['sources']
            if key in existing:
                row = existing[key]
                try:
                    old_sources = json.loads(row[8])
                except (TypeError, json.JSONDecodeError):
                    old_sources = []
                combined = []
                seen = set()
                for source in old_sources + sources:
                    clean = _source_record(source)
                    if not clean:
                        continue
                    marker = tuple(clean.values())
                    if marker not in seen:
                        combined.append(clean)
                        seen.add(marker)
                new_kind = 'reading' if item['kind'] == 'reading' and row[3] == 'bookmark' else row[3]
                db.execute('UPDATE library SET sources=?,kind=?,updated=? WHERE id=?',
                           (json.dumps(combined, ensure_ascii=False), new_kind, now, row[0]))
                merged += 1
            else:
                item_id = secrets.token_urlsafe(12)
                unique_sources = []
                seen = set()
                for source in sources:
                    clean = _source_record(source, item['title'])
                    if clean and tuple(clean.values()) not in seen:
                        unique_sources.append(clean)
                        seen.add(tuple(clean.values()))
                db.execute('INSERT INTO library(id,title,url,kind,tags,note,created,updated,sources) VALUES (?,?,?,?,?,?,?,?,?)',
                           (item_id, item['title'], item['url'], item['kind'], item['tags'], item['note'], now, now,
                            json.dumps(unique_sources, ensure_ascii=False)))
                added += 1
        for item, sources in blank_urls:
            item_id = secrets.token_urlsafe(12)
            db.execute('INSERT INTO library(id,title,url,kind,tags,note,created,updated,sources) VALUES (?,?,?,?,?,?,?,?,?)',
                       (item_id, item['title'], '', item['kind'], item['tags'], item['note'], now, now,
                        json.dumps(sources, ensure_ascii=False)))
            added += 1
    return {'added': added, 'merged': merged, 'duplicates_in_batch': duplicate_in_batch,
            'skipped': 0, 'backup_created': bool(backup), **library_list()}


def _source_item(browser, profile, folder, title, url, reading=False):
    try:
        parsed = urlsplit(url)
        if parsed.scheme.lower() not in ('http', 'https') or not parsed.hostname or parsed.username or parsed.password:
            return None
    except (TypeError, ValueError):
        return None
    title = str(title or parsed.hostname).strip()
    title = ''.join(char for char in title if ord(char) >= 32)[:180] or parsed.hostname
    folder = str(folder or 'Bookmarks')[:512]
    return {'title': title, 'url': url[:2048], 'kind': 'reading' if reading or READING_FOLDER.search(folder) else 'bookmark',
            'tags': '', 'note': '', 'sources': [{'browser': browser, 'profile': profile,
                                                  'folder': folder, 'title': title}]}


def read_chromium_bookmarks(path, browser, profile):
    path = Path(path)
    with path.open('rb') as stream:
        before = os.fstat(stream.fileno())
        if before.st_size > 32 * 1024 * 1024:
            raise ValueError('Bookmark file exceeds the 32 MiB safety limit')
        raw = stream.read(32 * 1024 * 1024 + 1)
        after = os.fstat(stream.fileno())
    if (before.st_ino, before.st_size, before.st_mtime_ns) != (after.st_ino, after.st_size, after.st_mtime_ns):
        raise RuntimeError('Bookmark file changed during scan; preview again')
    data = json.loads(raw)
    items = []
    roots = data.get('roots', {})
    def walk(node, folders, reading=False):
        if not isinstance(node, dict):
            return
        name = node.get('name', '')
        kind = node.get('type')
        if kind == 'url':
            item = _source_item(browser, profile, ' / '.join(folders), node.get('name', ''), node.get('url', ''), reading)
            if item:
                items.append(item)
            return
        next_folders = folders + ([str(name)[:120]] if name and
                                   (not folders or str(name).casefold() != folders[-1].casefold()) else [])
        is_reading = reading or name.lower().replace('_', ' ') in ('reading list', 'read later')
        children = node.get('children', [])
        if isinstance(children, list):
            for child in children:
                walk(child, next_folders, is_reading)
    for root_name, node in roots.items():
        label = {'bookmark_bar': 'Bookmarks bar', 'other': 'Other bookmarks', 'synced': 'Synced bookmarks',
                 'reading_list': 'Reading list'}.get(root_name, root_name.replace('_', ' ').title())
        walk(node, [label], root_name == 'reading_list')
    if len(items) > LIBRARY_IMPORT_LIMIT:
        raise ValueError('Profile exceeds the 10,000 item safety limit')
    return items


def read_firefox_bookmarks(path, browser, profile):
    path = Path(path)
    if path.stat().st_size > 256 * 1024 * 1024:
        raise ValueError('Places database exceeds the 256 MiB safety limit')
    wal = Path(str(path) + '-wal')
    if wal.exists() and wal.stat().st_size > 256 * 1024 * 1024:
        raise ValueError('Places WAL exceeds the 256 MiB safety limit')
    with tempfile.TemporaryDirectory(prefix='khaos-hub-places-') as temp:
        copied = Path(temp) / 'places.sqlite'
        source = sqlite3.connect(path.as_uri() + '?mode=ro', uri=True, timeout=5)
        snapshot = sqlite3.connect(copied, timeout=5)
        try:
            source.backup(snapshot)
        finally:
            snapshot.close()
            source.close()
        db = sqlite3.connect(f'file:{copied}?mode=ro', uri=True, timeout=5)
        db.row_factory = sqlite3.Row
        try:
            db.execute('PRAGMA query_only=ON')
            bookmarks = {row['id']: row for row in db.execute('SELECT id,parent,title,type,fk FROM moz_bookmarks')}
            places = {row['id']: row for row in db.execute('SELECT id,url,title FROM moz_places')}
            items = []
            for bookmark in bookmarks.values():
                if bookmark['type'] != 1 or bookmark['fk'] not in places:
                    continue
                place = places[bookmark['fk']]
                folders = []
                parent = bookmark['parent']
                visited = set()
                while parent in bookmarks and parent not in visited and len(folders) < 32:
                    visited.add(parent)
                    ancestor = bookmarks[parent]
                    if ancestor['title']:
                        folders.append(str(ancestor['title']))
                    parent = ancestor['parent']
                folder = ' / '.join(reversed(folders)) or 'Bookmarks'
                item = _source_item(browser, profile, folder, bookmark['title'] or place['title'] or '', place['url'])
                if item:
                    items.append(item)
                if len(items) > LIBRARY_IMPORT_LIMIT:
                    raise ValueError('Profile exceeds the 10,000 item safety limit')
            return items
        finally:
            db.close()


def collect_browser_bookmarks():
    home = Path.home()
    roots = [
        ('Brave', [home / '.config/BraveSoftware/Brave-Browser', home / '.var/app/com.brave.Browser/config/BraveSoftware/Brave-Browser']),
        ('Chromium', [home / '.config/chromium', home / '.var/app/org.chromium.Chromium/config/chromium']),
        ('Chrome', [home / '.config/google-chrome', home / '.var/app/com.google.Chrome/config/google-chrome']),
        ('Vivaldi', [home / '.config/vivaldi']),
        ('Edge', [home / '.config/microsoft-edge']),
    ]
    items, counts, errors = [], [], []
    for browser, candidates in roots:
        for root in candidates:
            if not root.is_dir():
                continue
            try:
                safe_root = root.resolve()
                profiles = [root] if (root / 'Bookmarks').is_file() else sorted(
                    path for path in root.iterdir() if path.is_dir() and (path / 'Bookmarks').is_file()
                    and path.resolve().is_relative_to(safe_root)
                )
            except OSError:
                errors.append(f'{browser}: profile directory unavailable')
                continue
            for index, profile_path in enumerate(profiles, 1):
                label = 'Default' if profile_path.name == 'Default' else f'Profile {index}'
                try:
                    found = read_chromium_bookmarks(profile_path / 'Bookmarks', browser, label)
                    items.extend(found)
                    counts.append({'browser': browser, 'profile': label, 'count': len(found),
                                   'reading': sum(item['kind'] == 'reading' for item in found)})
                except (OSError, ValueError, RuntimeError, json.JSONDecodeError) as error:
                    errors.append(f'{browser} {label}: {str(error)[:160]}')
    firefox_root = home / '.mozilla/firefox'
    if firefox_root.is_dir():
        try:
            profiles = sorted(path for path in firefox_root.iterdir() if path.is_dir()
                              and (path / 'places.sqlite').is_file()
                              and path.resolve().is_relative_to(firefox_root.resolve()))
        except OSError:
            profiles = []
            errors.append('Firefox: profile directory unavailable')
        for index, profile_path in enumerate(profiles, 1):
            label = f'Profile {index}'
            try:
                found = read_firefox_bookmarks(profile_path / 'places.sqlite', 'Firefox', label)
                items.extend(found)
                counts.append({'browser': 'Firefox', 'profile': label, 'count': len(found),
                               'reading': sum(item['kind'] == 'reading' for item in found)})
            except (OSError, ValueError, RuntimeError, sqlite3.Error) as error:
                errors.append(f'Firefox {label}: {str(error)[:160]}')
    if len(items) > LIBRARY_IMPORT_LIMIT:
        raise ValueError('Combined browser bookmarks exceed the 10,000 item safety limit')
    return items, counts, errors


def library_browser_preview():
    items, counts, errors = collect_browser_bookmarks()
    existing = set()
    with library_connection() as db:
        existing = {normalized_library_url(row[0]) for row in db.execute('SELECT url FROM library WHERE url<>\'\'')}
    seen = set()
    matching = duplicate_in_scan = will_add = 0
    for item in items:
        key = normalized_library_url(item['url'])
        if not key:
            will_add += 1
        elif key in seen:
            duplicate_in_scan += 1
        elif key in existing:
            matching += 1
        else:
            will_add += 1
        seen.add(key)
    scan_id = secrets.token_urlsafe(20)
    now = time.monotonic()
    with LOCK:
        for key, value in list(LIBRARY_IMPORTS.items()):
            if now - value['created'] > 300:
                del LIBRARY_IMPORTS[key]
        LIBRARY_IMPORTS[scan_id] = {'created': now, 'items': items, 'counts': counts, 'errors': errors}
    return {'scan_id': scan_id, 'counts': counts, 'total': len(items), 'errors': errors,
            'will_add': will_add, 'matching': matching, 'duplicates_in_scan': duplicate_in_scan,
            'message': 'Titles, URLs, and folder names stay on this computer.'}


def library_browser_import(data):
    if not isinstance(data, dict) or data.get('confirmed') is not True:
        raise ValueError('Explicit confirmation is required')
    scan_id = data.get('scan_id')
    if not isinstance(scan_id, str) or len(scan_id) > 80:
        raise ValueError('Preview expired; scan again')
    with LOCK:
        scan = LIBRARY_IMPORTS.pop(scan_id, None)
    if not scan or time.monotonic() - scan['created'] > 300:
        raise ValueError('Preview expired; scan again')
    if scan['errors']:
        raise ValueError('Some browser profiles could not be read. Review the preview and resolve those profiles before importing.')
    result = library_import_items(scan['items'], source_label='')
    result['sources_scanned'] = scan['counts']
    return result


def library_delete(data):
    item_id = data.get('id') if isinstance(data, dict) else None
    if not isinstance(item_id, str) or len(item_id) > 40:
        raise ValueError('Invalid item identifier')
    with library_connection() as db:
        db.execute('DELETE FROM library WHERE id=?', (item_id,))
    return library_list()


def garage_csp():
    """Build the Garage policy from its exact inline script and style bytes."""
    html = GARAGE_APP.read_text(encoding='utf-8')
    hashes = {}
    for tag in ('script', 'style'):
        match = re.search(rf'<{tag}[^>]*>(.*?)</{tag}>', html, re.S)
        if not match:
            raise ValueError(f'Garage is missing its inline {tag}')
        digest = base64.b64encode(hashlib.sha256(match.group(1).encode()).digest()).decode()
        hashes[tag] = f"'sha256-{digest}'"
    return ("default-src 'none'; "
            f"script-src {hashes['script']}; style-src {hashes['style']}; "
            "img-src data:; connect-src 'none'; font-src 'none'; object-src 'none'; "
            "frame-ancestors 'none'; base-uri 'none'; form-action 'none'")


def static_assets():
    """Return the exact static routes served by the local Hub."""
    return {
        '/': (WEB, 'index.html', 'text/html; charset=utf-8'),
        '/app.js': (WEB, 'app.js', 'text/javascript'),
        '/app.css': (WEB, 'app.css', 'text/css'),
        '/icon.svg': (WEB, 'icon.svg', 'image/svg+xml'),
        '/icon-kimi-512.png': (WEB, 'icon-kimi-512.png', 'image/png'),
        '/icon-kimi-round-512.png': (WEB, 'icon-kimi-round-512.png', 'image/png'),
        '/khaos-lab-mark-round.png': (WEB, 'khaos-lab-mark-round.png', 'image/png'),
        '/khaos-lab-mark-round-512.png': (WEB, 'khaos-lab-mark-round-512.png', 'image/png'),
        '/khaos-lab-mark.png': (WEB, 'khaos-lab-mark.png', 'image/png'),
        '/khaos-lab-mark-512.png': (WEB, 'khaos-lab-mark-512.png', 'image/png'),
        '/kimi-khaos-hub.png': (WEB, 'kimi-khaos-hub.png', 'image/png'),
        '/kimi-wallpaper.jpg': (WEB, 'kimi-wallpaper.jpg', 'image/jpeg'),
        '/favicon.ico': (WEB, 'khaos-lab-mark-round-512.png', 'image/png'),
        '/manifest.webmanifest': (WEB, 'manifest.webmanifest', 'application/manifest+json'),
        '/garage': (GARAGE_APP.parent, GARAGE_APP.name, 'text/html; charset=utf-8'),
        '/garage/': (GARAGE_APP.parent, GARAGE_APP.name, 'text/html; charset=utf-8'),
        '/garage/index.html': (GARAGE_APP.parent, GARAGE_APP.name, 'text/html; charset=utf-8'),
        '/horizon-dusk.jpg': (GARAGE_APP.parent, 'horizon-dusk.jpg', 'image/jpeg'),
    }


class Handler(BaseHTTPRequestHandler):
    def setup(self):
        super().setup()
        self.connection.settimeout(5)

    def reply(self, code, body, mime='application/json'):
        payload = json.dumps(body).encode() if mime == 'application/json' else body
        self.send_response(code)
        self.send_header('Content-Type', mime)
        self.send_header('Content-Length', str(len(payload)))
        self.send_header('Cache-Control', 'no-store')
        self.send_header('X-Content-Type-Options', 'nosniff')
        if urlsplit(self.path).path.startswith('/garage'):
            csp = garage_csp()
        else:
            csp = "default-src 'self'; connect-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'none'"
        self.send_header('Content-Security-Policy', csp)
        self.end_headers()
        self.wfile.write(payload)

    def allowed(self):
        return (self.headers.get('Host') == f'127.0.0.1:{PORT}'
                and self.headers.get('Sec-Fetch-Site') not in ('cross-site', 'same-site')
                and self.headers.get('Origin', ORIGIN) == ORIGIN)

    def do_GET(self):
        if not self.allowed():
            return self.reply(403, {'error': 'Local access only'})
        path = urlsplit(self.path).path
        try:
            if path == '/api/calendar':
                return self.reply(200, snapshot())
            if path == '/api/library':
                return self.reply(200, library_list())
            if path == '/api/library/browser-preview':
                return self.reply(200, library_browser_preview())
            if path == '/api/session':
                return self.reply(200, {'token': TOKEN})
            assets = static_assets()
            if path in assets:
                root, name, mime = assets[path]
                return self.reply(200, (root / name).read_bytes(), mime)
            self.reply(404, {'error': 'Not found'})
        except (OSError, sqlite3.Error, RuntimeError):
            self.reply(503, {'error': 'Calendar unavailable; retry shortly.'})

    def do_POST(self):
        if not self.allowed() or self.headers.get('X-Hub-Token') != TOKEN:
            return self.reply(403, {'error': 'Refresh your local Hub session'})
        if self.path not in ('/api/calendar/check', '/api/library/save', '/api/library/delete',
                             '/api/library/import', '/api/library/browser-import'):
            return self.reply(404, {'error': 'Not found'})
        try:
            length = int(self.headers.get('Content-Length', '0'))
            limit = 2048 if self.path == '/api/calendar/check' else (
                LIBRARY_BODY_LIMIT if self.path in ('/api/library/import', '/api/library/browser-import') else 8192
            )
            if not 0 < length <= limit or self.headers.get('Content-Type') != 'application/json':
                raise ValueError('Invalid request')
            data = json.loads(self.rfile.read(length))
            if not isinstance(data, dict):
                raise ValueError('Invalid request')
            routes = {
                '/api/calendar/check': set_checked,
                '/api/library/save': library_save,
                '/api/library/delete': library_delete,
                '/api/library/import': lambda value: library_import_items(value.get('items'), 'JSON import'),
                '/api/library/browser-import': library_browser_import,
            }
            result = routes[self.path](data)
            self.reply(200, result)
        except RuntimeError as e:
            self.reply(409, {'error': str(e)})
        except (ValueError, TypeError) as e:
            self.reply(400, {'error': str(e)})
        except (OSError, sqlite3.Error):
            self.reply(503, {'error': 'Could not save; refresh and retry.'})

    def log_message(self, *_args):
        pass  # Do not log private calendar entries.


if __name__ == '__main__':
    argparse.ArgumentParser(description=__doc__).parse_args()
    os.umask(0o077)
    server = ThreadingHTTPServer(('127.0.0.1', PORT), Handler)
    server.daemon_threads = True
    print(f'Khaos Hub local calendar: {ORIGIN}', flush=True)
    server.serve_forever()
