#!/usr/bin/env python3
"""arc-notify-theme -- keep the stock XFCE notification popups on the Kataleya phase colour.

arc-pine bubbles already follow the phase live. Popups from other apps (Brave, Thunar,
MEGAsync ...) are drawn by xfce4-notifyd from GTK CSS, which can't follow the clock, so this
regenerates ~/.config/gtk-3.0/arc-notify.css (imported by gtk.css) with the current phase
accent and restarts the popup daemon only when the accent actually changed.
Run at login and at each phase boundary by arc-notify-theme.timer. Scoped to
#XfceNotifyWindow only -- no other GTK3 app is affected.
"""
import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import _arc_ui as ui  # noqa: E402

OUT = Path.home() / ".config/gtk-3.0/arc-notify.css"

TEMPLATE = """/* GENERATED by arc-notify-theme -- do not edit. phase: {phase} */
#XfceNotifyWindow {{
  background-color: rgba({sr}, {sg}, {sb}, 0.84);
  background-image: linear-gradient(to bottom, rgba(255,255,255,0.06), rgba(255,255,255,0));
  color: {fg};
  border: 1px solid rgba({ar}, {ag}, {ab}, 0.45);
  border-radius: 16px;
  box-shadow: 0 6px 22px rgba(0, 0, 0, 0.38);
  font-family: Lato, Cantarell, "DejaVu Sans", sans-serif;
}}
#XfceNotifyWindow label {{ color: {fg}; }}
#XfceNotifyWindow label#summary {{ font-weight: bold; font-size: 11pt; letter-spacing: 0.2px; }}
#XfceNotifyWindow label#body {{ color: {muted}; font-size: 10pt; }}
#XfceNotifyWindow button, #XfceNotifyWindow button.flat {{
  background: rgba({ar}, {ag}, {ab}, 0.16);
  border: none;
  border-radius: 10px;
  color: {fg};
}}
#XfceNotifyWindow button:hover {{ background: rgba({ar}, {ag}, {ab}, 0.30); }}
#XfceNotifyWindow progressbar trough {{ background: rgba(255,255,255,0.10); border-radius: 4px; min-height: 4px; }}
#XfceNotifyWindow progressbar progress {{ background: {accent}; border-radius: 4px; min-height: 4px; }}
"""


def render():
    phase, accent = ui.phase_info()
    c = ui.circadian()
    sr, sg, sb = ui._hex_to_rgb(c["surface"])
    ar, ag, ab = ui._hex_to_rgb(accent)
    return phase, TEMPLATE.format(phase=phase, accent=accent, fg=c["fg"], muted=c["fg_muted"],
                                  sr=sr, sg=sg, sb=sb, ar=ar, ag=ag, ab=ab)


def main():
    phase, css = render()
    old = OUT.read_text() if OUT.exists() else ""
    # restart only when the phase/accent line changed (surface drifts a little within a phase)
    changed = old.split("\n", 1)[0] != css.split("\n", 1)[0]
    OUT.parent.mkdir(parents=True, exist_ok=True)
    tmp = OUT.with_suffix(".tmp")
    tmp.write_text(css)
    os.replace(tmp, OUT)
    if changed:
        subprocess.run(["pkill", "-x", "xfce4-notifyd"], check=False)  # dbus-activated again on the next popup
    print(f"arc-notify-theme: {phase}{' (popup daemon restarted)' if changed else ''}")


if __name__ == "__main__":
    main()
