        # wazuh-cloud: added 2026-09-08, replacing the retired-OSSIM lab plan
        # (see aws-infra's variables.tf for the full reasoning). Same
        # tunnel+launch cloud-open pattern, same no-Elastic-IP live-lookup
        # convention. Longer start timeout than gvm-cloud's -- a from-scratch
        # rebuild's first boot runs the real 5-10min manager+indexer+
        # dashboard install, not just a docker compose up.
        Action("wazuh-cloud: status", "arc wazuh cloud-status"),
        Action("wazuh-cloud: start",  "arc wazuh cloud-start", confirm=True, timeout=600),
        Action("wazuh-cloud: stop",   "arc wazuh cloud-stop", confirm=True, timeout=60),
        Action("Open Wazuh dashboard (browser, cloud)", "arc wazuh cloud-open", timeout=20),
        # ZAP's real day-to-day "interface" is its desktop GUI app, not a
        # browser tab -- daemon mode (arc zap start) is an API-only scan
        # backend for `arc zap spider/active <target>`, out of scope for a
        # one-click GUI button (needs a real target argument, and first-run
        # addon install can take minutes). Status only for the daemon,
        # `gui` launches the actual app people look at.
        Action("ZAP: status",       "arc zap status"),
        Action("ZAP: open desktop app", "arc zap gui", detach=True),
        # Kismet: real wireless recon monitor, but genuinely disruptive --
        # takes the only WiFi adapter into monitor mode, dropping WiFi/VPN
        # for as long as it runs (confirmed in arc-kismet's own header
        # comment, plus a real 2026-08-23 incident where a crash left wlan0
        # dead until reboot). Warning lives right in the button label, not
        # just the confirm dialog -- confirm=True alone wasn't judged
        # enough given the history here.
        Action("Kismet: status",    "arc kismet status"),
        Action("Kismet: start (drops WiFi/VPN while running!)", "arc kismet start", confirm=True, timeout=15),
        Action("Kismet: stop (restores WiFi/VPN)", "arc kismet stop", confirm=True, timeout=20),
        Action("Open Kismet dashboard (browser)", "xdg-open http://127.0.0.1:2501"),
    ],
    # Cloud -- new 2026-09-10, v2 sweep. The always-on py-bite EC2 box plus
    # the two account-level cost/usage checks -- none of this had ANY
    # panel presence before (the SOC category's "cloud" entries are the
    # on-demand security labs, gvm/wazuh/soc-lab-cloud -- a different
    # thing entirely from py-bite, which is the always-running personal
    # server). `arc aws` needs ~/.ssh/py-bite.pem -- confirmed missing on
    # this machine right now (checked live), so `status`/`logs`/`htop`
    # will honestly report that until the key's restored from vault
    # backup. Wired anyway -- an honest "key not found" is real, useful
    # information, better than the box having zero panel presence at all.
    "Cloud": [
        Action("py-bite: status", "arc aws status", timeout=20),
        Action("py-bite: recent auth.log", "arc aws logs", timeout=20),
        Action("Combined AWS snapshot (both cloud instances + budget)", "arc aws-status", timeout=20),
        Action("Cloudflare Workers usage (free-tier check)", "arc cf-watch", timeout=15),
        Action("Cloudflare Workers usage: recent history", "arc cf-watch log"),
    ],
    # Dev -- new 2026-09-10. kali-workbench had zero panel presence;
    # confirmed live it doesn't currently exist on this machine
    # ("container not found") -- `start` should create it per `arc kali`'s
    # own doc ("starts it if stopped"), wired anyway so that's a one-click
    # provision rather than a remembered terminal command. `arc mirrors`
    # (sync-mirrors cron status) is read-only, sudo-free.
    "Dev": [
        Action("Kali container: status", "arc kali status", timeout=15),
        Action("Kali container: start",  "arc kali start", confirm=True, timeout=60),
        Action("Kali container: stop",   "arc kali stop", confirm=True, timeout=20),
        Action("Kali container: recent logs", "arc kali logs", timeout=15),
        Action("Mirror sync: status (sync-mirrors cron)", "arc mirrors", timeout=15),
    ],
    # Remote Access -- new 2026-09-10. This controls actual inbound access
    # to this machine (Cloudflare Tunnel + VNC bundle) and had zero panel
    # presence -- deserves clear visibility given the security sensitivity,
    # not just a command someone has to remember exists. Confirmed live:
    # not installed on this machine right now, first-time setup needs
    # `sudo bash ~/khaos-lab/setup-local-desktop-vnc.sh` run from a real
    # terminal (one-time, needs a real sudo TTY) -- status is wired since
    # it reports that honestly and instantly; start/stop wired too since
    # once installed they're the actual real control surface for this,
    # but if run before setup they'll just surface the same "not installed"
    # message, not hang (verified `status` returns instantly, no sudo
    # prompt, when uninstalled).
    "Remote Access": [
        Action("Status (Cloudflare Tunnel + VNC)", "arc desktop status", timeout=15),
        Action("Enable (survives reboot until stopped)", "arc desktop start", confirm=True, timeout=30),
        Action("Disable (full teardown)", "arc desktop stop", confirm=True, timeout=20),
    ],
    "Maintenance": [
        Action("Disk overview",     "arc disk"),
        Action("System health",     "arc health"),
        Action("Git repo audit",    "arc audit", timeout=60),
        Action("Deep clean (cache/apt/journal)", "arc clean", confirm=True, timeout=120),
        Action("Update system (apt)", "arc update", confirm=True, timeout=300),
        Action("Backup now",        "arc backup", confirm=True, timeout=60),
        # v2 sweep additions, 2026-09-10:
        # - `arc mount`: trivial, was missing, genuinely useful one-click.
        # - `arc snap`: confirmed live this is a REAL Timeshift snapshot
        #   (full rsync of the root filesystem via the same mechanism as
        #   timeshift-check), not a quick MEGA sync as its one-line help
        #   text implies -- genuinely slow (minutes), confirm-gated with a
        #   long timeout matching the pattern already used for lynis/
        #   wazuh-cloud-start.
        # - `arc sweep status`/`dry`: read-only preview only, never `purge`
        #   (that's a real delete, terminal-only on purpose).
        # - `arc disk caches`/`clean`: caches is a sized report (safe),
        #   clean actually reclaims space (confirm-gated, matches update/
        #   backup's own pattern).
        # - `arc keys`: public keys only, pure read -- does NOT re-add
        #   `guard`/`guard-quiet` as a button, matches standing memory
        #   (feedback_manual_start_tools.md) that this stays manual/opt-in.
        # - `arc browser-clean`: closes Brave+Firefox as a side effect,
        #   confirm-gated like the other disruptive fixes below.
        # - `arc logs ts`: Timeshift's own backup log, glob-picks the
        #   latest run -- doesn't fit LOG_SOURCES' fixed-path shape, wired
        #   as a plain action instead, reuses the CLI's own logic as-is.
        # arc day (morning startup: USB check, backup status, repos) --
        # verified sudo-free, safe one-click. arc sync (vault -> MEGA)
        # deliberately NOT wired -- `sudo /usr/local/bin/vault-backup-mega`
        # with no `-n`, same no-TTY trap as the clamav/chkrootkit/
        # rkhunter scan-triggers above. arc mega (browse MEGA) also
        # excluded -- needs a mode argument (ls/lsd/tree), same class as
        # rename/wire/mirror being left terminal-only.
        Action("Morning startup check (arc day)", "arc day", timeout=20),
        Action("Mount USB vault", "arc mount", timeout=15),
        Action("System snapshot (Timeshift, slow)", "arc snap", confirm=True, timeout=600),
        Action("Home sweep: status", "arc sweep status"),
        Action("Home sweep: dry run (preview only)", "arc sweep dry", timeout=20),
        Action("Disk: reclaimable caches (report only)", "arc disk caches", timeout=15),
        Action("Disk: clean reclaimable caches", "arc disk clean", confirm=True, timeout=60),
        Action("SSH public keys (both accounts)", "arc keys"),
        Action("Browser cache clean (closes Brave+Firefox)", "arc browser-clean", confirm=True, timeout=30),
        Action("Timeshift backup log", "arc logs ts", timeout=15),
        # arc-sot: the canonical SOT repo for every personal script (incl.
        # this app) -- status is a safe read-only drift check, snapshot
        # commits+pushes+mirrors to USB (confirm-gated, real network/git
        # action). pull/bootstrap deliberately not buttons here -- both are
        # rarer, more consequential operations (pull needs a clean working
        # tree or it refuses; bootstrap is for a machine that isn't this
        # one) better run deliberately from a terminal, not a one-click.
        Action("Personal tooling: status (arc sot)", "arc sot status"),
        Action("Personal tooling: snapshot (arc sot)", "arc sot snapshot", confirm=True, timeout=60),
        # Quick Fixes -- one of 3 things picked from `arc help`'s full list
        # (2026-08-31) to wire in here: one-click remediation for the
        # handful of annoyances that otherwise mean remembering a terminal
        # command. Brave/WiFi confirm-gated since they have a real,
        # if brief, disruptive side effect (closed tabs / dropped
        # connectivity); display/audio are quick and safe, left one-click.
        # Panel gets its own extra-cautious label -- a real outage happened
        # once this session restarting it, not a hypothetical risk.
        Action("Fix: relaunch Brave",       "arc fix brave", confirm=True),
        Action("Fix: restart display compositor", "arc fix display"),
        Action("Fix: WiFi toggle off/on",   "arc fix wifi", confirm=True, timeout=15),
        Action("Fix: audio profile",        "arc fix audio"),
        Action("Fix: taskbar panel (has caused a real outage before)", "arc fix panel", confirm=True),
    ],
    "Personal": [
        Action("Break timer status", "arc break status"),
        Action("Break: start",      "arc break start"),
        Action("Break: stop",       "arc break stop"),
        # These three launch a *persistent* GUI window that stays open
        # until the user closes it -- `arc break gui` in particular calls
        # Tkinter's own mainloop() directly (blocking) -- launched via
        # launch_detached() (Popen with DEVNULL-redirected stdio), not the
        # normal run()/capture_output path, which was confirmed live to
        # hang indefinitely on any backgrounded GUI process regardless of
        # shell-level `&`/`nohup` (a real Python subprocess pipe-inheritance
        # gotcha, not an arc-break-specific issue).
        Action("Break: open GUI",   "arc-break gui", detach=True),
        Action("Open arc-pine (notification history/settings)", "arc-pine", detach=True),
        # 3rd of 3 things picked from `arc help` (2026-08-31) -- quick,
        # non-interactive count check, distinct from the GUI launch above.
        Action("Notification history: count", "arc notify status"),
        # Emoji picker + TOTP authenticator removed from this panel 2026-09-07
        # (user's call) -- both still exist and work as `arc emoji`/`arc auth`
        # from a real terminal, just not surfaced as panel buttons anymore.
    ],
}


def main():
    # className explicit, not left at Tk's own default -- real bug found
    # 2026-08-27: WM_CLASS was actually just generic "Tk" this whole time
    # (confirmed via `xprop WM_CLASS`), never "khaos-lab" as the .desktop
    # file's StartupWMClass=khaos-lab assumed it would be. A genuine
    # correctness fix on its own, independent of the taskbar-icon bug
    # (see TASKBAR_ICON_PATH's comment above for that one).
    root = tk.Tk(className="khaos-lab")
    root.title("khaos☠️lab")
    root.configure(bg=BG)
    # 660, not the original 600 -- the Status view grew a 4th tile row
    # (self-heal) 2026-08-27 and 600 didn't leave room to actually show it,
    # confirmed live via screenshot (tile was silently clipped, not visibly
    # broken -- easy to miss without actually looking).
    #
    # Real regression found 2026-08-29: the forced "+40+40" position, combined
    # with xfwm4 adding its own ~50px of decoration offset on top of that
    # (confirmed live via `xdotool getwindowgeometry` -- actual placed y
    # ended up 92, not the requested 40), pushed the window's bottom edge to
    # y=792 -- past the real usable desktop area (`_NET_WORKAREA` confirmed
    # 766px tall, the bottom 34px reserved by the taskbar panel). The
    # bottom-most widget (the free-form "arc <cmd>" entry row) rendered
    # right where the panel covers it -- invisible, not removed. Dropping
    # the forced position lets xfwm4's own placement algorithm keep the
    # whole window on-screen (it already accounts for panel struts when
    # given the choice), which a hardcoded position can't -- verified live,
    # confirmed the command row is visible again with this change.
    root.geometry("860x700")
    root.minsize(720, 480)

    _taskbar_icon = load_image(TASKBAR_ICON_PATH)
    if _taskbar_icon:
        root.iconphoto(True, _taskbar_icon)

    try:
        # DejaVu Sans, not JetBrains Mono, specifically for the header title --
        # confirmed live (throwaway test window, 2026-08-26) that JetBrains
        # Mono (a code font) has no glyph for the skull-and-crossbones
        # character at all, so Tk just rendered blank space for it -- not a
        # transparency/color issue, a missing-glyph one. DejaVu Sans has real
        # coverage for it (confirmed via `fc-match ":charset=2620"`), and Tk
        # doesn't do automatic per-character font fallback the way a browser
        # or GTK app would, so the font itself had to change, not just retry.
        big_font    = tkfont.Font(family="DejaVu Sans", size=14, weight="bold")
        label_font  = tkfont.Font(family="JetBrains Mono", size=10)
        small_font  = tkfont.Font(family="JetBrains Mono", size=9)
        mono_font   = tkfont.Font(family="JetBrains Mono", size=9)
        nav_font    = tkfont.Font(family="JetBrains Mono", size=10)
    except Exception:
        big_font = label_font = small_font = mono_font = nav_font = tkfont.Font(size=10)

    # ── Header ──────────────────────────────────────────────────────────────
    header = tk.Frame(root, bg=BG)
    header.pack(fill="x", padx=14, pady=(12, 6))

    # Background watermark first (place(), not pack()) so the icon/title/
    # clock -- all packed normally below -- stack visually on top of it and
    # keep their own correct left/right-anchored resize behavior. relwidth/
    # relheight=1 means it re-fills the header automatically on resize,
    # unlike a Canvas here would need manual <Configure> tracking for.
    _header_bg = load_image(HEADER_BG_PATH)
    if _header_bg:
        tk.Label(header, image=_header_bg, bg=BG).place(relx=0, rely=0, relwidth=1, relheight=1)

    _header_icon = load_image(HEADER_ICON_PATH)
    if _header_icon:
        tk.Label(header, image=_header_icon, bg=BG).pack(side="left", padx=(0, 8))

    tk.Label(header, text="khaos", font=big_font, bg=BG, fg=GOLD).pack(side="left")
    tk.Label(header, text="☠️", font=big_font, bg=BG, fg=ROSE).pack(side="left")
    tk.Label(header, text="lab", font=big_font, bg=BG, fg=GOLD).pack(side="left", padx=(0, 16))
    clock_lbl = tk.Label(header, text="", font=small_font, bg=BG, fg=FG_MUTED)
    clock_lbl.pack(side="right")

    # Global quick-search, added 2026-09-10 (v2 sweep). The Find view (own
    # sidebar category) searches note CONTENT across the 4 tracked trees;
    # this searches ACTION LABELS across every category -- the actual fix
    # for "100+ buttons across 15 categories, can't find the one I want
    # fast." Lives in the header (real free space between the title and
    # the clock) rather than the 150px sidebar Canvas, which has no room
    # for an Entry without reworking its manual Y-offset button layout.
    # Pure in-memory string filtering, no subprocess -- cheap enough to
    # re-render live on every keystroke rather than waiting for Enter.
    search_var = tk.StringVar()
    search_entry = tk.Entry(
        header, textvariable=search_var, font=small_font,
        bg=OVERLAY, fg=FG, insertbackground=FG, relief="flat",
    )
    search_entry.pack(side="left", fill="x", expand=True, ipady=4, padx=(0, 16))
    search_entry.insert(0, "quick-jump: type an action name…")
    search_entry.configure(fg=FG_MUTED)
    _search_placeholder = {"active": True}

    def _search_focus_in(_e=None):
        if _search_placeholder["active"]:
            search_entry.delete(0, "end")
            search_entry.configure(fg=FG)
            _search_placeholder["active"] = False

    def _search_focus_out(_e=None):
        if not search_var.get().strip():
            _search_placeholder["active"] = True
            search_entry.insert(0, "quick-jump: type an action name…")
            search_entry.configure(fg=FG_MUTED)

    search_entry.bind("<FocusIn>", _search_focus_in)
    search_entry.bind("<FocusOut>", _search_focus_out)

    tk.Frame(root, bg=OVERLAY, height=1).pack(fill="x", padx=14)

    # ── Body/console split, drag-resizable ───────────────────────────────────
    # Real layout complaint (2026-08-29): the console was fixed at
    # height=9 lines and packed fill="x" only (no expand) -- every extra
    # pixel from resizing the window went entirely to body (sidebar+
    # content), so the output area could never grow no matter how the
    # window was resized. A PanedWindow with a draggable sash fixes this
    # properly instead of just picking a different fixed split: the user
    # can grow the console themselves whenever they want more room to
    # read output, and shrink it back for more sidebar/content room.
    main_pane = tk.PanedWindow(
        root, orient="vertical", bg=OVERLAY, sashwidth=6, sashrelief="flat",
        bd=0, showhandle=False, opaqueresize=True,
    )
    main_pane.pack(fill="both", expand=True, padx=14, pady=10)

    # ── Body: sidebar + content ────────────────────────────────────────────
    body = tk.Frame(main_pane, bg=BG)
    # height=460 is just the INITIAL split (roughly matching the old fixed
    # proportions so the status tiles aren't clipped by default) -- the
    # sash is fully drag-resizable from here, this isn't a new fixed value.
    main_pane.add(body, minsize=240, height=460)

    # Horizontal PanedWindow, not a plain pack -- real user feedback
    # 2026-09-11: the sidebar/content split had no way to adjust at all
    # (150px fixed), unlike the vertical body/output split below which
    # was already a real drag-resizable PanedWindow. Same treatment here.
    body_pane = tk.PanedWindow(
        body, orient="horizontal", bg=OVERLAY, sashwidth=6, sashrelief="flat",
        bd=0, showhandle=False, opaqueresize=True,
    )
    body_pane.pack(fill="both", expand=True)

    # Canvas, not Frame -- lets the watermark image sit behind the nav
    # buttons. Tk buttons are opaque (bg=BG is a solid fill, no real alpha),
    # so the image only actually shows through in the empty space below the
    # 5 nav buttons, not underneath them -- that's by design, not a bug: a
    # background image directly behind clickable buttons would just be
    # invisible anyway, covered edge-to-edge by each button's own fill.
    sidebar = tk.Canvas(body_pane, bg=BG, width=150, highlightthickness=0)
    body_pane.add(sidebar, minsize=110, width=150)

    # Second pane: a plain wrapper Frame holding content+its scrollbar
    # exactly as before -- PanedWindow panes are added as single widgets,
    # so the existing content/content_scroll pack() pairing stays inside
    # this one extra container rather than needing to change at all.
    content_wrap = tk.Frame(body_pane, bg=SURFACE)
    body_pane.add(content_wrap, minsize=300)

    _sidebar_bg = load_image(SIDEBAR_BG_PATH)
    if _sidebar_bg:
        sidebar.create_image(0, 0, anchor="nw", image=_sidebar_bg)

    # Canvas, not Frame -- same reasoning as the sidebar: lets the watermark
    # show behind the actual view (status tiles / action rows), visible in
    # whatever margin/gap those don't opaquely cover. Each view-builder
    # embeds its own frame via _embed_content() below instead of .pack(),
    # and that helper keeps it stretched to the canvas's current size on
    # resize (a plain create_window() child doesn't auto-follow the canvas
    # growing/shrinking the way a packed fill="both" child would).
    content = tk.Canvas(content_wrap, bg=SURFACE, highlightthickness=0)
    # Real bug found+fixed 2026-08-29: the SOC category grew to 18 actions
    # while _embed_content forced the embedded frame to the canvas's exact
    # visible height (see below) -- with no scrollbar, anything past
    # Darkstat's row was clipped with zero way to reach it. Same underlying
    # class of bug as the cmd_row disappearance earlier the same day, just
    # a bigger instance of it. Real fix, not a bandage: a real scrollbar,
    # wired to a canvas scrollregion that's kept honest by the embedded
    # widget's own actual required size, not an assumed/guessed number.
    content_scroll = tk.Scrollbar(
        content_wrap, orient="vertical", command=content.yview,
        bg=OVERLAY, troughcolor=BG, activebackground=TEAL,
        bd=0, highlightthickness=0, width=12,
    )
    # Not packed yet -- starts hidden, _set_scrollbar_visible() below packs
    # it in only when a view's content actually overflows the viewport.
    content.configure(yscrollcommand=content_scroll.set)
    content.pack(side="left", fill="both", expand=True, padx=(10, 0))

    _content_bg = load_image(CONTENT_BG_PATH)
    if _content_bg:
        content.create_image(0, 0, anchor="nw", image=_content_bg)

    def _set_scrollbar_visible(visible):
        # "keep it clean and simple" -- only show the scrollbar on views
        # that actually overflow (SOC, currently). Status and the smaller
        # categories don't need one cluttering the edge.
        if visible:
            if not content_scroll.winfo_ismapped():
                content_scroll.pack(side="right", fill="y")
        else:
            if content_scroll.winfo_ismapped():
                content_scroll.pack_forget()

    def _embed_content(widget, pad=16, scrollable=False):
        # pad on all sides -- also what lets the watermark actually show
        # (a widget filling the canvas edge-to-edge would hide it entirely).
        item = content.create_window(pad, pad, anchor="nw", window=widget)
        def _resize(event, item=item, pad=pad):
            w = max(event.width - 2 * pad, 1)
            content.itemconfigure(item, width=w)
            if scrollable:
                # Let the widget grow to whatever height its real content
                # needs (not forced to the visible viewport) -- scrolling
                # is what makes the overflow reachable instead of hidden.
                widget.update_idletasks()
                req_h = max(widget.winfo_reqheight(), event.height - 2 * pad)
                content.configure(scrollregion=(0, 0, event.width, req_h + 2 * pad))
                _set_scrollbar_visible(req_h + 2 * pad > event.height)
            else:
                h = max(event.height - 2 * pad, 1)
                content.itemconfigure(item, height=h)
                content.configure(scrollregion=(0, 0, event.width, event.height))
                _set_scrollbar_visible(False)
        content.bind("<Configure>", _resize)
        if scrollable:
            def _on_wheel(evt):
                content.yview_scroll(-1 if (evt.num == 4 or evt.delta > 0) else 1, "units")
            content.bind_all("<Button-4>", _on_wheel)
            content.bind_all("<Button-5>", _on_wheel)
            content.bind_all("<MouseWheel>", _on_wheel)
        else:
            content.unbind_all("<Button-4>")
            content.unbind_all("<Button-5>")
            content.unbind_all("<MouseWheel>")
            _set_scrollbar_visible(False)

    def _refresh_scrollregion(widget, pad=16):
        # Called once after a category view finishes packing all of its
        # rows -- _embed_content's own <Configure>-driven resize only
        # fires on canvas resize, not when rows are added to an
        # already-correctly-sized canvas (switching between categories
        # doesn't resize anything, so nothing would otherwise trigger a
        # recompute here).
        widget.update_idletasks()
        w = content.winfo_width()
        viewport_h = content.winfo_height()
        req_h = max(widget.winfo_reqheight(), viewport_h - 2 * pad)
        content.configure(scrollregion=(0, 0, w, req_h + 2 * pad))
        content.yview_moveto(0)
        _set_scrollbar_visible(req_h + 2 * pad > viewport_h)

    def _clear_content():
        for w in content.winfo_children():
            w.destroy()

    # ── Output console (shared, bottom pane -- drag the sash above to resize) ─
    # Real bug found+fixed 2026-08-29: the free-form "arc <cmd>" entry row
    # that used to live below the console got silently squeezed out of
    # existence once the console pane could shrink (confirmed via
    # `xwininfo -tree` -- it stopped existing as a real X window at all,
    # not just clipped). Removed rather than fought -- it only ever
    # duplicated typing the same command in an actual terminal, and the
    # user offered this as the preferred fallback themselves.
    console_frame = tk.Frame(main_pane, bg=BG)
    # minsize=110 is a real floor, not decoration -- the 2026-08-29
    # cmd_row bug happened because a pane's content could demand more
    # than the pane's actual allocated height with nothing stopping it;
    # the fix there was removing the widget that could silently vanish,
    # this floor is the second layer -- whatever's left (label + Text)
    # only ever shrinks the Text's visible lines, never disappears.
    main_pane.add(console_frame, minsize=110, height=190)

    tk.Label(console_frame, text="output", font=small_font, bg=BG, fg=FG_MUTED).pack(anchor="w")
    console = tk.Text(
        console_frame, bg=SURFACE, fg=FG, insertbackground=FG,
        font=mono_font, relief="flat", padx=8, pady=6, wrap="word",
    )
    console.pack(fill="both", expand=True)
    console.configure(state="disabled")

    def log(text, color=FG):
        console.configure(state="normal")
        console.insert("end", text + "\n")
        console.tag_add(f"c{len(text)}", "end-2l", "end-1l")
        console.tag_config(f"c{len(text)}", foreground=color)
        console.see("end")
        console.configure(state="disabled")

    def run_async(cmd, timeout=30, on_done=None):
        log(f"$ {cmd}", TEAL)

        def worker():
            ok, out = run(cmd, timeout=timeout)
            def finish():
                if out:
                    log(out, FG if ok else ROSE)
                log(f"[{'ok' if ok else 'failed'}]", PINE if ok else ROSE)
                if on_done:
                    on_done()
            root.after(0, finish)

        threading.Thread(target=worker, daemon=True).start()

    def launch_detached_async(cmd):
        log(f"$ {cmd}  (opens its own window)", TEAL)
        ok, msg = launch_detached(cmd)
        log(f"[{'ok' if ok else 'failed'}] {msg}", PINE if ok else ROSE)


    # ── Confirm modal ──────────────────────────────────────────────────────
    def confirm(label, cmd, timeout, on_yes_done=None):
        popup = tk.Toplevel(root)
        popup.title("confirm")
        popup.configure(bg=BG)
        popup.resizable(False, False)
        popup.attributes("-topmost", True)
        popup.geometry(f"+{root.winfo_x()+120}+{root.winfo_y()+150}")

        tk.Label(
            popup, text=f"run: {label}?", font=label_font, bg=BG, fg=FG,
        ).pack(padx=20, pady=(16, 4))
        tk.Label(
            popup, text=cmd, font=small_font, bg=BG, fg=FG_MUTED,
        ).pack(padx=20, pady=(0, 14))

        row = tk.Frame(popup, bg=BG)
        row.pack(pady=(0, 16))

        def do_yes():
            popup.destroy()
            run_async(cmd, timeout=timeout, on_done=on_yes_done)

        ui.button(row, "yes, run it", command=do_yes, font=small_font,
                  bg=SURFACE, fg=ROSE, hover_bg=OVERLAY, padx=12, pady=6,
                  ).pack(side="left", padx=6)
        ui.button(row, "cancel", command=popup.destroy, font=small_font,
                  bg=SURFACE, fg=FG_MUTED, hover_bg=OVERLAY, padx=12, pady=6,
                  ).pack(side="left", padx=6)

    # ── Status dashboard (live tiles) ──────────────────────────────────────
    status_tiles = {}
    # AWS lab status is polled on its own slower 90s timer, not the 15s
    # status loop -- added 2026-08-31. Two AWS API calls (describe-instances
    # + describe-budget) on every 15s refresh would add real, felt latency
    # to the whole dashboard and needlessly hammers AWS for state that
    # rarely changes second-to-second. The 15s loop just reads this cache.
    aws_lab_cache = {"text": "checking…", "ok": True}

    def build_status_view():
        _clear_content()
        status_tiles.clear()

        grid = tk.Frame(content, bg=SURFACE)
        _embed_content(grid)

        def tile(row, col, key, title):
            # Tried ui.rounded_frame() here first -- reverted. Its Canvas
            # sizes itself to content, not to whatever grid's "nsew" sticky
            # actually allocates, so a multi-column grid of these went
            # visibly uneven (row heights no longer matched between
            # columns). Confirmed live via screenshot before reverting, not
            # assumed. Flat Frame is the correct tool for a responsive
            # grid; rounded_frame is proven for arc-break's simple
            # single-column vertical stack, a genuinely different layout
            # shape. Still gets the circadian palette for free either way.
            f = tk.Frame(grid, bg=OVERLAY)
            f.grid(row=row, column=col, padx=8, pady=8, sticky="nsew")
            grid.columnconfigure(col, weight=1)
            tk.Label(f, text=title, font=small_font, bg=OVERLAY, fg=FG_MUTED).pack(
                anchor="w", padx=12, pady=(10, 2))
            val = tk.Label(f, text="checking…", font=label_font, bg=OVERLAY, fg=FG, justify="left")
            val.pack(anchor="w", padx=12, pady=(0, 10))
            status_tiles[key] = val

        # VPN tile removed 2026-08-31 (ProtonVPN purged) -- reflowed the
        # remaining 7 rather than leave a gap in the middle of the grid.
        tile(0, 0, "dns", "DNS")
        tile(0, 1, "break", "Break timer")
        tile(1, 0, "disk", "Disk")
        tile(1, 1, "services", "Failed services")
        tile(2, 0, "uptime", "Uptime / load")
        tile(2, 1, "selfheal", "Self-heal (arc-heal)")
        tile(3, 0, "idsips", "IDS/IPS")
        tile(3, 1, "calendar", "Upcoming (Orage)")
        tile(4, 0, "awslab", "AWS Lab (gvm/soc-lab-cloud)")

        refresh_status()
        aws_lab_poll()

    def refresh_status():
        def worker():
            checks = {}
            ok, out = run("arc dns status", timeout=8)
            mode_line = next((l for l in out.splitlines() if "mode:" in l), "")
            checks["dns"] = mode_line.split("mode:")[-1].strip() if mode_line else (out[:60] or "unavailable")

            ok, out = run("arc break status", timeout=8)
            checks["break"] = strip_banner(out, cmd="arc break status") or "unavailable"

            ok, out = run("df -h / --output=used,avail,pcent", timeout=8)
            lines = out.splitlines()
            checks["disk"] = lines[-1].strip() if len(lines) > 1 else "unavailable"

            ok1, out1 = run("systemctl --failed --no-legend", timeout=8)
            ok2, out2 = run("systemctl --user --failed --no-legend", timeout=8)
            n = len([l for l in (out1 + "\n" + out2).splitlines() if l.strip()])
            checks["services"] = f"{n} failed" if n else "all healthy"

            ok, out = run("uptime -p && uptime | grep -oP 'load average: \\K.*'", timeout=8)
            checks["uptime"] = out.replace("\n", "  ·  ") or "unavailable"

            # Self-heal, on today's design principle: surface arc-heal's own
            # last result right on the main dashboard instead of making the
            # user remember to click into Security -- a plain file read, not
            # a fresh `arc heal` run (that takes 5-10s+, too heavy for this
            # 15s auto-refresh; the cron job already runs it every 3h, this
            # just shows what it last found).
            checks["selfheal"] = "no runs on record yet"
            try:
                text = HEAL_LOG_PATH.read_text()
                ts_match = re.search(r"— (\d{8}T\d{6}Z)", text)
                summary_match = re.search(r"Run took .*", text)
                summary = summary_match.group(0) if summary_match else "unrecognized log format"
                if ts_match:
                    epoch = calendar.timegm(time.strptime(ts_match.group(1), "%Y%m%dT%H%M%SZ"))
                    age_min = max(0, int((time.time() - epoch) / 60))
                    age_str = f"{age_min}m ago" if age_min < 120 else f"{age_min // 60}h ago"
                    checks["selfheal"] = f"{summary}  ·  {age_str}"
                else:
                    checks["selfheal"] = summary
            except Exception:
                pass

            # IDS/IPS -- the real, live security monitoring stack (Suricata
            # engine + Sagan correlation + EveBox alert viewer), not the
            # soc-lab training containers (those stay Security-category-only,
            # manual-launch, never shown here). Plain status reads, cheap
            # enough for the 15s auto-refresh -- native, so a glance at the
            # dashboard covers what used to need a browser tab.
            ok, out = run("systemctl is-active suricata", timeout=5)
            suricata_state = out.strip() or "unknown"
            ok, out = run("docker inspect --format '{{.State.Status}}' sagan", timeout=5)
            sagan_state = out.strip() if ok else "missing"
            ok, out = run("docker inspect --format '{{.State.Status}}' evebox", timeout=5)
            evebox_state = out.strip() if ok else "missing"
            checks["idsips"] = f"suricata {suricata_state}  ·  sagan {sagan_state}  ·  evebox {evebox_state}"

            try:
                upcoming = get_upcoming_events(limit=2)
                checks["calendar"] = "\n".join(upcoming) if upcoming else "nothing scheduled"
            except Exception:
                checks["calendar"] = "unavailable"

            def apply():
                for key, val in checks.items():
                    if key in status_tiles:
                        color = FG
                        if key == "services" and "failed" in val and "0 failed" not in val:
                            color = ROSE
                        if key == "selfheal":
                            flagged = re.search(r"(\d+) flagged", val)
                            healed = re.search(r"(\d+) healed", val)
                            if flagged and int(flagged.group(1)) > 0:
                                color = ROSE
                            elif healed and int(healed.group(1)) > 0:
                                color = TEAL
                        if key == "idsips":
                            # Exact-word checks, not substring -- "inactive"
                            # contains the substring "active", which a naive
                            # `"active" in val` would wrongly call healthy.
                            healthy = (
                                "suricata active" in val
                                and val.count("running") == 2
                            )
                            color = TEAL if healthy else ROSE
                        status_tiles[key].configure(text=val, fg=color)
            root.after(0, apply)

        threading.Thread(target=worker, daemon=True).start()

    def aws_lab_poll():
        def apply_cache():
            if "awslab" not in status_tiles:
                return
            color = FG
            if not aws_lab_cache["ok"]:
                color = ROSE
            elif aws_lab_cache.get("any_running"):
                color = TEAL  # visible reminder something is live/billing
            status_tiles["awslab"].configure(text=aws_lab_cache["text"], fg=color)

        def worker():
            conf_path = Path.home() / ".config/arc/aws-lab.conf"
            if not conf_path.exists():
                aws_lab_cache.update(text="not configured", ok=True, any_running=False)
                root.after(0, apply_cache)
                return
            conf = {}
            for line in conf_path.read_text().splitlines():
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                conf[k] = v
            region = conf.get("AWS_LAB_REGION", "us-east-1")
            gvm_id = conf.get("GVM_INSTANCE_ID", "")
            soclab_id = conf.get("SOCLAB_INSTANCE_ID", "")
            wazuh_id = conf.get("WAZUH_INSTANCE_ID", "")
            ok, out = run(
                f"aws ec2 describe-instances --instance-ids {gvm_id} {soclab_id} {wazuh_id} "
                f"--region {region} --query 'Reservations[*].Instances[*].{{N:Tags[?Key==`Name`]|[0].Value,S:State.Name}}' "
                f"--output text",
                timeout=15,
            )
            if not ok:
                aws_lab_cache.update(text="unreachable (check aws configure / network)", ok=False, any_running=False)
                root.after(0, apply_cache)
                return
            states = {}
            for line in out.splitlines():
                parts = line.split()
                if len(parts) == 2:
                    states[parts[0]] = parts[1]
            gvm_s = states.get("gvm-cloud", "?")
            soclab_s = states.get("soclab-cloud", "?")
            wazuh_s = states.get("wazuh-cloud", "?")
            ok2, out2 = run(
                "aws budgets describe-budget --account-id 433985779144 "
                "--budget-name aws-credits-100 --region us-east-1 "
                "--query 'Budget.CalculatedSpend.ActualSpend.Amount' --output text",
                timeout=15,
            )
            spend = f"${out2.strip()}/100" if ok2 else "spend n/a"
            # "ok" here just means the check itself succeeded, not that
            # nothing is running -- a running instance is normal/expected
            # mid-session, not a fault. any_running just drives a visible
            # color cue so it's never silently forgotten in the background.
            aws_lab_cache.update(
                text=f"gvm {gvm_s}  ·  soc-lab {soclab_s}  ·  wazuh {wazuh_s}  ·  {spend}",
                ok=True,
                any_running=(gvm_s == "running" or soclab_s == "running" or wazuh_s == "running"),
            )
            root.after(0, apply_cache)

        threading.Thread(target=worker, daemon=True).start()
        root.after(90000, aws_lab_poll)

    # ── Cockpit view (2026-09-07) ────────────────────────────────────────────
    # Network/pipeline/cloud/local overview -- distinct from the general
    # Status dashboard above, and not a button list like the other
    # categories. Every check here is real work (a subprocess, some of them
    # real network calls), so it's polled on its own slower timer, same
    # reasoning as aws_lab_poll -- doing this on the fast 15s status loop
    # would add felt latency for data that doesn't change second to second.
    cockpit_tiles = {}

    def build_cockpit_view():
        _clear_content()
        cockpit_tiles.clear()

        grid = tk.Frame(content, bg=SURFACE)
        _embed_content(grid)

        def tile(row, col, key, title):
            f = tk.Frame(grid, bg=OVERLAY)
            f.grid(row=row, column=col, padx=8, pady=8, sticky="nsew")
            grid.columnconfigure(col, weight=1)
            tk.Label(f, text=title, font=small_font, bg=OVERLAY, fg=FG_MUTED).pack(
                anchor="w", padx=12, pady=(10, 2))
            val = tk.Label(f, text="checking…", font=label_font, bg=OVERLAY, fg=FG, justify="left")
            val.pack(anchor="w", padx=12, pady=(0, 10))
            cockpit_tiles[key] = val

        tile(0, 0, "vpn", "VPN (ProtonVPN)")
        tile(0, 1, "dns", "DNS + leak check")
        tile(1, 0, "netstats", "Network (wlan0, since boot)")
        tile(1, 1, "eero", "Eero")
        tile(2, 0, "cloudlab", "Cloud lab (gvm/soc-lab-cloud)")
        tile(2, 1, "kismet", "Kismet (wireless recon)")

        cockpit_poll()

    def cockpit_poll():
        def worker():
            checks = {}

            ok, out = run("arc vpn status", timeout=15)
            m = re.search(r"Status:\s*(.+)", out)
            checks["vpn"] = m.group(1).strip() if m else (out.strip()[:60] or "unavailable")

            ok, out = run("arc dns check", timeout=15)
            daemon = re.search(r"daemon:\s*(\S+)", out)
            routing = re.search(r"routing:\s*(.+)", out)
            query = re.search(r"query:\s*(\S+)", out)
            if daemon and query:
                checks["dns"] = f"daemon {daemon.group(1)}  ·  query {query.group(1)}\n{(routing.group(1).strip() if routing else '')[:60]}"
            else:
                checks["dns"] = "unavailable"

            ok, out = run("arc net stats", timeout=8)
            wlan = next((l for l in out.splitlines() if "wlan0" in l), "")
            checks["netstats"] = wlan.strip() or "unavailable"

            ok, out = run("arc eero-summary", timeout=15)
            if "auth: ok" in out:
                d = {}
                for line in out.splitlines():
                    if ":" in line:
                        k, v = line.split(":", 1)
                        d[k.strip()] = v.strip()
                checks["eero"] = f"{d.get('internet', '?')}  ·  {d.get('clients', '?')} clients  ·  {d.get('nodes', '?')} node(s)\ndns {d.get('dns', '?')}  ·  {d.get('public_ip', '?')}"
            elif "not signed in" in out:
                checks["eero"] = "not signed in — arc eero"
            else:
                checks["eero"] = "unavailable"

            checks["cloudlab"] = aws_lab_cache.get("text", "checking…")

            ok, out = run("arc kismet status", timeout=8)
            checks["kismet"] = strip_banner(out, cmd="arc kismet status") or "unavailable"

            def apply():
                for key, val in checks.items():
                    if key in cockpit_tiles:
                        color = FG
                        if key == "vpn":
                            color = TEAL if "connected" in val.lower() and "disconnected" not in val.lower() else FG_MUTED
                        if key == "dns" and "unavailable" in val:
                            color = ROSE
                        if key == "eero" and ("down" in val.lower() or "unavailable" in val.lower()):
                            color = ROSE
                        cockpit_tiles[key].configure(text=val, fg=color)
            root.after(0, apply)

        threading.Thread(target=worker, daemon=True).start()
        root.after(60000, lambda: cockpit_poll() if current_cat.get() == "Cockpit" else None)

    # ── Logs view (2026-09-08) ───────────────────────────────────────────────
    # Click a log, review real content, purge (clears the actual file on
    # disk, not just the display) or keep (just close). Built after a real
    # complaint: an arc-heal notification said "1 thing(s) healed... see the
    # log" with zero detail, forcing a trip to a terminal to find out what.
    # That got fixed at the source (arc-heal's own notification body, same
    # commit as this) -- this view is the other half: a real place to check
    # without a terminal at all, for this and every other log worth reviewing.
    def _log_stat(path):
        try:
            st = path.stat()
            size = st.st_size
            for unit in ("B", "KB", "MB", "GB"):
                if size < 1024 or unit == "GB":
                    size_s = f"{size:.0f}{unit}" if unit == "B" else f"{size/1024:.1f}{unit}"
                    break
                size /= 1024
            mtime = datetime.fromtimestamp(st.st_mtime).strftime("%Y-%m-%d %H:%M")
            return f"{size_s}  ·  {mtime}"
        except FileNotFoundError:
            return "not found"
        except PermissionError:
            return "permission denied"

    def build_logs_view():
        _clear_content()
        wrap = tk.Frame(content, bg=SURFACE)
        _embed_content(wrap)

        for src in LOG_SOURCES:
            row = tk.Frame(wrap, bg=OVERLAY)
            row.pack(fill="x", padx=8, pady=5)

            left = tk.Frame(row, bg=OVERLAY)
            left.pack(side="left", fill="x", expand=True, padx=12, pady=10)
            tk.Label(left, text=src["name"], font=label_font, bg=OVERLAY, fg=FG).pack(anchor="w")
            stat_lbl = tk.Label(left, text=_log_stat(src["path"]), font=small_font, bg=OVERLAY, fg=FG_MUTED)
            stat_lbl.pack(anchor="w")

            btns = tk.Frame(row, bg=OVERLAY)
            btns.pack(side="right", padx=12)

            def make_view(s=src):
                return lambda: _log_view_popup(s)

            def make_purge(s=src, lbl=None):
                return lambda: _log_purge_confirm(s, lambda: lbl.configure(text=_log_stat(s["path"])))

            ui.button(btns, "view", command=make_view(), font=small_font,
                      bg=SURFACE, fg=TEAL, hover_bg=BG, padx=10, pady=5,
                      ).pack(side="left", padx=4)
            # Real bug caught before shipping: ui.button() captures `command`
            # in a closure at creation time (a plain tk.Label has no native
            # -command option the way tk.Button does), so the old two-step
            # "create, then .configure(command=...)" pattern silently can't
            # work here -- pass it straight through at creation instead.
            purge_btn = ui.button(btns, "purge", command=make_purge(src, stat_lbl),
                                   font=small_font, bg=SURFACE, fg=ROSE,
                                   hover_bg=BG, padx=10, pady=5)
            purge_btn.pack(side="left", padx=4)

    def _log_tail_text(path, n=200):
        ok, out = run(f"tail -n {n} {path}", timeout=10)
        return out if ok else f"(couldn't read {path} — {out})"

    def _log_tail_sqlite(path, n=50):
        ok, out = run(
            f'sqlite3 -separator " | " {path} '
            f'"SELECT timestamp, app_name, summary, body FROM notifications ORDER BY id DESC LIMIT {n};"',
            timeout=10,
        )
        return out if ok else f"(couldn't read {path} — {out})"

    def _log_view_popup(src):
        popup = tk.Toplevel(root)
        popup.title(src["name"])
        popup.configure(bg=BG)
        popup.geometry("900x600")
        popup.attributes("-topmost", True)

        tk.Label(
            popup, text=f"{src['name']}  —  {src['path']}", font=small_font,
            bg=BG, fg=FG_MUTED, anchor="w",
        ).pack(fill="x", padx=14, pady=(12, 4))

        text_frame = tk.Frame(popup, bg=BG)
        text_frame.pack(fill="both", expand=True, padx=14, pady=(0, 8))
        scroll = tk.Scrollbar(text_frame)
        scroll.pack(side="right", fill="y")
        box = tk.Text(
            text_frame, bg=SURFACE, fg=FG, font=("JetBrains Mono", 10),
            wrap="word", yscrollcommand=scroll.set, relief="flat",
        )
        box.pack(side="left", fill="both", expand=True)
        scroll.configure(command=box.yview)
        box.insert("1.0", "loading…")
        box.configure(state="disabled")

        def worker():
            tail_fn = _log_tail_sqlite if src["kind"] == "sqlite" else _log_tail_text
            text = tail_fn(src["path"])

            def apply():
                box.configure(state="normal")
                box.delete("1.0", "end")
                box.insert("1.0", text or "(empty)")
                box.configure(state="disabled")
                box.see("end")
            root.after(0, apply)

        threading.Thread(target=worker, daemon=True).start()

        ui.button(popup, "close", command=popup.destroy, font=small_font,
                  bg=SURFACE, fg=FG_MUTED, hover_bg=OVERLAY, padx=14, pady=8,
                  ).pack(pady=(0, 12))

    def _log_purge_failed(name, out):
        popup = tk.Toplevel(root)
        popup.title("purge failed")
        popup.configure(bg=BG)
        popup.resizable(False, False)
        popup.attributes("-topmost", True)
        popup.geometry(f"+{root.winfo_x()+120}+{root.winfo_y()+150}")
        tk.Label(popup, text=f"couldn't clear {name}", font=label_font, bg=BG, fg=ROSE).pack(padx=20, pady=(16, 4))
        tk.Label(
            popup, text=(out or "")[:300] + ("\n\nlikely needs: arc sot install-sudoers" if "password" in (out or "") else ""),
            font=small_font, bg=BG, fg=FG_MUTED, wraplength=380, justify="left",
        ).pack(padx=20, pady=(0, 14))
        ui.button(popup, "ok", command=popup.destroy, font=small_font,
                  bg=SURFACE, fg=FG_MUTED, hover_bg=OVERLAY, padx=14, pady=6,
                  ).pack(pady=(0, 16))

    def _log_purge_confirm(src, on_done):
        popup = tk.Toplevel(root)
        popup.title("confirm")
        popup.configure(bg=BG)
        popup.resizable(False, False)
        popup.attributes("-topmost", True)
        popup.geometry(f"+{root.winfo_x()+120}+{root.winfo_y()+150}")

        tk.Label(
            popup, text=f"clear {src['name']}?", font=label_font, bg=BG, fg=FG,
        ).pack(padx=20, pady=(16, 4))
        tk.Label(
            popup, text="This deletes the real file's content — cannot be undone.",
            font=small_font, bg=BG, fg=ROSE,
        ).pack(padx=20, pady=(0, 14))

        row = tk.Frame(popup, bg=BG)
        row.pack(pady=(0, 16))

        def do_purge():
            popup.destroy()
            if src["kind"] == "sqlite":
                cmd = f'sqlite3 {src["path"]} "DELETE FROM notifications; VACUUM;"'
            elif src["sudo"]:
                cmd = f"sudo -n truncate -s 0 {src['path']}"
            else:
                cmd = f"truncate -s 0 {src['path']}"

            def worker():
                ok, out = run(cmd, timeout=10)
                def apply():
                    on_done()
                    if not ok:
                        _log_purge_failed(src["name"], out)
                root.after(0, apply)
            threading.Thread(target=worker, daemon=True).start()

        ui.button(row, "yes, clear it", command=do_purge, font=small_font,
                  bg=SURFACE, fg=ROSE, hover_bg=OVERLAY, padx=12, pady=6,
                  ).pack(side="left", padx=6)
        ui.button(row, "cancel (keep)", command=popup.destroy, font=small_font,
                  bg=SURFACE, fg=FG_MUTED, hover_bg=OVERLAY, padx=12, pady=6,
                  ).pack(side="left", padx=6)

    # ── Find view (2026-09-10, v2 sweep) ────────────────────────────────────
    # The literal answer to "surface dev-notes/hq-main/arc-lt-cmc" -- wires
    # `arc find <query>` (cross-tree search: arc-lt-cmc + dev-notes +
    # khaos-lab + vault/archive, already grouped/formatted, real content
    # snippets with line numbers) directly into the panel. Same worker-
    # thread + root.after(0, apply) marshal pattern as the Logs view's
    # popup, just embedded in the main content pane instead of a Toplevel.
    def build_find_view():
        _clear_content()
        wrap = tk.Frame(content, bg=SURFACE)
        _embed_content(wrap, scrollable=True)

        top = tk.Frame(wrap, bg=SURFACE)
        top.pack(fill="x", padx=4, pady=(4, 10))
        tk.Label(
            top, text="search arc-lt-cmc + dev-notes + khaos-lab + vault/archive",
            font=small_font, bg=SURFACE, fg=FG_MUTED, anchor="w",
        ).pack(fill="x", pady=(0, 6))

        entry_row = tk.Frame(top, bg=SURFACE)
        entry_row.pack(fill="x")
        query_var = tk.StringVar()
        entry = tk.Entry(
            entry_row, textvariable=query_var, font=label_font,
            bg=OVERLAY, fg=FG, insertbackground=FG, relief="flat",
        )
        entry.pack(side="left", fill="x", expand=True, ipady=6, padx=(0, 8))

        text_frame = tk.Frame(wrap, bg=BG)
        text_frame.pack(fill="both", expand=True, padx=4, pady=(0, 4))
        scroll = tk.Scrollbar(text_frame)
        scroll.pack(side="right", fill="y")
        box = tk.Text(
            text_frame, bg=SURFACE, fg=FG, font=("JetBrains Mono", 10),
            wrap="word", yscrollcommand=scroll.set, relief="flat", height=24,
        )
        box.pack(side="left", fill="both", expand=True)
        scroll.configure(command=box.yview)
        box.insert("1.0", "type a query, press enter or click search")
        box.configure(state="disabled")

        def _show(text):
            box.configure(state="normal")
            box.delete("1.0", "end")
            box.insert("1.0", text or "(no results)")
            box.configure(state="disabled")
            box.see("1.0")

        def do_search(_evt=None):
            q = query_var.get().strip()
            if not q:
                return
            _show(f"searching for '{q}'…")

            def worker():
                ok, out = run(f"arc find {shlex.quote(q)}", timeout=20)
                root.after(0, lambda: _show(out if ok else f"(search failed) {out}"))
            threading.Thread(target=worker, daemon=True).start()

        def do_ref():
            _show("loading archived references…")

            def worker():
                ok, out = run("arc ref", timeout=15)
                root.after(0, lambda: _show(out if ok else f"(failed) {out}"))
            threading.Thread(target=worker, daemon=True).start()

        entry.bind("<Return>", do_search)
        ui.button(entry_row, "search", command=do_search, font=small_font,
                  bg=OVERLAY, fg=TEAL, hover_bg=BG, padx=14, pady=6,
                  ).pack(side="left", padx=(0, 6))
        ui.button(entry_row, "browse refs (arc ref)", command=do_ref, font=small_font,
                  bg=OVERLAY, fg=GOLD, hover_bg=BG, padx=14, pady=6,
                  ).pack(side="left")

        entry.focus_set()
        _refresh_scrollregion(wrap)

    # ── Category action view ───────────────────────────────────────────────
    def _render_action_row(wrap, action, prefix=""):
        # Real usability gap found 2026-08-30 (user report): the label
        # sits far-left, the button far-right, nothing visually ties
        # them together -- easy to lose track of which button belongs
        # to which row once a category has more than a handful of
        # actions (SOC has 18+). Fix: the whole row highlights together
        # on hover, so you get a clear "this is the one" confirmation
        # before you click, regardless of the horizontal gap.
        #
        # Extracted 2026-09-10 (v2 sweep) from build_category_view's own
        # loop body so the new global search-results view can render
        # identical rows for matches pulled from *any* category, not just
        # one -- `prefix` (e.g. "SOC — ") disambiguates which category a
        # hit came from when browsing filtered results.
        row = tk.Frame(wrap, bg=SURFACE)
        row.pack(fill="x", pady=1)
        label = tk.Label(
            row, text=f"{prefix}{action.label}", font=label_font, bg=SURFACE, fg=FG,
            anchor="w", padx=10, pady=6,
        )
        label.pack(side="left", fill="x", expand=True)

        def make_cmd(a=action):
            def go():
                if a.detach:
                    launch_detached_async(a.cmd)
                elif a.confirm:
                    confirm(a.label, a.cmd, a.timeout, on_yes_done=refresh_status)
                else:
                    run_async(a.cmd, timeout=a.timeout, on_done=refresh_status)
            return go

        btn = tk.Button(
            row, text="run", command=make_cmd(), font=small_font,
            bg=OVERLAY, fg=TEAL, activebackground=BG, activeforeground=TEAL,
            relief="flat", bd=0, padx=14, pady=4, cursor="hand2",
        )
        btn.pack(side="right", padx=10, pady=6)

        def _hover_on(_e, row=row, label=label):
            row.configure(bg=OVERLAY)
            label.configure(bg=OVERLAY)

        def _hover_off(_e, row=row, label=label):
            row.configure(bg=SURFACE)
            label.configure(bg=SURFACE)

        for w in (row, label, btn):
            w.bind("<Enter>", _hover_on)
            w.bind("<Leave>", _hover_off)

    def build_category_view(name):
        _clear_content()

        wrap = tk.Frame(content, bg=SURFACE)
        _embed_content(wrap, scrollable=True)

        for action in CATEGORIES[name]:
            _render_action_row(wrap, action)

        # Rows are all packed by now -- safe to measure the frame's real
        # required height and size the scrollbar to match. Doing this
        # inside the loop above would measure a partially-built frame.
        _refresh_scrollregion(wrap)

    def build_search_results_view(query):
        # Global quick-jump (2026-09-10) -- flattens every category's
        # Action list, filters by substring on the label (case-insensitive),
        # renders with _render_action_row so results look/behave exactly
        # like a normal category view, just sourced from everywhere at
        # once. Special-view categories (Status/Cockpit/Logs/Find, empty
        # lists in CATEGORIES) have nothing to match against -- expected,
        # not a gap; they're each one click away in the sidebar regardless.
        _clear_content()
        wrap = tk.Frame(content, bg=SURFACE)
        _embed_content(wrap, scrollable=True)

        q = query.lower().strip()
        hits = [
            (cat, a) for cat, actions in CATEGORIES.items()
            for a in actions if q in a.label.lower()
        ]

        if not hits:
            tk.Label(
                wrap, text=f"no actions match '{query}'", font=label_font,
                bg=SURFACE, fg=FG_MUTED, anchor="w", padx=10, pady=10,
            ).pack(fill="x")
        else:
            for cat, action in hits:
                _render_action_row(wrap, action, prefix=f"{cat} — ")

        _refresh_scrollregion(wrap)

    # ── Sidebar nav ─────────────────────────────────────────────────────────
    nav_buttons = {}
    current_cat = tk.StringVar(value="Status")

    def select(name):
        current_cat.set(name)
        for n, b in nav_buttons.items():
            b.set_look(bg=OVERLAY if n == name else BG, fg=GOLD if n == name else FG_MUTED)
        if name == "Status":
            build_status_view()
        elif name == "Cockpit":
            build_cockpit_view()
        elif name == "Logs":
            build_logs_view()
        elif name == "Find":
            build_find_view()
        else:
            build_category_view(name)

    # create_window, not pack -- sidebar is a Canvas now (see above), so its
    # children are positioned manually instead of auto-stacked.
    _nav_y = 0
    for cat in CATEGORIES:
        b = ui.button(
            sidebar, cat, command=lambda c=cat: select(c),
            font=nav_font, bg=BG, fg=FG_MUTED, hover_bg=OVERLAY, hover_fg=GOLD,
            padx=12, pady=8,
        )
        b.configure(anchor="w")
        sidebar.create_window(0, _nav_y, anchor="nw", window=b, width=150)
        b.update_idletasks()
        _nav_y += b.winfo_reqheight() + 1
        nav_buttons[cat] = b

    # Wire the global quick-search now that select()/build_search_results_view
    # both exist. Live on every keystroke (cheap in-memory filter, no
    # subprocess) -- typing shows results immediately; clearing the box
    # (or Escape) reverts to whatever category was actually selected in
    # the sidebar, rather than leaving the last search result stuck on
    # screen with no obvious way back.
    def _do_global_search(_evt=None):
        if _search_placeholder["active"]:
            return
        q = search_var.get().strip()
        if q:
            for n, b in nav_buttons.items():
                b.set_look(bg=BG, fg=FG_MUTED)
            build_search_results_view(q)
        else:
            select(current_cat.get())

    def _clear_global_search(_evt=None):
        search_var.set("")
        select(current_cat.get())
        root.focus_set()

    search_entry.bind("<KeyRelease>", _do_global_search)
    search_entry.bind("<Escape>", _clear_global_search)

    select("Status")

    # ── Clock + auto status refresh ────────────────────────────────────────
    def tick():
        clock_lbl.configure(text=time.strftime("%H:%M:%S"))
        root.after(1000, tick)

    def auto_refresh():
        if current_cat.get() == "Status":
            refresh_status()
        root.after(15000, auto_refresh)

    # Self-heal (2026-08-29): keep the window fully inside the real usable
    # desktop area, not just the raw screen. A forced position once put
    # this window's bottom edge under the taskbar panel, silently hiding
    # the last-packed widget (see that day's GAMEPLAN entry) -- dropping
    # the forced position fixed the one-time startup case, but nothing
    # stopped the same class of problem recurring if the window's ever
    # dragged (or a future WM/panel config change) puts it off-area
    # again. Queries `_NET_WORKAREA` directly -- what the window manager
    # itself publishes as the real usable area -- rather than guessing
    # screen height minus an assumed panel size, which would silently go
    # stale on a different monitor/panel setup. Runs periodically, not
    # just once at launch, so this keeps correcting itself for as long
    # as the window stays open.
    def geometry_watchdog():
        ok, out = run("xprop -root _NET_WORKAREA", timeout=3)
        if ok and out:
            nums = [int(n) for n in re.findall(r"-?\d+", out)]
            if len(nums) >= 4:
                wx, wy, ww, wh = nums[:4]
                root.update_idletasks()
                x, y = root.winfo_x(), root.winfo_y()
                w, h = root.winfo_width(), root.winfo_height()
                new_x, new_y = x, y
                if x < wx:
                    new_x = wx
                elif x + w > wx + ww:
                    new_x = max(wx, wx + ww - w)
                if y < wy:
                    new_y = wy
                elif y + h > wy + wh:
                    new_y = max(wy, wy + wh - h)
                if (new_x, new_y) != (x, y):
                    root.geometry(f"+{new_x}+{new_y}")
        root.after(10000, geometry_watchdog)

    tick()
    root.after(15000, auto_refresh)
    # 500ms delay on the first run -- gives the WM time to finish its own
    # initial placement first (confirmed live 2026-08-27/29: xfwm4 doesn't
    # finalize window position instantly on map).
    root.after(500, geometry_watchdog)

    root.mainloop()


if __name__ == "__main__":
    main()
