#!/usr/bin/env python3
"""
arc-pine — notification history browser.

Rebuilt from scratch (original source lost with the Tails USB). Fresh,
functional design rather than a port of the old one: one clean theme
(Rose Pine Moon, matching this system's existing GTK/terminal theme) instead
of three, search-as-you-type, delete individual entries, purge by age or by
app. Reads the same history.db that arc-pined writes to.
"""

import sqlite3
import sys
import tkinter as tk
from tkinter import ttk
from pathlib import Path
from datetime import datetime, timedelta

sys.path.insert(0, str(Path(__file__).resolve().parent))
import _arc_pine_common as pine

DB_PATH     = pine.DB_PATH
ICON_PATH   = Path.home() / ".local/share/arc-pine/icon.png"

# Same theme palette arc-pine-bubbles renders with -- kept in one place
# there, mirrored here just for the Settings preview swatches (this
# viewer's own chrome always stays Rose Pine Moon regardless of the
# selected bubble theme -- only the popups themselves change).
THEMES = {
    "rose-pine-moon": {"bg": "#2a273f", "accent": "#eb6f92", "fg": "#e0def4"},
    "nord":           {"bg": "#3b4252", "accent": "#bf616a", "fg": "#eceff4"},
    "dracula":        {"bg": "#282a36", "accent": "#ff5555", "fg": "#f8f8f2"},
    "gruvbox":        {"bg": "#3c3836", "accent": "#fb4934", "fg": "#ebdbb2"},
}

# Rose Pine Moon
BG       = "#232136"
SURFACE  = "#2a273f"
OVERLAY  = "#393552"
FG       = "#e0def4"
FG_MUTED = "#6e6a86"
GOLD     = "#f6c177"
ROSE     = "#eb6f92"
PINE     = "#3e8fb0"
TEAL     = "#9ccfd8"

URGENCY_COLOR = {0: FG_MUTED, 1: TEAL, 2: ROSE}


def db_query(sql, params=()):
    if not DB_PATH.exists():
        return []
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    rows = conn.execute(sql, params).fetchall()
    conn.close()
    return rows


def db_exec(sql, params=()):
    if not DB_PATH.exists():
        return
    conn = sqlite3.connect(DB_PATH)
    conn.execute(sql, params)
    conn.commit()
    conn.close()


class ArcPine(tk.Tk):
    def __init__(self):
        super().__init__()
        self.title("arc · pine")
        self.geometry("480x560")
        self.configure(bg=BG)

        if ICON_PATH.exists():
            try:
                self._icon = tk.PhotoImage(file=str(ICON_PATH))
                self.iconphoto(True, self._icon)
            except Exception:
                pass

        self.search_var = tk.StringVar()
        self.search_var.trace_add("write", lambda *_: self.refresh())

        self.config = pine.load_config()
        self.view = "history"

        self._build_ui()
        self.refresh()

    def _build_ui(self):
        top = tk.Frame(self, bg=BG)
        top.pack(fill="x", padx=10, pady=10)

        tk.Label(top, text="arc pine", font=("JetBrains Mono", 14, "bold"),
                 bg=BG, fg=GOLD).pack(side="left")

        self.settings_btn = tk.Button(
            top, text="⚙ settings", font=("JetBrains Mono", 9), bg=SURFACE, fg=TEAL,
            activebackground=OVERLAY, activeforeground=TEAL, relief="flat", bd=0,
            padx=8, pady=4, cursor="hand2", command=self.toggle_view,
        )
        self.settings_btn.pack(side="right", padx=(10, 0))

        self.search_entry = tk.Entry(top, textvariable=self.search_var, font=("JetBrains Mono", 10),
                                      bg=SURFACE, fg=FG, insertbackground=FG, relief="flat")
        self.search_entry.pack(side="right", fill="x", expand=True)
        self.search_entry.focus()

        # Body: history view and settings view share the same slot, only
        # one packed at a time -- simplest way to keep this single-window,
        # no extra Toplevel/dialog clutter.
        self.body = tk.Frame(self, bg=BG)
        self.body.pack(fill="both", expand=True)

        self._build_history_view()
        self._build_settings_view()

    def toggle_view(self):
        if self.view == "history":
            self.view = "settings"
            self.settings_btn.configure(text="✕ close")
            self.history_view.pack_forget()
            self.settings_view.pack(fill="both", expand=True)
            self._load_settings_into_ui()
        else:
            self.view = "history"
            self.settings_btn.configure(text="⚙ settings")
            self.settings_view.pack_forget()
            self.history_view.pack(fill="both", expand=True)

    def _build_history_view(self):
        self.history_view = tk.Frame(self.body, bg=BG)
        self.history_view.pack(fill="both", expand=True)

        # Scrollable list
        container = tk.Frame(self.history_view, bg=BG)
        container.pack(fill="both", expand=True, padx=10)

        canvas = tk.Canvas(container, bg=BG, highlightthickness=0)
        scrollbar = ttk.Scrollbar(container, orient="vertical", command=canvas.yview)
        self.list_frame = tk.Frame(canvas, bg=BG)

        self.list_frame.bind(
            "<Configure>", lambda e: canvas.configure(scrollregion=canvas.bbox("all"))
        )
        canvas.create_window((0, 0), window=self.list_frame, anchor="nw", width=440)
        canvas.configure(yscrollcommand=scrollbar.set)

        canvas.pack(side="left", fill="both", expand=True)
        scrollbar.pack(side="right", fill="y")

        # Bottom action bar
        bottom = tk.Frame(self.history_view, bg=BG)
        bottom.pack(fill="x", padx=10, pady=10)

        BTN = dict(font=("JetBrains Mono", 9), bg=SURFACE, fg=TEAL,
                   activebackground=OVERLAY, activeforeground=TEAL,
                   relief="flat", bd=0, padx=8, pady=4, cursor="hand2")

        tk.Button(bottom, text="purge >7d", command=lambda: self.purge_age(7), **BTN).pack(side="left", padx=2)
        tk.Button(bottom, text="purge >30d", command=lambda: self.purge_age(30), **BTN).pack(side="left", padx=2)
        tk.Button(bottom, text="clear all", command=self.purge_all, **{**BTN, "fg": ROSE}).pack(side="left", padx=2)

        self.count_lbl = tk.Label(bottom, text="", font=("JetBrains Mono", 9), bg=BG, fg=FG_MUTED)
        self.count_lbl.pack(side="right")

    def _build_settings_view(self):
        self.settings_view = tk.Frame(self.body, bg=BG)
        # not packed yet -- history view shows first

        pad = dict(padx=14, pady=(14, 4))

        def section(text):
            tk.Label(self.settings_view, text=text, font=("JetBrains Mono", 10, "bold"),
                      bg=BG, fg=GOLD, anchor="w").pack(fill="x", **pad)

        def row():
            r = tk.Frame(self.settings_view, bg=BG)
            r.pack(fill="x", padx=14, pady=2)
            return r

        # -- Bubble popups --
        section("bubble popups")

        r = row()
        tk.Label(r, text="theme", font=("JetBrains Mono", 9), bg=BG, fg=FG, width=16, anchor="w").pack(side="left")
        self.theme_var = tk.StringVar()
        theme_menu = ttk.Combobox(r, textvariable=self.theme_var, values=list(THEMES.keys()),
                                   state="readonly", font=("JetBrains Mono", 9), width=18)
        theme_menu.pack(side="left")
        theme_menu.bind("<<ComboboxSelected>>", lambda e: self._save_setting("bubble_theme", self.theme_var.get()))

        r = row()
        tk.Label(r, text="max visible", font=("JetBrains Mono", 9), bg=BG, fg=FG, width=16, anchor="w").pack(side="left")
        self.max_visible_var = tk.IntVar()
        tk.Spinbox(r, from_=1, to=10, textvariable=self.max_visible_var, width=6,
                   font=("JetBrains Mono", 9), bg=SURFACE, fg=FG, insertbackground=FG,
                   relief="flat", command=lambda: self._save_setting("bubble_max_visible", self.max_visible_var.get())
                   ).pack(side="left")

        r = row()
        tk.Label(r, text="duration (sec)", font=("JetBrains Mono", 9), bg=BG, fg=FG, width=16, anchor="w").pack(side="left")
        self.duration_var = tk.IntVar()
        tk.Spinbox(r, from_=3, to=60, textvariable=self.duration_var, width=6,
                   font=("JetBrains Mono", 9), bg=SURFACE, fg=FG, insertbackground=FG,
                   relief="flat",
                   command=lambda: self._save_setting("bubble_duration_ms", self.duration_var.get() * 1000)
                   ).pack(side="left")
        tk.Label(r, text="always auto-clears, never sticks around", font=("JetBrains Mono", 8),
                  bg=BG, fg=FG_MUTED).pack(side="left", padx=(10, 0))

        # -- Sound & voice --
        section("sound & voice")

        r = row()
        self.sound_var = tk.BooleanVar()
        tk.Checkbutton(r, text="sound on new notification", variable=self.sound_var,
                       font=("JetBrains Mono", 9), bg=BG, fg=FG, selectcolor=SURFACE,
                       activebackground=BG, activeforeground=FG, anchor="w",
                       command=lambda: self._save_setting("sound_enabled", self.sound_var.get())
                       ).pack(side="left")

        r = row()
        self.speak_var = tk.BooleanVar()
        tk.Checkbutton(r, text="speak notifications (arc-break only)", variable=self.speak_var,
                       font=("JetBrains Mono", 9), bg=BG, fg=FG, selectcolor=SURFACE,
                       activebackground=BG, activeforeground=FG, anchor="w",
                       command=lambda: self._save_setting("speak_enabled", self.speak_var.get())
                       ).pack(side="left")

        # -- App lists --
        section("ignored apps  (comma-separated, never notify)")
        r = row()
        self.ignored_var = tk.StringVar()
        ignored_entry = tk.Entry(r, textvariable=self.ignored_var, font=("JetBrains Mono", 9),
                                  bg=SURFACE, fg=FG, insertbackground=FG, relief="flat")
        ignored_entry.pack(side="left", fill="x", expand=True)
        ignored_entry.bind("<FocusOut>", lambda e: self._save_setting(
            "ignored_apps", [a.strip() for a in self.ignored_var.get().split(",") if a.strip()]))
        ignored_entry.bind("<Return>", lambda e: self._save_setting(
            "ignored_apps", [a.strip() for a in self.ignored_var.get().split(",") if a.strip()]))

        section("speak apps  (comma-separated, TTS-eligible)")
        r = row()
        self.speak_apps_var = tk.StringVar()
        speak_entry = tk.Entry(r, textvariable=self.speak_apps_var, font=("JetBrains Mono", 9),
                                bg=SURFACE, fg=FG, insertbackground=FG, relief="flat")
        speak_entry.pack(side="left", fill="x", expand=True)
        speak_entry.bind("<FocusOut>", lambda e: self._save_setting(
            "speak_apps", [a.strip() for a in self.speak_apps_var.get().split(",") if a.strip()]))
        speak_entry.bind("<Return>", lambda e: self._save_setting(
            "speak_apps", [a.strip() for a in self.speak_apps_var.get().split(",") if a.strip()]))

        tk.Label(self.settings_view, text="changes apply live -- no restart needed",
                 font=("JetBrains Mono", 8), bg=BG, fg=FG_MUTED).pack(anchor="w", padx=14, pady=(16, 0))

    def _load_settings_into_ui(self):
        self.config = pine.load_config()
        self.theme_var.set(self.config.get("bubble_theme", "rose-pine-moon"))
        self.max_visible_var.set(self.config.get("bubble_max_visible", 4))
        self.duration_var.set(self.config.get("bubble_duration_ms", 12000) // 1000)
        self.sound_var.set(self.config.get("sound_enabled", True))
        self.speak_var.set(self.config.get("speak_enabled", True))
        self.ignored_var.set(", ".join(self.config.get("ignored_apps", [])))
        self.speak_apps_var.set(", ".join(self.config.get("speak_apps", ["arc-break"])))

    def _save_setting(self, key, value):
        self.config[key] = value
        pine.save_config(self.config)

    def refresh(self):
        for w in self.list_frame.winfo_children():
            w.destroy()

        q = self.search_var.get().strip()
        if q:
            rows = db_query(
                "SELECT * FROM notifications WHERE app_name LIKE ? OR summary LIKE ? OR body LIKE ? "
                "ORDER BY id DESC LIMIT 200",
                (f"%{q}%", f"%{q}%", f"%{q}%"),
            )
        else:
            rows = db_query("SELECT * FROM notifications ORDER BY id DESC LIMIT 200")

        if not rows:
            tk.Label(self.list_frame, text="no notifications", font=("JetBrains Mono", 10),
                     bg=BG, fg=FG_MUTED).pack(pady=20)

        for row in rows:
            self._add_card(row)

        total = db_query("SELECT COUNT(*) as c FROM notifications")
        self.count_lbl.configure(text=f"{total[0]['c'] if total else 0} total")

    def _add_card(self, row):
        card = tk.Frame(self.list_frame, bg=SURFACE)
        card.pack(fill="x", pady=3)

        color = URGENCY_COLOR.get(row["urgency"], TEAL)

        header = tk.Frame(card, bg=SURFACE)
        header.pack(fill="x", padx=8, pady=(6, 0))
        tk.Label(header, text=row["app_name"], font=("JetBrains Mono", 9, "bold"),
                 bg=SURFACE, fg=color).pack(side="left")
        tk.Label(header, text=row["timestamp"], font=("JetBrains Mono", 8),
                 bg=SURFACE, fg=FG_MUTED).pack(side="right")

        tk.Label(card, text=row["summary"], font=("JetBrains Mono", 10),
                 bg=SURFACE, fg=FG, anchor="w", wraplength=420, justify="left"
                 ).pack(fill="x", padx=8, pady=(2, 0))

        if row["body"]:
            tk.Label(card, text=row["body"], font=("JetBrains Mono", 9),
                     bg=SURFACE, fg=FG_MUTED, anchor="w", wraplength=420, justify="left"
                     ).pack(fill="x", padx=8, pady=(0, 4))

        actions = tk.Frame(card, bg=SURFACE)
        actions.pack(fill="x", padx=8, pady=(0, 6))

        def do_copy(text=f"{row['summary']} {row['body']}".strip()):
            self.clipboard_clear()
            self.clipboard_append(text)

        def do_delete(nid=row["id"]):
            db_exec("DELETE FROM notifications WHERE id = ?", (nid,))
            self.refresh()

        tk.Button(actions, text="copy", command=do_copy, font=("JetBrains Mono", 8),
                  bg=OVERLAY, fg=TEAL, relief="flat", bd=0, padx=6, cursor="hand2"
                  ).pack(side="left")
        tk.Button(actions, text="delete", command=do_delete, font=("JetBrains Mono", 8),
                  bg=OVERLAY, fg=ROSE, relief="flat", bd=0, padx=6, cursor="hand2"
                  ).pack(side="left", padx=(4, 0))

    def purge_age(self, days):
        cutoff = (datetime.now() - timedelta(days=days)).strftime("%Y-%m-%d %H:%M:%S")
        db_exec("DELETE FROM notifications WHERE timestamp < ?", (cutoff,))
        self.refresh()

    def purge_all(self):
        db_exec("DELETE FROM notifications")
        self.refresh()


if __name__ == "__main__":
    ArcPine().mainloop()
