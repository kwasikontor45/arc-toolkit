)
EQ_NODE_NAMES = ("headroom", *(band[0] for band in EQ_BANDS))
_EQ_NUMBER = r"[-+]?(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][-+]?\d+)?"


def _safe_owned_read(path, limit=65536):
    """Read one owned, regular, bounded file without following its final symlink."""
    path = Path(path)
    for parent in reversed([path.parent, *path.parent.parents]):
        parent_stat = parent.lstat()
        if stat.S_ISLNK(parent_stat.st_mode) or not stat.S_ISDIR(parent_stat.st_mode):
            raise OSError(f"refusing unsafe parent directory: {parent}")
    before = path.lstat()
    if not stat.S_ISREG(before.st_mode) or before.st_uid != os.getuid():
        raise OSError(f"refusing non-regular or non-user-owned file: {path}")
    if before.st_size > limit:
        raise OSError(f"file exceeds the {limit}-byte safety limit: {path}")
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
    fd = os.open(path, flags)
    with os.fdopen(fd, "rb") as stream:
        opened = os.fstat(stream.fileno())
        if (opened.st_dev, opened.st_ino) != (before.st_dev, before.st_ino):
            raise OSError(f"file changed while opening: {path}")
        data = stream.read(limit + 1)
    if len(data) > limit:
        raise OSError(f"file exceeds the {limit}-byte safety limit: {path}")
    return data, before


def _parse_eq_config(text):
    """Parse only the known six-node speaker profile; reject altered layouts."""
    nodes_match = re.search(
        r"(?s)filter\.graph\s*=\s*\{.*?nodes\s*=\s*\[(.*?)\]\s*links\s*=",
        text,
    )
    if not nodes_match:
        raise ValueError("speaker profile does not contain the supported filter graph")
    nodes_text = nodes_match.group(1)
    names = re.findall(r"(?m)^\s*name\s*=\s*([A-Za-z0-9_]+)\s*$", nodes_text)
    if tuple(names) != EQ_NODE_NAMES:
        raise ValueError("speaker filter nodes changed; refusing to edit an unknown profile")

    def node_body(name):
        matches = list(re.finditer(
            rf"(?m)^\s*name\s*=\s*{re.escape(name)}\s*$", nodes_text))
        if len(matches) != 1:
            raise ValueError(f"speaker profile must contain exactly one {name} node")
        start = nodes_text.rfind("{", 0, matches[0].start())
        if start < 0:
            raise ValueError(f"could not locate the {name} node")
        depth, quoted, escaped = 0, False, False
        for pos in range(start, len(nodes_text)):
            char = nodes_text[pos]
            if quoted:
                if escaped:
                    escaped = False
                elif char == "\\":
                    escaped = True
                elif char == '"':
                    quoted = False
                continue
            if char == '"':
                quoted = True
            elif char == "{":
                depth += 1
            elif char == "}":
                depth -= 1
                if depth == 0:
                    return nodes_text[start:pos + 1]
        raise ValueError(f"unterminated {name} node")

    def controls(body, name, expected):
        if len(re.findall(r"(?m)^\s*type\s*=\s*builtin\s*$", body)) != 1:
            raise ValueError(f"unsupported implementation in {name} node")
        controls_match = re.search(r"(?s)control\s*=\s*\{([^{}]*)\}", body)
        if not controls_match:
            raise ValueError(f"missing controls in {name} node")
        pairs = re.findall(rf'"([A-Za-z]+)"\s*=\s*({_EQ_NUMBER})', controls_match.group(1))
        if len(pairs) != len(expected) or {key for key, _ in pairs} != set(expected):
            raise ValueError(f"unsupported controls in {name} node")
        values = {key: float(value) for key, value in pairs}
        if not all(math.isfinite(value) for value in values.values()):
            raise ValueError(f"non-finite control in {name} node")
        return values

    headroom = controls(node_body("headroom"), "headroom", ("Mult", "Add"))
    if len(re.findall(r"(?m)^\s*label\s*=\s*linear\s*$", node_body("headroom"))) != 1:
        raise ValueError("unsupported headroom filter type")
    if not 0 < headroom["Mult"] <= 1 or not math.isclose(headroom["Add"], 0.0, abs_tol=1e-9):
        raise ValueError("unsupported headroom controls")
    gains = {}
    for name, _label, freq, q, label in EQ_BANDS:
        body = node_body(name)
        if len(re.findall(rf"(?m)^\s*label\s*=\s*{re.escape(label)}\s*$", body)) != 1:
            raise ValueError(f"unsupported filter type in {name} node")
        values = controls(body, name, ("Freq", "Q", "Gain"))
        if not math.isclose(values["Freq"], freq, abs_tol=0.01) or not math.isclose(values["Q"], q, abs_tol=0.001):
            raise ValueError(f"frequency or Q changed in {name} node")
        if not -3.0 <= values["Gain"] <= 3.0:
            raise ValueError(f"{name} gain is outside the supported ±3 dB range")
        gains[name] = values["Gain"]
    links_match = re.search(r"(?s)links\s*=\s*\[(.*?)\]", text)
    if not links_match:
        raise ValueError("speaker profile links are missing")
    links = re.findall(
        r'output\s*=\s*"([A-Za-z0-9_]+:Out)"\s+input\s*=\s*"([A-Za-z0-9_]+:In)"',
        links_match.group(1),
    )
    expected_links = [(f"{left}:Out", f"{right}:In") for left, right in zip(
        EQ_NODE_NAMES, EQ_NODE_NAMES[1:])]
    if links != expected_links:
        raise ValueError("speaker profile signal path changed; refusing to edit it")
    return {"gains": gains, "mult": headroom["Mult"]}


def read_speaker_eq_snapshot():
    """Read and validate the current EQ without touching audio services."""
    try:
        raw, st = _safe_owned_read(AUDIO_EQ_CONFIG)
        text = raw.decode("utf-8")
        parsed = _parse_eq_config(text)
        return {"available": True, "gains": parsed["gains"], "mult": parsed["mult"],
                "sha256": hashlib.sha256(raw).hexdigest(), "mode": stat.S_IMODE(st.st_mode),
                "error": ""}
    except FileNotFoundError:
        return {"available": False, "error": "speaker EQ profile not found"}
    except (OSError, UnicodeError, ValueError) as exc:
        return {"available": False, "error": f"speaker EQ locked: {exc}"}


def _validate_private_state_dir(path):
    """Create the app's small state directory without accepting symlinked paths."""
    path = Path(path)
    chain = [path, *path.parents]
    for item in reversed(chain):
        try:
            st = item.lstat()
        except FileNotFoundError:
            item.mkdir(mode=0o700)
            st = item.lstat()
        if stat.S_ISLNK(st.st_mode) or not stat.S_ISDIR(st.st_mode):
            raise OSError(f"unsafe state directory: {item}")
        if item == path and (st.st_uid != os.getuid() or stat.S_IMODE(st.st_mode) & 0o077):
            raise OSError(f"state directory must be private and user-owned: {item}")


def _atomic_owned_write(path, data, mode, expected=None, create=False):
    """Atomically replace a user's regular file, optionally checking its inode."""
    path = Path(path)
    for parent in reversed([path.parent, *path.parent.parents]):
        parent_stat = parent.lstat()
        if stat.S_ISLNK(parent_stat.st_mode) or not stat.S_ISDIR(parent_stat.st_mode):
            raise OSError(f"unsafe target directory: {parent}")
    try:
        current = path.lstat()
    except FileNotFoundError:
        current = None
    if current is None:
        if not create or expected is not None:
            raise OSError(f"target file disappeared before the write: {path}")
    else:
        if not stat.S_ISREG(current.st_mode) or current.st_uid != os.getuid():
            raise OSError(f"refusing non-regular or non-user-owned target: {path}")
        if create:
            raise OSError(f"refusing to replace an existing baseline: {path}")
        if expected is not None and (current.st_dev, current.st_ino, current.st_size,
                                     current.st_mtime_ns) != expected:
            raise OSError("speaker profile changed before the write; reload and retry")
    fd, temp_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        os.fchmod(fd, mode)
        with os.fdopen(fd, "wb") as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        if create:
            os.link(temp_name, path, follow_symlinks=False)
            os.unlink(temp_name)
        else:
            os.replace(temp_name, path)
        dir_fd = os.open(path.parent, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0))
        try:
            os.fsync(dir_fd)
        finally:
            os.close(dir_fd)
    except Exception:
        try:
            os.unlink(temp_name)
        except OSError:
            pass
        raise


def _replace_eq_values(text, gains, mult):
    """Change only the five Gain numbers and headroom Mult in the validated file."""
    replacements = [("headroom", "Mult", mult)] + [(name, "Gain", gains[name])
                                                     for name, *_ in EQ_BANDS]
    nodes_match = re.search(
        r"(?s)filter\.graph\s*=\s*\{.*?nodes\s*=\s*\[(.*?)\]\s*links\s*=",
        text,
    )
    if not nodes_match:
        raise ValueError("speaker profile graph disappeared")
    nodes_text = nodes_match.group(1)
    edits = []
    for name, key, value in replacements:
        node_match = re.search(rf"(?m)^\s*name\s*=\s*{re.escape(name)}\s*$", nodes_text)
        if not node_match:
            raise ValueError(f"missing {name} node")
        open_at = nodes_text.rfind("{", 0, node_match.start())
        depth, quoted, escaped, close_at = 0, False, False, None
        for pos in range(open_at, len(nodes_text)):
            char = nodes_text[pos]
            if quoted:
                if escaped: escaped = False
                elif char == "\\": escaped = True
                elif char == '"': quoted = False
                continue
            if char == '"': quoted = True
            elif char == "{": depth += 1
            elif char == "}":
                depth -= 1
                if depth == 0:
                    close_at = pos + 1
                    break
        if close_at is None:
            raise ValueError(f"unterminated {name} node")
        body = nodes_text[open_at:close_at]
        match = re.search(rf'("{key}"\s*=\s*)({_EQ_NUMBER})', body)
        if not match:
            raise ValueError(f"missing {key} in {name} node")
        absolute = nodes_match.start(1) + open_at + match.start(2)
        edits.append((absolute, absolute + len(match.group(2)), f"{value:.6g}"))
    result = text
    for start, end, value in sorted(edits, reverse=True):
        result = result[:start] + value + result[end:]
    _parse_eq_config(result)
    return result


def apply_speaker_eq(gains, expected_sha256, reset=False):
    """Apply the validated speaker curve after an explicit UI confirmation.

    PipeWire is restarted only when its user service is already active. An
    inactive service is left stopped and picks up the saved profile next start.
    """
    raw, st = _safe_owned_read(AUDIO_EQ_CONFIG)
    if hashlib.sha256(raw).hexdigest() != expected_sha256:
        raise OSError("speaker profile changed outside this panel; reload before applying")
    old_text = raw.decode("utf-8")
    current = _parse_eq_config(old_text)
    _validate_private_state_dir(AUDIO_EQ_BASELINE.parent)
    baseline_exists = AUDIO_EQ_BASELINE.exists() or AUDIO_EQ_BASELINE.is_symlink()
    if baseline_exists:
        baseline_raw, baseline_st = _safe_owned_read(AUDIO_EQ_BASELINE)
        baseline = _parse_eq_config(baseline_raw.decode("utf-8"))
    else:
        baseline_raw, baseline_st = raw, st
        baseline = current

    service = subprocess.run(["systemctl", "--user", "is-active", "pipewire.service"],
                             capture_output=True, text=True, timeout=6, check=False)
    service_state = (service.stdout or service.stderr).strip().splitlines()
    service_state = service_state[-1] if service_state else ""
    if service_state not in {"active", "inactive", "failed"}:
        raise OSError("could not safely determine PipeWire state; profile was not changed")
    if service_state == "active" and service.returncode != 0:
        raise OSError("PipeWire status response was inconsistent; profile was not changed")
    was_active = service_state == "active"

    if reset:
        target_raw = baseline_raw
        target_values = _parse_eq_config(target_raw.decode("utf-8"))
    else:
        if set(gains) != {band[0] for band in EQ_BANDS}:
            raise ValueError("the EQ selection is incomplete")
        clean_gains = {name: float(gains[name]) for name, *_ in EQ_BANDS}
        if not all(math.isfinite(value) and -3.0 <= value <= 3.0
                   for value in clean_gains.values()):
            raise ValueError("EQ values must stay within ±3.0 dB")
        expected_mult = baseline["mult"] * 10 ** (
            -sum(max(0.0, clean_gains[name] - baseline["gains"][name])
                 for name, *_ in EQ_BANDS) / 20.0)
        if baseline_exists:
            expected_current = baseline["mult"] * 10 ** (
                -sum(max(0.0, current["gains"][name] - baseline["gains"][name])
                     for name, *_ in EQ_BANDS) / 20.0)
            if not math.isclose(current["mult"], expected_current, rel_tol=0.0, abs_tol=0.0005):
                raise OSError("headroom changed outside this panel; reset/review the profile first")
        target_text = _replace_eq_values(old_text, clean_gains, expected_mult)
        target_raw = target_text.encode("utf-8")
        target_values = _parse_eq_config(target_text)

    if not baseline_exists:
        _atomic_owned_write(AUDIO_EQ_BASELINE, baseline_raw, 0o600, create=True)
    before = (st.st_dev, st.st_ino, st.st_size, st.st_mtime_ns)
    _atomic_owned_write(AUDIO_EQ_CONFIG, target_raw, stat.S_IMODE(st.st_mode), expected=before)
    if not was_active:
        return {"message": "EQ saved. PipeWire was already stopped and was left stopped; the profile takes effect the next time it starts.",
                "sha256": hashlib.sha256(target_raw).hexdigest(), "values": target_values,
                "active": False}

    applied_stat = AUDIO_EQ_CONFIG.lstat()
    applied_identity = (applied_stat.st_dev, applied_stat.st_ino, applied_stat.st_size,
                        applied_stat.st_mtime_ns)
    restart = active = None
    restart_error = ""
    try:
        restart = subprocess.run(["systemctl", "--user", "restart", "pipewire.service"],
                                 capture_output=True, text=True, timeout=20, check=False)
        active = subprocess.run(["systemctl", "--user", "is-active", "pipewire.service"],
                                capture_output=True, text=True, timeout=6, check=False)
        if restart.returncode != 0 or (active.stdout or active.stderr).strip() != "active":
            restart_error = ((restart.stderr or restart.stdout).strip()
                             or "PipeWire did not return to active")
    except (OSError, subprocess.SubprocessError) as exc:
        restart_error = str(exc)
    if restart_error:
        _atomic_owned_write(AUDIO_EQ_CONFIG, raw, stat.S_IMODE(st.st_mode),
                            expected=applied_identity)
        try:
            subprocess.run(["systemctl", "--user", "restart", "pipewire.service"],
                           capture_output=True, text=True, timeout=20, check=False)
        except (OSError, subprocess.SubprocessError):
            pass
        raise RuntimeError(f"PipeWire restart failed; the previous profile was restored. {restart_error}")

    try:
        graph = subprocess.run(["pw-cli", "ls", "Node"], capture_output=True, text=True,
                               timeout=8, check=False)
    except (OSError, subprocess.SubprocessError):
        graph = None
    if graph is not None and graph.returncode == 0:
        expected_nodes = ("effect_input.speaker_studio_eq", "effect_output.speaker_studio_eq")
        if not all(name in graph.stdout for name in expected_nodes):
            _atomic_owned_write(AUDIO_EQ_CONFIG, raw, stat.S_IMODE(st.st_mode),
                                expected=applied_identity)
            try:
                subprocess.run(["systemctl", "--user", "restart", "pipewire.service"],
                               capture_output=True, text=True, timeout=20, check=False)
            except (OSError, subprocess.SubprocessError):
                pass
            raise RuntimeError("EQ nodes did not appear; the previous profile was restored")
        verification = " PipeWire restarted and both EQ nodes were found."
    else:
        verification = " PipeWire restarted; node listing was unavailable, so graph verification is pending."
    return {"message": "Speaker EQ applied." + verification,
            "sha256": hashlib.sha256(target_raw).hexdigest(), "values": target_values,
            "active": True}


def audio_status_line(snapshot):
    if not snapshot.get("available"):
        return "audio status unavailable"
    state = "muted" if snapshot["muted"] else "live"
    return f"{snapshot['sink']}  ·  {snapshot['volume']}%  ·  {state}"


def sop_setup_command(cmd):
    """Allow only the small SOP workflow that can inspect or unlock operations.

    Everything else launched from the panel is gated centrally in App.run_async.
    Keep parsing strict so shell suffixes cannot ride along with an allowed command.
    """
    try:
        words = shlex.split(cmd)
    except ValueError:
        return False
    if words[:2] == ["arc-sop", "start"]:
        return (len(words) == 3 and bool(words[2].strip()) or
                len(words) == 5 and words[3] == "--accept-policy"
                and bool(words[2].strip()) and re.fullmatch(r"[a-f0-9]{64}", words[4]) is not None)
    if words[:2] == ["arc-sop", "violations"]:
        return len(words) == 2 or words[2:] == ["--watch"]
    if words[:2] == ["arc-sop", "gate-check"]:
        return len(words) == 2
    if words == ["arc-sop", "recover"]:
        return True
    if words == ["arc-sop", "emergency"]:
        return True
    if words == ["arc-sop", "gate-enable"]:
        return True
    if words == ["arc", "sop", "gate-enable"]:
        return True
    if words[:2] != ["arc", "sop"]:
        return False
    if len(words) >= 4 and words[:3] == ["arc", "sop", "start"]:
        if len(words) == 4:
            return bool(words[3].strip())
        return ("--accept-policy" in words[4:] and len(words) == 6
                and bool(words[3].strip()) and re.fullmatch(r"[a-f0-9]{64}", words[5]) is not None)
    if words[:3] == ["arc", "sop", "violations"]:
        return len(words) == 3 or words[3:] == ["--watch"]
    if words == ["arc", "sop", "recover"]:
        return True
    if words == ["arc", "sop", "emergency"]:
        return True
    return len(words) == 3 and words[2] in {"ack-today", "check", "gate-check", "verify", "status"}


def panel_preflight_command(cmd):
    """Commands that must remain usable to read or satisfy the gate."""
    if sop_setup_command(cmd):
        return True
    try:
        return shlex.split(cmd) == ["arc", "help", "all"]
    except ValueError:
        return False


def panel_command_allowed(cmd, gate_open):
    """Allow SOP recovery/readiness actions while locked; gate every other command."""
    return gate_open or panel_preflight_command(cmd)


def check_sop_gate(timeout=5):
    """Use arc-sop's authoritative same-session gate check."""
    try:
        p = subprocess.run(["arc-sop", "gate-check"], capture_output=True, text=True,
                           timeout=timeout)
        return p.returncode == 0, strip_ansi((p.stdout or p.stderr).strip())
    except Exception as e:
        return False, f"SOP gate check unavailable: {e}"


def gate_status(ok, detail=''):
    """Show the current, version-bound session gate state."""
    return ("SOP GATE  ·  OPEN", PINE) if ok else ("SOP GATE  ·  LOCKED", ROSE)


# ── execution core ───────────────────────────────────────────────────────────
class Runner:
    """The ONE way this app runs commands.

    Captured runs write to a temp file, not a pipe, so a stray grandchild (a
    tunnel, a browser) that inherits the write end can never hold a read open.
    We only wait on the shell itself, and on timeout kill the whole process
    GROUP (process_group=0): the old subprocess.run(shell=True, timeout=...)
    returned on time but killed only the shell, orphaning everything it had
    started (measured: 2 processes left running after a 3s timeout; 0 now).
    stdin is closed so nothing waits on a TTY (sudo, prompts) -- it fails fast
    with a real error instead of hanging.

    detach() is for persistent GUI windows: Popen with stdio on DEVNULL returns
    instantly however long the window stays open. Deliberately NOT
    start_new_session -- setsid()'d children were reaped by logind ~4-5s in
    (confirmed by timed observation). Finished children are reaped by reap()
    so they don't linger as zombies."""

    MAX_OUT = 200_000

    def __init__(self):
        self._detached = []
        self._lock = threading.Lock()

    def run(self, cmd, timeout=30):
        """(ok, output). Never raises."""
        timed_out = False
        try:
            with tempfile.TemporaryFile() as tf:
                p = subprocess.Popen(cmd, shell=True, stdin=subprocess.DEVNULL, stdout=tf,
                                     stderr=subprocess.STDOUT, process_group=0)
                try:
                    rc = p.wait(timeout=timeout)
                except subprocess.TimeoutExpired:
                    timed_out, rc = True, None
                    self._kill_group(p)
                tf.seek(0)
                out = strip_ansi(tf.read(self.MAX_OUT).decode("utf-8", "replace")).strip()
        except Exception as e:
            return False, f"(error launching command: {e})"
        if timed_out:
            return False, (out + "\n" if out else "") + f"(timed out after {timeout}s -- killed)"
        return rc == 0, out

    @staticmethod
    def _kill_group(p):
        try:
            os.killpg(p.pid, signal.SIGTERM)
        except ProcessLookupError:
            return
        try:
            p.wait(timeout=2)
        except subprocess.TimeoutExpired:
            try:
                os.killpg(p.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            p.wait()

    def detach(self, cmd):
        try:
            p = subprocess.Popen(cmd, shell=True, stdin=subprocess.DEVNULL,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception as e:
            return False, f"(error launching: {e})"
        with self._lock:
            self._detached.append(p)
        return True, "launched"

    def reap(self):
        with self._lock:
            self._detached = [p for p in self._detached if p.poll() is None]


class UiBridge:
    """Worker threads must never call Tk (not thread-safe -- intermittent
    "main thread is not in main loop" errors). They post callables here; the
    main thread drains the queue on a short timer. Errors in a callback go to
    the app's callback-exception handler instead of killing the pump."""

    def __init__(self, root):
        self.root = root
        self._q = queue.Queue()
        root.after(40, self._pump)

    def post(self, fn, *args):
        self._q.put((fn, args))

    def _pump(self):
        try:
            for _ in range(300):
                fn, args = self._q.get_nowait()
                try:
                    fn(*args)
                except Exception:
                    self.root.report_callback_exception(*sys.exc_info())
        except queue.Empty:
            pass
        self.root.after(40, self._pump)


class Poller:
    """Named periodic jobs. Guarantees the old code lacked: exactly ONE chain
    per name (start() cancels any previous one -- the old aws poll started a new
    never-ending chain on every visit to Status), an in-flight guard (a slow
    check skips a beat instead of stacking threads), and nothing applies to a
    view that's gone (alive() is checked before every apply)."""

    def __init__(self, root, bridge):
        self.root, self.bridge = root, bridge
        self._jobs = {}

    def start(self, name, every_ms, work, apply, alive):
        self.stop(name)
        job = {"after": None, "busy": False, "stop": False}
        self._jobs[name] = job

        def run_once():
            if job["stop"] or job["busy"]:
                return
            job["busy"] = True

            def worker():
                try:
                    res, err = work(), None
                except Exception as e:
                    res, err = None, e
                self.bridge.post(finish, res, err)
            threading.Thread(target=worker, daemon=True).start()

        def finish(res, err):
            job["busy"] = False
            if job["stop"] or not alive():
                return
            if err is not None:
                raise err
            apply(res)

        def beat():
            if job["stop"]:
                return
            job["after"] = self.root.after(every_ms, beat)   # next beat first: one chain, always
            run_once()

        job["kick"] = run_once
        beat()

    def kick(self, name):
        job = self._jobs.get(name)
        if job:
            job["kick"]()

    def stop(self, name):
        job = self._jobs.pop(name, None)
        if job:
            job["stop"] = True
            if job["after"] is not None:
                try:
                    self.root.after_cancel(job["after"])
                except Exception:
                    pass

    def active(self):
        return sorted(self._jobs)


# ── actions + confirm policy ─────────────────────────────────────────────────
class Action:
    """One button: a label, the command it runs, and how. `confirm=None` means
    "decide by ConfirmPolicy" (the normal case); True/False overrides -- False
    only with a comment saying why. `detach` = persistent GUI launch."""

    def __init__(self, label, cmd, confirm=None, timeout=30, detach=False):
        self.label, self.cmd, self.confirm = label, cmd, confirm
        self.timeout, self.detach = timeout, detach


class ConfirmPolicy:
    """One rule, by verb, instead of a per-button flag that drifts (the old
    code left `sudo stop`, `fix audio` -- which restarts the panel -- `fix
    display` and `break stop` ungated while gating near-identical siblings).
    Anything that starts/stops/restarts/rebuilds/toggles/connects/changes
    network or system state needs a confirm click; read-only checks run
    immediately."""

    VERBS = re.compile(
        r"\b(start|stop|restart|reboot|kill|purge|clean|update|upgrade|rebuild|build|baseline|"
        r"snapshot|snap|backup|toggle|connect|disconnect|killswitch|expose|unexpose|enable|"
        r"disable|fix|on|off)\b", re.I)

    @classmethod
    def inferred(cls, action):
        return bool(cls.VERBS.search(action.cmd))

    @classmethod
    def required(cls, action):
        return action.confirm if action.confirm is not None else cls.inferred(action)

    @classmethod
    def overrides(cls, categories):
        """Actions explicitly exempted from a confirm the verbs say they need
        (for review / selftest output -- each must have a stated reason)."""
        return [(c, a.label, a.cmd) for c, acts in categories.items() for a in acts
                if a.confirm is False and cls.inferred(a)]


CATEGORIES = {
