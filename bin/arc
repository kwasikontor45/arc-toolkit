}

# ── Notifications ──────────────────────────────────────────────────────────────
cmd_notify() {
  case "${2:-}" in
    status|count)
      if [ -f ~/.local/share/arc-pine/history.db ]; then
        local count
        count=$(sqlite3 ~/.local/share/arc-pine/history.db "SELECT COUNT(*) FROM notifications" 2>/dev/null || echo 0)
        echo -e "  ${C}${count}${N} notifications in history"
      else
        echo -e "  ${D}no notification database yet${N}"
      fi
      ;;
    purge)
      arc-pine &
      ;;
    tts-on)
      arc-pine-speak on
      ;;
    tts-off)
      arc-pine-speak off
      ;;
    *)
      arc-pine &
      ;;
  esac
}

# ── SOP enforcement ─────────────────────────────────────────────────────────────
cmd_sop() {
  case "${2:-}" in
    ack)
      arc-sop ack
      ;;
    baseline)
      arc-sop baseline
      ;;
    verify)
      arc-sop verify
      ;;
    check)
      arc-sop check
      ;;
    status)
      arc-sop status
      ;;
    bundle)
      arc-sop bundle
      ;;
    root-copy)
      arc-sop root-copy
      ;;
    recover)
      arc-sop recover
      ;;
    violations)
      arc-sop violations
      ;;
    resolve)
      arc-sop resolve "${3:-}"
      ;;
    ack-today|check-today)
      arc-sop ack-today
      ;;
    done-balance|check-done)
      arc-sop done-balance
      ;;
    start)
      arc-sop start "${@:3}"
      ;;
    gate)
      case "${3:-}" in
        status)  arc-sop gate-status ;;
        bypass)  arc-sop gate-bypass ;;
        enable)  arc-sop gate-enable ;;
        *)       echo -e "  usage: arc sop gate [status|bypass|enable]" ;;
      esac
      ;;
    *)
      echo -e "  ${C}arc sop${N} — SOP enforcement"
      echo -e "  ${D}ack · baseline · verify · check · status · violations · resolve <id>${N}"
      echo -e "  ${D}bundle · root-copy · recover · ack-today · done-balance${N}"
      echo -e "  ${D}start [description]        — the one command: shows GAMEPLAN.md + logs [STARTING] + acks${N}"
      echo -e "  ${D}gate status|bypass|enable  — interactive-shell gate management${N}"
      ;;
  esac
}

# ── System compliance check ─────────────────────────────────────────────────────
cmd_arc_check() {
  arc-sop check
}

# ── Rename ─────────────────────────────────────────────────────────────────────
cmd_rename() {
  ~/.local/bin/rename-case "$@"
}

# ── AWS SSH ─────────────────────────────────────────────────────────────────────
cmd_aws() {
  local sub="${1:-}"
  local conf="$HOME/.config/arc/aws.conf"
  local AWS_HOST="34.225.113.167" AWS_USER="ubuntu" AWS_KEY="$HOME/.ssh/py-bite.pem"
  [[ -f "$conf" ]] && source "$conf"
  AWS_KEY="${AWS_KEY/#\~/$HOME}"
  if [[ ! -f "$AWS_KEY" ]]; then
    echo -e "  ${R}✗${N}  key not found: $AWS_KEY"
    echo -e "  ${D}update: ~/.config/arc/aws.conf${N}"
    return 1
  fi

  case "$sub" in
    motd)
      local src="$HOME/khaos-lab/tools/aws-motd"
      echo -e "$HR"
      echo -e "  ${C}${B}arc aws motd${N}  —  install custom MOTD"
      echo -e "$HR\n"
      if [[ ! -f "$src" ]]; then
        echo -e "  ${R}✗${N}  not found: $src"; echo -e "\n$HR"; return 1
      fi
      echo -e "  ${C}installing...${N}"
      base64 "$src" | ssh -i "$AWS_KEY" "${AWS_USER}@${AWS_HOST}" \
        'base64 -d > /tmp/aws-motd \
         && sudo mv /tmp/aws-motd /etc/update-motd.d/01-greeting \
         && sudo chmod +x /etc/update-motd.d/01-greeting \
         && for f in 00-header 10-help-text 50-landscape-sysinfo 50-motd-news \
              90-updates-available 91-contract-ua-esm-status; do
              sudo chmod -x /etc/update-motd.d/$f 2>/dev/null || true; done \
         && for f in 85-fwupd 91-release-upgrade 92-unattended-upgrades \
              95-hwe-eol 97-overlayroot 98-fsck-at-reboot 98-reboot-required; do
              sudo chmod -x /etc/update-motd.d/$f 2>/dev/null || true; done \
         && echo done' \
        && echo -e "  ${G}✓${N}  MOTD installed — reconnect with ${C}arc aws${N} to see it" \
        || echo -e "  ${R}✗${N}  install failed"
      echo -e "\n$HR"
      ;;
    push)
      local src="$HOME/khaos-lab/tools/server-arc"
      local dst="/home/${AWS_USER}/.local/bin/server-arc"
      echo -e "$HR"
      echo -e "  ${C}${B}arc aws push${N}  —  deploy server-arc"
      echo -e "$HR\n"
      if [[ ! -f "$src" ]]; then
        echo -e "  ${R}✗${N}  not found: $src"; echo -e "\n$HR"; return 1
      fi
      echo -e "  ${C}copying...${N}"
      ssh -i "$AWS_KEY" "${AWS_USER}@${AWS_HOST}" "mkdir -p ~/.local/bin" \
        && scp -i "$AWS_KEY" "$src" "${AWS_USER}@${AWS_HOST}:${dst}" \
        && ssh -i "$AWS_KEY" "${AWS_USER}@${AWS_HOST}" "chmod +x ${dst}" \
        && echo -e "  ${G}✓${N}  server-arc deployed to ${AWS_USER}@${AWS_HOST}" \
        || echo -e "  ${R}✗${N}  deploy failed"
      echo -e "\n$HR"
      ;;
    status)
      echo -e "$HR"
      echo -e "  ${C}${B}arc aws status${N}  —  ${M}${AWS_USER}@${AWS_HOST}${N}"
      echo -e "$HR"
      ssh -i "$AWS_KEY" "${AWS_USER}@${AWS_HOST}" bash <<'REMOTE'
echo ""
# Uptime
uptime_str=$(uptime -p 2>/dev/null || uptime)
printf "  \033[0;36muptime\033[0m  \033[38;5;250m%s\033[0m\n" "$uptime_str"

# Disk
du_=$(df -h / | awk 'NR==2 {print $3}')
df_=$(df -h / | awk 'NR==2 {print $4}')
dp_=$(df /   | awk 'NR==2 {print $5}')
printf "  \033[0;36mdisk\033[0m    \033[38;5;250m%s used  ·  %s free  (%s)\033[0m\n" "$du_" "$df_" "$dp_"

# RAM
rm_used=$(free -h | awk '/Mem:/ {print $3}')
rm_free=$(free -h | awk '/Mem:/ {print $7}')
rm_pct=$(free    | awk '/Mem:/ {printf "%.0f%%", $3/$2*100}')
printf "  \033[0;36mram\033[0m     \033[38;5;250m%s used  ·  %s free  (%s)\033[0m\n" "$rm_used" "$rm_free" "$rm_pct"

# Load
read -r l1 l5 l15 _ < /proc/loadavg
printf "  \033[0;36mload\033[0m    \033[38;5;250m%s · %s · %s\033[0m\n" "$l1" "$l5" "$l15"

echo ""

# Services (py-bite has run as a Docker container since the 2026-07-07
# containerization migration — checked via the container's own health status,
# not the old systemd unit, which is deliberately disabled and always reads
# "inactive" now regardless of whether the real app is actually up)
for svc in nginx fail2ban ufw; do
  if systemctl is-active --quiet "$svc" 2>/dev/null; then
    printf "  \033[0;32m·\033[0m  \033[38;5;250m%s\033[0m\n" "$svc"
  else
    printf "  \033[0;31m·\033[0m  \033[38;5;250m%s\033[0m  \033[0;90m(inactive)\033[0m\n" "$svc"
  fi
done
pb_health=$(docker inspect --format '{{.State.Health.Status}}' py-bite 2>/dev/null)
if [[ "$pb_health" == "healthy" ]]; then
  printf "  \033[0;32m·\033[0m  \033[38;5;250mpy-bite\033[0m  \033[0;90m(docker, healthy)\033[0m\n"
elif [[ -n "$pb_health" ]]; then
  printf "  \033[0;31m·\033[0m  \033[38;5;250mpy-bite\033[0m  \033[0;90m(docker, %s)\033[0m\n" "$pb_health"
else
  printf "  \033[0;31m·\033[0m  \033[38;5;250mpy-bite\033[0m  \033[0;90m(container not found)\033[0m\n"
fi

echo ""

# Active SSH sessions
sessions=$(who 2>/dev/null | wc -l | tr -d ' ')
printf "  \033[0;36mssh sessions\033[0m  \033[38;5;250m%s active\033[0m\n" "$sessions"

# Auth failures in last hour
fails=$(awk -v d="$(date --date='1 hour ago' '+%b %e %H')" \
  '$0 ~ d && /Failed password|Invalid user/' \
  /var/log/auth.log 2>/dev/null | wc -l | tr -d ' ')
if (( fails > 0 )); then
  printf "  \033[0;31m·\033[0m  \033[38;5;250m%s failed auth attempt(s) in last hour\033[0m\n" "$fails"
else
  printf "  \033[0;32m·\033[0m  \033[38;5;250m0 failed auth attempts in last hour\033[0m\n"
fi
echo ""
REMOTE
      echo -e "$HR"
      ;;
    logs)
      echo -e "$HR"
      echo -e "  ${C}${B}arc aws logs${N}  —  live auth tail  ${D}(ctrl-c to exit)${N}"
      echo -e "$HR\n"
      ssh -i "$AWS_KEY" "${AWS_USER}@${AWS_HOST}" "sudo tail -f /var/log/auth.log"
      ;;
    htop)
      ssh -i "$AWS_KEY" -t "${AWS_USER}@${AWS_HOST}" "htop"
      ;;
    '')
      echo -e "  ${C}connecting${N}  ${M}${AWS_USER}@${AWS_HOST}${N}  ${D}(${AWS_KEY})${N}"
      ssh -i "$AWS_KEY" "${AWS_USER}@${AWS_HOST}"
      ;;
    *)
      echo -e "${R}unknown:${N} arc aws $sub"
      echo -e "${D}options: status · logs · htop · push · motd${N}"
      ;;
  esac
}

# ── Local Docker containers ─────────────────────────────────────────────────
# kali-workbench / sagan / evebox all run as local Docker containers, not
# remote EC2 boxes -- no SSH/key involved, just `docker` directly against
# each container by name.

cmd_kali() {
  local sub="${1:-}"
  local name="kali-workbench"
  case "$sub" in
    start)
      echo -e "$HR"
      echo -e "  ${C}${B}arc kali start${N}  —  start ${name}"
      echo -e "$HR\n"
      docker start "$name" >/dev/null 2>&1 \
        && echo -e "  ${G}✓${N}  running" \
        || echo -e "  ${R}✗${N}  failed — is the container present? (docker ps -a)"
      echo -e "\n$HR"
      ;;
    stop)
      echo -e "$HR"
      echo -e "  ${C}${B}arc kali stop${N}  —  stop ${name}"
      echo -e "$HR\n"
      docker stop "$name" >/dev/null 2>&1 \
        && echo -e "  ${G}✓${N}  stopped" \
        || echo -e "  ${R}✗${N}  failed to stop"
      echo -e "\n$HR"
      ;;
    status)
      echo -e "$HR"
      echo -e "  ${C}${B}arc kali status${N}"
      echo -e "$HR\n"
      local state; state=$(docker inspect --format '{{.State.Status}}' "$name" 2>/dev/null)
      if [[ -z "$state" ]]; then
        echo -e "  ${R}✗${N}  container not found"
      elif [[ "$state" == "running" ]]; then
        local stats; stats=$(docker stats "$name" --no-stream --format '{{.CPUPerc}} cpu · {{.MemUsage}}' 2>/dev/null)
        echo -e "  ${G}✓${N}  running  ${D}(${stats})${N}"
      else
        echo -e "  ${Y}!${N}  ${state}  ${D}(arc kali start)${N}"
      fi
      echo -e "\n$HR"
      ;;
    logs)
      docker logs -f "$name"
      ;;
    '')
      local state; state=$(docker inspect --format '{{.State.Status}}' "$name" 2>/dev/null)
      if [[ -z "$state" ]]; then
        echo -e "  ${R}✗${N}  container not found — check docker ps -a"
        return 1
      fi
      if [[ "$state" != "running" ]]; then
        echo -e "  ${Y}!${N}  container is ${state} — starting it..."
        docker start "$name" >/dev/null 2>&1
      fi
      echo -e "  ${C}entering${N}  ${M}${name}${N}"
      docker exec -it "$name" bash
      ;;
    *)
      echo -e "${R}unknown:${N} arc kali $sub"
      echo -e "${D}options: (bare) shell · start · stop · status · logs${N}"
      ;;
  esac
}

cmd_sagan() {
  local sub="${1:-}"
  local name="sagan"
  case "$sub" in
    start)
      echo -e "$HR"
      echo -e "  ${C}${B}arc sagan start${N}  —  start ${name}"
      echo -e "$HR\n"
      docker start "$name" >/dev/null 2>&1 \
        && echo -e "  ${G}✓${N}  running" \
        || echo -e "  ${R}✗${N}  failed — is the container present? (docker ps -a)"
      echo -e "\n$HR"
      ;;
    stop)
      echo -e "$HR"
      echo -e "  ${C}${B}arc sagan stop${N}  —  stop ${name}"
      echo -e "$HR\n"
      docker stop "$name" >/dev/null 2>&1 \
        && echo -e "  ${G}✓${N}  stopped" \
        || echo -e "  ${R}✗${N}  failed to stop"
      echo -e "\n$HR"
      ;;
    restart)
      echo -e "$HR"
      echo -e "  ${C}${B}arc sagan restart${N}"
      echo -e "$HR\n"
      docker restart "$name" >/dev/null 2>&1 \
        && echo -e "  ${G}✓${N}  restarted" \
        || echo -e "  ${R}✗${N}  restart failed"
      echo -e "\n$HR"
      ;;
    status)
      echo -e "$HR"
      echo -e "  ${C}${B}arc sagan status${N}"
      echo -e "$HR\n"
      local state; state=$(docker inspect --format '{{.State.Status}}' "$name" 2>/dev/null)
      if [[ -z "$state" ]]; then
        echo -e "  ${R}✗${N}  container not found"
      elif [[ "$state" == "running" ]]; then
        local stats; stats=$(docker stats "$name" --no-stream --format '{{.CPUPerc}} cpu · {{.MemUsage}}' 2>/dev/null)
        echo -e "  ${G}✓${N}  running  ${D}(${stats})${N}"
        docker exec "$name" tail -3 /var/log/sagan/sagan.log 2>/dev/null | sed 's/^/  /'
      else
        echo -e "  ${Y}!${N}  ${state}  ${D}(arc sagan start)${N}"
      fi
      echo -e "\n$HR"
      ;;
    logs)
      docker exec "$name" tail -f /var/log/sagan/sagan.log
      ;;
    alerts)
      echo -e "$HR"
      echo -e "  ${C}${B}arc sagan alerts${N}  —  most recent"
      echo -e "$HR\n"
      docker exec "$name" tail -10 /var/log/sagan/eve.json 2>/dev/null | python3 -c "
import sys, json
for line in sys.stdin:
    line = line.strip()
    if not line:
        continue
    try:
        d = json.loads(line)
    except Exception:
        continue
    a = d.get('alert', {})
    if not a:
        continue
    print(f\"  {d.get('timestamp','?')}  {a.get('signature','?')}  (src {d.get('src_ip','?')})\")
"
      echo -e "\n$HR"
      ;;
    '')
      cmd_sagan status
      ;;
    *)
      echo -e "${R}unknown:${N} arc sagan $sub"
      echo -e "${D}options: status · start · stop · restart · logs · alerts${N}"
      ;;
  esac
}

cmd_darkstat() {
  # darkstat wrapper -- live traffic dashboard (who's talking to whom right
  # now), picked 2026-08-18 over ntopng after verifying ntopng has no real
  # Kali build (ntop.org's repo only ships bookworm/bullseye/buster/trixie,
  # kali-rolling 404s -- using trixie's repo on kali-rolling risked a real
  # apt dependency conflict, not worth it for this). darkstat is genuinely
  # in Kali's own repos, no third-party trust added.
  #
  # Manual-start only, same principle as arc-break/arc-zap. Reconciled
  # 2026-08-22 onto the packaged systemd unit (was a parallel setcap+raw-binary
  # path on a different port, 8667, that this wrapper had never actually been
  # used to start -- two independent darkstat paths existing at once was the
  # real problem, not which one). Unit ships disabled by default and stays
  # that way; this wrapper only ever starts/stops it manually. Config fixed
  # the same day (interface was still pointed at the dead eth0) in
  # /etc/darkstat/init.cfg, backed up alongside.
  local sub="${1:-}"
  local DS_HOST="127.0.0.1"
  local DS_PORT="667"
  local DS_IFACE="wlan0"

  case "$sub" in
    start)
      echo -e "$HR"
      echo -e "  ${C}${B}arc darkstat start${N}  —  live traffic dashboard on ${DS_IFACE}"
      echo -e "$HR\n"
      if systemctl is-active --quiet darkstat; then
        echo -e "  ${Y}!${N}  already running"
      else
        sudo systemctl start darkstat
        sleep 1
        if systemctl is-active --quiet darkstat && curl -s "http://${DS_HOST}:${DS_PORT}" >/dev/null 2>&1; then
          echo -e "  ${G}✓${N}  up  ${D}(http://${DS_HOST}:${DS_PORT}, watching ${DS_IFACE}, loopback only)${N}"
        else
          echo -e "  ${R}✗${N}  didn't come up — check: sudo journalctl -u darkstat"
        fi
      fi
      echo -e "\n$HR"
      ;;
    stop)
      echo -e "$HR"
      echo -e "  ${C}${B}arc darkstat stop${N}"
      echo -e "$HR\n"
      if systemctl is-active --quiet darkstat; then
        sudo systemctl stop darkstat \
          && echo -e "  ${G}✓${N}  stopped" \
          || echo -e "  ${R}✗${N}  failed to stop"
      else
        echo -e "  ${D}·${N}  not running"
      fi
      echo -e "\n$HR"
      ;;
    status|'')
      echo -e "$HR"
      echo -e "  ${C}${B}arc darkstat status${N}"
      echo -e "$HR\n"
      if systemctl is-active --quiet darkstat; then
        echo -e "  ${G}✓${N}  running  ${D}(http://${DS_HOST}:${DS_PORT}, ${DS_IFACE}, loopback only)${N}"
      else
        echo -e "  ${D}·${N}  not running  ${D}(arc darkstat start — manual only, never auto-starts)${N}"
      fi
      echo -e "\n$HR"
      ;;
    open)
      xdg-open "http://${DS_HOST}:${DS_PORT}" >/dev/null 2>&1 &
      ;;
    *)
      echo -e "${R}unknown:${N} arc darkstat $sub"
      echo -e "${D}options: status · start · stop · open${N}"
      ;;
  esac
}

cmd_zap() {
  # OWASP ZAP wrapper. Deliberately manual-start only, same principle as
  # arc-break after 2026-08-18's regression: no systemd unit, no arc-heal
  # check, nothing brings this up on its own. "Lab stays lab" is enforced
  # structurally, not just by convention -- ZAP_GUARD below refuses any
  # target that isn't localhost/127.0.0.1/a private IP range unless you
  # explicitly pass --force-live, which is logged locally when used. This is
  # a speed bump against yourself, not real security (anyone could just run
  # owasp-zap directly) -- the point is arc's own path defaults safe.
  local sub="${1:-}"
  local ZAP_HOME="$HOME/.local/share/arc-zap"
  local ZAP_PID_F="$ZAP_HOME/zap.pid"
  local ZAP_KEY_F="$ZAP_HOME/api.key"
  local ZAP_LOG="$ZAP_HOME/zap-daemon.log"
  local ZAP_HOST="127.0.0.1"
  local ZAP_PORT="8090"

  _zap_key() {
    mkdir -p "$ZAP_HOME"
    if [[ ! -f "$ZAP_KEY_F" ]]; then
      openssl rand -hex 16 > "$ZAP_KEY_F"
      chmod 600 "$ZAP_KEY_F"
    fi
    cat "$ZAP_KEY_F"
  }

  _zap_running() {
    [[ -f "$ZAP_PID_F" ]] && kill -0 "$(cat "$ZAP_PID_F" 2>/dev/null)" 2>/dev/null
  }

  # Only localhost/127.0.0.1/::1/private ranges pass by default. Public
  # hosts (including your own live domains) are refused unless --force-live
  # is explicitly typed -- no denylist to keep in sync, just a hard
  # default-deny for anything that isn't obviously local/private.
  _zap_guard() {
    local target="$1" force="$2"
    local host
    host=$(echo "$target" | sed -E 's#^[a-zA-Z]+://##; s#[:/].*##')
    if [[ "$host" == "localhost" || "$host" == "127.0.0.1" || "$host" == "::1" \
          || "$host" =~ ^10\. || "$host" =~ ^192\.168\. \
          || "$host" =~ ^172\.(1[6-9]|2[0-9]|3[0-1])\. ]]; then
      return 0
    fi
    if [[ "$force" == "--force-live" ]]; then
      echo -e "  ${Y}!${N}  LIVE target confirmed via --force-live: ${target}"
      mkdir -p "$ZAP_HOME"
      echo "$(date -Is)  ${target}" >> "$ZAP_HOME/live-target-audit.log"
      return 0
    fi
    echo -e "  ${R}✗${N}  refusing — ${D}${target}${N} isn't localhost/127.0.0.1/a private IP."
    echo -e "  ${D}arc zap only touches local/private lab targets by default (\"lab stays lab\").${N}"
    echo -e "  ${D}To scan something else on purpose: add --force-live (logged locally).${N}"
    return 1
  }

  case "$sub" in
    start)
      echo -e "$HR"
      echo -e "  ${C}${B}arc zap start${N}  —  ZAP daemon mode (API only, no GUI)"
      echo -e "$HR\n"
      if _zap_running; then
        echo -e "  ${Y}!${N}  already running  ${D}(pid $(cat "$ZAP_PID_F"))${N}"
      else
        mkdir -p "$ZAP_HOME"
        local key; key=$(_zap_key)
        nohup owasp-zap -daemon -host "$ZAP_HOST" -port "$ZAP_PORT" \
          -config api.key="$key" -config api.disablekey=false \
          >"$ZAP_LOG" 2>&1 &
        echo $! > "$ZAP_PID_F"
        echo -e "  ${D}starting, waiting for the API to come up...${N}"
        echo -e "  ${D}(first run installs addons — can take a couple minutes)${N}"
        local up=0
        for _ in $(seq 1 150); do
          curl -s "http://${ZAP_HOST}:${ZAP_PORT}" >/dev/null 2>&1 && { up=1; break; }
          sleep 2
        done
        if [[ "$up" == "1" ]]; then
          echo -e "  ${G}✓${N}  up  ${D}(${ZAP_HOST}:${ZAP_PORT}, api key in ${ZAP_KEY_F})${N}"
        else
          echo -e "  ${R}✗${N}  didn't come up in 5min — check ${ZAP_LOG}"
        fi
      fi
      echo -e "\n$HR"
      ;;
    stop)
      echo -e "$HR"
      echo -e "  ${C}${B}arc zap stop${N}"
      echo -e "$HR\n"
      if _zap_running; then
        kill "$(cat "$ZAP_PID_F")" 2>/dev/null
        rm -f "$ZAP_PID_F"
        echo -e "  ${G}✓${N}  stopped"
      else
        echo -e "  ${D}·${N}  not running"
      fi
      echo -e "\n$HR"
      ;;
    status|'')
      echo -e "$HR"
      echo -e "  ${C}${B}arc zap status${N}"
      echo -e "$HR\n"
      if _zap_running; then
        echo -e "  ${G}✓${N}  running  ${D}(pid $(cat "$ZAP_PID_F"), ${ZAP_HOST}:${ZAP_PORT}, loopback only)${N}"
      else
        echo -e "  ${D}·${N}  not running  ${D}(arc zap start — manual only, never auto-starts)${N}"
      fi
      echo -e "  ${D}pkg: $(dpkg -l zaproxy 2>/dev/null | awk '/^ii/{print $3}')${N}"
      echo -e "\n$HR"
      ;;
    gui)
      echo -e "  ${D}launching full ZAP desktop app...${N}"
      nohup zaproxy >/dev/null 2>&1 & disown
      ;;
    logs)
      tail -f "$ZAP_LOG" 2>/dev/null || echo -e "${D}no log yet — start it first${N}"
      ;;
    spider)
      local target="$2" force="$3"
      if [[ -z "$target" ]]; then
        echo -e "${R}usage:${N} arc zap spider <target> [--force-live]"
      elif _zap_guard "$target" "$force"; then
        if ! _zap_running; then
          echo -e "${Y}!${N}  daemon not running — start it first: arc zap start"
        else
          local key; key=$(_zap_key)
          echo -e "$HR"
          echo -e "  ${C}${B}arc zap spider${N}  —  crawl + passive scan: ${target}"
          echo -e "$HR\n"
          python3 -c "
from zapv2 import ZAPv2
import time, sys
zap = ZAPv2(apikey='$key', proxies={'http':'http://${ZAP_HOST}:${ZAP_PORT}','https':'http://${ZAP_HOST}:${ZAP_PORT}'})
sid = zap.spider.scan('$target')
while int(zap.spider.status(sid)) < 100:
    time.sleep(2)
print('  spider done —', len(zap.spider.results(sid)), 'urls found')
time.sleep(2)  # let passive scan drain
alerts = zap.core.alerts(baseurl='$target')
print(f'  {len(alerts)} passive alert(s)')
for a in alerts[:10]:
    print(f\"    · {a.get('risk','?')}  {a.get('alert','?')}  ({a.get('url','?')})\")
"
          echo -e "\n$HR"
        fi
      fi
      ;;
    active)
      local target="$2"
      shift 2 2>/dev/null
      local force="" confirm=""
      for a in "$@"; do
        [[ "$a" == "--force-live" ]] && force="--force-live"
        [[ "$a" == "--yes" ]] && confirm="--yes"
      done
      if [[ -z "$target" ]]; then
        echo -e "${R}usage:${N} arc zap active <target> --yes [--force-live]"
      elif [[ -z "$confirm" ]]; then
        echo -e "  ${Y}!${N}  active scan is intrusive (real attack traffic), even against a lab"
        echo -e "  ${Y}!${N}  target — re-run with --yes to actually run it"
      elif _zap_guard "$target" "$force"; then
        if ! _zap_running; then
          echo -e "${Y}!${N}  daemon not running — start it first: arc zap start"
        else
          local key; key=$(_zap_key)
          echo -e "$HR"
          echo -e "  ${C}${B}arc zap active${N}  —  active scan: ${target}"
          echo -e "$HR\n"
          python3 -c "
from zapv2 import ZAPv2
import time
zap = ZAPv2(apikey='$key', proxies={'http':'http://${ZAP_HOST}:${ZAP_PORT}','https':'http://${ZAP_HOST}:${ZAP_PORT}'})
sid = zap.ascan.scan('$target')
while int(zap.ascan.status(sid)) < 100:
    print('  progress:', zap.ascan.status(sid), '%')
    time.sleep(5)
alerts = zap.core.alerts(baseurl='$target')
print(f'  done — {len(alerts)} alert(s)')
for a in alerts[:15]:
    print(f\"    · {a.get('risk','?')}  {a.get('alert','?')}  ({a.get('url','?')})\")
"
          echo -e "\n$HR"
        fi
      fi
      ;;
    *)
      echo -e "${R}unknown:${N} arc zap $sub"
      echo -e "${D}options: status · start · stop · gui · logs · spider <target> · active <target> --yes${N}"
      ;;
  esac
}

cmd_soclab() {
  local sub="${1:-}"
  local dir="$HOME/khaos-lab/soc-lab"
  case "$sub" in
    start)
      echo -e "$HR"
      echo -e "  ${C}${B}arc soc-lab start${N}  —  bring up Splunk"
      echo -e "$HR\n"
      (cd "$dir" && docker compose up -d) \
        && echo -e "  ${G}✓${N}  started" \
        || echo -e "  ${R}✗${N}  failed — check: cd $dir && docker compose up -d"
      echo -e "\n$HR"
      ;;
    stop)
      echo -e "$HR"
      echo -e "  ${C}${B}arc soc-lab stop${N}"
      echo -e "$HR\n"
      (cd "$dir" && docker compose stop) \
        && echo -e "  ${G}✓${N}  stopped  ${D}(data preserved — docker compose down -v to wipe)${N}" \
        || echo -e "  ${R}✗${N}  failed to stop"
      echo -e "\n$HR"
      ;;
    restart)
      echo -e "$HR"
      echo -e "  ${C}${B}arc soc-lab restart${N}"
      echo -e "$HR\n"
      (cd "$dir" && docker compose restart) \
        && echo -e "  ${G}✓${N}  restarted" \
        || echo -e "  ${R}✗${N}  restart failed"
      echo -e "\n$HR"
      ;;
    status)
      echo -e "$HR"
      echo -e "  ${C}${B}arc soc-lab status${N}"
      echo -e "$HR\n"
      local splunk_state
      splunk_state=$(docker inspect --format '{{.State.Status}}' soc-lab-splunk 2>/dev/null)
      [[ "$splunk_state" == "running" ]] \
        && echo -e "  ${G}·${N}  splunk:      running  ${D}(http://127.0.0.1:8000)${N}" \
        || echo -e "  ${R}·${N}  splunk:      ${splunk_state:-not found}"
      echo -e "\n$HR"
      ;;
    logs)
      (cd "$dir" && docker compose logs -f)
      ;;
    open)
      # Splunk is the only service in this lab with a real browser UI --
      # sql-server is a bare DB port (1433), nothing to open in a browser.
      xdg-open "http://127.0.0.1:8000" >/dev/null 2>&1 &
      echo -e "  ${G}✓${N}  opening ${C}http://127.0.0.1:8000${N}  ${D}(Splunk)${N}"
      ;;
    '')
      cmd_soclab status
      ;;
    *)
      echo -e "${R}unknown:${N} arc soc-lab $sub"
      echo -e "${D}options: status · start · stop · restart · logs · open${N}"
      ;;
  esac
}

cmd_evebox() {
  local sub="${1:-}"
  local name="evebox"
  case "$sub" in
    start)
      echo -e "$HR"
      echo -e "  ${C}${B}arc evebox start${N}  —  start ${name}"
      echo -e "$HR\n"
      docker start "$name" >/dev/null 2>&1 \
        && echo -e "  ${G}✓${N}  running — ${C}http://127.0.0.1:5636${N}" \
        || echo -e "  ${R}✗${N}  failed — is the container present? (docker ps -a)"
      echo -e "\n$HR"
      ;;
    stop)
      echo -e "$HR"
      echo -e "  ${C}${B}arc evebox stop${N}  —  stop ${name}"
      echo -e "$HR\n"
      docker stop "$name" >/dev/null 2>&1 \
        && echo -e "  ${G}✓${N}  stopped" \
        || echo -e "  ${R}✗${N}  failed to stop"
      echo -e "\n$HR"
      ;;
    restart)
      echo -e "$HR"
      echo -e "  ${C}${B}arc evebox restart${N}"
      echo -e "$HR\n"
      docker restart "$name" >/dev/null 2>&1 \
        && echo -e "  ${G}✓${N}  restarted" \
        || echo -e "  ${R}✗${N}  restart failed"
      echo -e "\n$HR"
      ;;
    status)
      echo -e "$HR"
      echo -e "  ${C}${B}arc evebox status${N}"
      echo -e "$HR\n"
      local state; state=$(docker inspect --format '{{.State.Status}}' "$name" 2>/dev/null)
      if [[ -z "$state" ]]; then
        echo -e "  ${R}✗${N}  container not found"
      elif [[ "$state" == "running" ]]; then
        local stats; stats=$(docker stats "$name" --no-stream --format '{{.CPUPerc}} cpu · {{.MemUsage}}' 2>/dev/null)
        echo -e "  ${G}✓${N}  running  ${D}(${stats})${N}"
        echo -e "  ${C}url${N}  http://127.0.0.1:5636"
      else
        echo -e "  ${Y}!${N}  ${state}  ${D}(arc evebox start)${N}"
      fi
      echo -e "\n$HR"
      ;;
    logs)
      docker logs -f "$name"
      ;;
    open)
      xdg-open "http://127.0.0.1:5636" >/dev/null 2>&1 &
      echo -e "  ${G}✓${N}  opening ${C}http://127.0.0.1:5636${N}"
      ;;
    '')
      cmd_evebox status
      ;;
    *)
      echo -e "${R}unknown:${N} arc evebox $sub"
      echo -e "${D}options: (bare) status · start · stop · restart · logs · open${N}"
      ;;
  esac
}

cmd_gvm() {
  local sub="${1:-}"
  # Native systemd services, not docker -- gvmd (manager+DB), gsad (web UI),
  # ospd-openvas (the actual scanner engine) + its redis backend. Greenbone
  # ships gvm-start/gvm-stop as the real orchestration (handles service
  # ordering, VT sync wait, etc.) -- wrapped here rather than reimplemented,
  # same reasoning as soc-lab wrapping `docker compose` instead of per-
  # container commands. Manual-start only, same as zap/darkstat/kismet --
  # GVM alone wants 4GB+ RAM, never appropriate to auto-start at boot/login.
  local units=(gvmd gsad ospd-openvas notus-scanner)
  # gvm-start/gvm-stop's own exit codes are unreliable (confirmed live
  # 2026-08-31: gvm-stop reported failure while every unit had actually
  # stopped cleanly, likely because gsad's redirect-daemon sub-process logs
  # a CRITICAL that trips the wrapper's own exit status even when the
  # actual stop succeeded). Verify real state via systemctl after calling
  # it instead of trusting the wrapper's exit code -- same "don't trust the
  # tool summary, check directly" discipline used throughout this session.
  _gvm_all_active() { for u in "${units[@]}"; do systemctl is-active --quiet "$u" || return 1; done; return 0; }
  _gvm_all_inactive() { for u in "${units[@]}"; do systemctl is-active --quiet "$u" && return 1; done; return 0; }
  case "$sub" in
    start)
      echo -e "$HR"
      echo -e "  ${C}${B}arc gvm start${N}  —  start GVM/OpenVAS"
      echo -e "$HR\n"
      sudo gvm-start >/dev/null 2>&1
      if _gvm_all_active; then
        echo -e "\n  ${G}✓${N}  running — ${C}https://127.0.0.1:9392${N}  ${D}(self-signed cert, expected)${N}"
      else
        echo -e "\n  ${R}✗${N}  not all services came up — arc gvm status  ·  sudo gvm-check-setup"
      fi
      echo -e "\n$HR"
      ;;
    stop)
      echo -e "$HR"
      echo -e "  ${C}${B}arc gvm stop${N}"
      echo -e "$HR\n"
      sudo gvm-stop >/dev/null 2>&1
      if _gvm_all_inactive; then
        echo -e "\n  ${G}✓${N}  stopped"
      else
        echo -e "\n  ${R}✗${N}  failed to stop — arc gvm status"
      fi
      echo -e "\n$HR"
      ;;
    restart)
      echo -e "$HR"
      echo -e "  ${C}${B}arc gvm restart${N}"
      echo -e "$HR\n"
      sudo gvm-stop >/dev/null 2>&1
      sudo gvm-start >/dev/null 2>&1
      if _gvm_all_active; then
        echo -e "\n  ${G}✓${N}  restarted"
      else
        echo -e "\n  ${R}✗${N}  restart failed — arc gvm status"
      fi
      echo -e "\n$HR"
      ;;
    status)
      echo -e "$HR"
      echo -e "  ${C}${B}arc gvm status${N}"
      echo -e "$HR\n"
      local all_up=1
      for u in "${units[@]}"; do
        if systemctl is-active --quiet "$u"; then
          echo -e "  ${G}·${N}  ${u}"
        else
          echo -e "  ${R}·${N}  ${u}  ${D}(not running)${N}"
          all_up=0
        fi
      done
      [[ "$all_up" -eq 1 ]] && echo -e "\n  ${C}url${N}  https://127.0.0.1:9392" \
        || echo -e "\n  ${D}(arc gvm start)${N}"
      echo -e "\n$HR"
      ;;
    logs)
      journalctl -u gvmd -u gsad -u ospd-openvas -u notus-scanner -f
      ;;
    open)
      xdg-open "https://127.0.0.1:9392" >/dev/null 2>&1 &
      echo -e "  ${G}✓${N}  opening ${C}https://127.0.0.1:9392${N}  ${D}(self-signed cert, expected — login is manual, arc never handles the password)${N}"
      ;;
    '')
      cmd_gvm status
      ;;
    *)
      echo -e "${R}unknown:${N} arc gvm $sub"
      echo -e "${D}options: (bare) status · start · stop · restart · logs · open${N}"
      ;;
  esac
}

cmd_desktop() {
  local sub="${1:-}"
  # GUI + SSH access to THIS machine from outside, over a Cloudflare Tunnel —
  # x11vnc shares the live :0 session, novnc/websockify gives a browser
  # client, cloudflared is the tunnel connector itself (also carries
  # ssh.kontor.studio). All three are bundled here because they were torn
  # down together 2026-07-30 (user: no outside access needed until
  # traveling) and should come back together with one command, not three
  # separately-remembered ones.
  local URL="https://desktop.kontor.studio/vnc.html"
  local UNITS="cloudflared.service x11vnc-share.service novnc-bridge.service"

  _desktop_state() {
    systemctl is-active $UNITS 2>/dev/null | sort -u
  }

  case "$sub" in
    start)
      echo -e "$HR"
      echo -e "  ${C}${B}arc desktop start${N}  —  enable remote access (tunnel + desktop sharing)"
      echo -e "$HR\n"
      sudo systemctl enable --now $UNITS 2>/dev/null
      # Don't trust systemctl's own exit code — verify each unit's actual
      # state directly (a unit can report a non-zero start/stop result for
      # reasons unrelated to whether it's really up, as hit today with
      # x11vnc's own non-zero exit-on-SIGTERM behavior).
      if systemctl is-active --quiet cloudflared.service \
        && systemctl is-active --quiet x11vnc-share.service \
        && systemctl is-active --quiet novnc-bridge.service; then
        echo -e "  ${G}✓${N}  running — ${M}${URL}${N}"
      else
        echo -e "  ${R}✗${N}  one or more services didn't come up — check: systemctl status $UNITS"
      fi
      echo -e "\n$HR"
      ;;
    stop)
      echo -e "$HR"
      echo -e "  ${C}${B}arc desktop stop${N}  —  disable remote access (tunnel + desktop sharing)"
      echo -e "$HR\n"
      sudo systemctl disable --now $UNITS 2>/dev/null
      sudo systemctl reset-failed x11vnc-share.service 2>/dev/null
      if ! systemctl is-active --quiet cloudflared.service \
        && ! systemctl is-active --quiet x11vnc-share.service \
        && ! systemctl is-active --quiet novnc-bridge.service; then
        echo -e "  ${G}✓${N}  stopped — no longer reachable from outside"
      else
        echo -e "  ${R}✗${N}  one or more services still active — check: systemctl status $UNITS"
      fi
      echo -e "\n$HR"
      ;;
    status)
      if systemctl list-unit-files x11vnc-share.service &>/dev/null; then
        local states; states=$(_desktop_state)
        if echo "$states" | grep -q "^active$" && ! echo "$states" | grep -qv "^active$"; then
          echo -e "  ${C}state${N}  ${G}active${N}  ${D}(tunnel + desktop sharing both up)${N}"
          echo -e "  ${C}url${N}    ${M}${URL}${N}"
        elif echo "$states" | grep -q "^active$"; then
          echo -e "  ${C}state${N}  ${Y}partial${N}  ${D}— some up, some not: systemctl status $UNITS${N}"
        else
          echo -e "  ${C}state${N}  ${R}inactive${N}  ${D}(run 'arc desktop start')${N}"
        fi
      else
        echo -e "  ${R}✗${N}  not installed — run: ${C}sudo bash ~/khaos-lab/setup-local-desktop-vnc.sh${N}"
      fi
      ;;
    url)
      echo -e "  ${M}${URL}${N}"
      ;;
    '')
      echo -e "  ${D}usage: arc desktop start|stop|status|url${N}"
      ;;
    *)
      echo -e "${R}unknown:${N} arc desktop $sub"
      echo -e "${D}options: start · stop · status · url${N}"
      ;;
  esac
}

cmd_heal() {
  local sub="${1:-}"
  case "$sub" in
    log)
      [[ -f ~/khaos-lab/arc-heal-log/history.log ]] && tail -30 ~/khaos-lab/arc-heal-log/history.log \
        || echo -e "  ${D}no runs yet${N}"
      ;;
    status)
      [[ -f ~/khaos-lab/arc-heal-log/latest-status.md ]] && cat ~/khaos-lab/arc-heal-log/latest-status.md \
        || echo -e "  ${D}no runs yet — run 'arc heal' now${N}"
      ;;
    '')
      ~/.local/bin/arc-heal
      ;;
    *)
      echo -e "${R}unknown:${N} arc heal $sub"
      echo -e "${D}options: (bare) · log · status${N}"
      ;;
  esac
}


